@@ -489,6 +489,18 @@ config THERMAL_WEIGHTED_SENSOR
 	  To compile this driver as a module, choose M here: the module
 	  will be called thermal-weighted.
 
+config ICELAND_HORAE_SHELL
+	tristate "OnePlus Pad 4 shell temperature (stock Horae model)"
+	depends on THERMAL && OF && POWER_SUPPLY
+	help
+	  A read-only thermal sensor that estimates the shell (skin)
+	  temperature of the OnePlus Pad 4 with the stock thermal daemon's
+	  linear model over the present and three earlier samples of a few
+	  board sensors, as the device tree describes it.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called iceland_horae_shell.
+
 config GENERIC_ADC_THERMAL
 	tristate "Generic ADC based thermal sensor"
 	depends on IIO
