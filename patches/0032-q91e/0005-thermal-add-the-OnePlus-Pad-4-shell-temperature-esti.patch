+++ b/drivers/thermal/Makefile
@@ -64,6 +64,7 @@ obj-$(CONFIG_HISI_THERMAL)     += hisi_thermal.o
 obj-y				+= mediatek/
 obj-$(CONFIG_GENERIC_ADC_THERMAL)	+= thermal-generic-adc.o
 obj-$(CONFIG_THERMAL_WEIGHTED_SENSOR)	+= thermal-weighted.o
