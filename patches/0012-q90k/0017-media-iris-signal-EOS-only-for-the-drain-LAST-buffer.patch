From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 23 Oct 2026 23:00:00 +0300
Subject: [PATCH 17/17] media: iris: signal EOS only for the drain LAST buffer

The driver queues V4L2_EVENT_EOS and marks the m2m context stopped for
every capture buffer with V4L2_BUF_FLAG_LAST, including the PSC_LAST
buffer that closes a source change. On SM8850 the firmware raises a
source change after every seek (OUTPUT STREAMOFF/STREAMON), so userspace
that follows the EOS event (FFmpeg's v4l2m2m wrapper) ends the stream at
the first seek.

Per the stateful decoder interface, EOS belongs to the end of a drain
only. Queue it only while a drain is in progress, and clear the m2m
stopped state when V4L2_DEC_CMD_START resumes after a drain, so the next
drain signals EOS again (it was never cleared before).

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/iris/iris_buffer.c | 8 +++++++-
 drivers/media/platform/qcom/iris/iris_vb2.c    | 3 ++-
 drivers/media/platform/qcom/iris/iris_vdec.c   | 2 ++
 3 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index 31cba99a665c..35129cecd6e8 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -915,7 +915,13 @@ int iris_vb2_buffer_done(struct iris_inst *inst, struct iris_buffer *buf)
 	}
 
 	if (vbuf->flags & V4L2_BUF_FLAG_LAST) {
-		if (!v4l2_m2m_has_stopped(m2m_ctx)) {
+		/*
+		 * V4L2_EVENT_EOS marks the end of a drain only. The LAST buffer
+		 * that closes a source change (PSC_LAST, e.g. after every seek)
+		 * must not signal end of stream.
+		 */
+		if (inst->sub_state & IRIS_INST_SUB_DRAIN &&
+		    !v4l2_m2m_has_stopped(m2m_ctx)) {
 			const struct v4l2_event ev = { .type = V4L2_EVENT_EOS };
 
 			v4l2_event_queue_fh(&inst->fh, &ev);
diff --git a/drivers/media/platform/qcom/iris/iris_vb2.c b/drivers/media/platform/qcom/iris/iris_vb2.c
index 8faf709c26c1..1fae2da9413a 100644
--- a/drivers/media/platform/qcom/iris/iris_vb2.c
+++ b/drivers/media/platform/qcom/iris/iris_vb2.c
@@ -324,7 +324,8 @@ void iris_vb2_buf_queue(struct vb2_buffer *vb2)
 			vbuf->field = V4L2_FIELD_NONE;
 			vb2_set_plane_payload(vb2, 0, 0);
 			v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
-			if (!v4l2_m2m_has_stopped(m2m_ctx)) {
+			if (inst->sub_state & IRIS_INST_SUB_DRAIN &&
+			    !v4l2_m2m_has_stopped(m2m_ctx)) {
 				v4l2_event_queue_fh(&inst->fh, &eos);
 				v4l2_m2m_mark_stopped(m2m_ctx);
 			}
diff --git a/drivers/media/platform/qcom/iris/iris_vdec.c b/drivers/media/platform/qcom/iris/iris_vdec.c
index 0dd33ff447bb..f4f6d483f1ea 100644
--- a/drivers/media/platform/qcom/iris/iris_vdec.c
+++ b/drivers/media/platform/qcom/iris/iris_vdec.c
@@ -505,6 +505,8 @@ int iris_vdec_start_cmd(struct iris_inst *inst)
 	} else if (inst->sub_state & IRIS_INST_SUB_DRAIN &&
 		   inst->sub_state & IRIS_INST_SUB_DRAIN_LAST) {
 		vb2_clear_last_buffer_dequeued(dst_vq);
+		/* decoding restarts: the next drain signals EOS again */
+		v4l2_m2m_clear_state(inst->m2m_ctx);
 		clear_sub_state = IRIS_INST_SUB_DRAIN | IRIS_INST_SUB_DRAIN_LAST;
 		if (inst->sub_state & IRIS_INST_SUB_INPUT_PAUSE) {
 			if (hfi_ops->session_resume_drain) {
