From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 23 Oct 2026 22:31:52 +0300
Subject: [PATCH 16/17] drm/msm/a8xx: optional GPU_CLX_EN_REQ in the TZ GPU
 init request

KGSL asks TZ for GPU_BCL_EN_REQ and GPU_CLX_EN_REQ together with the
always-on and TSENSE requests when it initialises an A8xx GPU; we only
send the latter two. The GMU's current limiter (CLX) may depend on the
registers TZ sets up for that request.

Add msm.a8xx_clx_tz_flag (default off, read at boot). It only takes
effect with msm.enable_clx=1: then GPU_CLX_EN_REQ is added to the
request (next to BCL_EN with msm.a8xx_kgsl_bcl=1). If TZ refuses the
extended request, the plain one is sent and BCL / CLX stay without the
TZ setup, which is logged. The "CLX on" line now tells whether the TZ
flag was set.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/adreno/a6xx_gmu.c      | 39 +++++++++++++++-------
 drivers/gpu/drm/msm/adreno/a6xx_gmu.h      |  3 ++
 drivers/gpu/drm/msm/adreno/a6xx_hfi.c      |  3 +-
 drivers/gpu/drm/msm/adreno/adreno_device.c |  5 +++
 drivers/gpu/drm/msm/adreno/adreno_gpu.h    |  1 +
 5 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index b950985016bd..fadf5261009d 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1253,7 +1253,7 @@ static int a6xx_gmu_secure_init(struct a6xx_gpu *a6xx_gpu)
 	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
 	struct msm_gpu *gpu = &adreno_gpu->base;
 	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
-	u32 fuse_val;
+	u32 fuse_val, extra = 0;
 	int ret = 0;
 
 	if (test_bit(GMU_STATUS_SECURE_INIT, &gmu->status))
@@ -1280,22 +1280,37 @@ static int a6xx_gmu_secure_init(struct a6xx_gpu *a6xx_gpu)
 		}
 
 		/*
-		 * msm.a8xx_kgsl_bcl=1: also ask TZ to set up the battery current
-		 * limiter, as KGSL does; if TZ refuses that, BCL stays off and
-		 * the call is repeated without it.
+		 * As KGSL does, ask TZ to also set up the battery current
+		 * limiter (msm.a8xx_kgsl_bcl=1) and the current limiter
+		 * (msm.a8xx_clx_tz_flag=1, only with msm.enable_clx=1). If TZ
+		 * refuses that request, both stay off and the plain request is
+		 * sent instead.
 		 */
-		if (adreno_is_a8xx(adreno_gpu) && a8xx_kgsl_bcl &&
-		    adreno_gpu->info->a6xx->bcl_data) {
+		if (adreno_is_a8xx(adreno_gpu)) {
+			if (a8xx_kgsl_bcl && adreno_gpu->info->a6xx->bcl_data)
+				extra |= QCOM_SCM_GPU_BCL_EN_REQ;
+			if (a8xx_clx_tz_flag && enable_clx)
+				extra |= QCOM_SCM_GPU_CLX_EN_REQ;
+		}
+
+		if (extra) {
 			ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
-						     QCOM_SCM_GPU_BCL_EN_REQ |
-						     QCOM_SCM_GPU_TSENSE_EN_REQ);
-			gmu->bcl_enabled = !ret;
-			if (ret)
+						     QCOM_SCM_GPU_TSENSE_EN_REQ | extra);
+			if (ret) {
 				dev_warn(gpu->dev->dev,
-					 "SCM BCL request failed (%d), BCL off\n", ret);
+					 "SCM request with%s%s failed (%d), plain request, BCL / CLX TZ off\n",
+					 extra & QCOM_SCM_GPU_BCL_EN_REQ ? " BCL_EN" : "",
+					 extra & QCOM_SCM_GPU_CLX_EN_REQ ? " CLX_EN" : "", ret);
+			} else {
+				gmu->bcl_enabled = !!(extra & QCOM_SCM_GPU_BCL_EN_REQ);
+				gmu->clx_tz = !!(extra & QCOM_SCM_GPU_CLX_EN_REQ);
+				dev_info(gpu->dev->dev, "SCM GPU init request with%s%s\n",
+					 gmu->bcl_enabled ? " BCL_EN" : "",
+					 gmu->clx_tz ? " CLX_EN" : "");
+			}
 		}
 
-		if (!gmu->bcl_enabled)
+		if (!extra || ret)
 			ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
 						     QCOM_SCM_GPU_TSENSE_EN_REQ);
 		if (ret) {
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
index b5006bedfeb0..488da2579ef7 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
@@ -128,6 +128,9 @@ struct a6xx_gmu {
 	/* TZ took the BCL request (msm.a8xx_kgsl_bcl=1): send HFI_FEATURE_BCL */
 	bool bcl_enabled;
 
+	/* TZ took GPU_CLX_EN_REQ (msm.a8xx_clx_tz_flag=1 with msm.enable_clx=1) */
+	bool clx_tz;
+
 	/* For power domain callback */
 	struct notifier_block pd_nb;
 	struct completion pd_gate;
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
index 5aab2c1bbe0f..beb5f1ca553a 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -970,7 +970,8 @@ static int a6xx_hfi_enable_clx(struct a6xx_gmu *gmu)
 		return 0;
 	}
 
-	DRM_DEV_INFO_ONCE(gmu->dev, "CLX on (msm.enable_clx=1)\n");
+	DRM_DEV_INFO_ONCE(gmu->dev, "CLX on (msm.enable_clx=1, TZ CLX_EN %s)\n",
+			  gmu->clx_tz ? "set" : "not set");
 
 	ret = a6xx_hfi_feature_ctrl_msg(gmu, HFI_FEATURE_CLX, 1, 0);
 	if (ret) {
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index 9e68a9ac2197..a879d21c0945 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -48,6 +48,11 @@ MODULE_PARM_DESC(a8xx_kgsl_bcl,
 		 "A840: enable the GMU battery current limiter (BCL) as KGSL does: TZ BCL request, then HFI_FEATURE_BCL with 62/75/83 % throttle levels (0=off (default), 1=on)");
 module_param(a8xx_kgsl_bcl, bool, 0400);
 
+bool a8xx_clx_tz_flag;
+MODULE_PARM_DESC(a8xx_clx_tz_flag,
+		 "A8xx: with msm.enable_clx=1 also set GPU_CLX_EN_REQ in the TZ GPU init request, as KGSL does (0=off (default), 1=on)");
+module_param(a8xx_clx_tz_flag, bool, 0400);
+
 bool a8xx_safe_recover = true;
 MODULE_PARM_DESC(a8xx_safe_recover,
 		 "A8xx: when the CX GDSC did not collapse at a GPU recovery (no reset), complete the queued submits as faulted instead of replaying them (1=on (default), 0=replay)");
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index 5eb5fe65c79a..3a8f6a78200b 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -26,6 +26,7 @@ extern bool a8xx_safe_recover;
 extern bool a8xx_legacy_protect;
 extern bool a8xx_kgsl_eco;
 extern bool a8xx_kgsl_bcl;
+extern bool a8xx_clx_tz_flag;
 
 enum {
 	ADRENO_FW_PM4 = 0,
