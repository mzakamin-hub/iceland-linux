From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 23 Oct 2026 14:19:39 +0300
Subject: [PATCH 13/17] drm/msm/a8xx: optional KGSL hardware workaround values
 for A840

Qualcomm's KGSL driver (qualcomm-linux/kgsl, gfx-kernel.le.0.0 2b2d762,
GPL-2.0, gen8_2_0_nonctxt_regs for the A840 chip id 0x44050a01) programs
five non-context registers differently from kaanapali_nonctxt_regs:

  PC_CHICKEN_BITS_3     0x00400000 -> 0x00500000 (BR, BV)
  RB_CCU_DBG_ECO_CNTL   unset      -> 0x00002200 (BR; partial perf
                        clear, no DINT c/z data forwarding)
  SP_CHICKEN_BITS_2     0x00820800 -> 0x00c20800 (no PS out-of-order
                        retire)
  TPL1_DBG_ECO_CNTL     0x10000000 -> 0x10100000 (alphaOnly off)
  TPL1_DBG_ECO_CNTL1    0x00000720 -> 0x04000720 (no final clamp for
                        bicubic filtering)

Add them as a second table that a8xx_nonctxt_config() writes after the
first one when msm.a8xx_kgsl_eco=1 (default off, read at boot), so that a
test run can compare the GPU with and without them. All five registers
are on the A840 pwrup / IFPC restore lists, which read the programmed
values back once after the first hw_init. With the option on, the
read-back values are logged once.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/adreno/a6xx_gpu.h      |  2 ++
 drivers/gpu/drm/msm/adreno/a8xx_catalog.c  | 22 ++++++++++++++++++++++
 drivers/gpu/drm/msm/adreno/a8xx_gpu.c      | 22 ++++++++++++++++++++++
 drivers/gpu/drm/msm/adreno/adreno_device.c |  5 +++++
 drivers/gpu/drm/msm/adreno/adreno_gpu.h    |  1 +
 5 files changed, 52 insertions(+)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.h b/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
index cc23bbc1bf1a..24f2350607ad 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
@@ -67,6 +67,8 @@ struct a6xx_info {
 	const struct adreno_reglist_list *ifpc_reglist;
 	const struct adreno_reglist *gbif_cx;
 	const struct adreno_reglist_pipe *nonctxt_reglist;
+	/* written after nonctxt_reglist with msm.a8xx_kgsl_eco=1 (A840 only) */
+	const struct adreno_reglist_pipe *nonctxt_kgsl_eco;
 	u32 max_slices;
 	u32 gmu_chipid;
 	u32 gmu_cgc_mode;
diff --git a/drivers/gpu/drm/msm/adreno/a8xx_catalog.c b/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
index 4dc5de4d5ede..cf2ae4597abf 100644
--- a/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
@@ -654,6 +654,27 @@ static const struct adreno_reglist_pipe a840_dyn_pwrup_reglist_regs[] = {
 };
 DECLARE_ADRENO_REGLIST_PIPE_LIST(a840_dyn_pwrup_reglist);
 
+/*
+ * Hardware workaround values of Qualcomm's KGSL driver for gen8_2_x (A840,
+ * qualcomm-linux/kgsl gfx-kernel.le.0.0 2b2d762, gen8_2_0_nonctxt_regs),
+ * where they differ from kaanapali_nonctxt_regs or are missing there.
+ * Written after that table with msm.a8xx_kgsl_eco=1. The pwrup / IFPC
+ * restore lists read the programmed values back, all five are on them.
+ */
+static const struct adreno_reglist_pipe a840_kgsl_eco_regs[] = {
+	/* 0x400000 -> 0x500000 */
+	{ REG_A8XX_PC_CHICKEN_BITS_3, 0x00500000, BIT(PIPE_BV) | BIT(PIPE_BR) },
+	/* partially enable perf clear, no DINT c/z data forwarding (unset) */
+	{ REG_A7XX_RB_CCU_DBG_ECO_CNTL, 0x00002200, BIT(PIPE_BR) },
+	/* 0x820800 -> 0xc20800: no PS out-of-order retire */
+	{ REG_A7XX_SP_CHICKEN_BITS_2, 0x00c20800, BIT(PIPE_NONE) },
+	/* 0x10000000 -> 0x10100000: BIT(20) disables the alphaOnly feature */
+	{ REG_A6XX_TPL1_DBG_ECO_CNTL, 0x10100000, BIT(PIPE_NONE) },
+	/* 0x720 -> 0x4000720: BIT(26) no final clamp for bicubic filtering */
+	{ REG_A6XX_TPL1_DBG_ECO_CNTL1, 0x04000720, BIT(PIPE_NONE) },
+	{ /* sentinel */ },
+};
+
 static const struct a6xx_hfi_clx_table_v2_cmd a840_clx_tbl = {
 	.version = (2 << 16) | 1,
 	.domain = {
@@ -1029,6 +1050,7 @@ static const struct adreno_info a8xx_gpus[] = {
 			.protect = &kaanapali_protect,
 			.protect_legacy = &pakala_protect,
 			.nonctxt_reglist = kaanapali_nonctxt_regs,
+			.nonctxt_kgsl_eco = a840_kgsl_eco_regs,
 			.pwrup_reglist = &a840_pwrup_reglist,
 			.dyn_pwrup_reglist = &a840_dyn_pwrup_reglist,
 			.ifpc_reglist = &a840_ifpc_reglist,
diff --git a/drivers/gpu/drm/msm/adreno/a8xx_gpu.c b/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
index 184836062246..56efa1fdc8d5 100644
--- a/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
@@ -391,6 +391,8 @@ static void a8xx_nonctxt_config(struct msm_gpu *gpu)
 	struct a6xx_gmu *gmu = &to_a6xx_gpu(adreno_gpu)->gmu;
 	const struct a6xx_info *info = adreno_gpu->info->a6xx;
 	const struct adreno_reglist_pipe *regs = info->nonctxt_reglist;
+	const struct adreno_reglist_pipe *eco = a8xx_kgsl_eco ? info->nonctxt_kgsl_eco : NULL;
+	u32 eco_val[8] = { 0 };
 	unsigned int pipe_id, i;
 	unsigned long flags;
 
@@ -412,10 +414,30 @@ static void a8xx_nonctxt_config(struct msm_gpu *gpu)
 			}
 		}
 
+		/*
+		 * KGSL's workaround values, read back once for the log (in the
+		 * table's order: PC_CHICKEN_BITS_3, RB_CCU_DBG_ECO_CNTL,
+		 * SP_CHICKEN_BITS_2, TPL1_DBG_ECO_CNTL, TPL1_DBG_ECO_CNTL1)
+		 */
+		for (i = 0; eco && eco[i].offset; i++) {
+			if (!(BIT(pipe_id) & eco[i].pipe))
+				continue;
+
+			gpu_write(gpu, eco[i].offset, eco[i].value);
+			if (i < ARRAY_SIZE(eco_val) &&
+			    (pipe_id == PIPE_NONE || pipe_id == PIPE_BR))
+				eco_val[i] = gpu_read(gpu, eco[i].offset);
+		}
+
 		a8xx_aperture_release(gpu, flags);
 	}
 
 	a8xx_aperture_clear(gpu);
+
+	if (eco)
+		dev_info_once(&gpu->pdev->dev,
+			      "KGSL workaround values on: %08x %08x %08x %08x %08x\n",
+			      eco_val[0], eco_val[1], eco_val[2], eco_val[3], eco_val[4]);
 }
 
 static void a8xx_patch_pwrup_reglist(struct msm_gpu *gpu)
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index 1059bc489e40..34099ad31627 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -38,6 +38,11 @@ MODULE_PARM_DESC(a8xx_legacy_protect,
 		 "A840: program the CP protect table used before the SoC's own one (0=SoC table (default), 1=legacy)");
 module_param(a8xx_legacy_protect, bool, 0444);
 
+bool a8xx_kgsl_eco;
+MODULE_PARM_DESC(a8xx_kgsl_eco,
+		 "A840: program Qualcomm KGSL's hardware workaround values for PC_CHICKEN_BITS_3, SP_CHICKEN_BITS_2, TPL1_DBG_ECO_CNTL(1) and RB_CCU_DBG_ECO_CNTL (0=off (default), 1=on)");
+module_param(a8xx_kgsl_eco, bool, 0444);
+
 bool a8xx_safe_recover = true;
 MODULE_PARM_DESC(a8xx_safe_recover,
 		 "A8xx: when the CX GDSC did not collapse at a GPU recovery (no reset), complete the queued submits as faulted instead of replaying them (1=on (default), 0=replay)");
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index ae4894beea9a..a0ca22418e0d 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -24,6 +24,7 @@ extern bool enable_clx;
 extern bool a8xx_crashstate;
 extern bool a8xx_safe_recover;
 extern bool a8xx_legacy_protect;
+extern bool a8xx_kgsl_eco;
 
 enum {
 	ADRENO_FW_PM4 = 0,
