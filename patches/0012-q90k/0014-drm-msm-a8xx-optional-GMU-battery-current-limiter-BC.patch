From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 23 Oct 2026 14:20:35 +0300
Subject: [PATCH 14/17] drm/msm/a8xx: optional GMU battery current limiter
 (BCL) as in KGSL

KGSL enables the GMU battery current limiter on A840 (gen8_2_x): it
adds GPU_BCL_EN_REQ to the TZ GPU init request and sends
HFI_FEATURE_BCL between ACD and CLX with the throttle levels 62 / 75 /
83 % and response type 1 (GEN8_2_X_BCL_DATA). The GMU then throttles the
GPU in steps on the PMIC's BCL alarms instead of letting a battery
current peak brown the system out.

Do the same with msm.a8xx_kgsl_bcl=1 (default off, read at boot): the
SCM request carries QCOM_SCM_GPU_BCL_EN_REQ; if TZ refuses it, the old
request is sent and BCL stays off. The HFI message follows ACD as in
KGSL; a GMU that refuses it leaves BCL off and the start continues.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/adreno/a6xx_gmu.c      | 23 ++++++++++++++++---
 drivers/gpu/drm/msm/adreno/a6xx_gmu.h      |  3 +++
 drivers/gpu/drm/msm/adreno/a6xx_gpu.h      |  2 ++
 drivers/gpu/drm/msm/adreno/a6xx_hfi.c      | 26 ++++++++++++++++++++++
 drivers/gpu/drm/msm/adreno/a8xx_catalog.c  |  2 ++
 drivers/gpu/drm/msm/adreno/adreno_device.c |  5 +++++
 drivers/gpu/drm/msm/adreno/adreno_gpu.h    |  1 +
 7 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index 598a6839792a..b950985016bd 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1254,7 +1254,7 @@ static int a6xx_gmu_secure_init(struct a6xx_gpu *a6xx_gpu)
 	struct msm_gpu *gpu = &adreno_gpu->base;
 	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
 	u32 fuse_val;
-	int ret;
+	int ret = 0;
 
 	if (test_bit(GMU_STATUS_SECURE_INIT, &gmu->status))
 		return 0;
@@ -1279,8 +1279,25 @@ static int a6xx_gmu_secure_init(struct a6xx_gpu *a6xx_gpu)
 			goto done;
 		}
 
-		ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
-					     QCOM_SCM_GPU_TSENSE_EN_REQ);
+		/*
+		 * msm.a8xx_kgsl_bcl=1: also ask TZ to set up the battery current
+		 * limiter, as KGSL does; if TZ refuses that, BCL stays off and
+		 * the call is repeated without it.
+		 */
+		if (adreno_is_a8xx(adreno_gpu) && a8xx_kgsl_bcl &&
+		    adreno_gpu->info->a6xx->bcl_data) {
+			ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
+						     QCOM_SCM_GPU_BCL_EN_REQ |
+						     QCOM_SCM_GPU_TSENSE_EN_REQ);
+			gmu->bcl_enabled = !ret;
+			if (ret)
+				dev_warn(gpu->dev->dev,
+					 "SCM BCL request failed (%d), BCL off\n", ret);
+		}
+
+		if (!gmu->bcl_enabled)
+			ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
+						     QCOM_SCM_GPU_TSENSE_EN_REQ);
 		if (ret) {
 			dev_warn_once(gpu->dev->dev,
 				"SCM call failed\n");
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
index 1a2f82df6642..b5006bedfeb0 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
@@ -125,6 +125,9 @@ struct a6xx_gmu {
 	bool hung;
 	bool legacy; /* a618 or a630 */
 
+	/* TZ took the BCL request (msm.a8xx_kgsl_bcl=1): send HFI_FEATURE_BCL */
+	bool bcl_enabled;
+
 	/* For power domain callback */
 	struct notifier_block pd_nb;
 	struct completion pd_gate;
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.h b/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
index 24f2350607ad..1e5d891c87db 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
@@ -69,6 +69,8 @@ struct a6xx_info {
 	const struct adreno_reglist_pipe *nonctxt_reglist;
 	/* written after nonctxt_reglist with msm.a8xx_kgsl_eco=1 (A840 only) */
 	const struct adreno_reglist_pipe *nonctxt_kgsl_eco;
+	/* HFI_FEATURE_BCL data (response type + throttle levels), A8xx */
+	u32 bcl_data;
 	u32 max_slices;
 	u32 gmu_chipid;
 	u32 gmu_cgc_mode;
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
index 1ab46097c2c3..5aab2c1bbe0f 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -888,6 +888,27 @@ static int a6xx_hfi_enable_acd(struct a6xx_gmu *gmu)
 	return 0;
 }
 
+static int a6xx_hfi_enable_bcl(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	u32 data = a6xx_gpu->base.info->a6xx->bcl_data;
+	int ret;
+
+	if (!gmu->bcl_enabled)
+		return 0;
+
+	/* BIT(0) response type, BIT(1:7) / (8:14) / (15:21) throttle levels */
+	ret = a6xx_hfi_feature_ctrl_msg(gmu, HFI_FEATURE_BCL, 1, data);
+	if (ret) {
+		DRM_DEV_ERROR(gmu->dev, "Unable to enable BCL (%d), BCL off\n", ret);
+		gmu->bcl_enabled = false;
+		return 0;
+	}
+
+	DRM_DEV_INFO_ONCE(gmu->dev, "BCL on (msm.a8xx_kgsl_bcl=1, data %#x)\n", data);
+	return 0;
+}
+
 static int a6xx_hfi_enable_iff_pclx(struct a6xx_gmu *gmu, const struct a6xx_limits_tbl *limits)
 {
 	struct a6xx_hfi_table_entry *entry;
@@ -1090,6 +1111,11 @@ int a6xx_hfi_start(struct a6xx_gmu *gmu, int boot_state)
 	if (ret)
 		return ret;
 
+	/* KGSL's order: ACD, BCL, CLX, IFPC */
+	ret = a6xx_hfi_enable_bcl(gmu);
+	if (ret)
+		return ret;
+
 	ret = a6xx_hfi_enable_clx(gmu);
 	if (ret)
 		return ret;
diff --git a/drivers/gpu/drm/msm/adreno/a8xx_catalog.c b/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
index cf2ae4597abf..01942eed25d9 100644
--- a/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a8xx_catalog.c
@@ -1051,6 +1051,8 @@ static const struct adreno_info a8xx_gpus[] = {
 			.protect_legacy = &pakala_protect,
 			.nonctxt_reglist = kaanapali_nonctxt_regs,
 			.nonctxt_kgsl_eco = a840_kgsl_eco_regs,
+			/* KGSL GEN8_2_X_BCL_DATA: levels 62 / 75 / 83 %, response type 1 */
+			.bcl_data = (62 << 15) | (75 << 8) | (83 << 1) | 0x1,
 			.pwrup_reglist = &a840_pwrup_reglist,
 			.dyn_pwrup_reglist = &a840_dyn_pwrup_reglist,
 			.ifpc_reglist = &a840_ifpc_reglist,
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index 34099ad31627..9e68a9ac2197 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -43,6 +43,11 @@ MODULE_PARM_DESC(a8xx_kgsl_eco,
 		 "A840: program Qualcomm KGSL's hardware workaround values for PC_CHICKEN_BITS_3, SP_CHICKEN_BITS_2, TPL1_DBG_ECO_CNTL(1) and RB_CCU_DBG_ECO_CNTL (0=off (default), 1=on)");
 module_param(a8xx_kgsl_eco, bool, 0444);
 
+bool a8xx_kgsl_bcl;
+MODULE_PARM_DESC(a8xx_kgsl_bcl,
+		 "A840: enable the GMU battery current limiter (BCL) as KGSL does: TZ BCL request, then HFI_FEATURE_BCL with 62/75/83 % throttle levels (0=off (default), 1=on)");
+module_param(a8xx_kgsl_bcl, bool, 0400);
+
 bool a8xx_safe_recover = true;
 MODULE_PARM_DESC(a8xx_safe_recover,
 		 "A8xx: when the CX GDSC did not collapse at a GPU recovery (no reset), complete the queued submits as faulted instead of replaying them (1=on (default), 0=replay)");
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index a0ca22418e0d..5eb5fe65c79a 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -25,6 +25,7 @@ extern bool a8xx_crashstate;
 extern bool a8xx_safe_recover;
 extern bool a8xx_legacy_protect;
 extern bool a8xx_kgsl_eco;
+extern bool a8xx_kgsl_bcl;
 
 enum {
 	ADRENO_FW_PM4 = 0,
