From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Wed, 25 Nov 2026 14:57:00 +0200
Subject: [PATCH 4/4] arm64: dts: qcom: kaanapali: place the DSI1 nodes after
 the DSI0 PHY

The DSI1 controller and PHY nodes came with the SM8850 bring-up tree,
after the DisplayPort controller. Move them, unchanged, to directly
after the DSI0 PHY, which keeps the display subsystem's children in
unit-address order (dsi@9ac3000 and phy@9ac4000 before
displayport-controller@9ad2000) and matches where the version posted
for upstream adds them ("arm64: dts: qcom: kaanapali: Add the second
DSI controller and PHY", Molokai series v4 08/11, whose node text is
identical to ours).

No functional change: the decompiled DTB is the same apart from the
node order and the phandle numbers dtc assigns in tree order.

Link: https://lore.kernel.org/r/20261123-molokai-soc-v4-8-851e5a9f4878@yahoo.com
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 arch/arm64/boot/dts/qcom/kaanapali.dtsi | 162 ++++++++++++------------
 1 file changed, 81 insertions(+), 81 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index e02d58a1bd3c6..0ff3c5aaa7e88 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -4803,87 +4803,6 @@ mdss_dsi0_phy: phy@9ac1000 {
 				status = "disabled";
 			};
 
-			mdss_dp0: displayport-controller@9ad2000 {
-				compatible = "qcom,kaanapali-dp", "qcom,sm8650-dp";
-				reg = <0x0 0x09ad2000 0x0 0x10c>,
-				      <0x0 0x09ad2200 0x0 0xc8>,
-				      <0x0 0x09ad3000 0x0 0xb78>,
-				      <0x0 0x09ad4000 0x0 0xa0>,
-				      <0x0 0x09ad5000 0x0 0xa0>;
-
-				interrupts-extended = <&mdss 12>;
-
-				clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
-					 <&dispcc DISP_CC_MDSS_DPTX0_AUX_CLK>,
-					 <&dispcc DISP_CC_MDSS_DPTX0_LINK_CLK>,
-					 <&dispcc DISP_CC_MDSS_DPTX0_LINK_INTF_CLK>,
-					 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL0_CLK>,
-					 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL1_CLK>;
-				clock-names = "core_iface",
-					      "core_aux",
-					      "ctrl_link",
-					      "ctrl_link_iface",
-					      "stream_pixel",
-					      "stream_1_pixel";
-
-				assigned-clocks = <&dispcc DISP_CC_MDSS_DPTX0_LINK_CLK_SRC>,
-						  <&dispcc DISP_CC_MDSS_DPTX0_PIXEL0_CLK_SRC>,
-						  <&dispcc DISP_CC_MDSS_DPTX0_PIXEL1_CLK_SRC>;
-				assigned-clock-parents = <&usb_dp_qmpphy QMP_USB43DP_DP_LINK_CLK>,
-							 <&usb_dp_qmpphy QMP_USB43DP_DP_VCO_DIV_CLK>,
-							 <&usb_dp_qmpphy QMP_USB43DP_DP_VCO_DIV_CLK>;
-
-				operating-points-v2 = <&dp_opp_table>;
-				power-domains = <&rpmhpd RPMHPD_MMCX>;
-
-				phys = <&usb_dp_qmpphy QMP_USB43DP_DP_PHY>;
-				phy-names = "dp";
-
-				#sound-dai-cells = <0>;
-				status = "disabled";
-
-				dp_opp_table: opp-table {
-					compatible = "operating-points-v2";
-
-					opp-270000000 {
-						opp-hz = /bits/ 64 <270000000>;
-						required-opps = <&rpmhpd_opp_low_svs>;
-					};
-
-					opp-540000000 {
-						opp-hz = /bits/ 64 <540000000>;
-						required-opps = <&rpmhpd_opp_svs_l1>;
-					};
-
-					opp-810000000 {
-						opp-hz = /bits/ 64 <810000000>;
-						required-opps = <&rpmhpd_opp_nom>;
-					};
-				};
-
-				ports {
-					#address-cells = <1>;
-					#size-cells = <0>;
-
-					port@0 {
-						reg = <0>;
-
-						mdss_dp0_in: endpoint {
-							remote-endpoint = <&dpu_intf0_out>;
-						};
-					};
-
-					port@1 {
-						reg = <1>;
-
-						mdss_dp0_out: endpoint {
-							data-lanes = <0 1 2 3>;
-							remote-endpoint = <&usb_dp_qmpphy_dp_in>;
-						};
-					};
-				};
-			};
-
 			mdss_dsi1: dsi@9ac3000 {
 				compatible = "qcom,kaanapali-dsi-ctrl", "qcom,mdss-dsi-ctrl";
 				reg = <0x0 0x09ac3000 0x0 0x1000>;
@@ -4968,6 +4887,87 @@ mdss_dsi1_phy: phy@9ac4000 {
 
 				status = "disabled";
 			};
+
+			mdss_dp0: displayport-controller@9ad2000 {
+				compatible = "qcom,kaanapali-dp", "qcom,sm8650-dp";
+				reg = <0x0 0x09ad2000 0x0 0x10c>,
+				      <0x0 0x09ad2200 0x0 0xc8>,
+				      <0x0 0x09ad3000 0x0 0xb78>,
+				      <0x0 0x09ad4000 0x0 0xa0>,
+				      <0x0 0x09ad5000 0x0 0xa0>;
+
+				interrupts-extended = <&mdss 12>;
+
+				clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
+					 <&dispcc DISP_CC_MDSS_DPTX0_AUX_CLK>,
+					 <&dispcc DISP_CC_MDSS_DPTX0_LINK_CLK>,
+					 <&dispcc DISP_CC_MDSS_DPTX0_LINK_INTF_CLK>,
+					 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL0_CLK>,
+					 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL1_CLK>;
+				clock-names = "core_iface",
+					      "core_aux",
+					      "ctrl_link",
+					      "ctrl_link_iface",
+					      "stream_pixel",
+					      "stream_1_pixel";
+
+				assigned-clocks = <&dispcc DISP_CC_MDSS_DPTX0_LINK_CLK_SRC>,
+						  <&dispcc DISP_CC_MDSS_DPTX0_PIXEL0_CLK_SRC>,
+						  <&dispcc DISP_CC_MDSS_DPTX0_PIXEL1_CLK_SRC>;
+				assigned-clock-parents = <&usb_dp_qmpphy QMP_USB43DP_DP_LINK_CLK>,
+							 <&usb_dp_qmpphy QMP_USB43DP_DP_VCO_DIV_CLK>,
+							 <&usb_dp_qmpphy QMP_USB43DP_DP_VCO_DIV_CLK>;
+
+				operating-points-v2 = <&dp_opp_table>;
+				power-domains = <&rpmhpd RPMHPD_MMCX>;
+
+				phys = <&usb_dp_qmpphy QMP_USB43DP_DP_PHY>;
+				phy-names = "dp";
+
+				#sound-dai-cells = <0>;
+				status = "disabled";
+
+				dp_opp_table: opp-table {
+					compatible = "operating-points-v2";
+
+					opp-270000000 {
+						opp-hz = /bits/ 64 <270000000>;
+						required-opps = <&rpmhpd_opp_low_svs>;
+					};
+
+					opp-540000000 {
+						opp-hz = /bits/ 64 <540000000>;
+						required-opps = <&rpmhpd_opp_svs_l1>;
+					};
+
+					opp-810000000 {
+						opp-hz = /bits/ 64 <810000000>;
+						required-opps = <&rpmhpd_opp_nom>;
+					};
+				};
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@0 {
+						reg = <0>;
+
+						mdss_dp0_in: endpoint {
+							remote-endpoint = <&dpu_intf0_out>;
+						};
+					};
+
+					port@1 {
+						reg = <1>;
+
+						mdss_dp0_out: endpoint {
+							data-lanes = <0 1 2 3>;
+							remote-endpoint = <&usb_dp_qmpphy_dp_in>;
+						};
+					};
+				};
+			};
 		};
 
 		dispcc: clock-controller@9ba2000 {
-- 
