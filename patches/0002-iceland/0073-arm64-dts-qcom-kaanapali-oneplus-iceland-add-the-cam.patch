From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 02:01:25 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: add the cameras

The 13 MP rear camera (SmartSens SC1320CS on CSIPHY4) and the 8 MP front
camera (SmartSens SC820CS on CSIPHY5), both four-lane D-PHY, on the camera
I2C bus with their supplies, clocks and reset pins as in the vendor device
tree; the CSI-2 PHYs and CAMSS are enabled.

The reset pins are LV_VIN2 pads of the PMH0110 with two power sources: the
vendor tree asks for source 2, which cannot be set there; they stay on
source 0 as booted.

The rear focus motor is described but disabled, and the sensor has no
lens-focus link yet: the motor shares the sensors' 1.8 V rail for its bus
pull-ups and cannot probe before a sensor is powered, which would keep the
CAMSS notifier from completing.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 197 ++++++++++++++++++
 1 file changed, 197 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 3b0def8eb726..0fd09849969d 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -5,6 +5,8 @@
 
 /dts-v1/;
 
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/gpio-keys.h>
 #include <dt-bindings/input/linux-event-codes.h>
@@ -980,6 +982,86 @@
 	};
 };
 
+&camss {
+	status = "okay";
+
+	ports {
+		port@4 {
+			camss_csiphy4_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy4_out>;
+			};
+		};
+
+		port@5 {
+			camss_csiphy5_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy5_out>;
+			};
+		};
+	};
+};
+
+&csiphy4 {
+	vdda-0p9-supply = <&vreg_l3d_0p8>;
+	vdda-1p2-supply = <&vreg_l1d_1p2>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			csiphy4_in: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&cam_rear_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			csiphy4_out: endpoint {
+				remote-endpoint = <&camss_csiphy4_ep>;
+			};
+		};
+	};
+};
+
+&csiphy5 {
+	vdda-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-1p2-supply = <&vreg_l1d_1p2>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			csiphy5_in: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&cam_front_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			csiphy5_out: endpoint {
+				remote-endpoint = <&camss_csiphy5_ep>;
+			};
+		};
+	};
+};
+
 &gpu_opp_table {
 	/*
 	 * The Pad 4's stock GPU levels (qcom,gpu-pwrlevels for speed bin 0xfc):
@@ -1108,6 +1190,80 @@
 	};
 };
 
+&i2c9 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/* front: SmartSens SC820CS, chip id 0xd154 (stock "icelandfront") */
+	camera@10 {
+		compatible = "smartsens,sc820cs";
+		reg = <0x10>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+
+		reset-gpios = <&pmh0110_g_e0_gpios 13 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_front_mclk_default>, <&cam_front_reset_default>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l2f_1p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		avdd-supply = <&vreg_l14b_2p8>;
+
+		orientation = <0>;
+		rotation = <270>;
+
+		port {
+			cam_front_out: endpoint {
+				link-frequencies = /bits/ 64 <330000000>;
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy5_in>;
+			};
+		};
+	};
+
+	/* rear focus motor (DW9800K register map; stock "icelandmain_actuator") */
+	vcm: actuator@c {
+		compatible = "dongwoon,dw9800k";
+		reg = <0x0c>;
+
+		vdd-supply = <&vreg_l16b_2p8>;
+
+		dongwoon,sac-mode = <2>;
+		dongwoon,vcm-prescale = <0x79>;
+
+		/* first light without focus: the motor cannot probe before a sensor powers the bus pull-ups */
+		status = "disabled";
+	};
+
+	/* rear: SmartSens SC1320CS, chip id 0xc658 (stock "icelandmain") */
+	camera@36 {
+		compatible = "smartsens,sc1320cs";
+		reg = <0x36>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+
+		reset-gpios = <&pmh0110_g_e0_gpios 14 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_rear_mclk_default>, <&cam_rear_reset_default>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l2f_1p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		avdd-supply = <&vreg_l14b_2p8>;
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			cam_rear_out: endpoint {
+				link-frequencies = /bits/ 64 <662400000>;
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy4_in>;
+			};
+		};
+	};
+};
+
 &i2c14 {
 	status = "okay";
 
@@ -1378,6 +1534,30 @@
 	};
 };
 
+&pmh0110_g_e0_gpios {
+	/*
+	 * stock cam_sensor_active_rst_main / _front ask for power source 2, but these are LV_VIN2 pads
+	 * (two sources): the request is rejected there too and the pads stay on source 0, as booted
+	 */
+	cam_rear_reset_default: cam-rear-reset-default-state {
+		pins = "gpio14";
+		function = "normal";
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		output-low;
+		input-disable;
+	};
+
+	cam_front_reset_default: cam-front-reset-default-state {
+		pins = "gpio13";
+		function = "normal";
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		output-low;
+		input-disable;
+	};
+};
+
 &pmih0108_e1_eusb2_repeater {
 	vdd18-supply = <&vreg_l15b_1p8>;
 	vdd3-supply = <&vreg_l5b_3p1>;
@@ -1386,6 +1566,23 @@
 	qcom,tune-usb2-preem = /bits/ 8 <3>;
 };
 
+&pmk8850_gpios {
+	/* stock cam_sensor_main_mclk1_active / cam_sensor_front_mclk4_active */
+	cam_rear_mclk_default: cam-rear-mclk-default-state {
+		pins = "gpio2";
+		function = "func2";
+		power-source = <0>;
+		output-enable;
+	};
+
+	cam_front_mclk_default: cam-front-mclk-default-state {
+		pins = "gpio1";
+		function = "func2";
+		power-source = <0>;
+		output-enable;
+	};
+};
+
 &pmk8850_vadc {
 	pinctrl-0 = <&usbtemp_l_default>, <&usbtemp_r_default>;
 	pinctrl-names = "default";
