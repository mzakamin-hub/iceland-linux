From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 11:21:24 +0300
Subject: [PATCH] dt-bindings: input: add the OnePlus Pad 4 pogo keyboard dock

The OnePlus Pad 4 takes a keyboard dock with a touchpad on three pogo
pins: supply, ground and one data line. The tablet's UART receiver
listens on the data line, its transmitter reaches the line through a
gate that the host opens for the length of a frame, and the same line
is wired to a GPIO that tells whether a dock is attached (an unpowered
or sleeping dock holds the line low). Describe the dock as a child of
the UART with the detect GPIO, the gate GPIO and its supply.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../input/oneplus,iceland-pogo-keyboard.yaml  | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/oneplus,iceland-pogo-keyboard.yaml

diff --git a/Documentation/devicetree/bindings/input/oneplus,iceland-pogo-keyboard.yaml b/Documentation/devicetree/bindings/input/oneplus,iceland-pogo-keyboard.yaml
new file mode 100644
index 000000000000..d00e1fa4e392
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/oneplus,iceland-pogo-keyboard.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/oneplus,iceland-pogo-keyboard.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus pogo-pin keyboard dock
+
+maintainers:
+  - mzak <mzak.amin@gmail.com>
+
+description:
+  The OnePlus Pad 4 takes a keyboard dock with a touchpad ("Smart Keyboard")
+  on three pogo pins - supply, ground and one data line. The tablet's UART
+  receiver listens on the data line; its transmitter reaches the line through
+  a gate that the host opens for the length of a frame. The same line is
+  wired to a GPIO - an unpowered or sleeping dock holds it low, an empty
+  connector lets it float high - which serves as attach detection and
+  wake-up source. The dock speaks a private framed protocol at 921600 baud.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: oneplus,iceland-pogo-keyboard
+
+  detect-gpios:
+    maxItems: 1
+    description:
+      The data line read as a GPIO; active low (low = a dock is attached and
+      is unpowered or asleep).
+
+  tx-enable-gpios:
+    maxItems: 1
+    description: Opens the gate between the UART transmitter and the data line.
+
+  vcc-supply:
+    description: Supply of the dock.
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - detect-gpios
+  - tx-enable-gpios
+  - vcc-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    serial {
+      keyboard {
+        compatible = "oneplus,iceland-pogo-keyboard";
+        detect-gpios = <&tlmm 151 GPIO_ACTIVE_LOW>;
+        tx-enable-gpios = <&pmh0110_d_e0_gpios 6 GPIO_ACTIVE_HIGH>;
+        vcc-supply = <&pogo_vcc>;
+        wakeup-source;
+      };
+    };
