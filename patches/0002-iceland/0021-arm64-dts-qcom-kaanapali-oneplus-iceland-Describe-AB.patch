From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 28 Sep 2026 02:56:23 +0000
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: Describe ABL's
 splash framebuffer

Add a simple-framebuffer for ABL's splash buffer (3392x2400 at
0xfc800000), holding the MDSS AHB/MDP/LUT/VSYNC/ESC clocks, the display
AXI clock, the MDSS GDSC and MMCX + MX + MXC votes, and reserve its memory (it
lies inside a RAM range ABL reports). Modelled on the OnePlus 15
(infiniti) node, with two Pad 4 differences found on the tablet:

- ABL runs the MDP at 650 MHz for the 3392x2400@144 dual-DSI panel,
  which needs MMCX TURBO; an SVS vote (as on the OnePlus 15) lowered the
  rail under the running display engine and the LCD turned white as soon
  as simpledrm probed.
- MX and MXC were dropped to 0 when the RPMh power-domain driver synced
  its state (~22 s) and the LCD turned white. The stock display clock
  controller is supplied by MMCX and MX (vdd_mm, vdd_mx), and the boot
  chain holds MMCX, MX and MXC at TURBO; none has a parent on kaanapali,
  so all three are voted until the display driver takes over.
- The DSI byte/pixel clocks are not listed: their parents are the DSI
  PHY PLLs, unknown to Linux until the PHYs probe, so enabling them as
  orphans could re-program what ABL set up.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 54 ++++++++++++++++++-
 1 file changed, 53 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 3ea11107c35b..081fff201964 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -42,7 +42,54 @@
 		serial1 = &uart18;
 	};
 
-	chosen { };
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * ABL's splash framebuffer (3392x2400 XN251, dual DSI). The clocks, power
+		 * domains and MMCX level keep the bootloader's scanout alive until the
+		 * MSM KMS driver takes over (as on the OnePlus 15).
+		 */
+		framebuffer: framebuffer@fc800000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xfc800000 0x0 0x2b00000>;
+			width = <3392>;
+			height = <2400>;
+			stride = <(3392 * 4)>;
+			format = "a8r8g8b8";
+
+			/*
+			 * The DSI byte/pixel clocks are left out on purpose: their parents are the
+			 * DSI PHY PLLs, unknown to Linux until the DSI PHYs probe, and enabling them
+			 * as orphans could re-program what ABL set up.
+			 */
+			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
+				 <&dispcc DISP_CC_MDSS_AHB_CLK>,
+				 <&dispcc DISP_CC_MDSS_MDP_CLK>,
+				 <&dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
+				 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
+				 <&dispcc DISP_CC_MDSS_ESC0_CLK>,
+				 <&dispcc DISP_CC_MDSS_ESC1_CLK>;
+
+			/*
+			 * ABL runs the MDP at 650 MHz for 3392x2400@144 dual DSI: needs TURBO on
+			 * MMCX. The display clock controller is also supplied by MX (stock
+			 * vdd_mx), and the boot chain holds MX and MXC at TURBO too; none of
+			 * them has a parent here, so vote all three until MDSS takes over.
+			 */
+			power-domains = <&rpmhpd RPMHPD_MMCX>,
+					<&rpmhpd RPMHPD_MX>,
+					<&rpmhpd RPMHPD_MXC>,
+					<&dispcc DISP_CC_MDSS_CORE_GDSC>;
+			required-opps = <&rpmhpd_opp_turbo>,
+					<&rpmhpd_opp_turbo>,
+					<&rpmhpd_opp_turbo>;
+
+			memory-region = <&cont_splash_mem>;
+		};
+	};
 
 	/* Both produced by Master KTZ8869, unfortunately gpio 14 and 15 aren't
 	 * wired to Master KTZ8869 in MP units, so vddpos and vddneg will always be active
@@ -164,6 +211,11 @@
 	};
 
 	reserved-memory {
+		cont_splash_mem: splash-region@fc800000 {
+			reg = <0x0 0xfc800000 0x0 0x2b00000>;
+			no-map;
+		};
+
 		gunyah_hyp_mem: gunyah-hyp@80000000 {
 			reg = <0x0 0x80000000 0x0 0xe00000>;
 			no-map;
