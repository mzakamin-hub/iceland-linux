From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 09:07:58 +0300
Subject: [PATCH] regulator: qcom-rpmh: add the PMH0101 level shifters

The four bidirectional level shifters of the PMH0101 are enabled through
the RPMh XOB resources LS<n><pmic id> (for example LS1B_E0). Add a
resource name format for them and the four regulators ls1 - ls4, which
only have an enable vote.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/regulator/qcom-rpmh-regulator.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/regulator/qcom-rpmh-regulator.c b/drivers/regulator/qcom-rpmh-regulator.c
index 42bd7f1a6293..8a5be8287f10 100644
--- a/drivers/regulator/qcom-rpmh-regulator.c
+++ b/drivers/regulator/qcom-rpmh-regulator.c
@@ -39,6 +39,7 @@ enum rpmh_regulator_type {
  * @LDO:			Linear Dropout regulator.
  * @BOB:			Buck/Boost type regulator.
  * @VS:			Simple voltage ON/OFF switch.
+ * @LS:			Bidirectional level shifter with an enable vote.
  * @NUM_REGULATOR_TYPES:	Number of regulator types.
  */
 enum regulator_hw_type {
@@ -46,6 +47,7 @@ enum regulator_hw_type {
 	LDO,
 	BOB,
 	VS,
+	LS,
 	NUM_REGULATOR_TYPES,
 };
 
@@ -59,6 +61,7 @@ static const struct resource_name_formats vreg_rsc_name_lookup[NUM_REGULATOR_TYP
 	[LDO]	= {"L%d%s", "ldo%s%d"},
 	[BOB]	= {"B%d%s", "bob%s%d"},
 	[VS]	= {"VS%d%s", "vs%s%d"},
+	[LS]	= {"LS%d%s", "ls%s%d"},
 };
 
 #define RPMH_REGULATOR_REG_VRM_VOLTAGE		0x0
@@ -894,6 +897,12 @@ static const struct rpmh_vreg_hw_data pmic4_lvs = {
 	/* LVS hardware does not support voltage or mode configuration. */
 };
 
+static const struct rpmh_vreg_hw_data pmic5_ls = {
+	.regulator_type = XOB,
+	.ops = &rpmh_regulator_xob_ops,
+	/* A level shifter between two GPIO pads: only an enable vote. */
+};
+
 static const struct rpmh_vreg_hw_data pmic5_pldo = {
 	.regulator_type = VRM,
 	.ops = &rpmh_regulator_vrm_drms_ops,
@@ -1659,6 +1668,10 @@ static const struct rpmh_vreg_init_data pmh0101_vreg_data[] = {
 	RPMH_VREG("ldo18",  LDO, 18, &pmic5_nldo530,      "vdd-l18"),
 	RPMH_VREG("bob1",   BOB, 1,  &pmic5_bob,          "vdd-bob1"),
 	RPMH_VREG("bob2",   BOB, 2,  &pmic5_bob,          "vdd-bob2"),
+	RPMH_VREG("ls1",    LS,  1,  &pmic5_ls,           NULL),
+	RPMH_VREG("ls2",    LS,  2,  &pmic5_ls,           NULL),
+	RPMH_VREG("ls3",    LS,  3,  &pmic5_ls,           NULL),
+	RPMH_VREG("ls4",    LS,  4,  &pmic5_ls,           NULL),
 	{}
 };
 
