From 0077d1e6d11eb604bc5f9acaa5dffc7498b53c15 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 09:07:59 +0300
Subject: [PATCH] dt-bindings: media: i2c: dongwoon,dw9719: add the I/O supply

Some camera modules feed the pull-ups of their I2C bus from the 1.8 V
I/O rail of the module. The focus motor then needs that rail besides its
own supply, or the bus is stuck while only the motor is powered.
Describe it as the optional vio-supply.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../devicetree/bindings/media/i2c/dongwoon,dw9719.yaml       | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
index 8e8d62436e..7290628354 100644
--- a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
@@ -29,6 +29,11 @@ properties:
   vdd-supply:
     description: VDD power supply
 
+  vio-supply:
+    description:
+      I/O power supply. On some camera modules it also feeds the pull-ups of
+      the I2C bus, which then only works while this supply is on.
+
   dongwoon,sac-mode:
     description: |
       Slew Rate Control mode to use: direct, LSC (Linear Slope Control) or
-- 
2.43.0

