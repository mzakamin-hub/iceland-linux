From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 16:19:52 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: throttle the
 CDSP as stock

The vendor device tree of the OnePlus Pad 4 throttles the CDSP (the
NPU) at three places, all at trips that our device tree already has:

- the XO / board thermistor at 78 C (hysteresis 8 C): the CDSP from
  mitigation level 5 upwards, next to the GPU limit there
- the "socd" zone from 5 % battery left: the CDSP up to level 4, next
  to the CPU and GPU limits there
- the PMH0110 D temperature alarm at 95 C: the CDSP's vector unit (HVX)
  from level 5 upwards

Add the CDSP's TMD endpoints to those maps with the vendor's limits. The
vendor's modem entries in the PMH0110 D map have no counterpart: the Pad
4 has no modem.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 28 +++++++++++++------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 40492d32edc0..3ff002f3c54c 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -12,6 +12,7 @@
 #include <dt-bindings/input/linux-event-codes.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/thermal/qcom,pas.h>
 #include "kaanapali.dtsi"
 
 #include "pmh0101.dtsi"              /* SPMI0: SID-1       */
@@ -2368,9 +2369,9 @@ map1 {
 
 	/*
 	 * XO / board: stock sys-therm-0 = pmk8850_xo_therm. At 78 C (hysteresis 8) stock limits the GPU from
-	 * state 5 (826 MHz) upwards and pauses CPUs 2-7; at 80 C (hysteresis 10) it takes CPUs 3-7 offline; at
-	 * 90 C it shuts down. Mainline has no CPU pause or hotplug cooling device, so both CPU steps hold the
-	 * clusters at their lowest frequency instead.
+	 * state 5 (826 MHz) upwards, the CDSP (NPU) from TMD level 5 upwards and pauses CPUs 2-7; at 80 C
+	 * (hysteresis 10) it takes CPUs 3-7 offline; at 90 C it shuts down. Mainline has no CPU pause or hotplug
+	 * cooling device, so both CPU steps hold the clusters at their lowest frequency instead.
 	 */
 	xo-thermal {
 		polling-delay-passive = <1000>;
@@ -2401,6 +2402,7 @@ cooling-maps {
 			map0 {
 				trip = <&xo_alert0>;
 				cooling-device = <&gpu 5 THERMAL_NO_LIMIT>,
+						 <&remoteproc_cdsp QCOM_TMD_CDSP_SW 5 THERMAL_NO_LIMIT>,
 						 <&cpu0 27 27>,
 						 <&cpu6 28 28>;
 			};
@@ -2548,7 +2550,7 @@ map0 {
 	/*
 	 * Nearly empty. Stock's "socd" zone reads 100 - capacity; from 95 (5 % left) it limits the CPUs one state
 	 * per second down to state 11 (2227200 kHz) on the small cluster and state 15 (2438400 kHz) on the big
-	 * one, and the GPU down to state 5 (826 MHz). Stock's DSP map has no counterpart here.
+	 * one, the GPU down to state 5 (826 MHz) and the CDSP (NPU) up to TMD level 4.
 	 */
 	socd-thermal {
 		polling-delay-passive = <1000>;
@@ -2568,7 +2570,8 @@ map0 {
 				trip = <&socd_trip>;
 				cooling-device = <&cpu0 THERMAL_NO_LIMIT 11>,
 						 <&cpu6 THERMAL_NO_LIMIT 15>,
-						 <&gpu 0 5>;
+						 <&gpu 0 5>,
+						 <&remoteproc_cdsp QCOM_TMD_CDSP_SW 0 4>;
 			};
 		};
 	};
@@ -2622,10 +2625,19 @@ usb-temp-r-hot {
 };
 
 /*
- * PMIC temperature alarms: stock binds cooling to the 95 C stage of three PMH0110 zones: F -> the GPU from 826 MHz
- * down, G -> pause CPUs 2-5, I -> pause CPUs 6-7. Mainline has no CPU pause, so the cluster is held at its lowest
- * frequency instead (as in the XO zone).
+ * PMIC temperature alarms: stock binds cooling to the 95 C stage of four PMH0110 zones: D -> the CDSP's HVX from TMD
+ * level 5 up, F -> the GPU from 826 MHz down, G -> pause CPUs 2-5, I -> pause CPUs 6-7. Mainline has no CPU pause,
+ * so the cluster is held at its lowest frequency instead (as in the XO zone).
  */
+&{/thermal-zones/pmh0110-d-thermal} {
+	cooling-maps {
+		map0 {
+			trip = <&{/thermal-zones/pmh0110-d-thermal/trips/trip0}>;
+			cooling-device = <&remoteproc_cdsp QCOM_TMD_CDSP_SW_HVX 5 THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
 &{/thermal-zones/pmh0110-f-thermal} {
 	cooling-maps {
 		map0 {
-- 
2.43.0

