From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 19 Oct 2026 06:40:14 +0300
Subject: [PATCH 396/402] phy: qcom: qmp-combo: apply a Type-C mode switch
 deferred by the DP link

qmp_combo_typec_mux_set() does not switch the PHY mode while the DP PHY
is powered on, so that the lanes do not change under a running DP link.
The request is dropped, though, not deferred: the PHY stays in the old
mode until the next Type-C event, which may never come. Unplugging a
DP-only (pin assignment C) monitor and plugging a DP + USB3 (pin
assignment D) dock before the DP link has been torn down leaves the PHY
in DP-only mode with the dock attached: USB3 does not work and DP trains
on lanes that are routed to the USB3 pins.

Remember the requested mode instead and apply it from
qmp_combo_dp_exit(), once the DP controller has powered the PHY off and
released it. Not from the power-off itself: the DP controller powers the
PHY off and on between link training attempts and expects the lanes to
stay. A later request for the current mode drops the pending switch.

While a switch is pending, report the DP lane count of the pending mode
as the bus width: that is what the next DP link will get, and what the
DP controller has to size that link for when the sink is replugged
before the old link is down.

Move the mode switch itself into qmp_combo_switch_mode(), unchanged, so
that both paths share it.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 109 +++++++++++++++-------
 1 file changed, 74 insertions(+), 35 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index db90449fc59f..6f184f846896 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2599,6 +2599,10 @@ struct qmp_combo {
 	bool dp_powered_on;
 	bool dp_active;
 
+	/* A Type-C mode switch deferred while the DP PHY was powered on */
+	bool mode_switch_pending;
+	enum qmpphy_mode pending_qmpphy_mode;
+
 	struct clk_fixed_rate pipe_clk_fixed;
 	struct clk_hw dp_link_hw;
 	struct clk_hw dp_pixel_hw;
@@ -4201,16 +4205,25 @@ static int qmp_combo_dp_lanes(enum qmpphy_mode mode)
 
 /*
  * Report the DP lane count of the current mode as the bus width of the DP
- * PHY, so that the DisplayPort controller can size its link to it.
+ * PHY, so that the DisplayPort controller can size its link to it. While a
+ * mode switch waits for the DP link to go down, report the lanes of the mode
+ * the next link will get.
  */
 static void qmp_combo_dp_update_lanes(struct qmp_combo *qmp)
 {
+	enum qmpphy_mode mode = qmp->qmpphy_mode;
+
 	lockdep_assert_held(&qmp->phy_mutex);
 
+	if (qmp->mode_switch_pending)
+		mode = qmp->pending_qmpphy_mode;
+
 	if (qmp->dp_phy)
-		phy_set_bus_width(qmp->dp_phy, qmp_combo_dp_lanes(qmp->qmpphy_mode));
+		phy_set_bus_width(qmp->dp_phy, qmp_combo_dp_lanes(mode));
 }
 
+static void qmp_combo_switch_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mode);
+
 static int qmp_combo_dp_init(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
@@ -4242,6 +4255,13 @@ static int qmp_combo_dp_exit(struct phy *phy)
 
 	qmp->dp_init_count--;
 
+	/* The DP link is down: apply the Type-C mode switch it held back */
+	if (qmp->mode_switch_pending && !qmp->dp_powered_on) {
+		dev_dbg(qmp->dev, "dp_exit: switching from qmpphy mode %d to deferred %d\n",
+			qmp->qmpphy_mode, qmp->pending_qmpphy_mode);
+		qmp_combo_switch_mode(qmp, qmp->pending_qmpphy_mode);
+	}
+
 	mutex_unlock(&qmp->phy_mutex);
 
 	return 0;
@@ -4843,6 +4863,46 @@ static int qmp_combo_register_clocks(struct qmp_combo *qmp, struct device_node *
 	return devm_add_action_or_reset(qmp->dev, phy_clk_release_provider, dp_np);
 }
 
+static void qmp_combo_switch_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mode)
+{
+	const struct qmp_phy_cfg *cfg = qmp->cfg;
+
+	lockdep_assert_held(&qmp->phy_mutex);
+
+	qmp->qmpphy_mode = new_mode;
+	qmp->mode_switch_pending = false;
+	qmp_combo_dp_update_lanes(qmp);
+
+	if (qmp->init_count) {
+		if (qmp->usb_init_count)
+			qmp_combo_usb_power_off(qmp->usb_phy);
+
+		if (qmp->dp_init_count)
+			writel(DP_PHY_PD_CTL_PSR_PWRDN, qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
+
+		qmp_combo_com_exit(qmp, true);
+
+		/* Now everything's powered down, power up the right PHYs */
+		qmp_combo_com_init(qmp, true);
+
+		if (new_mode == QMPPHY_MODE_DP_ONLY) {
+			if (qmp->usb_init_count)
+				qmp->usb_init_count--;
+		}
+
+		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
+			qmp_combo_usb_power_on(qmp->usb_phy);
+			if (!qmp->usb_init_count)
+				qmp->usb_init_count++;
+		}
+
+		if (new_mode == QMPPHY_MODE_DP_ONLY || new_mode == QMPPHY_MODE_USB3DP) {
+			if (qmp->dp_init_count)
+				cfg->dp_aux_init(qmp);
+		}
+	}
+}
+
 #if IS_ENABLED(CONFIG_TYPEC)
 static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 				      enum typec_orientation orientation)
@@ -4875,7 +4935,6 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
 {
 	struct qmp_combo *qmp = typec_mux_get_drvdata(mux);
-	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	enum qmpphy_mode new_mode;
 	unsigned int svid;
 
@@ -4917,48 +4976,28 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 
 	if (new_mode == qmp->qmpphy_mode) {
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
+		/* Back to the current mode: drop a switch still waiting */
+		if (qmp->mode_switch_pending) {
+			qmp->mode_switch_pending = false;
+			qmp_combo_dp_update_lanes(qmp);
+		}
 		return 0;
 	}
 
 	if (qmp->qmpphy_mode != QMPPHY_MODE_USB3_ONLY && qmp->dp_powered_on) {
-		dev_dbg(qmp->dev, "typec_mux_set: DP PHY is still in use, delaying switch\n");
+		/* Switch once the DP link is down, in qmp_combo_dp_exit() */
+		dev_dbg(qmp->dev, "typec_mux_set: DP PHY is still in use, delaying switch to mode %d\n",
+			new_mode);
+		qmp->pending_qmpphy_mode = new_mode;
+		qmp->mode_switch_pending = true;
+		qmp_combo_dp_update_lanes(qmp);
 		return 0;
 	}
 
 	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
 		qmp->qmpphy_mode, new_mode);
 
-	qmp->qmpphy_mode = new_mode;
-	qmp_combo_dp_update_lanes(qmp);
-
-	if (qmp->init_count) {
-		if (qmp->usb_init_count)
-			qmp_combo_usb_power_off(qmp->usb_phy);
-
-		if (qmp->dp_init_count)
-			writel(DP_PHY_PD_CTL_PSR_PWRDN, qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
-
-		qmp_combo_com_exit(qmp, true);
-
-		/* Now everything's powered down, power up the right PHYs */
-		qmp_combo_com_init(qmp, true);
-
-		if (new_mode == QMPPHY_MODE_DP_ONLY) {
-			if (qmp->usb_init_count)
-				qmp->usb_init_count--;
-		}
-
-		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
-			qmp_combo_usb_power_on(qmp->usb_phy);
-			if (!qmp->usb_init_count)
-				qmp->usb_init_count++;
-		}
-
-		if (new_mode == QMPPHY_MODE_DP_ONLY || new_mode == QMPPHY_MODE_USB3DP) {
-			if (qmp->dp_init_count)
-				cfg->dp_aux_init(qmp);
-		}
-	}
+	qmp_combo_switch_mode(qmp, new_mode);
 
 	return 0;
 }
