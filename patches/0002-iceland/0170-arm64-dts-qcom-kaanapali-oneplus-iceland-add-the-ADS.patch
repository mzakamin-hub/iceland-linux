From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 21:07:15 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: add the ADSP
 FastRPC remote heap

The FastRPC channel of the ADSP has no reserved memory, so the driver
reports "no reserved DMA memory for FASTRPC" and the remote heap of the
DSP's static process comes from the generic DMA pool without being
assigned to the DSP.

Describe the 12 MiB reusable heap region the vendor tree of this tablet
uses and hand it to the LPASS and ADSP heap VMs, as the newer Qualcomm
SoC trees upstream do.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/kaanapali-oneplus-iceland.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index c503109a9244..ba601b94e181 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -318,6 +318,15 @@
 			reg = <0x0 0xff800000 0x0 0x800000>;
 			no-map;
 		};
+
+		/* the ADSP FastRPC remote heap, as the vendor tree's adsp_heap_region */
+		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
+			compatible = "shared-dma-pool";
+			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
+			reusable;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0xc00000>;
+		};
 	};
 
 	sound {
@@ -2040,6 +2049,14 @@
 			"qcom/kaanapali/iceland/adsp_dtb.mbn";
 
 	status = "okay";
+
+	glink-edge {
+		fastrpc {
+			memory-region = <&adsp_rpc_remote_heap_mem>;
+			qcom,vmids = <QCOM_SCM_VMID_LPASS
+				      QCOM_SCM_VMID_ADSP_HEAP>;
+		};
+	};
 };
 
 &remoteproc_cdsp {
