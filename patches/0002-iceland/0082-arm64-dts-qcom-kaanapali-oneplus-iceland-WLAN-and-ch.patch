From 37bef7a056d9edd66813693569f0f2fe10deb6cf Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 08:17:52 +0300
Subject: [PATCH 82/83] arm64: dts: qcom: kaanapali-oneplus-iceland: WLAN and
 charge-pump thermistors

The vendor's shell temperature estimate reads five temperatures: the
skin thermistor, the board thermistor, the battery, sys-therm-4 and
chg_cp_therm. The last two were missing.

Add them as ADC channels and thermal zones with the vendor's channel
settings:
- wlan-thermal: channel 0x146 (pmh0101_wlan_therm), ratiometric,
  settle time 200 us; a 125 C passive trip as on the vendor's zone, no
  cooling map.
- chg-cp-thermal: channel 0x274b (svooc_mos_btb_therm) on PMIH010x
  gpio15 (high impedance, no pull), ratiometric, settle time 200 us; no
  trips, as on the vendor's zone.

Tested on the OnePlus Pad 4: both read within 2 C of the board
thermistor at idle (34.2 C and 33.9 C next to 32.6 C).

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 54 ++++++++++++++++++-
 1 file changed, 53 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index a20feecde..64a38d2ff 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -1584,7 +1584,7 @@ cam_front_mclk_default: cam-front-mclk-default-state {
 };
 
 &pmk8850_vadc {
-	pinctrl-0 = <&usbtemp_l_default>, <&usbtemp_r_default>;
+	pinctrl-0 = <&usbtemp_l_default>, <&usbtemp_r_default>, <&chg_cp_therm_default>;
 	pinctrl-names = "default";
 
 	/* PMH0101 (SID 1) thermistors, 100k pull-up (stock: pmh0101_board_therm, pmh0101_flash_therm) */
@@ -1604,6 +1604,26 @@ channel@14a {
 		qcom,adc-tm;
 	};
 
+	/*
+	 * stock: pmh0101_wlan_therm (sys-therm-4) and svooc_mos_btb_therm (chg_cp_therm, on PMIH010x GPIO 15). With
+	 * skin_therm, board_therm and the battery they are the inputs of stock's shell temperature estimate.
+	 */
+	channel@146 {
+		reg = <ADC5_GEN4_AMUX3_THM_100K_PU(0, 1)>;
+		label = "wlan_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,adc-tm;
+	};
+
+	channel@274b {
+		reg = <ADC5_GEN4_AMUX2_GPIO_100K_PU(1, 7)>;
+		label = "chg_cp_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,adc-tm;
+	};
+
 	/* stock: pmh0101_skin_therm (sys-therm-2), the skin thermistor */
 	channel@144 {
 		reg = <ADC5_GEN4_AMUX1_THM_100K_PU(0, 1)>;
@@ -1661,6 +1681,14 @@ usbtemp_r_default: usbtemp-r-default-state {
 		bias-high-impedance;
 		bias-disable;
 	};
+
+	/* stock svooc_mos_btb_therm_default */
+	chg_cp_therm_default: chg-cp-therm-default-state {
+		pins = "gpio15";
+		function = "normal";
+		bias-high-impedance;
+		bias-disable;
+	};
 };
 
 &pon_resin {
@@ -2021,6 +2049,30 @@ flash-hot {
 		};
 	};
 
+	/*
+	 * Inputs of stock's shell temperature estimate (userspace: iceland-thermal). Stock: sys-therm-4 with both
+	 * trips at 125 C (passive, no cooling map), chg_cp_therm without trips.
+	 */
+	wlan-thermal {
+		polling-delay-passive = <1000>;
+		polling-delay = <0>;
+		thermal-sensors = <&pmk8850_vadc ADC5_GEN4_AMUX3_THM_100K_PU(0, 1)>;
+
+		trips {
+			wlan-hot {
+				temperature = <125000>;
+				hysteresis = <1000>;
+				type = "passive";
+			};
+		};
+	};
+
+	chg-cp-thermal {
+		polling-delay-passive = <0>;
+		polling-delay = <0>;
+		thermal-sensors = <&pmk8850_vadc ADC5_GEN4_AMUX2_GPIO_100K_PU(1, 7)>;
+	};
+
 	/*
 	 * Skin. Stock marks this sensor (sys-therm-2) at 48, 49, 50, 60, 61 and 90 C and leaves the throttling to
 	 * its userspace thermal service; that service's high-temperature protection steps in at 48 C (out at 46),
