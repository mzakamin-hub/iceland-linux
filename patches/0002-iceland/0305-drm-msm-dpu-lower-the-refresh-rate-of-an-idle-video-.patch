+static struct input_handler dpu_idle_rr_input_handler = {
+	.event = dpu_idle_rr_input_event,
+	.connect = dpu_idle_rr_input_connect,
+	.disconnect = dpu_idle_rr_input_disconnect,
+	.name = "msm_dpu_idle_refresh",
+	.id_table = dpu_idle_rr_input_ids,
+};
+
+/* called with dpu_idle_rr_lock held */
+static void dpu_idle_rr_input_update(bool on)
+{
+	if (on == dpu_idle_rr_input_registered)
+		return;
+
+	if (on) {
+		if (input_register_handler(&dpu_idle_rr_input_handler))
+			return;
+	} else {
+		input_unregister_handler(&dpu_idle_rr_input_handler);
+	}
+	dpu_idle_rr_input_registered = on;
+}
+
+/* input, or a parameter change: return to the mode rate, re-arm the drop */
+static void dpu_idle_rr_kick_fn(struct work_struct *work)
+{
+	struct dpu_encoder_virt *dpu_enc;
+
+	mutex_lock(&dpu_idle_rr_lock);
+	if (!list_empty(&dpu_idle_rr_encoders))
+		dpu_idle_rr_input_update(READ_ONCE(dpu_idle_refresh_ms) != 0);
+	list_for_each_entry(dpu_enc, &dpu_idle_rr_encoders, idle_rr.node)
+		dpu_idle_rr_raise(dpu_enc);
+	mutex_unlock(&dpu_idle_rr_lock);
+}
+
+/* encoder enable, under the commit lock */
+static void dpu_idle_rr_enable(struct dpu_encoder_virt *dpu_enc)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+	struct drm_crtc *crtc = dpu_enc->base.crtc;
+
+	idle->gen++;
+	idle->looked_up = false;
+	WRITE_ONCE(idle->idle_vtotal, 0);
+	WRITE_ONCE(idle->low, false);
+	drm_mode_copy(&idle->mode, &crtc->state->adjusted_mode);
+	WRITE_ONCE(idle->crtc_idx, drm_crtc_index(crtc));
+	idle->capable = dpu_idle_rr_capable(dpu_enc);
+	WRITE_ONCE(idle->last_kick, jiffies);
+	idle->enabled = true;
+
+	dpu_idle_rr_arm(idle);
+}
+
+/* encoder disable, under the commit lock: the next enable programs the mode */
+static void dpu_idle_rr_disable(struct dpu_encoder_virt *dpu_enc)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+
+	if (!idle->enabled)
+		return;
+
+	idle->enabled = false;
+	idle->gen++;
+	if (idle->low)
+		atomic_dec(&dpu_idle_rr_nr_low);
+	WRITE_ONCE(idle->low, false);
+	/* a running work item sees !enabled under the lock we hold */
+	cancel_delayed_work(&idle->work);
+}
+
+/* prepare for a commit kickoff, under the commit lock: re-arm the drop */
+static void dpu_idle_rr_prepare_kickoff(struct dpu_encoder_virt *dpu_enc)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+
+	if (!idle->enabled || !idle->capable)
+		return;
+
+	WRITE_ONCE(idle->last_kick, jiffies);
+	dpu_idle_rr_arm(idle);
+}
+
+/*
+ * Commit kickoff, under the commit lock and the encoder spinlock, right
+ * before the CTL flush: back to the mode rate with this frame's flush.
+ */
+static void dpu_idle_rr_kickoff_locked(struct dpu_encoder_virt *dpu_enc)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+
+	if (idle->enabled && idle->capable && idle->low)
+		dpu_idle_rr_program(dpu_enc, false, false);
+}
+
+/**
+ * dpu_encoder_idle_rr_fini - stop the idle refresh rate handling
+ * @drm_enc: encoder pointer
+ *
+ * Called before the KMS goes away; safe to call more than once.
+ */
+void dpu_encoder_idle_rr_fini(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+	bool last;
+
+	mutex_lock(&dpu_idle_rr_lock);
+	list_del_init(&idle->node);
+	last = list_empty(&dpu_idle_rr_encoders);
+	if (last)
+		dpu_idle_rr_input_update(false);
+	mutex_unlock(&dpu_idle_rr_lock);
+
+	cancel_delayed_work_sync(&idle->work);
+	if (last)
+		cancel_work_sync(&dpu_idle_rr_kick_work);
+}
+
+static void dpu_idle_rr_release(struct drm_device *dev, void *ptr)
+{
+	dpu_encoder_idle_rr_fini(ptr);
+}
+
+static int dpu_idle_rr_init(struct dpu_encoder_virt *dpu_enc)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+	int ret;
+
+	INIT_DELAYED_WORK(&idle->work, dpu_idle_rr_work_fn);
+	idle->crtc_idx = -1;
+
+	mutex_lock(&dpu_idle_rr_lock);
+	list_add_tail(&idle->node, &dpu_idle_rr_encoders);
+	mutex_unlock(&dpu_idle_rr_lock);
+
+	/* in case the KMS init fails before dpu_kms_destroy() can run */
+	ret = drmm_add_action_or_reset(dpu_enc->base.dev, dpu_idle_rr_release,
+				       &dpu_enc->base);
+	if (ret)
+		return ret;
+
+	/* apply a dpu_idle_refresh_ms given at load time */
+	dpu_idle_rr_kick();
+
+	return 0;
+}
+
+/**
+ * dpu_encoder_frame_vtotal - vertical total of the frame being scanned out
+ * @drm_enc: encoder pointer
+ * @line: the current INTF line count
+ * @mode_vtotal: vertical total of the mode
+ *
+ * Return: the idle vertical total while the front porch is stretched,
+ * else @mode_vtotal
+ */
+int dpu_encoder_frame_vtotal(struct drm_encoder *drm_enc, int line,
+			     int mode_vtotal)
+{
+	struct dpu_enc_idle_rr *idle = &to_dpu_encoder_virt(drm_enc)->idle_rr;
+	int idle_vtotal = READ_ONCE(idle->idle_vtotal);
+
+	if (idle_vtotal > mode_vtotal &&
+	    (READ_ONCE(idle->low) || line > mode_vtotal))
+		return idle_vtotal;
+
+	return mode_vtotal;
+}
