From 33f856d65d637ee9772036c462db7907dc54c4ca Mon Sep 17 00:00:00 2001
From: map220v <map220v300@gmail.com>
Date: Fri, 19 Jun 2026 17:58:04 +0000
Subject: [PATCH] SM8850: Add cache info

(cherry picked from commit 98673dc8e6c5912e48c3f486183e494be7786849)
---
 arch/arm64/boot/dts/qcom/kaanapali.dtsi | 54 +++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index 1c27220c07..f682fa1857 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -46,6 +46,12 @@ cpu0: cpu@0 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x0>;
 			enable-method = "psci";
+			d-cache-size = <0x10000>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <256>;
+			i-cache-size = <0x20000>;
+			i-cache-line-size = <64>;
+			i-cache-sets = <512>;
 			next-level-cache = <&l2_0>;
 			power-domains = <&cpu_pd0>, <&scmi_perf 0>;
 			power-domain-names = "psci", "perf";
@@ -55,6 +61,9 @@ l2_0: l2-cache {
 				compatible = "cache";
 				cache-level = <2>;
 				cache-unified;
+				cache-size = <0xc00000>;
+				cache-line-size = <64>;
+				cache-sets = <16384>;
 			};
 		};
 
@@ -63,6 +72,12 @@ cpu1: cpu@100 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x100>;
