+/*
+ * Live values make sense only while a transfer runs: the IC sleeps between its
+ * looks for a pen (stock reads them for a present pen only, c:3247, 3264).
+ */
+static ssize_t mt5806_live_show(struct device *dev, char *buf, u16 reg)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+	u16 val = 0;
+
+	guard(mutex)(&chip->lock);
+	if (chip->ready && chip->present && !chip->suspended)
+		mt5806_read16(chip, reg, &val);
+	return sysfs_emit(buf, "%u\n", val);
+}
