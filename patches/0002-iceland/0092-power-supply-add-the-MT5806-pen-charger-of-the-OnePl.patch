+	return sysfs_emit(buf, "%d\n", READ_ONCE(chip->rx_soc));
+}
+
+/*
+ * The pen's battery level as user space knows it (Bluetooth). As in stock
+ * (c:3285-3316, 3049-3087) a pen that was full and has dropped to the threshold
+ * is charged again; unlike stock only for a pen with a valid address and a
+ * value of 0..100.
+ */
+static ssize_t rx_soc_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > 100)
+		return -EINVAL;
+
+	guard(mutex)(&chip->lock);
+	if (!chip->ready || !chip->present)
+		return -ENODEV;
+
+	chip->rx_soc = val;
+	if (val <= MT5806_RECHARGE_SOC && chip->near && !chip->tx_allowed &&
+	    chip->stop == MT5806_STOP_FULL && !chip->inhibit) {
+		mt5806_note(chip, "pen at %u %%: charge again", val);
+		chip->stop = MT5806_STOP_NONE;
+		chip->recharge = true;
+		chip->tx_start = ktime_get_boottime();
+		mod_delayed_work(system_percpu_wq, &chip->max_time_work,
+				 msecs_to_jiffies(MT5806_MAX_CHARGE_MS));
+		mt5806_tx_update(chip);
+	}
+
+	return count;
+}
+static DEVICE_ATTR_RW(rx_soc);
+
+static ssize_t inhibit_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(chip->inhibit));
+}
+
+/*
+ * 1 switches the transmitter off (stock: tx_charge_disable for the camera,
+ * c:3572-3661), 0 gives it back to the rules above.
+ */
+static ssize_t inhibit_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&chip->lock);
+	if (val == chip->inhibit)
+		return count;
+
+	chip->inhibit = val;
+	mt5806_note(chip, "inhibit %d", val);
+	if (val) {
+		chip->validating = false;
+		cancel_delayed_work(&chip->validate_work);
+	} else if (chip->ready && chip->near && !chip->present && chip->stop == MT5806_STOP_NONE) {
+		mt5806_validate_start(chip);
+	}
+	mt5806_tx_update(chip);
+
+	return count;
+}
+static DEVICE_ATTR_RW(inhibit);
+
+static ssize_t scan_fast_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(chip->scan_fast));
+}
+
+/*
+ * 1: look for a pen every 200 ms (stock with the screen on), 0: every 2 s (stock
+ * with the screen off); c:122, 3966-3983.
+ */
+static ssize_t scan_fast_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&chip->lock);
+	chip->scan_fast = val;
+	if (chip->ready && !chip->suspended)
+		gpiod_set_value_cansleep(chip->scan_gpio, val);
+
+	return count;
+}
+static DEVICE_ATTR_RW(scan_fast);
+
+/* the pen's Bluetooth address, for pairing; readable by root only and never logged */
+static ssize_t ble_address_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+	u64 a;
+
+	guard(mutex)(&chip->lock);
+	if (!chip->present)
+		return -ENODATA;
+	a = chip->ble_addr;
+	return sysfs_emit(buf, "%02X:%02X:%02X:%02X:%02X:%02X\n", (u8)(a >> 40), (u8)(a >> 32),
+			  (u8)(a >> 24), (u8)(a >> 16), (u8)(a >> 8), (u8)a);
+}
+static DEVICE_ATTR_ADMIN_RO(ble_address);
