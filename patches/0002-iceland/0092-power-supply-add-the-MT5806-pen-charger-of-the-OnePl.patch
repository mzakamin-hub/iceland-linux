+static int mt5806_status_show(struct seq_file *s, void *unused)
+{
+	struct mt5806 *chip = s->private;
+	unsigned int i, first;
+	u16 val;
+
+	scoped_guard(mutex, &mt5806_link_lock) {
+		struct mt5806_hboost *hb = mt5806_hboost;
+
+		seq_printf(s, "boost_link: bound %d up %d epoch %u answers %u last_len %u last_result %u stray %u stray_opcode 0x%x\n",
+			   !!hb, hb ? hb->up : 0, hb ? hb->epoch : 0, hb ? hb->answers : 0,
+			   hb ? hb->resp_len : 0, hb ? hb->ret_code : 0, hb ? hb->stray : 0,
+			   hb ? hb->stray_opcode : 0);
+	}
+
+	guard(mutex)(&chip->lock);
+	seq_printf(s, "state: %s\n", mt5806_state(chip));
+	seq_printf(s, "ready: %d\n", chip->ready);
+	seq_printf(s, "fail: %s\n", chip->fail ?: "-");
+	seq_printf(s, "start_tries: %u of %d\n", chip->init_tries, MT5806_INIT_RETRIES + 1);
+	seq_printf(s, "chip_id: 0x%04x\n", chip->chip_id);
+	seq_printf(s, "fw_version: 0x%x %s\n", chip->fw_version,
+		   mt5806_fw_known(chip->fw_version) ? "known" : "unknown");
+	seq_printf(s, "boost: target_mv %u acked_mv %u err %d fault %d epoch %u\n",
+		   chip->boost_target_mv, chip->boost_acked_mv, chip->boost_err, chip->boost_fault,
+		   chip->epoch);
+	seq_printf(s, "limits: boost_idle_mv %u boost_charge_mv %u boost_max_mv %d validate_ms %d max_charge_min %d recharge_soc %d\n",
+		   chip->boost_idle_mv, chip->boost_charge_mv, MT5806_BOOST_MAX_MV,
+		   MT5806_VALIDATE_MS, MT5806_MAX_CHARGE_MIN, MT5806_RECHARGE_SOC);
+	seq_printf(s, "gpio: enable %d wake %d scan %d tx_off %d\n",
+		   gpiod_get_value_cansleep(chip->enable_gpio),
+		   gpiod_get_value_cansleep(chip->wake_gpio),
+		   gpiod_get_value_cansleep(chip->scan_gpio),
+		   gpiod_get_value_cansleep(chip->txoff_gpio));
+	seq_printf(s, "tx: allowed %d inhibit %d scan_fast %d suspended %d wakeup %d\n",
+		   chip->tx_allowed, chip->inhibit, chip->scan_fast, chip->suspended,
+		   device_may_wakeup(chip->dev));
+	seq_printf(s, "irq: count %u last_flags 0x%08x i2c_errors %u last_i2c_error %d\n",
+		   chip->irq_count, chip->last_flags, chip->i2c_errors, chip->last_i2c_err);
+	seq_printf(s, "pen: near %d present %d validating %d stop %s recharge %d id %u soc %d rx_soc %d ept %4ph\n",
+		   chip->near, chip->present, chip->validating, mt5806_stop_names[chip->stop],
+		   chip->recharge, chip->pen_id, chip->pen_soc, chip->rx_soc, chip->ept);
+	if (chip->near)
+		seq_printf(s, "pen_time_s: %lld\n",
+			   ktime_ms_delta(ktime_get_boottime(), chip->tx_start) / MSEC_PER_SEC);
+	seq_printf(s, "q: valid %d cnt %u width %u\n", chip->q_valid, chip->q_cnt, chip->q_width);
+
+	seq_puts(s, "init_regs:");
+	for (i = 0; i < ARRAY_SIZE(mt5806_snaps); i++) {
+		if (chip->snap_ok & BIT(i))
+			seq_printf(s, " %s=%u", mt5806_snaps[i].name, chip->snap[i]);
+		else
+			seq_printf(s, " %s=?", mt5806_snaps[i].name);
+	}
+	seq_putc(s, '\n');
+
+	/* the IC is awake while a transfer runs: values as stock reads them (c:515-569) */
+	if (chip->ready && chip->present && !chip->suspended) {
+		seq_puts(s, "live:");
+		if (!mt5806_read16(chip, MT5806_REG_VIN, &val))
+			seq_printf(s, " vin_mv=%u", val);
+		if (!mt5806_read16(chip, MT5806_REG_IIN, &val))
+			seq_printf(s, " iin_ma=%u", val);
+		if (!mt5806_read16(chip, MT5806_REG_VRECT, &val))
+			seq_printf(s, " vrect_mv=%u", val);
+		if (!mt5806_read16(chip, MT5806_REG_OP_FREQ, &val))
+			seq_printf(s, " op_freq=%u", val);
+		if (!mt5806_read16(chip, MT5806_REG_TEMP, &val))
+			seq_printf(s, " temp=%u", val);
+		seq_putc(s, '\n');
+	}
+
+	seq_puts(s, "events:\n");
+	first = chip->n_events > MT5806_EVENTS ? chip->n_events - MT5806_EVENTS : 0;
+	for (i = first; i < chip->n_events; i++) {
+		struct mt5806_event *e = &chip->events[i % MT5806_EVENTS];
+
+		seq_printf(s, "  [%6llu.%03llu] %s\n", e->ms / MSEC_PER_SEC, e->ms % MSEC_PER_SEC,
+			   e->text);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt5806_status);
+
+/* ---- driver ---- */
+
+/* transmitter off, IC without power, the supply back at its idle value */
+static void mt5806_quiesce(struct mt5806 *chip)
+{
+	bool at_charge;
+
+	scoped_guard(mutex, &mt5806_link_lock)
+		mt5806_charger = NULL;
+	scoped_guard(mutex, &chip->lock)
+		chip->removing = true;
+
+	disable_irq(chip->irq);
+	cancel_delayed_work_sync(&chip->init_work);
+	cancel_work_sync(&chip->boost_work);
+	cancel_delayed_work_sync(&chip->validate_work);
+	cancel_delayed_work_sync(&chip->max_time_work);
+
+	scoped_guard(mutex, &chip->lock) {
+		at_charge = chip->boost_acked_mv > chip->boost_idle_mv;
+		mt5806_stop_all(chip, "driver removed");
+	}
+	if (at_charge)
+		mt5806_hboost_set(chip->boost_idle_mv);
+}
+
+static int mt5806_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct mt5806 *chip;
+	int ret;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	chip->dev = dev;
+	chip->client = client;
+	chip->irq = client->irq;
+	chip->scan_fast = true;
+	chip->pen_soc = -1;
+	chip->rx_soc = -1;
+	chip->fail = "starting";
+	mutex_init(&chip->lock);
+	i2c_set_clientdata(client, chip);
+
+	ret = device_property_read_u32(dev, "maxic,boost-idle-microvolt", &chip->boost_idle_mv);
+	if (!ret)
+		ret = device_property_read_u32(dev, "maxic,boost-charge-microvolt",
+					       &chip->boost_charge_mv);
+	if (ret)
+		return dev_err_probe(dev, ret, "supply voltages missing\n");
+	chip->boost_idle_mv /= 1000;
+	chip->boost_charge_mv /= 1000;
+	if (chip->boost_idle_mv < MT5806_BOOST_MIN_MV ||
+	    chip->boost_idle_mv > chip->boost_charge_mv ||
+	    chip->boost_charge_mv > MT5806_BOOST_MAX_MV)
+		return dev_err_probe(dev, -EINVAL, "supply voltages %u / %u mV out of range\n",
+				     chip->boost_idle_mv, chip->boost_charge_mv);
+
+	/* transmitter off and IC without power until the start sequence has passed */
+	chip->txoff_gpio = devm_gpiod_get(dev, "tx-off", GPIOD_OUT_HIGH);
+	if (IS_ERR(chip->txoff_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->txoff_gpio), "tx-off GPIO\n");
+	chip->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(chip->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->enable_gpio), "enable GPIO\n");
+	chip->wake_gpio = devm_gpiod_get(dev, "wake", GPIOD_OUT_LOW);
+	if (IS_ERR(chip->wake_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->wake_gpio), "wake GPIO\n");
+	chip->scan_gpio = devm_gpiod_get(dev, "scan", GPIOD_OUT_LOW);
+	if (IS_ERR(chip->scan_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->scan_gpio), "scan GPIO\n");
+
+	INIT_DELAYED_WORK(&chip->init_work, mt5806_init_work);
+	INIT_WORK(&chip->boost_work, mt5806_boost_work);
+	INIT_DELAYED_WORK(&chip->validate_work, mt5806_validate_work);
+	INIT_DELAYED_WORK(&chip->max_time_work, mt5806_max_time_work);
+
+	if (chip->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "no interrupt\n");
+	/*
+	 * Stock: falling edge and a wake-up source (c:4328-4336). The trigger comes from
+	 * the device tree; with "wakeup-source" there the I2C core arms the wake-up.
+	 */
+	ret = devm_request_threaded_irq(dev, chip->irq, NULL, mt5806_irq, IRQF_ONESHOT,
+					"mt5806", chip);
+	if (ret)
+		return dev_err_probe(dev, ret, "interrupt\n");
+
+	chip->debugfs = debugfs_create_dir(dev_name(dev), mt5806_debugfs_root);
+	debugfs_create_file("status", 0400, chip->debugfs, chip, &mt5806_status_fops);
+
+	scoped_guard(mutex, &mt5806_link_lock)
+		mt5806_charger = chip;
+	mod_delayed_work(system_percpu_wq, &chip->init_work, 0);
+
+	return 0;
+}
+
+static void mt5806_remove(struct i2c_client *client)
+{
+	struct mt5806 *chip = i2c_get_clientdata(client);
+
+	mt5806_quiesce(chip);
+	debugfs_remove_recursive(chip->debugfs);
+}
+
+static void mt5806_shutdown(struct i2c_client *client)
+{
+	mt5806_quiesce(i2c_get_clientdata(client));
+}
+
+static int mt5806_suspend(struct device *dev)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+
+	disable_irq(chip->irq);
+
+	guard(mutex)(&chip->lock);
+	chip->suspended = true;
+	if (!device_may_wakeup(dev)) {
+		/*
+		 * Stock always wakes for an event of the IC. Without the wake-up nobody
+		 * would watch a transfer: transmitter off while suspended.
+		 */
+		chip->suspend_off = true;
+		mt5806_tx_update(chip);
+	}
+	if (chip->ready)
+		gpiod_set_value_cansleep(chip->scan_gpio, 0);	/* stock with the screen off */
+
+	return 0;
+}
+
+static int mt5806_resume(struct device *dev)
+{
+	struct mt5806 *chip = dev_get_drvdata(dev);
+
+	scoped_guard(mutex, &chip->lock) {
+		chip->suspended = false;
+		if (chip->ready)
+			gpiod_set_value_cansleep(chip->scan_gpio, chip->scan_fast);
+		mt5806_max_time_check(chip);			/* c:3749 */
+		if (chip->suspend_off) {
+			chip->suspend_off = false;
+			if (chip->ready && chip->near && !chip->present && !chip->inhibit &&
+			    chip->stop == MT5806_STOP_NONE)
+				mt5806_validate_start(chip);
+			mt5806_tx_update(chip);
+		}
+	}
+	enable_irq(chip->irq);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(mt5806_pm_ops, mt5806_suspend, mt5806_resume);
+
+static const struct of_device_id mt5806_of_match[] = {
+	{ .compatible = "maxic,mt5806" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, mt5806_of_match);
+
+static const struct i2c_device_id mt5806_i2c_id[] = {
+	{ "mt5806" },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, mt5806_i2c_id);
+
+static struct i2c_driver mt5806_driver = {
+	.driver = {
+		.name = "mt5806-pen-charger",
+		.of_match_table = mt5806_of_match,
+		.dev_groups = mt5806_groups,
+		.pm = pm_sleep_ptr(&mt5806_pm_ops),
+	},
+	.probe = mt5806_probe,
+	.remove = mt5806_remove,
+	.shutdown = mt5806_shutdown,
+	.id_table = mt5806_i2c_id,
+};
+
+static int __init mt5806_init(void)
+{
+	int ret;
+
+	mt5806_debugfs_root = debugfs_create_dir("mt5806-pen-charger", NULL);
+
+	ret = auxiliary_driver_register(&mt5806_hboost_driver);
+	if (ret)
+		goto err_debugfs;
+
+	ret = i2c_add_driver(&mt5806_driver);
+	if (ret)
+		goto err_aux;
+
+	return 0;
+
+err_aux:
+	auxiliary_driver_unregister(&mt5806_hboost_driver);
+err_debugfs:
+	debugfs_remove_recursive(mt5806_debugfs_root);
+	return ret;
+}
+module_init(mt5806_init);
+
+static void __exit mt5806_exit(void)
+{
+	i2c_del_driver(&mt5806_driver);
+	auxiliary_driver_unregister(&mt5806_hboost_driver);
+	debugfs_remove_recursive(mt5806_debugfs_root);
+}
+module_exit(mt5806_exit);
+
+MODULE_DESCRIPTION("Maxic MT5806 pen charger of the OnePlus Pad 4");
+MODULE_LICENSE("GPL");
