From 7e2eef48d2732a3d46d06c0ee9646adf5095b155 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 3 Oct 2026 08:53:16 +0300
Subject: [PATCH 177/185] power: supply: qcom_battmgr: OPLUS: USB supply
 present = the cable attached

With the charger input suspended by the host, the firmware may report
the charger offline although the cable is still in, and user space has
no way to tell that apart from an unplug. The vendor's driver reads the
port's CID status for its CC detect (oplus_hal_adsp.c,
oplus_chg_8350_get_hw_detect()), the same property this driver already
polls for its plug and unplug wake. Report it as the OPLUS variant's
USB supply "present": 1 while a cable is attached, whatever the input
does.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 30 +++++++++++++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index ceaecc764..db153bd11 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -1497,6 +1497,20 @@ static int qcom_battmgr_usb_get_property(struct power_supply *psy,
 	if (!battmgr->service_up)
 		return -EAGAIN;
 
+	/*
+	 * The cable's attach state from the port's CID, independent of the input (the vendor's "hw detect",
+	 * oplus_chg_8350_get_hw_detect()): a charger whose input the host suspended may read offline but present.
+	 */
+	if (psp == POWER_SUPPLY_PROP_PRESENT) {
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr, OPLUS_PROPERTY_GET, OPLUS_USB_CID_STATUS, 0);
+		if (!ret)
+			val->intval = battmgr->oplus_value == 1;
+		mutex_unlock(&battmgr->lock);
+
+		return ret;
+	}
+
 	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
 	    battmgr->variant == QCOM_BATTMGR_X1E80100)
 		ret = qcom_battmgr_bat_sc8280xp_update(battmgr, psp);
@@ -1570,6 +1584,18 @@ static const enum power_supply_property sm8350_usb_props[] = {
 	POWER_SUPPLY_PROP_USB_TYPE,
 };
 
+/* the OPLUS variant adds the cable's attach state */
+static const enum power_supply_property oplus_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_USB_TYPE,
+};
+
 static const struct power_supply_desc sm8350_usb_psy_desc = {
 	.name = "qcom-battmgr-usb",
 	.type = POWER_SUPPLY_TYPE_USB,
@@ -1615,8 +1641,8 @@ static int qcom_battmgr_usb_set_property(struct power_supply *psy,
 static const struct power_supply_desc oplus_usb_psy_desc = {
 	.name = "qcom-battmgr-usb",
 	.type = POWER_SUPPLY_TYPE_USB,
-	.properties = sm8350_usb_props,
-	.num_properties = ARRAY_SIZE(sm8350_usb_props),
+	.properties = oplus_usb_props,
+	.num_properties = ARRAY_SIZE(oplus_usb_props),
 	.get_property = qcom_battmgr_usb_get_property,
 	.set_property = qcom_battmgr_usb_set_property,
 	.property_is_writeable = qcom_battmgr_usb_is_writeable,
-- 
