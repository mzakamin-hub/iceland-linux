+/* ------------------------------------------------------------ PM, probe */
+
+static int pogo_suspend(struct device *dev)
+{
+	struct pogo *pogo = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&pogo->state_lock);
+	pogo->suspended = true;
+	mutex_unlock(&pogo->state_lock);
+
+	cancel_delayed_work_sync(&pogo->poll_work);
+	cancel_work_sync(&pogo->led_work);
+
+	mutex_lock(&pogo->state_lock);
+	switch (pogo->state) {
+	case POGO_CONNECTED:
+		pogo_release_inputs(pogo);
+		ret = pogo_send_sleep(pogo, true);
+		if (ret)
+			dev_warn(dev, "the dock did not confirm the sleep request: %d\n", ret);
+		/*
+		 * A sleeping dock holds the line low. A key press or taking
+		 * the dock off lets it rise: that is the wake-up event.
+		 */
+		msleep(POGO_SLEEP_IRQ_DELAY_MS);
+		irq_set_irq_type(pogo->irq, IRQ_TYPE_EDGE_RISING);
+		pogo_irq_enable(pogo);
+		break;
+	case POGO_ABSENT:
+		break;
+	default:
+		pogo_power_off(pogo);
+		pogo->state = POGO_ABSENT;
+		pogo_irq_enable(pogo);
+		break;
+	}
+	if (device_may_wakeup(dev))
+		enable_irq_wake(pogo->irq);
+	mutex_unlock(&pogo->state_lock);
+
+	return 0;
+}
+
+static int pogo_resume(struct device *dev)
+{
+	struct pogo *pogo = dev_get_drvdata(dev);
+
+	mutex_lock(&pogo->state_lock);
+	if (device_may_wakeup(dev))
+		disable_irq_wake(pogo->irq);
+	pogo->suspended = false;
+
+	if (pogo->state == POGO_CONNECTED) {
+		pogo_irq_disable(pogo);
+		irq_set_irq_type(pogo->irq, IRQ_TYPE_EDGE_FALLING);
+		pogo->need_wake = true;
+		pogo->uptime_ticks = 0;
+		atomic_set(&pogo->silent_ticks, 0);
+	}
+	schedule_delayed_work(&pogo->poll_work, 0);
+	mutex_unlock(&pogo->state_lock);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(pogo_pm_ops, pogo_suspend, pogo_resume);
+
+static int pogo_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct pogo *pogo;
+	unsigned int baud;
+	int ret;
+
+	pogo = devm_kzalloc(dev, sizeof(*pogo), GFP_KERNEL);
+	if (!pogo)
+		return -ENOMEM;
+
+	pogo->dev = dev;
+	pogo->serdev = serdev;
+	pogo->variant = device_get_match_data(dev);
+	if (!pogo->variant)
+		return -ENODEV;
+	pogo->baud = pogo->variant->baud;
+
+	ret = devm_mutex_init(dev, &pogo->state_lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &pogo->tx_lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &pogo->input_lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &pogo->trace_lock);
+	if (ret)
+		return ret;
+	spin_lock_init(&pogo->rx_lock);
+	init_completion(&pogo->echo_done);
+	init_completion(&pogo->reply_done);
+	INIT_DELAYED_WORK(&pogo->poll_work, pogo_poll_work);
+	INIT_WORK(&pogo->led_work, pogo_led_work);
+
+	pogo->trace = devm_kcalloc(dev, POGO_TRACE_LEN, sizeof(*pogo->trace), GFP_KERNEL);
+	if (!pogo->trace)
+		return -ENOMEM;
+
+	pogo->detect_gpio = devm_gpiod_get(dev, "detect", GPIOD_IN);
+	if (IS_ERR(pogo->detect_gpio))
+		return dev_err_probe(dev, PTR_ERR(pogo->detect_gpio), "no detect GPIO\n");
+
+	pogo->tx_en_gpio = devm_gpiod_get(dev, "tx-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(pogo->tx_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(pogo->tx_en_gpio), "no tx-enable GPIO\n");
+
+	pogo->vcc = devm_regulator_get(dev, "vcc");
+	if (IS_ERR(pogo->vcc))
+		return dev_err_probe(dev, PTR_ERR(pogo->vcc), "no vcc supply\n");
+
+	pogo->irq = gpiod_to_irq(pogo->detect_gpio);
+	if (pogo->irq < 0)
+		return dev_err_probe(dev, pogo->irq, "no interrupt for the detect GPIO\n");
+
+	serdev_device_set_drvdata(serdev, pogo);
+	serdev_device_set_client_ops(serdev, &pogo_serdev_ops);
+
+	/* the UART stays closed (clocks off) while no dock is there: only see that it works */
+	ret = serdev_device_open(serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot open the UART\n");
+	baud = serdev_device_set_baudrate(serdev, pogo->variant->baud);
+	serdev_device_close(serdev);
+	if (baud != pogo->variant->baud)
+		dev_warn(dev, "the UART gives %u baud instead of %u\n", baud, pogo->variant->baud);
+	if (baud)
+		pogo->baud = baud;
+
+	/* threaded: the handler reads the line, and the GPIO may be one that sleeps */
+	ret = devm_request_threaded_irq(dev, pogo->irq, NULL, pogo_detect_irq,
+					IRQF_TRIGGER_FALLING | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"pogo-detect", pogo);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request the detect interrupt\n");
+
+	if (device_property_read_bool(dev, "wakeup-source")) {
+		ret = devm_device_init_wakeup(dev);
+		if (ret)
+			return ret;
+	}
+
+	pogo->debugfs = debugfs_create_dir("oneplus-pogo", NULL);
+	debugfs_create_file("status", 0400, pogo->debugfs, pogo, &pogo_status_fops);
+	debugfs_create_file("trace", 0400, pogo->debugfs, pogo, &pogo_trace_fops);
+	debugfs_create_file("selftest", 0200, pogo->debugfs, pogo, &pogo_selftest_fops);
+	debugfs_create_file("send", 0600, pogo->debugfs, pogo, &pogo_send_fops);
+	ret = devm_add_action_or_reset(dev, pogo_debugfs_remove, pogo->debugfs);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "UART at %u baud, data line %s\n", baud,
+		 pogo_line_low(pogo) ? "low: a dock is there" : "high: no dock");
+
+	mutex_lock(&pogo->state_lock);
+	pogo_go_absent(pogo, true);
+	mutex_unlock(&pogo->state_lock);
+
+	return 0;
+}
+
+static void pogo_remove(struct serdev_device *serdev)
+{
+	struct pogo *pogo = serdev_device_get_drvdata(serdev);
+
+	mutex_lock(&pogo->state_lock);
+	pogo->suspended = true;		/* no more polling */
+	pogo_irq_disable(pogo);
+	mutex_unlock(&pogo->state_lock);
+
+	cancel_delayed_work_sync(&pogo->poll_work);
+
+	mutex_lock(&pogo->state_lock);
+	pogo_power_off(pogo);
+	pogo->state = POGO_ABSENT;
+	mutex_unlock(&pogo->state_lock);
+
+	cancel_work_sync(&pogo->led_work);
+}
+
