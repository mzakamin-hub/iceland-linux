+};
+
+struct pogo_variant {
+	unsigned int baud;
+	unsigned int tp_x_max;
+	unsigned int tp_y_max;
+	unsigned int tp_x_res;		/* units per mm */
+	unsigned int tp_y_res;
+	u16 id_vendor;
+	u16 id_product;
+	u16 id_version;
+	const char * const *names;	/* by the brand byte of the hello frame, 1 based */
+	unsigned int num_names;
+};
+
+#define POGO_KEYMAP_KBD		256
+#define POGO_KEYMAP_MEDIA	22
+#define POGO_KEYMAP_SIZE	(POGO_KEYMAP_KBD + POGO_KEYMAP_MEDIA)
+
