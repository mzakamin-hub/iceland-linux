+	240, 240, 240, 240, 240, 240, 240, 240, 111, 240, 240, 240, 240, 240, 240, 240,
+	 29, 42, 56, 125, 97, 54, 100, 126, 164, 166, 165, 163, 161, 115, 114, 113,
+	150, 158, 159, 128, 136, 177, 178, 176, 142, 152, 173, 140, 240, 240, 240, 240
+};
+
+/* the 16 bit codes of the "media key" frames */
+static const struct {
+	u16 code;
+	u16 key;
+} pogo_media_keys[POGO_KEYMAP_MEDIA] = {
+	{ 0x0070, KEY_BRIGHTNESSDOWN },
+	{ 0x006f, KEY_BRIGHTNESSUP },
+	{ 0x00e2, KEY_MUTE },
+	{ 0x00ea, KEY_VOLUMEDOWN },
+	{ 0x00e9, KEY_VOLUMEUP },
+	{ 0x0224, KEY_BACK },
+	{ 0x038e, KEY_SCREENLOCK },		/* vendor: lock the screen */
+	{ 0x0390, KEY_KBD_LAYOUT_NEXT },	/* vendor: switch the input language */
+	{ 0x0391, KEY_MICMUTE },		/* vendor: microphone off */
+	{ 0x0392, KEY_TOUCHPAD_TOGGLE },	/* vendor: touchpad off */
+	{ 0x0393, KEY_SEARCH },			/* vendor: global search */
+	{ 0x0394, KEY_FULL_SCREEN },		/* vendor: full screen */
+	{ 0x0395, KEY_PROG1 },			/* vendor: split screen */
+	{ 0x0397, KEY_PROG2 },			/* vendor: device interconnection */
+	{ 0x0398, KEY_PROG3 },			/* vendor: user defined 1 */
+	{ 0x0399, KEY_PROG4 },			/* vendor: user defined 2 */
+	{ 0x00cd, KEY_PLAYPAUSE },
+	{ 0x00b5, KEY_NEXTSONG },
+	{ 0x00b6, KEY_PREVIOUSSONG },
+	{ 0x0244, KEY_APPSELECT },
+	{ 0x02fa, KEY_ASSISTANT },		/* vendor: AI key */
+	{ 0x01d0, KEY_FN },
+};
+
+/* ------------------------------------------------------------------ trace */
+
+static void pogo_trace_add(struct pogo *pogo, u8 kind, const u8 *data, unsigned int len)
+{
+	struct pogo_trace *e;
+
+	mutex_lock(&pogo->trace_lock);
+	e = &pogo->trace[pogo->trace_head];
+	e->ns = local_clock();
+	e->kind = kind;
+	e->len = min_t(unsigned int, len, POGO_TRACE_DATA);
+	memcpy(e->data, data, e->len);
+	pogo->trace_head = (pogo->trace_head + 1) % POGO_TRACE_LEN;
+	if (pogo->trace_count < POGO_TRACE_LEN)
+		pogo->trace_count++;
+	mutex_unlock(&pogo->trace_lock);
+}
+
+/* ------------------------------------------------------------ input side */
+
+static void pogo_key(struct pogo *pogo, unsigned int scancode, int value)
+{
+	unsigned int code = pogo->keymap[scancode];
+
+	if (!code)
+		return;
+	if (code == KEY_UNKNOWN)
+		pogo->stats.unknown_keys++;
+	input_event(pogo->kbd, EV_MSC, MSC_SCAN, scancode);
+	input_report_key(pogo->kbd, code, value);
+}
+
+/* @rep: a HID boot keyboard report: modifiers, reserved, six usages */
+static void pogo_report_keys(struct pogo *pogo, const u8 *rep)
+{
+	unsigned int i;
+
+	if (!pogo->kbd)
+		return;
+
+	/* 0x01 in the slots: too many keys are down, the report says nothing */
+	if (rep[2] == 0x01) {
+		pogo->stats.rollover++;
+		return;
+	}
+
+	for (i = 0; i < 8; i++) {
+		if ((rep[0] ^ pogo->old_keys[0]) & BIT(i))
+			pogo_key(pogo, 224 + i, (rep[0] >> i) & 1);
+	}
+
+	for (i = 2; i < 8; i++) {
+		if (pogo->old_keys[i] > 3 && !memchr(rep + 2, pogo->old_keys[i], 6))
+			pogo_key(pogo, pogo->old_keys[i], 0);
+		if (rep[i] > 3 && !memchr(pogo->old_keys + 2, rep[i], 6))
+			pogo_key(pogo, rep[i], 1);
+	}
+
+	input_sync(pogo->kbd);
+	memcpy(pogo->old_keys, rep, 8);
+}
+
+static void pogo_media_key(struct pogo *pogo, u16 code, int value)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pogo_media_keys); i++) {
+		if (pogo_media_keys[i].code == code) {
+			pogo_key(pogo, POGO_KEYMAP_KBD + i, value);
+			return;
+		}
+	}
+
+	pogo->stats.unknown_keys++;
+	dev_dbg(pogo->dev, "unknown media key code %#06x %s\n", code, value ? "down" : "up");
+}
+
+/* @data: up to two 16 bit codes, little endian, 0 = no key */
+static void pogo_report_media(struct pogo *pogo, const u8 *data, unsigned int n)
+{
+	u16 now[2] = { 0, 0 };
+	unsigned int i;
+	u16 old;
+
+	if (!pogo->kbd)
+		return;
+
+	if (n >= 2)
+		now[0] = get_unaligned_le16(data);
+	if (n >= 4)
+		now[1] = get_unaligned_le16(data + 2);
+
+	for (i = 0; i < 2; i++) {
+		old = pogo->old_media[i];
+		if (old && old != now[0] && old != now[1])
+			pogo_media_key(pogo, old, 0);
+	}
+	for (i = 0; i < 2; i++) {
+		if (now[i] && now[i] != pogo->old_media[0] && now[i] != pogo->old_media[1])
+			pogo_media_key(pogo, now[i], 1);
+	}
+
+	input_sync(pogo->kbd);
+	pogo->old_media[0] = now[0];
+	pogo->old_media[1] = now[1];
+}
+
+static void pogo_touch_release_all(struct pogo *pogo)
+{
+	unsigned int i;
+
+	if (!pogo->tp || (!pogo->touch_active && !pogo->button_down))
+		return;
+
+	for (i = 0; i < POGO_MAX_CONTACTS; i++) {
+		input_mt_slot(pogo->tp, i);
+		input_mt_report_slot_inactive(pogo->tp);
+	}
+	input_report_key(pogo->tp, BTN_LEFT, 0);
+	input_mt_sync_frame(pogo->tp);
+	input_sync(pogo->tp);
+	pogo->touch_active = 0;
+	pogo->button_down = false;
+}
+
+static void pogo_report_touch(struct pogo *pogo, const u8 *data, unsigned int n)
+{
+	const struct pogo_variant *v = pogo->variant;
+	const struct pogo_contact *c;
+	struct pogo_touch t;
+	unsigned int i;
+
+	if (!pogo->tp)
+		return;
+
+	if (pogo_parse_touch(data, n, &t)) {
+		pogo->stats.touch_bad++;
+		return;
+	}
+
+	for (i = 0; i < t.count; i++) {
+		c = &t.contact[i];
+		if (c->id >= POGO_MAX_CONTACTS)
+			continue;
+
+		input_mt_slot(pogo->tp, c->id);
+		if (c->tip) {
+			input_mt_report_slot_state(pogo->tp,
+						   c->confidence ? MT_TOOL_FINGER : MT_TOOL_PALM,
+						   true);
+			input_report_abs(pogo->tp, ABS_MT_POSITION_X,
+					 min_t(unsigned int, c->x, v->tp_x_max));
+			input_report_abs(pogo->tp, ABS_MT_POSITION_Y,
+					 min_t(unsigned int, c->y, v->tp_y_max));
+			__set_bit(c->id, &pogo->touch_active);
+		} else {
+			input_mt_report_slot_inactive(pogo->tp);
+			__clear_bit(c->id, &pogo->touch_active);
+		}
+	}
+
+	/*
+	 * The pad has no button of its own: the dock decides from the force
+	 * on the pad what is a click and says "left" or "right". For a
+	 * button pad both are a press; user space picks the button from the
+	 * fingers' position and number.
+	 */
+	pogo->button_down = t.left || t.right;
+	input_report_key(pogo->tp, BTN_LEFT, pogo->button_down);
+	input_mt_sync_frame(pogo->tp);
+	input_sync(pogo->tp);
+}
+
+static void pogo_release_inputs(struct pogo *pogo)
+{
+	static const u8 no_keys[8];
+
+	mutex_lock(&pogo->input_lock);
+	if (pogo->kbd) {
+		pogo_report_keys(pogo, no_keys);
+		pogo_report_media(pogo, no_keys, 4);
+	}
+	pogo_touch_release_all(pogo);
+	mutex_unlock(&pogo->input_lock);
+}
+
+static int pogo_kbd_event(struct input_dev *input, unsigned int type, unsigned int code, int value)
+{
+	struct pogo *pogo = input_get_drvdata(input);
+
+	if (type != EV_LED)
+		return -1;
+
+	schedule_work(&pogo->led_work);
+
+	return 0;
+}
+
+/* ------------------------------------------------------------- transmit */
+
+static int pogo_xfer_once(struct pogo *pogo, u8 cmd, const u8 *data, unsigned int n,
+			  bool need_echo, bool want_reply)
+{
+	u8 frame[POGO_FRAME_MAX];
+	unsigned long wire_us;
+	int len, ret;
+
+	lockdep_assert_held(&pogo->tx_lock);
+
+	if (!pogo->port_open)
+		return -ENODEV;
+
+	len = pogo_build_frame(frame, cmd, data, n);
+	if (len < 0)
+		return -EINVAL;
+
+	spin_lock_irq(&pogo->rx_lock);
+	pogo->tx_cmd = cmd;
+	pogo->tx_crc = frame[len - 7] << 8 | frame[len - 6];
+	pogo->tx_pending = true;
+	pogo->want_reply = want_reply;
+	pogo->reply_len = 0;
+	reinit_completion(&pogo->echo_done);
+	reinit_completion(&pogo->reply_done);
+	spin_unlock_irq(&pogo->rx_lock);
+
+	pogo_trace_add(pogo, POGO_TRACE_TX, &frame[POGO_HEAD_SYNC_LEN],
+		       len - POGO_HEAD_SYNC_LEN - POGO_TAIL_SYNC_LEN);
+
+	/* ten bit times per byte */
+	wire_us = DIV_ROUND_UP(len * 10 * 1000000UL, pogo->baud);
+
+	gpiod_set_value_cansleep(pogo->tx_en_gpio, 1);
+	usleep_range(tx_setup_us, tx_setup_us + 50);
+	ret = serdev_device_write_buf(pogo->serdev, frame, len);
+	if (ret == len)
+		usleep_range(wire_us + tx_start_us + tx_hold_us,
+			     wire_us + tx_start_us + tx_hold_us + 100);
+	gpiod_set_value_cansleep(pogo->tx_en_gpio, 0);
+
+	pogo->stats.tx_frames++;
+	if (ret != len) {
+		serdev_device_write_flush(pogo->serdev);
+		pogo->stats.tx_errors++;
+		ret = ret < 0 ? ret : -EIO;
+		goto out;
+	}
+
+	ret = 0;
+	if (!wait_for_completion_timeout(&pogo->echo_done,
+					 msecs_to_jiffies(POGO_ECHO_TIMEOUT_MS))) {
+		pogo->stats.echo_missing++;
+		if (need_echo) {
+			ret = -ECOMM;
+			goto out;
+		}
+	}
+
+	if (want_reply && !wait_for_completion_timeout(&pogo->reply_done,
+						       msecs_to_jiffies(POGO_REPLY_TIMEOUT_MS))) {
+		pogo->stats.reply_timeouts++;
+		ret = -ETIMEDOUT;
+	}
+
+out:
+	spin_lock_irq(&pogo->rx_lock);
+	pogo->tx_pending = false;
+	pogo->want_reply = false;
+	spin_unlock_irq(&pogo->rx_lock);
+
+	return ret;
+}
+
+/*
+ * Send a command, up to three times. With @reply the dock's answer (its
+ * command byte, length byte and data) is copied there; @reply_len takes
+ * its size.
+ */
+static int pogo_xfer(struct pogo *pogo, u8 cmd, const u8 *data, unsigned int n,
+		     u8 *reply, unsigned int *reply_len)
+{
+	int ret = -ENODEV, try;
+
+	mutex_lock(&pogo->tx_lock);
+	for (try = 0; try < POGO_XFER_TRIES; try++) {
+		ret = pogo_xfer_once(pogo, cmd, data, n, echo_check, reply != NULL);
+		if (!ret || ret == -ENODEV || ret == -EINVAL)
+			break;
+		msleep(POGO_RETRY_DELAY_MS);
+	}
+	if (!ret && reply) {
+		spin_lock_irq(&pogo->rx_lock);
+		memcpy(reply, pogo->reply, pogo->reply_len);
+		*reply_len = pogo->reply_len;
+		spin_unlock_irq(&pogo->rx_lock);
+	}
+	mutex_unlock(&pogo->tx_lock);
+
+	return ret;
+}
+
+static int pogo_send_leds(struct pogo *pogo, bool caps, bool mute)
+{
+	/* capital lock, unused, mute, microphone mute */
+	u8 data[] = { POGO_PARAM_LEDS, 0x04, caps, 0x00, mute, 0x00 };
+
+	return pogo_xfer(pogo, POGO_CMD_PARAM_SET, data, sizeof(data), NULL, NULL);
+}
+
+static int pogo_send_backlight(struct pogo *pogo)
+{
+	u8 data[] = { POGO_GEN_BRIGHTNESS, 0x01, pogo->backlight_level };
+	u8 reply[POGO_FRAME_MAX];
+	unsigned int len;
+	int ret;
+
+	ret = pogo_xfer(pogo, POGO_CMD_GENERAL, data, sizeof(data), reply, &len);
+	if (ret)
+		return ret;
+	if (len < 5 || reply[2] != POGO_GEN_BRIGHTNESS || reply[4] != data[2])
+		return -EPROTO;
+
+	return 0;
+}
+
+/* Tell the dock that the host goes to sleep (or is back). */
+static int pogo_send_sleep(struct pogo *pogo, bool sleep)
+{
+	u8 data[] = { POGO_GEN_SLEEP, 0x01, sleep };
+	u8 reply[POGO_FRAME_MAX];
+	unsigned int len;
+	int ret;
+
+	ret = pogo_xfer(pogo, POGO_CMD_GENERAL, data, sizeof(data), reply, &len);
+	if (ret)
+		return ret;
+	/* answer: sub-command, 2, state, 1 = done */
+	if (len < 6 || reply[2] != POGO_GEN_SLEEP || reply[4] != data[2] || reply[5] != 0x01)
+		return -EPROTO;
+
+	return 0;
+}
+
+static void pogo_read_version(struct pogo *pogo)
+{
+	static const u8 data[] = { POGO_PASS_VERSION, 0x01, 0x01 };
+	u8 reply[POGO_FRAME_MAX];
+	unsigned int len, n, i;
+	int ret;
+
+	ret = pogo_xfer(pogo, POGO_CMD_PASSTHROUGH, data, sizeof(data), reply, &len);
+	if (ret) {
+		dev_warn(pogo->dev, "no answer to the version question: %d\n", ret);
+		return;
+	}
+
+	/* answer: sub-command, length of the text + 1, text */
+	if (len < 5 || reply[2] != POGO_PASS_VERSION || reply[3] < 2)
+		return;
+	n = min3((unsigned int)reply[3] - 1, len - 4, (unsigned int)POGO_VERSION_MAX);
+	for (i = 0; i < n; i++)
+		pogo->version[i] = (reply[4 + i] >= 0x20 && reply[4 + i] < 0x7f) ? reply[4 + i] : '?';
+	pogo->version[n] = 0;
+}
+
+static void pogo_led_work(struct work_struct *work)
+{
+	struct pogo *pogo = container_of(work, struct pogo, led_work);
+	bool caps, mute;
+
+	mutex_lock(&pogo->input_lock);
+	if (!pogo->kbd) {
+		mutex_unlock(&pogo->input_lock);
+		return;
+	}
+	caps = test_bit(LED_CAPSL, pogo->kbd->led);
+	mute = test_bit(LED_MUTE, pogo->kbd->led);
+	mutex_unlock(&pogo->input_lock);
+
+	pogo_send_leds(pogo, caps, mute);
+
+	if (atomic_xchg(&pogo->resend_backlight, 0) && pogo->backlight_set)
+		pogo_send_backlight(pogo);
+}
+
+static int pogo_backlight_set(struct led_classdev *cdev, enum led_brightness value)
+{
+	struct pogo *pogo = container_of(cdev, struct pogo, backlight);
+
+	pogo->backlight_level = value;
+	pogo->backlight_set = true;
+
+	return pogo_send_backlight(pogo);
+}
+
+/* -------------------------------------------------------------- receive */
+
+static void pogo_handle_sync(struct pogo *pogo, const u8 *data, unsigned int n)
+{
+	bool hello = n >= 3 && data[0] == POGO_SYNC_HELLO && data[1] == 0x02;
+	bool beat = n >= 4 && data[0] == POGO_SYNC_HEARTBEAT && data[1] == 0x02;
+	bool resend = false;
+
+	spin_lock_irq(&pogo->rx_lock);
+	if (hello) {
+		pogo->stats.sync_hello++;
+		pogo->brand = data[2];
+		if (n > 9)
+			pogo->tp_disabled = data[9];
+	} else if (beat) {
+		pogo->stats.sync_heartbeat++;
+		pogo->dock_leds = data[2];
+		pogo->brand = data[3];
+		if (n > 10)
+			pogo->tp_disabled = data[10];
+	} else {
+		pogo->stats.sync_other++;
+	}
+	pogo->hello_seen = true;
+	spin_unlock_irq(&pogo->rx_lock);
+
+	if (READ_ONCE(pogo->state) == POGO_POWERED) {
+		/* the first frame after power-on: register the input devices */
+		mod_delayed_work(system_percpu_wq, &pogo->poll_work, 0);
+		return;
+	}
+
+	mutex_lock(&pogo->input_lock);
+	if (pogo->kbd) {
+		if (hello) {
+			/* the dock started again without the host noticing: tell it everything again */
+			if (time_after(jiffies, pogo->hello_jiffies + HZ)) {
+				pogo->hello_jiffies = jiffies;
+				atomic_set(&pogo->resend_backlight, 1);
+				resend = true;
+			}
+		} else if (beat) {
+			/* a heartbeat only comes from an idle dock: nothing touches the pad */
+			if (pogo->touch_active || pogo->button_down) {
+				pogo->stats.touch_hb_release++;
+				pogo_touch_release_all(pogo);
+			}
+			/* the dock shows another capital lock state than the host has: say it again, once a second */
+			if ((data[2] & 0x01) != test_bit(LED_CAPSL, pogo->kbd->led) &&
+			    time_after(jiffies, pogo->led_jiffies + HZ)) {
+				pogo->led_jiffies = jiffies;
+				resend = true;
+			}
+		}
+	}
+	mutex_unlock(&pogo->input_lock);
+
+	if (resend)
+		schedule_work(&pogo->led_work);
+}
+
+/* @f: a checked frame; f[1] source, f[3] command, f[4] length, f[5] data */
+static void pogo_handle_frame(struct pogo *pogo, const u8 *f, unsigned int len)
+{
+	unsigned int n = min_t(unsigned int, f[4], len - 10);
+	u16 crc = f[len - 5] << 8 | f[len - 4];
+	const u8 *data = &f[5];
+	bool is_reply = false;
+	u8 cmd = f[3];
+
+	if (f[1] == POGO_ADDR_HOST) {
+		/* the host's own frame, heard on the shared line */
+		spin_lock_irq(&pogo->rx_lock);
+		if (pogo->tx_pending && cmd == pogo->tx_cmd && crc == pogo->tx_crc) {
+			pogo->stats.echo_ok++;
+			complete(&pogo->echo_done);
+		} else {
+			pogo->stats.echo_foreign++;
+		}
+		spin_unlock_irq(&pogo->rx_lock);
+		pogo_trace_add(pogo, POGO_TRACE_ECHO, f, len - 2);
+		return;
+	}
+
+	atomic_set(&pogo->silent_ticks, 0);
+	pogo->stats.rx_frames++;
+
+	/* idle heartbeats would push everything else out of the trace */
+	if (cmd != POGO_CMD_SYNC || len - 2 != pogo->last_sync_len ||
+	    memcmp(pogo->last_sync, f, len - 2)) {
+		pogo_trace_add(pogo, POGO_TRACE_RX, f, len - 2);
+		if (cmd == POGO_CMD_SYNC && len - 2 <= sizeof(pogo->last_sync)) {
+			memcpy(pogo->last_sync, f, len - 2);
+			pogo->last_sync_len = len - 2;
+		}
+	}
+
+	spin_lock_irq(&pogo->rx_lock);
+	if (pogo->want_reply && cmd == pogo->tx_cmd + 1) {
+		memcpy(pogo->reply, &f[3], n + 2);
+		pogo->reply_len = n + 2;
+		pogo->want_reply = false;
+		complete(&pogo->reply_done);
+		is_reply = true;
+	}
+	spin_unlock_irq(&pogo->rx_lock);
+
+	switch (cmd) {
+	case POGO_CMD_KEYS:
+		if (n < 8)
+			break;
+		pogo->stats.key_reports++;
+		mutex_lock(&pogo->input_lock);
+		pogo_report_keys(pogo, data);
+		mutex_unlock(&pogo->input_lock);
+		break;
+	case POGO_CMD_MEDIA_KEYS:
+		pogo->stats.media_reports++;
+		mutex_lock(&pogo->input_lock);
+		pogo_report_media(pogo, data, n);
+		mutex_unlock(&pogo->input_lock);
+		break;
+	case POGO_CMD_TOUCHPAD:
+		pogo->stats.touch_reports++;
+		mutex_lock(&pogo->input_lock);
+		pogo_report_touch(pogo, data, n);
+		mutex_unlock(&pogo->input_lock);
+		break;
+	case POGO_CMD_SYNC:
+		pogo_handle_sync(pogo, data, n);
+		break;
+	case POGO_CMD_GENERAL + 1:
+		spin_lock_irq(&pogo->rx_lock);
+		if (n >= 4 && data[0] == POGO_GEN_BATTERY) {
+			pogo->battery_level = data[2];
+			pogo->battery_state = data[3];
+			pogo->battery_seen = true;
+		} else if (n >= 3 && data[0] == POGO_GEN_TP_STATUS) {
+			pogo->tp_disabled = data[2];
+		}
+		spin_unlock_irq(&pogo->rx_lock);
+		break;
+	default:
+		if (!is_reply)
+			pogo->stats.rx_unknown++;
+		break;
+	}
+}
+
+static size_t pogo_receive_buf(struct serdev_device *serdev, const u8 *buf, size_t count)
+{
+	struct pogo *pogo = serdev_device_get_drvdata(serdev);
+	size_t i;
+
+	pogo->stats.rx_bytes += count;
+
+	if (pogo->raw_on) {
+		spin_lock_irq(&pogo->rx_lock);
+		for (i = 0; i < count && pogo->raw_len < POGO_RAW_LEN; i++)
+			pogo->raw[pogo->raw_len++] = buf[i];
+		spin_unlock_irq(&pogo->rx_lock);
+	}
+
+	for (i = 0; i < count; i++) {
+		switch (pogo_rx_byte(&pogo->rx, buf[i])) {
+		case POGO_RX_FRAME:
+			if (pogo_frame_check(pogo->rx.buf, pogo->rx.len) == POGO_FRAME_OK) {
+				pogo_handle_frame(pogo, pogo->rx.buf, pogo->rx.len);
+			} else {
+				pogo->stats.rx_bad++;
+				pogo_trace_add(pogo, POGO_TRACE_BAD, pogo->rx.buf, pogo->rx.len);
+			}
+			pogo->rx.len = 0;
+			break;
+		case POGO_RX_NOISE:
+			pogo->stats.rx_noise++;
+			break;
+		default:
+			break;
+		}
+	}
+
+	return count;
+}
+
+static const struct serdev_device_ops pogo_serdev_ops = {
+	.receive_buf = pogo_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+/* --------------------------------------------------------- input devices */
+
+static const char *pogo_brand_name(struct pogo *pogo)
+{
+	const struct pogo_variant *v = pogo->variant;
+	u8 brand;
+
+	spin_lock_irq(&pogo->rx_lock);
+	brand = pogo->brand;
+	spin_unlock_irq(&pogo->rx_lock);
+
+	if (brand >= 1 && brand <= v->num_names)
+		return v->names[brand - 1];
+
+	return "OnePlus pogo keyboard";
+}
+
+static int pogo_register_inputs(struct pogo *pogo)
+{
+	const struct pogo_variant *v = pogo->variant;
+	struct input_dev *kbd, *tp;
+	unsigned int i;
+	int ret;
+
+	strscpy(pogo->name, pogo_brand_name(pogo), sizeof(pogo->name));
+	snprintf(pogo->tp_name, sizeof(pogo->tp_name), "%s Touchpad", pogo->name);
+
+	kbd = input_allocate_device();
+	tp = input_allocate_device();
+	if (!kbd || !tp) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	for (i = 0; i < POGO_KEYMAP_KBD; i++)
+		pogo->keymap[i] = pogo_usage_keycode[i];
+	for (i = 0; i < POGO_KEYMAP_MEDIA; i++)
+		pogo->keymap[POGO_KEYMAP_KBD + i] = pogo_media_keys[i].key;
+
+	kbd->name = pogo->name;
+	kbd->phys = "pogo/input0";
+	kbd->id.bustype = BUS_HOST;
+	kbd->id.vendor = v->id_vendor;
+	kbd->id.product = v->id_product;
+	kbd->id.version = v->id_version;
+	kbd->dev.parent = pogo->dev;
+	kbd->keycode = pogo->keymap;
+	kbd->keycodesize = sizeof(pogo->keymap[0]);
+	kbd->keycodemax = POGO_KEYMAP_SIZE;
+	kbd->event = pogo_kbd_event;
+	input_set_drvdata(kbd, pogo);
+	__set_bit(EV_REP, kbd->evbit);
+	input_set_capability(kbd, EV_MSC, MSC_SCAN);
+	input_set_capability(kbd, EV_LED, LED_CAPSL);
+	input_set_capability(kbd, EV_LED, LED_MUTE);
+	for (i = 0; i < POGO_KEYMAP_SIZE; i++) {
+		if (pogo->keymap[i])
+			input_set_capability(kbd, EV_KEY, pogo->keymap[i]);
+	}
+
+	tp->name = pogo->tp_name;
+	tp->phys = "pogo/input1";
+	tp->id = kbd->id;
+	tp->dev.parent = pogo->dev;
+	input_set_drvdata(tp, pogo);
+	input_set_capability(tp, EV_KEY, BTN_LEFT);
+	__set_bit(INPUT_PROP_BUTTONPAD, tp->propbit);
+	input_set_abs_params(tp, ABS_MT_POSITION_X, 0, v->tp_x_max, 0, 0);
+	input_set_abs_params(tp, ABS_MT_POSITION_Y, 0, v->tp_y_max, 0, 0);
+	input_abs_set_res(tp, ABS_MT_POSITION_X, v->tp_x_res);
+	input_abs_set_res(tp, ABS_MT_POSITION_Y, v->tp_y_res);
+	input_set_abs_params(tp, ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0);
+	ret = input_mt_init_slots(tp, POGO_MAX_CONTACTS, INPUT_MT_POINTER);
+	if (ret)
+		goto err_free;
+
+	memset(pogo->old_keys, 0, sizeof(pogo->old_keys));
+	memset(pogo->old_media, 0, sizeof(pogo->old_media));
+	pogo->touch_active = 0;
+	pogo->button_down = false;
+
+	ret = input_register_device(kbd);
+	if (ret)
+		goto err_free;
+
+	ret = input_register_device(tp);
+	if (ret) {
+		input_unregister_device(kbd);
+		input_free_device(tp);
+		return ret;
+	}
+
+	mutex_lock(&pogo->input_lock);
+	pogo->kbd = kbd;
+	pogo->tp = tp;
+	pogo->hello_jiffies = jiffies;
+	pogo->led_jiffies = jiffies;
+	mutex_unlock(&pogo->input_lock);
+
+	return 0;
+
+err_free:
+	input_free_device(kbd);
+	input_free_device(tp);
+	return ret;
+}
+
+static void pogo_unregister_inputs(struct pogo *pogo)
+{
+	struct input_dev *kbd, *tp;
+
+	mutex_lock(&pogo->input_lock);
+	kbd = pogo->kbd;
+	tp = pogo->tp;
+	pogo->kbd = NULL;
+	pogo->tp = NULL;
+	mutex_unlock(&pogo->input_lock);
+
+	if (tp)
+		input_unregister_device(tp);
+	if (kbd)
+		input_unregister_device(kbd);
+}
+
+/* -------------------------------------------------- attach state machine */
+
+static bool pogo_line_low(struct pogo *pogo)
+{
+	/* the detect GPIO is active low: 1 = the line is held low = a dock is there */
+	return gpiod_get_value_cansleep(pogo->detect_gpio) > 0;
+}
+
+static void pogo_irq_enable(struct pogo *pogo)
+{
+	if (!pogo->irq_on) {
+		enable_irq(pogo->irq);
+		pogo->irq_on = true;
+	}
+}
+
+static void pogo_irq_disable(struct pogo *pogo)
+{
+	if (pogo->irq_on) {
+		disable_irq(pogo->irq);
+		pogo->irq_on = false;
+	}
+}
+
+static int pogo_port_open(struct pogo *pogo)
+{
+	int ret;
+
+	ret = serdev_device_open(pogo->serdev);
+	if (ret)
+		return ret;
+
+	pogo->baud = serdev_device_set_baudrate(pogo->serdev, pogo->variant->baud);
+	serdev_device_set_flow_control(pogo->serdev, false);
+	serdev_device_set_parity(pogo->serdev, SERDEV_PARITY_NONE);
+	if (!pogo->baud)
+		pogo->baud = pogo->variant->baud;
+
+	memset(&pogo->rx, 0, sizeof(pogo->rx));
+	pogo->last_sync_len = 0;
+
+	mutex_lock(&pogo->tx_lock);
+	pogo->port_open = true;
+	mutex_unlock(&pogo->tx_lock);
+
+	return 0;
+}
+
+static void pogo_port_close(struct pogo *pogo)
+{
+	mutex_lock(&pogo->tx_lock);
+	if (!pogo->port_open) {
+		mutex_unlock(&pogo->tx_lock);
+		return;
+	}
+	pogo->port_open = false;
+	gpiod_set_value_cansleep(pogo->tx_en_gpio, 0);
+	mutex_unlock(&pogo->tx_lock);
+
+	serdev_device_close(pogo->serdev);
+}
+
+static void pogo_go_absent(struct pogo *pogo, bool recheck)
+{
+	pogo->state = POGO_ABSENT;
+	pogo_irq_enable(pogo);
+	/* an edge between the last sample and the enable would be lost */
+	if (recheck && pogo_line_low(pogo))
+		mod_delayed_work(system_percpu_wq, &pogo->poll_work, 0);
+}
+
+static int pogo_power_on(struct pogo *pogo)
+{
+	int ret;
+
+	ret = pogo_port_open(pogo);
+	if (ret) {
+		dev_err(pogo->dev, "cannot open the UART: %d\n", ret);
+		return ret;
+	}
+
+	spin_lock_irq(&pogo->rx_lock);
+	pogo->hello_seen = false;
+	spin_unlock_irq(&pogo->rx_lock);
+
+	msleep(POGO_POWER_ON_SETTLE_MS);
+
+	ret = regulator_enable(pogo->vcc);
+	if (ret) {
+		dev_err(pogo->dev, "cannot switch the dock's supply on: %d\n", ret);
+		pogo_port_close(pogo);
+		return ret;
+	}
+
+	pogo->vcc_on = true;
+	pogo->uptime_ticks = 0;
+	atomic_set(&pogo->silent_ticks, 0);
+	pogo->state = POGO_POWERED;
+	pogo->stats.power_on++;
+	dev_dbg(pogo->dev, "line low: supply on, waiting for the dock\n");
+
+	return 0;
+}
+
+/* Supply off; the next state is left to the caller. */
+static void pogo_power_off(struct pogo *pogo)
+{
+	if (pogo->backlight_registered) {
+		led_classdev_unregister(&pogo->backlight);
+		pogo->backlight_registered = false;
+	}
+	if (pogo->kbd) {
+		pogo_unregister_inputs(pogo);
+		dev_info(pogo->dev, "keyboard detached\n");
+	}
+	if (pogo->vcc_on) {
+		regulator_disable(pogo->vcc);
+		pogo->vcc_on = false;
+	}
+	pogo_port_close(pogo);
+}
+
+static void pogo_connect(struct pogo *pogo)
+{
+	int ret;
+
+	ret = pogo_register_inputs(pogo);
+	if (ret) {
+		dev_err_ratelimited(pogo->dev, "cannot register the input devices: %d\n", ret);
+		return;
+	}
+
+	pogo->state = POGO_CONNECTED;
+	pogo->power_cycles = 0;
+	pogo->uptime_ticks = 0;
+	pogo->stats.connects++;
+
+	pogo->version[0] = 0;
+	pogo_read_version(pogo);
+	dev_info(pogo->dev, "keyboard attached: %s, firmware %s\n", pogo->name,
+		 pogo->version[0] ? pogo->version : "unknown");
+
+	memset(&pogo->backlight, 0, sizeof(pogo->backlight));
+	pogo->backlight.name = "oneplus_pogo::kbd_backlight";
+	pogo->backlight.max_brightness = POGO_BRIGHTNESS_MAX;
+	pogo->backlight.brightness = pogo->backlight_level;
+	pogo->backlight.brightness_set_blocking = pogo_backlight_set;
+	pogo->backlight.flags = LED_RETAIN_AT_SHUTDOWN;
+	if (!led_classdev_register(pogo->dev, &pogo->backlight))
+		pogo->backlight_registered = true;
+
+	/* what the user had set before the dock was taken off */
+	if (pogo->backlight_set)
+		pogo_send_backlight(pogo);
+	schedule_work(&pogo->led_work);
+}
+
+static void pogo_poll_work(struct work_struct *work)
+{
+	struct pogo *pogo = container_of(to_delayed_work(work), struct pogo, poll_work);
+	unsigned int next = 0;
+	bool low, hello;
+
+	mutex_lock(&pogo->state_lock);
+	if (pogo->suspended)
+		goto out;
+
+	low = pogo_line_low(pogo);
+
+	switch (pogo->state) {
+	case POGO_ABSENT:
+		if (!low)
+			break;
+		pogo_irq_disable(pogo);
+		pogo->state = POGO_DEBOUNCE;
+		pogo->present_cnt = 1;
+		pogo->absent_cnt = 0;
+		next = POGO_DEBOUNCE_MS;
+		break;
+
+	case POGO_DEBOUNCE:
+		if (low) {
+			pogo->present_cnt++;
+			pogo->absent_cnt = 0;
+		} else {
+			pogo->absent_cnt++;
+			pogo->present_cnt = 0;
+		}
+		if (pogo->absent_cnt >= POGO_DEBOUNCE_ABSENT) {
+			pogo_go_absent(pogo, true);
+			break;
+		}
+		if (pogo->present_cnt < POGO_DEBOUNCE_PRESENT) {
+			next = POGO_DEBOUNCE_MS;
+			break;
+		}
+		if (pogo->power_cycles >= POGO_POWER_CYCLES_MAX) {
+			/* something holds the line low, but it is not a dock that talks */
+			dev_warn(pogo->dev, "line low but no dock answered %u times: supply stays off\n",
+				 pogo->power_cycles);
+			pogo->power_cycles = 0;
+			pogo_go_absent(pogo, false);
+			break;
+		}
+		if (pogo_power_on(pogo)) {
+			pogo_go_absent(pogo, false);
+			break;
+		}
+		next = POGO_HEARTBEAT_MS;
+		break;
+
+	case POGO_POWERED:
+	case POGO_CONNECTED:
+		if (pogo->state == POGO_POWERED) {
+			spin_lock_irq(&pogo->rx_lock);
+			hello = pogo->hello_seen;
+			spin_unlock_irq(&pogo->rx_lock);
+			if (hello)
+				pogo_connect(pogo);
+		} else if (pogo->need_wake) {
+			/* back from system sleep: a dock that left meanwhile shows as silence below */
+			pogo->need_wake = false;
+			pogo_send_sleep(pogo, false);
+			schedule_work(&pogo->led_work);
+		}
+		if (atomic_read(&pogo->silent_ticks) >= POGO_SILENT_MAX &&
+		    pogo->uptime_ticks >= POGO_GRACE_TICKS) {
+			pogo_power_off(pogo);
+			if (pogo->power_cycles < POGO_POWER_CYCLES_MAX) {
+				pogo->power_cycles++;
+				pogo->state = POGO_OFF_CHECK;
+				pogo->present_cnt = 0;
+				pogo->absent_cnt = 0;
+				next = POGO_OFF_CHECK_MS;
+			} else {
+				dev_warn(pogo->dev, "no dock answered in %u tries: waiting for the line to change\n",
+					 pogo->power_cycles);
+				pogo_go_absent(pogo, false);
+			}
+			break;
+		}
+		atomic_inc(&pogo->silent_ticks);
+		if (pogo->uptime_ticks < POGO_GRACE_TICKS)
+			pogo->uptime_ticks++;
+		next = POGO_HEARTBEAT_MS;
+		break;
+
+	case POGO_OFF_CHECK:
+		if (low) {
+			pogo->present_cnt++;
+			pogo->absent_cnt = 0;
+		} else {
+			pogo->absent_cnt++;
+			pogo->present_cnt = 0;
+		}
+		if (pogo->absent_cnt >= POGO_OFF_ABSENT) {
+			pogo_go_absent(pogo, true);
+			break;
+		}
+		if (pogo->present_cnt >= POGO_OFF_PRESENT) {
+			if (pogo_power_on(pogo)) {
+				pogo_go_absent(pogo, false);
+				break;
+			}
+			next = POGO_HEARTBEAT_MS;
+			break;
+		}
+		next = POGO_OFF_CHECK_MS;
+		break;
+	}
+
+	if (next)
+		schedule_delayed_work(&pogo->poll_work, msecs_to_jiffies(next));
+out:
+	mutex_unlock(&pogo->state_lock);
+}
+
+/*
+ * An edge on the data line. While the line carries frames the interrupt is
+ * disabled, but those edges are latched and replayed when it is enabled
+ * again; so the line's level decides, not the edge. With no dock known only
+ * a low line means something (attached); with a sleeping dock only a high
+ * one (a key press, or the dock taken off).
+ */
+static irqreturn_t pogo_detect_irq(int irq, void *data)
+{
+	struct pogo *pogo = data;
+	bool want_low = READ_ONCE(pogo->state) != POGO_CONNECTED;
+
+	pogo->stats.irqs++;
+	if (pogo_line_low(pogo) != want_low) {
+		pogo->stats.irqs_stale++;
+		return IRQ_HANDLED;
+	}
+	pm_wakeup_event(pogo->dev, POGO_WAKE_HOLD_MS);
+	mod_delayed_work(system_percpu_wq, &pogo->poll_work, 0);
+
+	return IRQ_HANDLED;
+}
+
+/* --------------------------------------------------------------- debugfs */
+
+static int pogo_status_show(struct seq_file *s, void *unused)
+{
+	struct pogo *pogo = s->private;
+	struct pogo_stats *st = &pogo->stats;
+
+	mutex_lock(&pogo->state_lock);
+	seq_printf(s, "state: %s\n", pogo_state_names[pogo->state]);
+	seq_printf(s, "line: %s\n", pogo_line_low(pogo) ?
+		   "low (a dock holds it)" : "high (idle or empty connector)");
+	seq_printf(s, "supply: %s\n", pogo->vcc_on ? "on" : "off");
+	seq_printf(s, "tx-gate: %d\n", gpiod_get_value_cansleep(pogo->tx_en_gpio));
+	seq_printf(s, "uart: %s, %u baud\n", pogo->port_open ? "open" : "closed", pogo->baud);
+	seq_printf(s, "detect-irq: %s\n", pogo->irq_on ? "armed" : "off");
+	seq_printf(s, "wakeup: %s\n", device_may_wakeup(pogo->dev) ? "enabled" : "disabled");
+	seq_printf(s, "power-cycles: %u\n", pogo->power_cycles);
+	if (pogo->state == POGO_CONNECTED) {
+		seq_printf(s, "keyboard: %s\n", pogo->name);
+		seq_printf(s, "brand: %u\n", pogo->brand);
+		seq_printf(s, "firmware: %s\n", pogo->version[0] ? pogo->version : "unknown");
+		seq_printf(s, "touchpad-disabled: %u\n", pogo->tp_disabled);
+		seq_printf(s, "dock-leds: %#04x\n", pogo->dock_leds);
+		if (pogo->battery_seen)
+			seq_printf(s, "battery: level %u, state %#04x\n",
+				   pogo->battery_level, pogo->battery_state);
+	} else {
+		seq_puts(s, "keyboard: none\n");
+	}
+	seq_printf(s, "backlight: %u%s\n", pogo->backlight_level,
+		   pogo->backlight_set ? "" : " (never set)");
+	mutex_unlock(&pogo->state_lock);
+
+	seq_printf(s, "timing: tx_setup_us %u tx_start_us %u tx_hold_us %u echo_check %d\n",
+		   tx_setup_us, tx_start_us, tx_hold_us, echo_check);
+	seq_printf(s, "rx: bytes %lu noise %lu frames %lu bad %lu unknown %lu\n",
+		   st->rx_bytes, st->rx_noise, st->rx_frames, st->rx_bad, st->rx_unknown);
+	seq_printf(s, "tx: frames %lu errors %lu echo-ok %lu echo-foreign %lu echo-missing %lu reply-timeouts %lu\n",
+		   st->tx_frames, st->tx_errors, st->echo_ok, st->echo_foreign,
+		   st->echo_missing, st->reply_timeouts);
+	seq_printf(s, "reports: keys %lu media %lu touch %lu touch-bad %lu touch-released-by-heartbeat %lu unknown-keys %lu rollover %lu\n",
+		   st->key_reports, st->media_reports, st->touch_reports, st->touch_bad,
+		   st->touch_hb_release, st->unknown_keys, st->rollover);
+	seq_printf(s, "sync: hello %lu heartbeat %lu other %lu\n",
+		   st->sync_hello, st->sync_heartbeat, st->sync_other);
+	seq_printf(s, "events: detect-irqs %lu stale %lu power-on %lu connects %lu\n",
+		   st->irqs, st->irqs_stale, st->power_on, st->connects);
+	seq_printf(s, "selftest: %s\n", pogo->selftest[0] ? pogo->selftest : "not run");
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pogo_status);
+
+/*
+ * The frames as they went over the line, start byte to end byte. The
+ * dock's Bluetooth address (sync frames) and serial number are private:
+ * they and the CRC that depends on them are printed as "xx".
+ */
+static int pogo_trace_show(struct seq_file *s, void *unused)
+{
+	static const char * const kind[] = { "rx", "tx", "echo", "bad" };
+	struct pogo *pogo = s->private;
+	unsigned int i, j, idx, from, to;
+	struct pogo_trace *e;
+	bool crc;
+
+	mutex_lock(&pogo->trace_lock);
+	for (i = 0; i < pogo->trace_count; i++) {
+		idx = (pogo->trace_head + POGO_TRACE_LEN - pogo->trace_count + i) % POGO_TRACE_LEN;
+		e = &pogo->trace[idx];
+		from = 0;
+		to = 0;
+		if (e->kind != POGO_TRACE_BAD && e->len > 7) {
+			if (e->data[3] == POGO_CMD_SYNC && e->data[5] == POGO_SYNC_HELLO) {
+				from = 8;
+				to = 14;
+			} else if (e->data[3] == POGO_CMD_SYNC && e->data[5] == POGO_SYNC_HEARTBEAT) {
+				from = 9;
+				to = 15;
+			} else if (e->data[3] == POGO_CMD_GENERAL + 1 &&
+				   e->data[5] == POGO_GEN_SERIAL) {
+				from = 7;
+				to = e->len;
+			}
+		}
+		seq_printf(s, "%6llu.%06llu %-4s", e->ns / NSEC_PER_SEC,
+			   (e->ns % NSEC_PER_SEC) / NSEC_PER_USEC, kind[e->kind & 3]);
+		for (j = 0; j < e->len; j++) {
+			/* the two bytes before the end byte of a whole frame are its CRC */
+			crc = from && j + 3 >= e->len && j + 1 < e->len;
+			if ((from && j >= from && j < to) || crc)
+				seq_puts(s, " xx");
+			else
+				seq_printf(s, " %02x", e->data[j]);
+		}
+		seq_putc(s, '\n');
+	}
+	mutex_unlock(&pogo->trace_lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pogo_trace);
+
+/*
+ * Without a dock: open the UART, send one frame through the gate and
+ * listen for it. Proves the UART, the transmit gate and the receive path
+ * up to the connector. The supply stays off.
+ */
+static ssize_t pogo_selftest_write(struct file *file, const char __user *ubuf,
+				   size_t count, loff_t *ppos)
+{
+	static const u8 data[] = { POGO_PASS_VERSION, 0x01, 0x01 };
+	struct pogo *pogo = file->private_data;
+	unsigned int n, i;
+	unsigned long bytes;
+	ktime_t t0;
+	s64 us;
+	int ret;
+
+	mutex_lock(&pogo->state_lock);
+	if (pogo->state != POGO_ABSENT || pogo->suspended || pogo_line_low(pogo)) {
+		snprintf(pogo->selftest, sizeof(pogo->selftest),
+			 "skipped: state %s, line %s (it needs an empty connector)",
+			 pogo_state_names[pogo->state], pogo_line_low(pogo) ? "low" : "high");
+		goto out;
+	}
+
+	pogo_irq_disable(pogo);
+	ret = pogo_port_open(pogo);
+	if (ret) {
+		snprintf(pogo->selftest, sizeof(pogo->selftest), "FAIL: UART open %d", ret);
+		pogo_irq_enable(pogo);
+		goto out;
+	}
+
+	spin_lock_irq(&pogo->rx_lock);
+	pogo->raw_len = 0;
+	pogo->raw_on = true;
+	spin_unlock_irq(&pogo->rx_lock);
+	bytes = pogo->stats.rx_bytes;
+
+	t0 = ktime_get();
+	mutex_lock(&pogo->tx_lock);
+	ret = pogo_xfer_once(pogo, POGO_CMD_PASSTHROUGH, data, sizeof(data), true, false);
+	mutex_unlock(&pogo->tx_lock);
+	us = ktime_us_delta(ktime_get(), t0);
+	if (ret)
+		msleep(20);
+
+	spin_lock_irq(&pogo->rx_lock);
+	pogo->raw_on = false;
+	spin_unlock_irq(&pogo->rx_lock);
+	bytes = pogo->stats.rx_bytes - bytes;
+
+	if (!ret) {
+		snprintf(pogo->selftest, sizeof(pogo->selftest),
+			 "PASS: echo of a %zu byte frame heard %lld us after the gate opened (%lu bytes received, %u baud)",
+			 sizeof(data) + POGO_OVERHEAD, us, bytes, pogo->baud);
+	} else {
+		n = scnprintf(pogo->selftest, sizeof(pogo->selftest),
+			      "FAIL: %d, %lu bytes received (%u baud):", ret, bytes, pogo->baud);
+		for (i = 0; i < pogo->raw_len && n + 4 < sizeof(pogo->selftest); i++)
+			n += scnprintf(pogo->selftest + n, sizeof(pogo->selftest) - n,
+				       " %02x", pogo->raw[i]);
+	}
+
+	pogo_port_close(pogo);
+	pogo_go_absent(pogo, true);
+out:
+	dev_info(pogo->dev, "self-test: %s\n", pogo->selftest);
+	mutex_unlock(&pogo->state_lock);
+
+	return count;
+}
+
+static const struct file_operations pogo_selftest_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = pogo_selftest_write,
+	.llseek = noop_llseek,
+};
+
+/* what a tester may send through debugfs: nothing that writes the dock's firmware or asks for its serial number */
+static bool pogo_send_allowed(u8 cmd, const u8 *data, unsigned int n)
+{
+	static const u8 general[] = {
+		0x02, 0x03, 0x08, 0x09, 0x0c, 0x0e, 0x11, 0x17, 0x19, 0x1b, 0x1c, 0x21,
+	};
+
+	if (!n)
+		return false;
+
+	switch (cmd) {
+	case POGO_CMD_PARAM_SET:
+		return data[0] == POGO_PARAM_LEDS;
+	case POGO_CMD_PASSTHROUGH:
+		return data[0] == POGO_PASS_VERSION;
+	case POGO_CMD_GENERAL:
+		return memchr(general, data[0], sizeof(general)) != NULL;
+	default:
+		return false;
+	}
+}
+
+/* "3a 1c 01 32": the command, then the data bytes (the length byte is added here) */
+static ssize_t pogo_send_write(struct file *file, const char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct pogo *pogo = s->private;
+	u8 msg[64], reply[POGO_FRAME_MAX];
+	unsigned int n = 0, len = 0, i, pos;
+	char buf[200], *p = buf, *tok;
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+
+	while ((tok = strsep(&p, " \t\n")) != NULL) {
+		if (!*tok)
+			continue;
+		if (n >= sizeof(msg) || kstrtou8(tok, 16, &msg[n]))
+			return -EINVAL;
+		n++;
+	}
+	if (n < 2 || !pogo_send_allowed(msg[0], &msg[1], n - 1))
+		return -EPERM;
+
+	ret = pogo_xfer(pogo, msg[0], &msg[1], n - 1, reply, &len);
+	pos = scnprintf(pogo->send_result, sizeof(pogo->send_result), "%d:", ret);
+	for (i = 0; !ret && i < len && pos + 4 < sizeof(pogo->send_result); i++)
+		pos += scnprintf(pogo->send_result + pos, sizeof(pogo->send_result) - pos,
+				 " %02x", reply[i]);
+
+	return count;
+}
+
+static int pogo_send_show(struct seq_file *s, void *unused)
+{
+	struct pogo *pogo = s->private;
+
+	seq_printf(s, "%s\n", pogo->send_result);
+
+	return 0;
+}
+
+static int pogo_send_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, pogo_send_show, inode->i_private);
+}
+
+static const struct file_operations pogo_send_fops = {
+	.owner = THIS_MODULE,
+	.open = pogo_send_open,
+	.read = seq_read,
+	.write = pogo_send_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static void pogo_debugfs_remove(void *data)
+{
+	debugfs_remove_recursive(data);
+}
