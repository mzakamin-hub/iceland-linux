+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus / OPPO pogo-pin keyboard dock with touchpad ("Smart Keyboard")
+ *
+ * The dock hangs on three pogo pins: supply, ground and ONE data line. The
+ * tablet's UART receiver listens on that line all the time; the UART
+ * transmitter reaches it through a gate that the host opens for the length
+ * of a frame (tx-enable GPIO). The host therefore hears its own frames,
+ * which is used to check that a frame went out undamaged. An unpowered or
+ * sleeping dock holds the line low, an empty connector lets it float high:
+ * the same line, read as a GPIO, is the attach detection and the wake-up
+ * source.
+ *
+ * Frames (921600 baud, 8N1):
+ *
+ *   8 x 0x55, 0xf1, source, destination, command, length, data[length],
+ *   CRC16 high, CRC16 low, 0xfe, 4 x 0xaa
+ *
+ * with the CRC (polynomial 0x8005, initial value 0xc596, MSB first) over
+ * everything from 0xf1 to the end of the data. The dock sends a "sync"
+ * frame every 100 ms while it is awake, HID boot keyboard reports, 16 bit
+ * codes for the media keys and touchpad reports that look like those of a
+ * precision touchpad (confidence, tip, contact id, x, y per finger, then
+ * the contact count and the button state).
+ *
+ * The protocol, the timing and the attach / detach handling follow the
+ * vendor driver (oplus_bsp_pogo_keyboard); firmware update is not
+ * implemented.
+ */
+
+#include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm_wakeup.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/sched/clock.h>
+#include <linux/seq_file.h>
+#include <linux/serdev.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+/* PROTO-BEGIN: the wire format, free of kernel services (also built by the self-test on the PC) */
+
+#define POGO_HEAD_SYNC		0x55
+#define POGO_TAIL_SYNC		0xaa
+#define POGO_START		0xf1
+#define POGO_START_REPEAT	0xf2
+#define POGO_END		0xfe
+#define POGO_ADDR_KEYBOARD	0xa1
+#define POGO_ADDR_HOST		0xa2
+
+#define POGO_HEAD_SYNC_LEN	8
+#define POGO_HEAD_SYNC_MIN	4	/* a receiver wants at least four of them */
+#define POGO_TAIL_SYNC_LEN	4
+#define POGO_FRAME_MAX		256
+#define POGO_OVERHEAD		20	/* everything in a frame except the data */
+#define POGO_DATA_MAX		(POGO_FRAME_MAX - POGO_OVERHEAD)
+
+#define POGO_CRC_POLY		0x8005
+#define POGO_CRC_INIT		0xc596
+
+/* commands; a reply carries the command + 1 */
+#define POGO_CMD_KEYS		0x01
+#define POGO_CMD_MEDIA_KEYS	0x02
+#define POGO_CMD_TOUCHPAD	0x03
+#define POGO_CMD_PARAM_SET	0x20
+#define POGO_CMD_SYNC		0x2f	/* dock -> host: hello / heartbeat */
+#define POGO_CMD_PASSTHROUGH	0x38
+#define POGO_CMD_GENERAL	0x3a
+
+/* sub-commands (first data byte) */
+#define POGO_PARAM_LEDS		0x0d
+#define POGO_PASS_VERSION	0x08
+#define POGO_GEN_SLEEP		0x02
+#define POGO_GEN_SERIAL		0x0b
+#define POGO_GEN_TP_STATUS	0x0c
+#define POGO_GEN_BATTERY	0x0e
+#define POGO_GEN_BRIGHTNESS	0x1c
+
+/* first data byte of a sync frame */
+#define POGO_SYNC_HELLO		0x01
+#define POGO_SYNC_HEARTBEAT	0x05
+
+#define POGO_MAX_CONTACTS	5
+
+enum { POGO_RX_NONE, POGO_RX_FRAME, POGO_RX_NOISE };
+enum { POGO_FRAME_OK, POGO_FRAME_SHORT, POGO_FRAME_ADDRESS, POGO_FRAME_CRC };
+
+struct pogo_rx {
+	u8 buf[POGO_FRAME_MAX];	/* from the start byte to the first two tail bytes */
+	unsigned int len;
+	unsigned int sync;
+	bool active;
+};
+
+struct pogo_contact {
+	u8 id;
+	bool tip;
+	bool confidence;
+	u16 x;
+	u16 y;
+};
+
+struct pogo_touch {
+	unsigned int count;
+	struct pogo_contact contact[POGO_MAX_CONTACTS];
+	bool left;
+	bool right;
+	bool has_force;
+	u16 force;
+};
+
+static u16 pogo_crc16(const u8 *buf, unsigned int len)
+{
+	u16 crc = POGO_CRC_INIT;
+	unsigned int i;
+	u8 data;
+
+	while (len--) {
+		data = *buf++;
+		for (i = 0; i < 8; i++) {
+			if (((crc & 0x8000) >> 8) ^ (data & 0x80))
+				crc = (crc << 1) ^ POGO_CRC_POLY;
+			else
+				crc <<= 1;
+			data <<= 1;
+		}
+	}
+
+	return crc;
+}
+
+/* A host frame for @cmd with @n data bytes; returns its length or -1. */
+static int pogo_build_frame(u8 *out, u8 cmd, const u8 *data, unsigned int n)
+{
+	unsigned int i, pos = 0;
+	u16 crc;
+
+	if (n > POGO_DATA_MAX)
+		return -1;
+
+	for (i = 0; i < POGO_HEAD_SYNC_LEN; i++)
+		out[pos++] = POGO_HEAD_SYNC;
+	out[pos++] = POGO_START;
+	out[pos++] = POGO_ADDR_HOST;
+	out[pos++] = POGO_ADDR_KEYBOARD;
+	out[pos++] = cmd;
+	out[pos++] = n;
+	for (i = 0; i < n; i++)
+		out[pos++] = data[i];
+	crc = pogo_crc16(&out[POGO_HEAD_SYNC_LEN], n + 5);
+	out[pos++] = crc >> 8;
+	out[pos++] = crc & 0xff;
+	out[pos++] = POGO_END;
+	for (i = 0; i < POGO_TAIL_SYNC_LEN; i++)
+		out[pos++] = POGO_TAIL_SYNC;
+
+	return pos;
+}
+
+/*
+ * Feed one received byte. POGO_RX_FRAME: rx->buf[0 .. rx->len) holds a
+ * frame from its start byte to the first two tail bytes; the caller has to
+ * use it before the next byte goes in.
+ */
+static int pogo_rx_byte(struct pogo_rx *rx, u8 c)
+{
+	if (c == POGO_HEAD_SYNC) {
+		rx->sync++;
+	} else if (c == POGO_START || c == POGO_START_REPEAT) {
+		if (rx->sync >= POGO_HEAD_SYNC_MIN) {
+			rx->len = 0;
+			rx->active = true;
+		}
+		rx->sync = 0;
+	} else {
+		rx->sync = 0;
+	}
+
+	if (!rx->active)
+		return (c == POGO_HEAD_SYNC || c == POGO_TAIL_SYNC) ? POGO_RX_NONE : POGO_RX_NOISE;
+
+	rx->buf[rx->len++] = c;
+	if (rx->len >= 3 && rx->buf[rx->len - 1] == POGO_TAIL_SYNC &&
+	    rx->buf[rx->len - 2] == POGO_TAIL_SYNC && rx->buf[rx->len - 3] == POGO_END) {
+		rx->active = false;
+		return POGO_RX_FRAME;
+	}
+	if (rx->len >= POGO_FRAME_MAX) {
+		rx->active = false;
+		rx->len = 0;
+	}
+
+	return POGO_RX_NONE;
+}
+
+/* @f: start, source, destination, command, length, data, CRC, end, 2 x tail */
+static int pogo_frame_check(const u8 *f, unsigned int len)
+{
+	u16 crc;
+
+	if (len < 10)
+		return POGO_FRAME_SHORT;
+	if (f[2] != POGO_ADDR_KEYBOARD && f[2] != POGO_ADDR_HOST)
+		return POGO_FRAME_ADDRESS;
+	crc = f[len - 5] << 8 | f[len - 4];
+	if (crc != pogo_crc16(f, len - 5))
+		return POGO_FRAME_CRC;
+
+	return POGO_FRAME_OK;
+}
+
+/*
+ * Touchpad data: five bytes per contact (flags, x low, x high, y low,
+ * y high; flags: bit 0 confidence, bit 1 tip, bits 4-7 contact id), an
+ * optional force value (two bytes), the contact count, the buttons.
+ */
+static int pogo_parse_touch(const u8 *data, unsigned int n, struct pogo_touch *t)
+{
+	unsigned int i, count;
+	const u8 *p;
+
+	if (n < 2)
+		return -1;
+	count = data[n - 2];
+	if (count > POGO_MAX_CONTACTS || 5 * count + 2 > n)
+		return -1;
+
+	t->count = count;
+	t->left = data[n - 1] & 0x01;
+	t->right = (data[n - 1] >> 1) & 0x01;
+	t->has_force = n == 5 * count + 4;
+	t->force = t->has_force ? data[n - 4] | data[n - 3] << 8 : 0;
+	for (i = 0; i < count; i++) {
+		p = data + 5 * i;
+		t->contact[i].id = p[0] >> 4;
+		t->contact[i].tip = (p[0] >> 1) & 0x01;
+		t->contact[i].confidence = p[0] & 0x01;
+		t->contact[i].x = p[1] | p[2] << 8;
+		t->contact[i].y = p[3] | p[4] << 8;
+	}
+
+	return 0;
+}
+
+/* PROTO-END */
+
+/* attach detection and heartbeat supervision, in the vendor driver's steps */
+#define POGO_DEBOUNCE_MS		20
+#define POGO_DEBOUNCE_PRESENT		6	/* line low for 6 x 20 ms: switch the supply on */
+#define POGO_DEBOUNCE_ABSENT		3
+#define POGO_HEARTBEAT_MS		50
+#define POGO_SILENT_MAX			10	/* 0.5 s without a frame: the dock is gone */
+#define POGO_GRACE_TICKS		40	/* but not in the first 2 s after power-on / attach */
+#define POGO_OFF_CHECK_MS		50
+#define POGO_OFF_PRESENT		12	/* off and line low for 0.6 s: power on again */
+#define POGO_OFF_ABSENT			20	/* off and line high for 1 s: connector empty */
+#define POGO_POWER_CYCLES_MAX		20
+#define POGO_POWER_ON_SETTLE_MS		10
+#define POGO_SLEEP_IRQ_DELAY_MS		30
+#define POGO_WAKE_HOLD_MS		500
+
+#define POGO_ECHO_TIMEOUT_MS		50
+#define POGO_REPLY_TIMEOUT_MS		100
+#define POGO_RETRY_DELAY_MS		50
+#define POGO_XFER_TRIES			3
+
+#define POGO_BRIGHTNESS_MAX		100
+#define POGO_VERSION_MAX		30
+
+#define POGO_TRACE_LEN			1024
+#define POGO_TRACE_DATA			46
+#define POGO_RAW_LEN			48
+
+static unsigned int tx_setup_us = 450;
+module_param(tx_setup_us, uint, 0644);
+MODULE_PARM_DESC(tx_setup_us, "Time between opening the transmit gate and the first bit (us)");
+
+static unsigned int tx_hold_us = 300;
+module_param(tx_hold_us, uint, 0644);
+MODULE_PARM_DESC(tx_hold_us, "Time the transmit gate stays open after the last bit (us)");
+
+static unsigned int tx_start_us = 200;
+module_param(tx_start_us, uint, 0644);
+MODULE_PARM_DESC(tx_start_us, "Allowance for the UART to start a frame (us)");
+
+static bool echo_check = true;
+module_param(echo_check, bool, 0644);
+MODULE_PARM_DESC(echo_check, "Treat a frame whose echo is not heard as not sent");
+
+enum pogo_state {
+	POGO_ABSENT,		/* supply off, waiting for the line to go low */
+	POGO_DEBOUNCE,		/* line went low: is it a dock? */
+	POGO_POWERED,		/* supply on, waiting for the first frame */
+	POGO_CONNECTED,		/* input devices registered */
+	POGO_OFF_CHECK,		/* supply off after silence: gone or only stuck? */
+};
+
+static const char * const pogo_state_names[] = {
+	[POGO_ABSENT] = "absent",
+	[POGO_DEBOUNCE] = "debounce",
+	[POGO_POWERED] = "powered",
+	[POGO_CONNECTED] = "connected",
+	[POGO_OFF_CHECK] = "off-check",
+};
+
+enum { POGO_TRACE_RX, POGO_TRACE_TX, POGO_TRACE_ECHO, POGO_TRACE_BAD };
+
+struct pogo_trace {
+	u64 ns;
+	u8 kind;
+	u8 len;
+	u8 data[POGO_TRACE_DATA];
+};
+
+struct pogo_stats {
