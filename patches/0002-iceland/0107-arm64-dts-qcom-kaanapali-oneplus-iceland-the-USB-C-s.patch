From 3d273a9ddb88acb5e2a68d854defbec6262a332b Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 11:21:28 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: the USB-C switch
 has no reset line

The WCD9395 USB-SS switch was given GPIO 162 as its reset line. Stock's
node for the chip has no reset line, no stock node uses GPIO 162, and the
vendor kernel leaves that pad as a pulled-down input. Drop the property
(it is optional in the driver) and give the pad the state stock runs it
in: GPIO function, input, pull-down, 2 mA.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/kaanapali-oneplus-iceland.dts    | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index a478016d4a..b77376fd00 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -1223,7 +1223,10 @@ wcd_usbss: typec-mux@e {
 		reg = <0xe>;
 
 		vdd-supply = <&vreg_l15b_1p8>;
-		reset-gpios = <&tlmm 162 GPIO_ACTIVE_HIGH>;
+
+		/* GPIO 162 is no reset line on this board: stock leaves it an input with a pull-down */
+		pinctrl-0 = <&wcd_usbss_gpio162_idle>;
+		pinctrl-names = "default";
 
 		mode-switch;
 		orientation-switch;
@@ -2062,6 +2065,15 @@ wake-n-pins {
 		};
 	};
 
+	/* stock's run-time state of GPIO 162 (docs/device-facts/lineage-20260928/gpio.txt:149) */
+	wcd_usbss_gpio162_idle: wcd-usbss-gpio162-idle-state {
+		pins = "gpio162";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-down;
+	};
+
 	wcd_default: wcd-reset-n-active-state {
 		pins = "gpio161";
 		function = "gpio";
-- 
