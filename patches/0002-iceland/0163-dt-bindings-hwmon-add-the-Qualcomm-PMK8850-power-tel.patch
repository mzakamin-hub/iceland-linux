From 0413b232cf945b1e7da877db707be87b330bbf1e Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 19:25:23 +0300
Subject: [PATCH 163/166] dt-bindings: hwmon: add the Qualcomm PMK8850 power
 telemetry

A PBS client of the PMK8850 PMIC samples the output power of up to 23
switching regulators of the PMICs around it and adds it up in three
SDAM blocks of the PMK8850: the configuration written by the boot
firmware, an accumulator per regulator with a time stamp, and the
accumulators' fractional parts. It raises one interrupt per complete
report and one before the accumulators overflow.

Describe the block with its two interrupts and the three SDAMs as nvmem
devices, and the measured regulators as optional child nodes that give
each one a label. Allow the node as the "power-monitor" child of an
SPMI PMIC.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/hwmon/qcom,pmk8850-qpt.yaml      | 111 ++++++++++++++++++
 .../bindings/mfd/qcom,spmi-pmic.yaml          |   4 +
 2 files changed, 115 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/hwmon/qcom,pmk8850-qpt.yaml

diff --git a/Documentation/devicetree/bindings/hwmon/qcom,pmk8850-qpt.yaml b/Documentation/devicetree/bindings/hwmon/qcom,pmk8850-qpt.yaml
new file mode 100644
index 000000000..8ac5f39f5
--- /dev/null
+++ b/Documentation/devicetree/bindings/hwmon/qcom,pmk8850-qpt.yaml
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/hwmon/qcom,pmk8850-qpt.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMK8850 power telemetry (QPT)
+
+maintainers:
+  - mzak <mzak.amin@gmail.com>
+
+description: |
+  A PBS (programmable boot sequencer) client of the PMK8850 samples the output
+  power of up to 23 switching regulators of the PMICs around it and adds it up
+  in three SDAM blocks of the PMK8850: the configuration that the boot firmware
+  writes (which regulators, the sample timer, the scale), a 40-bit accumulator
+  per regulator with a time stamp, and the fractional parts of the
+  accumulators. The client raises one interrupt each time a report is complete
+  and one when the accumulators have to be read before they overflow.
+
+  The regulators are named by their SPMI slave id and peripheral id,
+  SID << 8 | PID, as in the configuration. Child nodes give them labels.
+
+properties:
+  compatible:
+    const: qcom,pmk8850-qpt
+
+  interrupts:
+    items:
+      - description: a report is complete
+      - description: the accumulators are about to overflow
+
+  interrupt-names:
+    items:
+      - const: data-ready
+      - const: overflow
+
+  nvmem:
+    items:
+      - description: SDAM with the configuration
+      - description: SDAM with the fractional parts of the accumulators
+      - description: SDAM with the control byte, the time stamp and the accumulators
+
+  nvmem-names:
+    items:
+      - const: config
+      - const: frac
+      - const: data
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^channel@[0-9a-f]+$":
+    type: object
+    description: A regulator whose output power the client measures.
+    additionalProperties: false
+
+    properties:
+      reg:
+        description: SID << 8 | PID of the regulator.
+        maximum: 0x1fff
+
+      label:
+        description: Name of the rail that the regulator supplies.
+
+    required:
+      - reg
+
+required:
+  - compatible
+  - interrupts
+  - interrupt-names
+  - nvmem
+  - nvmem-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        power-monitor {
+            compatible = "qcom,pmk8850-qpt";
+            interrupts = <0x0 0xa2 0x1 IRQ_TYPE_EDGE_RISING>,
+                         <0x0 0xa1 0x1 IRQ_TYPE_EDGE_RISING>;
+            interrupt-names = "data-ready", "overflow";
+            nvmem = <&pmk8850_sdam_49>, <&pmk8850_sdam_50>, <&pmk8850_sdam_51>;
+            nvmem-names = "config", "frac", "data";
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            channel@59b {
+                reg = <0x59b>;
+                label = "gpu";
+            };
+
+            channel@6b6 {
+                reg = <0x6b6>;
+                label = "cpu-m";
+            };
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml b/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
index 5e0ed30a9..a04605f41 100644
--- a/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
@@ -128,6 +128,10 @@ properties:
     type: object
     $ref: /schemas/regulator/qcom,spmi-regulator.yaml#
 
+  power-monitor:
+    type: object
+    $ref: /schemas/hwmon/qcom,pmk8850-qpt.yaml#
+
   pwm:
     type: object
     $ref: /schemas/leds/leds-qcom-lpg.yaml#
