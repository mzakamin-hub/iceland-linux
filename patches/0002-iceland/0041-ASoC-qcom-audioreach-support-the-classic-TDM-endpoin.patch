From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 29 Sep 2026 07:22:23 +0300
Subject: [PATCH] ASoC: qcom: audioreach: support the classic TDM endpoint
 modules

Not every AudioReach firmware has the Audio Interface (QAIF) module: the OnePlus Pad 4's stock ADSP build
lists the classic I2S, TDM and codec-DMA endpoints in its static module table and its ACDB drives the
speakers through MODULE_ID_TDM_SINK (TDM-LPAIF-RX-PRIMARY), so a topology with MODULE_ID_AUDIO_IF_SINK
fails at APM_CMD_GRAPH_OPEN with AR_EFAILED. Add MODULE_ID_TDM_SINK/SOURCE (0x0700100E/F): they take the
Audio IF topology tokens plus the LPAIF type, and are configured with PARAM_ID_TDM_INTF_CFG (0x0800101B:
LPAIF type, interface index, sync source, data-out enable, slot mask, slots per frame, slot width, sync
mode, sync inversion, data delay) followed by the hardware endpoint media format and the frame size
factor, like the I2S modules. The slot mask, slot count and slot width from set_tdm_slot() take
precedence over the topology's defaults, as for the Audio IF module.

Also report a failed APM_CMD_GRAPH_OPEN: q6apm_get_audioreach_graph() dropped its result, so a rejected
graph only surfaced through the set-config errors that followed.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/audioreach.c | 90 +++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/audioreach.h | 39 ++++++++++++++
 sound/soc/qcom/qdsp6/q6apm.c      |  3 +-
 sound/soc/qcom/qdsp6/topology.c   |  5 ++
 4 files changed, 136 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index cce0ad31ff0c..f4deb977dc8b 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -152,6 +152,13 @@ struct apm_i2s_module_intf_cfg {
 
 #define APM_I2S_INTF_CFG_PSIZE ALIGN(sizeof(struct apm_i2s_module_intf_cfg), 8)
 
+struct apm_tdm_module_intf_cfg {
+	struct apm_module_param_data param_data;
+	struct param_id_tdm_intf_cfg cfg;
+} __packed;
+
+#define APM_TDM_INTF_CFG_PSIZE ALIGN(sizeof(struct apm_tdm_module_intf_cfg), 8)
+
 struct apm_audio_if_module_intf_cfg {
 	struct apm_module_param_data param_data;
 	struct param_id_audio_if_intf_cfg cfg;
@@ -1066,6 +1073,85 @@ static int audioreach_i2s_set_media_format(struct q6apm_graph *graph,
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
 }
 
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					   const struct audioreach_module *module,
+					   const struct audioreach_module_config *cfg)
+{
+	struct apm_module_frame_size_factor_cfg *fs_cfg;
+	struct apm_module_param_data *param_data;
+	struct apm_tdm_module_intf_cfg *intf_cfg;
+	struct apm_module_hw_ep_mf_cfg *hw_cfg;
+	int ic_sz = APM_TDM_INTF_CFG_PSIZE;
+	int ep_sz = APM_HW_EP_CFG_PSIZE;
+	int fs_sz = APM_FS_CFG_PSIZE;
+	int size = ic_sz + ep_sz + fs_sz;
+	u32 slot_mask = cfg->slot_mask ? cfg->slot_mask : module->slot_mask;
+	u16 nslots_per_frame = cfg->nslots_per_frame ?
+				 (u16)cfg->nslots_per_frame : module->nslots_per_frame;
+	u16 slot_width = cfg->slot_width ? (u16)cfg->slot_width : module->slot_width;
+	void *p;
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	intf_cfg = p;
+
+	param_data = &intf_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_TDM_INTF_CFG;
+	param_data->param_size = ic_sz - APM_MODULE_PARAM_DATA_SIZE;
+
+	intf_cfg->cfg.lpaif_type = module->hw_interface_type;
+	intf_cfg->cfg.intf_idx = module->hw_interface_idx;
+	intf_cfg->cfg.sync_src = module->sync_src;
+	intf_cfg->cfg.ctrl_data_out_enable = module->ctrl_data_out_enable;
+	intf_cfg->cfg.slot_mask = slot_mask;
+	intf_cfg->cfg.nslots_per_frame = nslots_per_frame;
+	intf_cfg->cfg.slot_width = slot_width;
+	intf_cfg->cfg.sync_mode = module->sync_mode;
+	intf_cfg->cfg.ctrl_invert_sync_pulse = module->ctrl_invert_sync_pulse;
+	intf_cfg->cfg.ctrl_sync_data_delay = module->ctrl_sync_data_delay;
+
+	switch (cfg->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_BP_FP:
+		intf_cfg->cfg.sync_src = TDM_SYNC_SRC_INTERNAL;
+		break;
+	case SND_SOC_DAIFMT_BC_FC:
+		/* CPU is slave */
+		intf_cfg->cfg.sync_src = TDM_SYNC_SRC_EXTERNAL;
+		break;
+	default:
+		break;
+	}
+
+	p += ic_sz;
+	hw_cfg = p;
+	param_data = &hw_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_HW_EP_MF_CFG;
+	param_data->param_size = ep_sz - APM_MODULE_PARAM_DATA_SIZE;
+
+	hw_cfg->mf.sample_rate = cfg->sample_rate;
+	hw_cfg->mf.bit_width = cfg->bit_width;
+	hw_cfg->mf.num_channels = cfg->num_channels;
+	hw_cfg->mf.data_format = module->data_format;
+
+	p += ep_sz;
+	fs_cfg = p;
+	param_data = &fs_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+	param_data->param_size = fs_sz - APM_MODULE_PARAM_DATA_SIZE;
+	fs_cfg->frame_size_factor = 1;
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
+
 static int audioreach_audio_if_set_media_format(struct q6apm_graph *graph,
 						const struct audioreach_module *module,
 						const struct audioreach_module_config *cfg)
@@ -1527,6 +1613,10 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 		if (!rc)
 			rc = audioreach_module_enable(graph, module, true);
 		break;
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
+		rc = audioreach_tdm_set_media_format(graph, module, cfg);
+		break;
 	case MODULE_ID_AUDIO_IF_SOURCE:
 	case MODULE_ID_AUDIO_IF_SINK:
 		rc = audioreach_audio_if_set_media_format(graph, module, cfg);
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 35541b2d8c99..dde6140fca38 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -22,6 +22,8 @@ struct q6apm_graph;
 #define MODULE_ID_PLACEHOLDER_DECODER	0x07001009
 #define MODULE_ID_I2S_SINK		0x0700100A
 #define MODULE_ID_I2S_SOURCE		0x0700100B
+#define MODULE_ID_TDM_SINK		0x0700100E
+#define MODULE_ID_TDM_SOURCE		0x0700100F
 #define MODULE_ID_SAL			0x07001010
 #define MODULE_ID_MFC			0x07001015
 #define MODULE_ID_DATA_LOGGING		0x0700101A
@@ -546,6 +548,43 @@ struct param_id_i2s_intf_cfg {
 #define PORT_ID_I2S_OUPUT		1
 #define I2S_STACK_SIZE			2048
 
+/* Classic TDM hardware endpoint (firmware without the Audio IF module) */
+#define PARAM_ID_TDM_INTF_CFG		0x0800101B
+
+#define TDM_SYNC_SRC_EXTERNAL		0
+#define TDM_SYNC_SRC_INTERNAL		1
+#define TDM_SHORT_SYNC_BIT_MODE		0
+#define TDM_LONG_SYNC_MODE		1
+#define TDM_SHORT_SYNC_SLOT_MODE	2
+
+/**
+ * struct param_id_tdm_intf_cfg - classic TDM interface configuration
+ * @lpaif_type: LPAIF instance the interface belongs to
+ * @intf_idx: interface index (primary, secondary, ...)
+ * @sync_src: frame sync source (external / internal)
+ * @ctrl_data_out_enable: share the data-out line with other masters
+ * @slot_mask: active slot bitmask
+ * @nslots_per_frame: slots per frame
+ * @slot_width: slot width in bits
+ * @sync_mode: short-bit / long / short-slot frame sync
+ * @ctrl_invert_sync_pulse: invert the frame sync when set
+ * @ctrl_sync_data_delay: data delay after the frame sync, in bit clocks
+ * @reserved: must be 0
+ */
+struct param_id_tdm_intf_cfg {
+	uint32_t lpaif_type;
+	uint32_t intf_idx;
+	uint16_t sync_src;
+	uint16_t ctrl_data_out_enable;
+	uint32_t slot_mask;
+	uint16_t nslots_per_frame;
+	uint16_t slot_width;
+	uint16_t sync_mode;
+	uint16_t ctrl_invert_sync_pulse;
+	uint16_t ctrl_sync_data_delay;
+	uint16_t reserved;
+} __packed;
+
 #define PARAM_ID_AUDIO_IF_INTF_CFG	0x08001B11
 
 /*
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 6adf6021274e..b503599cec29 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -89,7 +89,8 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 
 	kref_init(&graph->refcount);
 
-	q6apm_send_cmd_sync(apm, graph->graph, 0);
+	if (q6apm_send_cmd_sync(apm, graph->graph, 0))
+		dev_err(apm->dev, "graph %d: APM_CMD_GRAPH_OPEN failed\n", graph_id);
 
 	return graph;
 }
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index faafbc5c0ad0..874404ae13bb 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -771,6 +771,9 @@ static int audioreach_widget_audio_if_module_load(struct audioreach_module *mod,
 		case AR_TKN_U32_MODULE_FMT_DATA:
 			mod->data_format = val;
 			break;
+		case AR_TKN_U32_MODULE_HW_IF_TYPE:
+			mod->hw_interface_type = val;
+			break;
 		case AR_TKN_U16_MODULE_SYNC_SRC:
 			if (val > U16_MAX)
 				return -EINVAL;
@@ -903,6 +906,8 @@ static int audioreach_widget_load_buffer(struct snd_soc_component *component,
 	case MODULE_ID_I2S_SOURCE:
 		audioreach_widget_i2s_module_load(mod, mod_array);
 		break;
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
 	case MODULE_ID_AUDIO_IF_SINK:
 	case MODULE_ID_AUDIO_IF_SOURCE:
 		ret = audioreach_widget_audio_if_module_load(mod, mod_array);
-- 
2.43.0

