From 189aa8950909828da899037185bf22c7725c7b7c Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 28 Sep 2026 00:35:32 +0000
Subject: [PATCH 20/20] arm64: dts: qcom: kaanapali-oneplus-iceland: Drop the
 modem remoteproc

SM8850P has no modem DSP and the board already deletes its carveouts.
kaanapali.dtsi now describes the modem (remoteproc_mpss and its smp2p
edge), which referenced the deleted regions and broke the build; delete
those nodes too.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 9dbdda18889f..3ea11107c35b 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -26,6 +26,11 @@
 /delete-node/ &mpss_mem;
 /delete-node/ &q6_mpss_dtb_mem;
 /delete-node/ &rmtfs_mem;
+/delete-node/ &remoteproc_mpss;
+
+/ {
+	/delete-node/ smp2p-modem;
+};
 
 / {
 	model = "OnePlus Pad 4";
