From 2ae7c407022f7bb8bd53aee92c4fd2642aa6c72b Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 21:07:16 +0300
Subject: [PATCH] Input: nt36536: do not log the panel wait deferral as an
 error

When the panel is not powered on yet, the probe defers and prints
"panel wait failed, ret=-517" as an error, three times per boot,
although the touch screen binds on a later retry. Use dev_err_probe()
so that the reason is recorded for the deferred probe list instead.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/nt36536/nt36xxx.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/input/touchscreen/nt36536/nt36xxx.c b/drivers/input/touchscreen/nt36536/nt36xxx.c
index e1850fc15f..d557d0e2e5 100644
--- a/drivers/input/touchscreen/nt36536/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36536/nt36xxx.c
@@ -1304,8 +1304,8 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 
 	while (!ts->panel_on) {
 		if(retry_count > 5) {
-			ret = -EPROBE_DEFER;
-			NVT_ERR("panel wait failed, ret=%d\n", ret);
+			ret = dev_err_probe(&client->dev, -EPROBE_DEFER,
+					    "waiting for the panel to power on\n");
 			goto err_panelwait_failed;
 		}
 		NVT_LOG("panel is off, retry=%d\n", retry_count);
-- 
