From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 13 Oct 2026 01:00:00 +0300
Subject: [PATCH] media: iris: signal SMPTE 170M as 6/6/6 and map decoded
 colour codes consistently

The encoder writes the colour description of the coded stream from the
colorimetry of its raw OUTPUT queue. V4L2 has no BT.601 transfer function:
SMPTE 170M uses V4L2_XFER_FUNC_709, so a BT.601 source (colorspace
SMPTE170M, xfer 709, ycbcr 601, limited range) is signalled as primaries 6,
transfer 1, matrix 6. That mixed 6/1/6 description is legal but unusual:
other encoders write 6/6/6 for SMPTE 170M, and user space that maps the
V4L2 colorimetry back for a decoder (GStreamer 1.28's v4l2 decoders list
SMPTE170M + 709 as "bt601" = 6/6/6) then rejects the stream, so a hardware
round trip of SD content fails to negotiate. A colorspace with a default
transfer function or Y'CbCr encoding also signalled the reserved code 0 / 3
for that field instead of the one the colorspace implies.

Resolve the default transfer function and Y'CbCr encoding from the
colorspace (V4L2_MAP_*_DEFAULT), and signal the SMPTE 170M transfer
code (6) for SMPTE 170M, which is the same curve as BT.709.

On the decoder side, map the colour codes the firmware reports so the
CAPTURE format is consistent:
- transfer 6 (BT.601), 14 and 15 (BT.2020) are the BT.709 curve in V4L2,
  transfer 8 is linear (V4L2_XFER_FUNC_NONE);
- matrix 5 (BT.470 BG / BT.601 625) is the BT.601 encoding, not xvYCC 601;
- the DCI-P3 case compared the firmware's primaries code with a V4L2
  colorspace and returned an HFI code: map primaries 11 (SMPTE RP 431-2)
  to V4L2_COLORSPACE_DCI_P3.

The decoder's OUTPUT queue still echoes the colorimetry set by user space,
as the stateful decoder interface requires.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 .../platform/qcom/iris/iris_hfi_common.c      | 10 +++++--
 .../qcom/iris/iris_hfi_gen2_command.c         | 29 +++++++++++++++++--
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_hfi_common.c b/drivers/media/platform/qcom/iris/iris_hfi_common.c
index 42fc854d4c05..e87d16717e32 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_common.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_common.c
@@ -27,8 +27,8 @@ u32 iris_hfi_get_v4l2_color_primaries(u32 hfi_primaries)
 		return V4L2_COLORSPACE_SMPTE240M;
 	case HFI_PRIMARIES_BT2020:
 		return V4L2_COLORSPACE_BT2020;
-	case V4L2_COLORSPACE_DCI_P3:
-		return HFI_PRIMARIES_SMPTE_RP431_2;
+	case HFI_PRIMARIES_SMPTE_RP431_2:
+		return V4L2_COLORSPACE_DCI_P3;
 	default:
 		return V4L2_COLORSPACE_DEFAULT;
 	}
@@ -40,7 +40,12 @@ u32 iris_hfi_get_v4l2_transfer_char(u32 hfi_characterstics)
 	case HFI_TRANSFER_RESERVED:
 		return V4L2_XFER_FUNC_DEFAULT;
 	case HFI_TRANSFER_BT709:
+	case HFI_TRANSFER_BT601_525_OR_625:
+	case HFI_TRANSFER_BT2020_14:
+	case HFI_TRANSFER_BT2020_15:
 		return V4L2_XFER_FUNC_709;
+	case HFI_TRANSFER_LINEAR:
+		return V4L2_XFER_FUNC_NONE;
 	case HFI_TRANSFER_SMPTE_ST240M:
 		return V4L2_XFER_FUNC_SMPTE240M;
 	case HFI_TRANSFER_SRGB_SYCC:
@@ -60,7 +65,6 @@ u32 iris_hfi_get_v4l2_matrix_coefficients(u32 hfi_coefficients)
 	case HFI_MATRIX_COEFF_BT709:
 		return V4L2_YCBCR_ENC_709;
 	case HFI_MATRIX_COEFF_BT470_SYS_BG_OR_BT601_625:
-		return V4L2_YCBCR_ENC_XV601;
 	case HFI_MATRIX_COEFF_BT601_525_BT1358_525_OR_625:
 		return V4L2_YCBCR_ENC_601;
 	case HFI_MATRIX_COEFF_SMPTE_ST240:
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
index 388a36ff2b07..57ccdbf5dc33 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
@@ -368,11 +368,36 @@ static int iris_hfi_gen2_set_colorspace(struct iris_inst *inst, u32 plane)
 	if (pixmp->colorspace != V4L2_COLORSPACE_DEFAULT ||
 	    pixmp->ycbcr_enc != V4L2_YCBCR_ENC_DEFAULT ||
 	    pixmp->xfer_func != V4L2_XFER_FUNC_DEFAULT) {
+		u32 ycbcr_enc = pixmp->ycbcr_enc;
+		u32 xfer_func = pixmp->xfer_func;
+
+		/*
+		 * A colorspace implies its transfer function and Y'CbCr
+		 * encoding: resolve the defaults instead of signalling the
+		 * reserved codes in the colour description.
+		 */
+		if (pixmp->colorspace != V4L2_COLORSPACE_DEFAULT) {
+			if (xfer_func == V4L2_XFER_FUNC_DEFAULT)
+				xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(pixmp->colorspace);
+			if (ycbcr_enc == V4L2_YCBCR_ENC_DEFAULT)
+				ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(pixmp->colorspace);
+		}
+
 		colour_description_present_flag = 1;
 		video_signal_type_present_flag = 1;
 		primaries = iris_hfi_gen2_get_color_primaries(pixmp->colorspace);
-		matrix_coeff = iris_hfi_gen2_get_matrix_coefficients(pixmp->ycbcr_enc);
-		transfer_char = iris_hfi_gen2_get_transfer_char(pixmp->xfer_func);
+		matrix_coeff = iris_hfi_gen2_get_matrix_coefficients(ycbcr_enc);
+		transfer_char = iris_hfi_gen2_get_transfer_char(xfer_func);
+
+		/*
+		 * V4L2 has no separate BT.601 transfer function: SMPTE 170M
+		 * uses V4L2_XFER_FUNC_709. The bitstream has its own code for
+		 * it, so signal SMPTE 170M as 6/6/6 like other encoders do,
+		 * not as the mixed 6/1/6.
+		 */
+		if (pixmp->colorspace == V4L2_COLORSPACE_SMPTE170M &&
+		    transfer_char == HFI_TRANSFER_BT709)
+			transfer_char = HFI_TRANSFER_BT601_525_OR_625;
 	}
 
 	if (pixmp->quantization != V4L2_QUANTIZATION_DEFAULT) {
-- 
2.43.0

