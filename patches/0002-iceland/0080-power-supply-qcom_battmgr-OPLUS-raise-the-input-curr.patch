From 13a4dcfe0397df29cfa65543a769bf3cd0274fd2 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 08:17:52 +0300
Subject: [PATCH 80/83] power: supply: qcom_battmgr: OPLUS: raise the input
 current in the vendor's steps

The type's input current limit was written in one go (2 A for a DCP or a
PD charger at 5 V) and nothing looked at VBUS afterwards; a weak charger,
a thin cable or a hub then sags or drops out.

The vendor never does that (oplus,usb_aicl_enhance):
- wall chargers: steps of 300 500 900 1200 1350 1500 1750 2000 2500
  3000 mA starting at 500 mA; after each write it waits 50 ms, asks the
  firmware for a VBUS collapse and reads VBUS; VBUS below the AICL point
  means back to the step before (500 mA is the floor). AICL point
  4500 mV, or 4550 mV with the battery above 4100 mV.
- PC ports (SDP, CDP) and an unknown type: 100 mA steps from 100 mA with
  the same two checks; the AICL point of an SDP is 4620 mV.

Do the same for the 5 V limit of every type. The limits themselves stay
the vendor's table, nothing is raised. The charge current limit is
written before the ladder. A PD charger's 9 V current is the lower of
the 9 V value and the 5 V result. If VBUS cannot be read the step counts
as not held. The collapse status is asked only until it fails once.

The log line gains ", AICL <result> of <asked> uA, VBUS <mV> mV".

Tested on the OnePlus Pad 4 on a PC port: "AICL 500000 of 500000 uA,
VBUS 4959 mV", 497 mA drawn.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 107 ++++++++++++++++++++++++++--
 1 file changed, 101 insertions(+), 6 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index e36679bc9..e8ade86f4 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -2272,9 +2272,102 @@ static void qcom_battmgr_iceland_check(struct qcom_battmgr *battmgr, int ret, co
 		dev_warn(battmgr->dev, "charger setup: %s failed: %d\n", what, ret);
 }
 
+/*
+ * Stock raises the input current in steps and stays at the last one the source holds (oplus_hal_adsp.c,
+ * oplus_chg_set_input_current() and, for PC ports, oplus_chg_usb_set_input_current()): 50 ms after each step it
+ * asks the firmware for a VBUS collapse and reads VBUS; below the AICL point it goes back one step.
+ */
+#define OPLUS_USB_VBUS_COLLAPSE_STATUS	9	/* oplus_pmic_glink_id.h */
+#define ICELAND_AICL_SETTLE_MS		50	/* oplus_hal_adsp.c: usleep_range(50000, 51000) after each step */
+#define ICELAND_AICL_MV			4500	/* aicl_point */
+#define ICELAND_AICL_HIGH_VBAT_MV	4550	/* aicl_point with the battery above 4100 mV */
+#define ICELAND_AICL_HIGH_VBAT_UV	4100000
+#define ICELAND_AICL_SDP_MV		4620	/* USB_SW_AICL_POINT, for an SDP */
+#define ICELAND_AICL_PC_STEP_MA		100	/* PC ports: 100 mA steps from 100 mA */
+
+/* usb_icl[] from 500 mA (stock's first step and floor) up to the highest limit of the 0053 table */
+static const unsigned int iceland_icl_steps_ma[] = { 500, 900, 1200, 1350, 1500, 1750, 2000 };
+
+/* the source holds the step just written: no VBUS collapse and VBUS at or above the AICL point */
+static bool qcom_battmgr_iceland_aicl_held(struct qcom_battmgr *battmgr, unsigned int aicl_mv,
+					   bool *collapse_ok, unsigned int *mv)
+{
+	msleep(ICELAND_AICL_SETTLE_MS);
+
+	if (*collapse_ok) {
+		if (qcom_battmgr_request_property(battmgr, OPLUS_PROPERTY_GET,
+						  OPLUS_USB_VBUS_COLLAPSE_STATUS, 0))
+			*collapse_ok = false;	/* not answered: not asked again in this ladder */
+		else if (battmgr->oplus_value)
+			return false;
+	}
+
+	/* VBUS unreadable: the step does not count as held (fail low) */
+	if (qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_NOW, 0))
+		return false;
+	*mv = battmgr->usb.voltage_now / 1000;
+
+	return *mv >= aicl_mv;
+}
+
+/* Returns the input current now in force (uA), at most @target_ua. Called with the lock held. */
+static unsigned int qcom_battmgr_iceland_aicl(struct qcom_battmgr *battmgr, unsigned int type,
+					      unsigned int target_ua, unsigned int *mv)
+{
+	unsigned int target_ma = target_ua / 1000, aicl_mv = ICELAND_AICL_MV;
+	unsigned int ma = 0, held = 0, floor_ma, i;
+	bool collapse_ok = true;
+	int ret = 0;
+
+	/* the AICL point depends on the battery voltage (the last gauge reading if this one fails) */
+	qcom_battmgr_oplus_update_gauge(battmgr);
+	if (battmgr->status.voltage_now > ICELAND_AICL_HIGH_VBAT_UV)
+		aicl_mv = ICELAND_AICL_HIGH_VBAT_MV;
+
+	if (type == POWER_SUPPLY_USB_TYPE_SDP || type == POWER_SUPPLY_USB_TYPE_CDP ||
+	    target_ma <= iceland_icl_steps_ma[0]) {
+		/* PC ports and the 500 mA "unknown" limit: 100 mA steps */
+		if (type == POWER_SUPPLY_USB_TYPE_SDP)
+			aicl_mv = ICELAND_AICL_SDP_MV;
+		floor_ma = ICELAND_AICL_PC_STEP_MA;
+		for (ma = floor_ma; ma <= target_ma; ma += ICELAND_AICL_PC_STEP_MA) {
+			ret = qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT, ma * 1000);
+			if (ret || !qcom_battmgr_iceland_aicl_held(battmgr, aicl_mv, &collapse_ok, mv))
+				break;
+			held = ma;
+		}
+	} else {
+		floor_ma = iceland_icl_steps_ma[0];
+		for (i = 0; i < ARRAY_SIZE(iceland_icl_steps_ma) && iceland_icl_steps_ma[i] <= target_ma; i++) {
+			ma = iceland_icl_steps_ma[i];
+			ret = qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT, ma * 1000);
+			if (ret || !qcom_battmgr_iceland_aicl_held(battmgr, aicl_mv, &collapse_ok, mv))
+				break;
+			held = ma;
+		}
+	}
+	if (ret)
+		dev_warn(battmgr->dev, "charger setup: input current limit %u mA failed: %d\n", ma, ret);
+
+	/*
+	 * Stepped back, or nothing held: the last held step, or the floor as stock does. After a clean run to the
+	 * target the last write already is the held step.
+	 */
+	if (!held)
+		held = floor_ma;
+	if (held != ma || ret) {
+		ret = qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT, held * 1000);
+		if (ret)
+			dev_warn(battmgr->dev, "charger setup: input current limit %u mA failed: %d\n", held, ret);
+	}
+
+	return held * 1000;
+}
+
 static void qcom_battmgr_iceland_setup_charger(struct qcom_battmgr *battmgr)
 {
 	unsigned int type, power_mw, fcc_ma, icl_ua, mv;
+	unsigned int icl_ask_ua, icl_5v_ua, aicl_mv = 0;
 	bool pd;
 	int ret;
 
@@ -2295,21 +2388,22 @@ static void qcom_battmgr_iceland_setup_charger(struct qcom_battmgr *battmgr)
 	     type == POWER_SUPPLY_USB_TYPE_PD_PPS;
 
 	battmgr->chg_fcc_ua = fcc_ma * 1000;
-	icl_ua = qcom_battmgr_iceland_icl_ua(type, power_mw, 5000);
-	qcom_battmgr_iceland_check(battmgr, qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT, icl_ua),
-				   "input current limit");
 	qcom_battmgr_iceland_check(battmgr,
 				   qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
 								 BATT_CHG_CTRL_LIM,
 								 qcom_battmgr_oplus_fcc_ua(battmgr,
 											   battmgr->chg_fcc_ua)),
 				   "charge current limit");
+	/* the input current in stock's steps: up to the type's limit, or the last step the source holds */
+	icl_ask_ua = qcom_battmgr_iceland_icl_ua(type, power_mw, 5000);
+	icl_5v_ua = qcom_battmgr_iceland_aicl(battmgr, type, icl_ask_ua, &aicl_mv);
+	icl_ua = icl_5v_ua;
 	mv = 0;		/* VBUS is only read after a 9 V request */
 
 	/* stock asks for 9 V only below 4.5 V; lower the input current first so 9 V never exceeds the power */
 	if (pd && !qcom_battmgr_oplus_update_gauge(battmgr) &&
 	    battmgr->status.voltage_now < ICELAND_PD_9V_VBAT_MAX_UV) {
-		icl_ua = qcom_battmgr_iceland_icl_ua(type, power_mw, ICELAND_PD_MV);
+		icl_ua = min(qcom_battmgr_iceland_icl_ua(type, power_mw, ICELAND_PD_MV), icl_5v_ua);
 		ret = qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT, icl_ua);
 		qcom_battmgr_iceland_check(battmgr, ret, "9 V input current limit");
 		/* no 9 V request unless the lower current is in place */
@@ -2330,7 +2424,7 @@ static void qcom_battmgr_iceland_setup_charger(struct qcom_battmgr *battmgr)
 		 * 9 V current (fail low: VBUS may be 9 V).
 		 */
 		if (!ret && mv <= ICELAND_PD_MV - 2000) {
-			icl_ua = qcom_battmgr_iceland_icl_ua(type, power_mw, 5000);
+			icl_ua = icl_5v_ua;	/* what the source held at 5 V */
 			qcom_battmgr_iceland_check(battmgr,
 						   qcom_battmgr_oplus_set(battmgr, OPLUS_USB_INPUT_CURR_LIMIT,
 									  icl_ua),
@@ -2339,8 +2433,9 @@ static void qcom_battmgr_iceland_setup_charger(struct qcom_battmgr *battmgr)
 	}
 	mutex_unlock(&battmgr->lock);
 
-	dev_info(battmgr->dev, "charger: type %u, input limit %u uA, charge limit %u uA, VBUS after 9 V request %u mV%s\n",
+	dev_info(battmgr->dev, "charger: type %u, input limit %u uA, charge limit %u uA, VBUS after 9 V request %u mV, AICL %u of %u uA, VBUS %u mV%s\n",
 		 type, icl_ua, qcom_battmgr_oplus_fcc_ua(battmgr, battmgr->chg_fcc_ua), mv,
+		 icl_5v_ua, icl_ask_ua, aicl_mv,
 		 battmgr->chg_inhibit ? ", charging inhibited" :
 		 battmgr->chg_limit_hold ? ", charging held by the charge limit" : "");
 }
-- 
