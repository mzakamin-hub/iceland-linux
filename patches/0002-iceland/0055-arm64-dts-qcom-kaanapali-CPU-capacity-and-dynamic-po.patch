From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 29 Sep 2026 23:49:34 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali: CPU capacity and dynamic power
 coefficients

Without capacity-dmips-mhz every core reports capacity 1024, so the
scheduler treats the two Oryon clusters as equal: no asymmetric-capacity
topology, no energy-aware placement, and the big cores are picked as
often as the small ones. The stock Kaanapali tree carries the values:
1792 DMIPS/MHz and coefficient 238 for cpu0-5, 1894 and 588 for cpu6-7,
which with the SCMI frequency tables (3.63 and 4.40 GHz) gives the small
cores about 78 % of a big core's capacity.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/kaanapali.dtsi | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index f682fa185776..5d75118364ec 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -46,6 +46,8 @@ cpu0: cpu@0 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x0>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -72,6 +74,8 @@ cpu1: cpu@100 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x100>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -89,6 +93,8 @@ cpu2: cpu@200 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x200>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -106,6 +112,8 @@ cpu3: cpu@300 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x300>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -123,6 +131,8 @@ cpu4: cpu@400 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x400>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -140,6 +150,8 @@ cpu5: cpu@500 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x500>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1792>;
+			dynamic-power-coefficient = <238>;
 			d-cache-size = <0x10000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -157,6 +169,8 @@ cpu6: cpu@10000 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x10000>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1894>;
+			dynamic-power-coefficient = <588>;
 			d-cache-size = <0x18000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
@@ -183,6 +197,8 @@ cpu7: cpu@10100 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x10100>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1894>;
+			dynamic-power-coefficient = <588>;
 			d-cache-size = <0x18000>;
 			d-cache-line-size = <64>;
 			d-cache-sets = <256>;
