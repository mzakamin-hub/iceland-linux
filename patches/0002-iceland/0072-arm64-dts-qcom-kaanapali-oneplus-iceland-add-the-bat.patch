From 0159bb9b8ec440f6f62ba0367b5921550a5a03d7 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 00:42:13 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: add the
 battery's design voltages

Without them UPower takes the momentary battery voltage as the design
voltage, so the full energy it shows moves with the state of charge. The
vendor device tree gives 3.3 V as the power-off threshold and 4.5 V as the
float voltage at normal temperature.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index abe082adca..3b0def8eb7 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -47,6 +47,9 @@ aliases {
 	battery: battery {
 		compatible = "simple-battery";
 		charge-full-design-microamp-hours = <13380000>;
+		/* stock oplus,comm: vbat_uv_thr_mv 3300 (power off) and fv-mv 4500 (float, normal temperature) */
+		voltage-min-design-microvolt = <3300000>;
+		voltage-max-design-microvolt = <4500000>;
 	};
 
 	chosen {
-- 
2.43.0

