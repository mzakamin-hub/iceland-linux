From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Thu, 1 Oct 2026 23:25:43 +0300
Subject: [PATCH] wifi: ath12k: tell the firmware not to use SBS on boards that
 cannot do it

While the station is not associated the WCN7860 firmware scans a request
that has channels from both halves of the 5 GHz band on its two MACs at
once: the upper half on the first MAC, the lower half on the second one
after its 2.4 GHz channels. On a board whose second MAC has no 5 GHz path
that half of the scan hears nothing, so full scans never show a network on
channels 36-64 and the station cannot find its 5 GHz access point.

The downstream host driver sends the dual-MAC configuration at start
(WMI_PDEV_SET_MAC_CONFIG_CMDID): the firmware's default bits, with the
ASYNC_SBS bit only if SBS is enabled for the board. Do the same for boards
marked qcom,no-sbs: send the default bits without ASYNC_SBS. The firmware
then scans the whole 5 GHz band on the first MAC.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/net/wireless/ath/ath12k/mac.c | 17 +++++++++++++
 drivers/net/wireless/ath/ath12k/wmi.c | 36 +++++++++++++++++++++++++++
 drivers/net/wireless/ath/ath12k/wmi.h | 14 +++++++++++
 3 files changed, 67 insertions(+)

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 01f8c6572f65..a4c4cb515025 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -7,6 +7,7 @@
 #include <net/mac80211.h>
 #include <net/cfg80211.h>
 #include <linux/etherdevice.h>
+#include <linux/property.h>
 
 #include "mac.h"
 #include "core.h"
@@ -9812,6 +9813,22 @@ static int ath12k_mac_start(struct ath12k *ar)
 
 	__ath12k_set_antenna(ar, ar->cfg_tx_chainmask, ar->cfg_rx_chainmask);
 
+	/* The firmware runs a scan over both halves of the 5 GHz band on its
+	 * two MACs at once (SBS) unless it is told not to. On a board whose
+	 * second MAC has no 5 GHz path that half of the scan hears nothing.
+	 */
+	if (device_property_read_bool(ab->dev, "qcom,no-sbs")) {
+		ret = ath12k_wmi_pdev_set_mac_config(ar,
+						     ab->wmi_ab.default_conc_scan_config_bits,
+						     ab->wmi_ab.default_fw_config_bits &
+						     ~WMI_DBS_FW_MODE_CFG_ASYNC_SBS);
+		if (ret) {
+			ath12k_err(ab, "failed to set the dual MAC configuration: %d\n",
+				   ret);
+			goto err;
+		}
+	}
+
 	/* TODO: Do we need to enable ANI? */
 
 	ret = ath12k_reg_update_chan_list(ar, false);
diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index 75b259990c79..d267d12e6ccc 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -2827,6 +2827,38 @@ int ath12k_wmi_send_scan_start_cmd(struct ath12k *ar,
 	return ret;
 }
 
+int ath12k_wmi_pdev_set_mac_config(struct ath12k *ar, u32 scan_config,
+				   u32 fw_mode_config)
+{
+	struct ath12k_wmi_pdev *wmi = ar->wmi;
+	struct ath12k_wmi_pdev_set_mac_config_cmd *cmd;
+	struct sk_buff *skb;
+	int ret;
+
+	skb = ath12k_wmi_alloc_skb(wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+
+	cmd = (struct ath12k_wmi_pdev_set_mac_config_cmd *)skb->data;
+	cmd->tlv_header = ath12k_wmi_tlv_cmd_hdr(WMI_TAG_PDEV_SET_MAC_CONFIG_CMD,
+						 sizeof(*cmd));
+	cmd->pdev_id = cpu_to_le32(WMI_PDEV_ID_SOC);
+	cmd->concurrent_scan_config_bits = cpu_to_le32(scan_config);
+	cmd->fw_mode_config_bits = cpu_to_le32(fw_mode_config);
+
+	ath12k_dbg(ar->ab, ATH12K_DBG_WMI,
+		   "WMI pdev set mac config scan 0x%08x fw mode 0x%08x\n",
+		   scan_config, fw_mode_config);
+
+	ret = ath12k_wmi_cmd_send(wmi, skb, WMI_PDEV_SET_MAC_CONFIG_CMDID);
+	if (ret) {
+		ath12k_warn(ar->ab, "failed to send WMI_PDEV_SET_MAC_CONFIG cmd\n");
+		dev_kfree_skb(skb);
+	}
+
+	return ret;
+}
+
 int ath12k_wmi_send_scan_stop_cmd(struct ath12k *ar,
 				  struct ath12k_wmi_scan_cancel_arg *arg)
 {
@@ -5063,6 +5095,10 @@ static int ath12k_wmi_svc_rdy_ext_parse(struct ath12k_base *ab,
 			ath12k_warn(ab, "unable to extract ext params\n");
 			return ret;
 		}
+		ab->wmi_ab.default_conc_scan_config_bits =
+			svc_rdy_ext->arg.default_conc_scan_config_bits;
+		ab->wmi_ab.default_fw_config_bits =
+			svc_rdy_ext->arg.default_fw_config_bits;
 		break;
 
 	case WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS:
diff --git a/drivers/net/wireless/ath/ath12k/wmi.h b/drivers/net/wireless/ath/ath12k/wmi.h
index b508aa759bd8..13d063659977 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.h
+++ b/drivers/net/wireless/ath/ath12k/wmi.h
@@ -2849,6 +2849,16 @@ struct wmi_service_ready_ext2_event {
 	__le32 default_num_msduq_supported_per_tid;
 } __packed;
 
+/* fw_mode_config_bits of WMI_PDEV_SET_MAC_CONFIG_CMDID */
+#define WMI_DBS_FW_MODE_CFG_ASYNC_SBS	BIT(26)
+
+struct ath12k_wmi_pdev_set_mac_config_cmd {
+	__le32 tlv_header;
+	__le32 pdev_id;
+	__le32 concurrent_scan_config_bits;
+	__le32 fw_mode_config_bits;
+} __packed;
+
 struct ath12k_wmi_dbs_or_sbs_cap_params {
 	__le32 hw_mode_id;
 	__le32 sbs_lower_band_end_freq;
@@ -5417,6 +5427,8 @@ struct ath12k_wmi_base {
 
 	struct ath12k_svc_ext_info svc_ext_info;
 	u32 sbs_lower_band_end_freq;
+	u32 default_conc_scan_config_bits;
+	u32 default_fw_config_bits;
 	struct ath12k_hw_mode_info hw_mode_info;
 
 	u8 dp_peer_meta_data_ver;
@@ -6573,6 +6585,8 @@ void ath12k_wmi_start_scan_init(struct ath12k *ar,
 				struct ath12k_wmi_scan_req_arg *arg);
 int ath12k_wmi_send_scan_start_cmd(struct ath12k *ar,
 				   struct ath12k_wmi_scan_req_arg *arg);
+int ath12k_wmi_pdev_set_mac_config(struct ath12k *ar, u32 scan_config,
+				   u32 fw_mode_config);
 int ath12k_wmi_send_scan_stop_cmd(struct ath12k *ar,
 				  struct ath12k_wmi_scan_cancel_arg *arg);
 int ath12k_wmi_send_wmm_update_cmd(struct ath12k *ar, u32 vdev_id,
