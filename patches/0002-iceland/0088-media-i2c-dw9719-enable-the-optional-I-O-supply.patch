From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 09:07:59 +0300
Subject: [PATCH] media: i2c: dw9719: enable the optional I/O supply

Get the "vio" supply and keep it on while the motor is powered. It is
enabled first, as it may feed the pull-ups of the I2C bus the motor sits
on. Boards without the property get a dummy regulator.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/media/i2c/dw9719.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/dw9719.c b/drivers/media/i2c/dw9719.c
index 3b7ba88fd67c..7ea976df9247 100644
--- a/drivers/media/i2c/dw9719.c
+++ b/drivers/media/i2c/dw9719.c
@@ -86,6 +86,7 @@ struct dw9719_device {
 	struct device *dev;
 	struct regmap *regmap;
 	struct regulator *regulator;
+	struct regulator *vio;
 	enum dw9719_model model;
 	u32 mode_low_bits;
 	u32 sac_mode;
@@ -100,6 +101,7 @@ struct dw9719_device {
 static int dw9719_power_down(struct dw9719_device *dw9719)
 {
 	u32 reg_pwr = dw9719->model == DW9718S ? DW9718S_PD : DW9719_CONTROL;
+	int ret;
 
 	/*
 	 * Worth engaging the internal SHUTDOWN mode especially due to the
@@ -107,7 +109,9 @@ static int dw9719_power_down(struct dw9719_device *dw9719)
 	 */
 	if (cci_write(dw9719->regmap, reg_pwr, DW9719_SHUTDOWN, NULL))
 		dev_err(dw9719->dev, "Error writing to power register\n");
-	return regulator_disable(dw9719->regulator);
+	ret = regulator_disable(dw9719->regulator);
+	regulator_disable(dw9719->vio);
+	return ret;
 }
 
 static int dw9719_power_up(struct dw9719_device *dw9719, bool detect)
@@ -117,10 +121,20 @@ static int dw9719_power_up(struct dw9719_device *dw9719, bool detect)
 	int ret;
 	int err;
 
-	ret = regulator_enable(dw9719->regulator);
+	/* the I/O supply first: it may also feed the pull-ups of the bus */
+	ret = regulator_enable(dw9719->vio);
 	if (ret)
 		return ret;
 
+	ret = regulator_enable(dw9719->regulator);
+	if (ret) {
+		regulator_disable(dw9719->vio);
+		return ret;
+	}
+
+	/* let the rails and the bus pull-ups settle before the first transfer */
+	fsleep(1000);
+
 	/*
 	 * Need 100us to transition from SHUTDOWN to STANDBY.
 	 * Jiggle the SCL pin to wake up the device (even when the regulator is
@@ -372,6 +386,11 @@ static int dw9719_probe(struct i2c_client *client)
 		return dev_err_probe(&client->dev, PTR_ERR(dw9719->regulator),
 				     "getting regulator\n");
 
+	dw9719->vio = devm_regulator_get(&client->dev, "vio");
+	if (IS_ERR(dw9719->vio))
+		return dev_err_probe(&client->dev, PTR_ERR(dw9719->vio),
+				     "getting the I/O regulator\n");
+
 	v4l2_i2c_subdev_init(&dw9719->sd, client, &dw9719_ops);
 	dw9719->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	dw9719->sd.internal_ops = &dw9719_internal_ops;
