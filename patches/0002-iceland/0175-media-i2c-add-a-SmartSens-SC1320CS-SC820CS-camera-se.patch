index 05da409a99..93651a599a 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -134,6 +134,7 @@ obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
