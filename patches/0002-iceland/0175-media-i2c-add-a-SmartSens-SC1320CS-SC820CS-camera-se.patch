From ec46574357895f52b1597c09d35e85773f142df8 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 3 Oct 2026 08:53:15 +0300
Subject: [PATCH] media: i2c: add a SmartSens SC1320CS / SC820CS camera sensor
 driver

The OnePlus Pad 4 (iceland) carries a SmartSens SC1320CS 13 MP rear camera and an SC820CS 8 MP front camera
on the CAMSS / CCI buses described in its device tree. Add a V4L2 sub-device driver for both raw Bayer sensors:
power-up order and delays, chip IDs, the MIPI CSI-2 lane count and link frequencies, the register lists of the
modes the stock camera stack uses (four modes at 30 fps: rear 4160x3120 and 2104x1560, front 3264x2448 and
1632x1224), exposure, gain and the controls libcamera's simple pipeline needs.

No datasheet was available. Every value comes from the tablet's stock camera stack as observed on the device
(its I2C / supply / CSIPHY trace and its sensor-module binaries); the register lists are kept as the stock
software programs them.

Tested on the tablet with RAM-booted kits (both sensors stream in all four modes at 30 fps, libcamera lists
both cameras) and in the install rehearsal with kernel-iceland.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig         |  10 +
 drivers/media/i2c/Makefile        |   1 +
 drivers/media/i2c/sc-modes-regs.h | 191 +++++++++
 drivers/media/i2c/sc1320cs-regs.h | 192 +++++++++
 drivers/media/i2c/sc1320cs.c      | 637 ++++++++++++++++++++++++++++++
 drivers/media/i2c/sc820cs-regs.h  | 363 +++++++++++++++++
 6 files changed, 1394 insertions(+)
 create mode 100644 drivers/media/i2c/sc-modes-regs.h
 create mode 100644 drivers/media/i2c/sc1320cs-regs.h
 create mode 100644 drivers/media/i2c/sc1320cs.c
 create mode 100644 drivers/media/i2c/sc820cs-regs.h

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 3383f19363..9d04826c00 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -870,6 +870,16 @@ config VIDEO_S5KJN5
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5kjn5.
 
+config VIDEO_SC1320CS
+	tristate "SmartSens SC1320CS and SC820CS sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the SmartSens SC1320CS 13 MP and
+	  SC820CS 8 MP raw Bayer camera sensors, as used on the OnePlus Pad 4.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sc1320cs.
+
 config VIDEO_T4KA3
 	tristate "Toshiba T4KA3 sensor support"
 	depends on ACPI || COMPILE_TEST
