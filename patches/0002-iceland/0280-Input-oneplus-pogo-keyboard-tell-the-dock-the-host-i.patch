From 6eafd017e3ec3725f1040fa595bc9afbdfcaefc6 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 10 Oct 2026 17:56:41 +0300
Subject: [PATCH] Input: oneplus-pogo-keyboard: tell the dock the host is awake
 on attach

The dock repeats its hello sync frame (0x2f / 0x01) every 100 ms until
the host reports its wake state (general command 0x3a, sub-command 0x02
= awake); only then it sends regular heartbeats (0x2f / 0x05). The driver
sent that notification only after a system resume, so after an attach the
dock stayed in its hello phase, and every hello was taken as "the dock
started again": the caps-lock / mute state and the backlight level were
sent again once a second for as long as the dock was attached.

Send the wake notification when the dock is connected, repeat it (at
most once a second) while the dock still says hello, and treat a hello as
a restart of the dock only when heartbeats were seen since the last
hello.

The finding is SuperTurtleDev's (iceland-mainline-kernel, commit
d2b84d01ae8a "Input: oneplus-pogo-kbd: fix link loss after attach and
stuck re-detection", a different driver for the same dock); its other
half, a 6 x 20 ms debounce of the detect line and a re-check after
arming the interrupt, and its LED class backlight (c040c2a89578) are
already in this driver.

Link: https://github.com/SuperTurtleDev/iceland-mainline-kernel
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 .../input/keyboard/oneplus-pogo-keyboard.c    | 31 ++++++++++++++++---
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/drivers/input/keyboard/oneplus-pogo-keyboard.c b/drivers/input/keyboard/oneplus-pogo-keyboard.c
index b5fdbebf96..1fe56c8864 100644
--- a/drivers/input/keyboard/oneplus-pogo-keyboard.c
+++ b/drivers/input/keyboard/oneplus-pogo-keyboard.c
@@ -414,6 +414,7 @@ struct pogo {
 	struct completion echo_done;
 	struct completion reply_done;
 	bool hello_seen;
+	bool beat_seen;		/* heartbeats since the last hello: the dock left its hello phase */
 	u8 brand;
 	u8 tp_disabled;
 	u8 dock_leds;
@@ -915,15 +916,20 @@ static void pogo_handle_sync(struct pogo *pogo, const u8 *data, unsigned int n)
 	bool hello = n >= 3 && data[0] == POGO_SYNC_HELLO && data[1] == 0x02;
 	bool beat = n >= 4 && data[0] == POGO_SYNC_HEARTBEAT && data[1] == 0x02;
 	bool resend = false;
+	bool restarted;
 
 	spin_lock_irq(&pogo->rx_lock);
+	/* a hello after heartbeats: the dock started again */
+	restarted = hello && pogo->beat_seen;
 	if (hello) {
+		pogo->beat_seen = false;
 		pogo->stats.sync_hello++;
 		pogo->brand = data[2];
 		if (n > 9)
 			pogo->tp_disabled = data[9];
 	} else if (beat) {
 		pogo->stats.sync_heartbeat++;
+		pogo->beat_seen = true;
 		pogo->dock_leds = data[2];
 		pogo->brand = data[3];
 		if (n > 10)
@@ -943,9 +949,17 @@ static void pogo_handle_sync(struct pogo *pogo, const u8 *data, unsigned int n)
 	mutex_lock(&pogo->input_lock);
 	if (pogo->kbd) {
 		if (hello) {
-			/* the dock started again without the host noticing: tell it everything again */
+			/*
+			 * The dock repeats its hello every 100 ms until the host
+			 * has said that it is awake; only then it sends heartbeats.
+			 * Say it again (poll_work, at most once a second), and tell
+			 * a dock that started again everything else as well.
+			 */
 			if (time_after(jiffies, pogo->hello_jiffies + HZ)) {
 				pogo->hello_jiffies = jiffies;
+				WRITE_ONCE(pogo->need_wake, true);
+			}
+			if (restarted) {
 				atomic_set(&pogo->resend_backlight, 1);
 				resend = true;
 			}
@@ -1305,6 +1319,7 @@ static int pogo_power_on(struct pogo *pogo)
 
 	spin_lock_irq(&pogo->rx_lock);
 	pogo->hello_seen = false;
+	pogo->beat_seen = false;
 	spin_unlock_irq(&pogo->rx_lock);
 
 	msleep(POGO_POWER_ON_SETTLE_MS);
@@ -1364,6 +1379,11 @@ static void pogo_connect(struct pogo *pogo)
 	dev_info(pogo->dev, "keyboard attached: %s, firmware %s\n", pogo->name,
 		 pogo->version[0] ? pogo->version : "unknown");
 
+	/* the host is awake: this moves the dock from its hello frames to heartbeats */
+	ret = pogo_send_sleep(pogo, false);
+	if (ret)
+		dev_dbg(pogo->dev, "wake notification failed: %d\n", ret);
+
 	memset(&pogo->backlight, 0, sizeof(pogo->backlight));
 	pogo->backlight.name = "oneplus_pogo::kbd_backlight";
 	pogo->backlight.max_brightness = POGO_BRIGHTNESS_MAX;
@@ -1441,9 +1461,12 @@ static void pogo_poll_work(struct work_struct *work)
 			spin_unlock_irq(&pogo->rx_lock);
 			if (hello)
 				pogo_connect(pogo);
-		} else if (pogo->need_wake) {
-			/* back from system sleep: a dock that left meanwhile shows as silence below */
-			pogo->need_wake = false;
+		} else if (READ_ONCE(pogo->need_wake)) {
+			/*
+			 * back from system sleep, or the dock still says hello: a dock
+			 * that left meanwhile shows as silence below
+			 */
+			WRITE_ONCE(pogo->need_wake, false);
 			pogo_send_sleep(pogo, false);
 			schedule_work(&pogo->led_work);
 		}
-- 
2.43.0

