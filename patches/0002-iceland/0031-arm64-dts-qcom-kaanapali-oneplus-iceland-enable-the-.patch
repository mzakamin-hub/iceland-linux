From 58f9d282940c2048d33394e572dc0896028c3582 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 28 Sep 2026 18:59:09 +0300
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: enable the rear
 flash LED

The rear flash has two dies on the PMH0101 flash LED controller: a warm (yellow) one on channels 1 and 4 and a white
one on channels 2 and 3. Stock limits each die to 500 mA torch, 2 A flash and a 1.28 s flash timeout.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index d12c3da1e4..4b75e424f7 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -1229,6 +1229,31 @@ wifi@0 {
 	};
 };
 
+&pmh0101_flash {
+	status = "okay";
+
+	/* two dies, each on two channels (stock: 500 mA torch, 2 A flash, 1.28 s per die) */
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		function-enumerator = <0>;
+		color = <LED_COLOR_ID_YELLOW>;
+		led-sources = <1>, <4>;
+		led-max-microamp = <500000>;
+		flash-max-microamp = <2000000>;
+		flash-max-timeout-us = <1280000>;
+	};
+
+	led-1 {
+		function = LED_FUNCTION_FLASH;
+		function-enumerator = <1>;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <2>, <3>;
+		led-max-microamp = <500000>;
+		flash-max-microamp = <2000000>;
+		flash-max-timeout-us = <1280000>;
+	};
+};
+
 &pmh0101_gpios {
 	key_vol_down_default: key-vol-down-default-state {
 		pins = "gpio6";
-- 
2.43.0

