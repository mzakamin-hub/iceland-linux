+/**
+ * msm_dsi_host_set_mode_vfp() - adopt the vertical front porch of a new mode
+ * @host: DSI host
+ * @mode: the new mode; it may differ from the stored mode only in the length
+ *	  of the vertical front porch
+ *
+ * For a mode change that the DPU makes on the running timing instead of a
+ * modeset (see msm_dsi_host_set_vtotal()): the bridge mode_set is not called
+ * for it, so the stored mode follows here and the next power-on programs the
+ * new vertical total. The clocks do not change.
+ *
+ * Only copies the mode, no sleeping; serialised like msm_dsi_host_set_vtotal().
+ *
+ * Return: 0 on success, -EINVAL if no mode is stored or @mode differs from it
+ * in more than the vertical front porch
+ */
+int msm_dsi_host_set_mode_vfp(struct mipi_dsi_host *host,
+			      const struct drm_display_mode *mode)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	struct drm_display_mode *cur = msm_host->mode;
+
+	if (!cur || cur->clock != mode->clock || cur->flags != mode->flags ||
+	    cur->hdisplay != mode->hdisplay ||
+	    cur->hsync_start != mode->hsync_start ||
+	    cur->hsync_end != mode->hsync_end || cur->htotal != mode->htotal ||
+	    cur->hskew != mode->hskew || cur->vdisplay != mode->vdisplay ||
+	    cur->vscan != mode->vscan ||
+	    cur->vsync_end - cur->vsync_start != mode->vsync_end - mode->vsync_start ||
+	    cur->vtotal - cur->vsync_end != mode->vtotal - mode->vsync_end)
+		return -EINVAL;
+
+	drm_mode_copy(cur, mode);
+
+	return 0;
+}
