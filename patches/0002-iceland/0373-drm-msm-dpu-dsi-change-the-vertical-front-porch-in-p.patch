diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index d1c6a8ea4318..14decd9869a1 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1567,6 +1567,41 @@ int dpu_crtc_check_mode_changed(struct drm_crtc_state *old_crtc_state,
 	return 0;
 }
 
+/*
+ * A new mode that differs from the running one only in the vertical front
+ * porch keeps the link clocks, the DSC setup and every block of the pipeline;
+ * only the frame gets longer or shorter. If nothing else asks for a modeset
+ * and the encoders can change the front porch of their running timing (see
+ * dpu_encoder_can_change_vfp()), the commit does that at its kickoff instead
+ * of turning the encoders, the DSI hosts and the panel off and on again.
+ */
+static bool dpu_crtc_vfp_only_change(struct drm_crtc *crtc,
+				     struct drm_atomic_commit *state,
+				     struct drm_crtc_state *new)
+{
+	struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+	struct drm_encoder *encoder;
+
+	/* a colour management change may need DSPPs, which a modeset assigns */
+	if (!old || !new->mode_changed || new->active_changed ||
+	    new->connectors_changed || new->color_mgmt_changed ||
+	    !old->enable || !new->enable || !old->active || !new->active ||
+	    old->self_refresh_active || new->self_refresh_active ||
+	    !new->encoder_mask || new->encoder_mask != old->encoder_mask ||
+	    drm_crtc_in_clone_mode(old) || drm_crtc_in_clone_mode(new))
+		return false;
+
+	drm_for_each_encoder_mask(encoder, crtc->dev, new->encoder_mask) {
+		if (dpu_encoder_get_intf_mode(encoder) != INTF_MODE_VIDEO ||
+		    dpu_encoder_needs_modeset(encoder, state) ||
+		    !dpu_encoder_can_change_vfp(encoder, &old->adjusted_mode,
+						&new->adjusted_mode))
+			return false;
+	}
+
+	return true;
+}
+
 static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		struct drm_atomic_commit *state)
 {
@@ -1582,6 +1617,12 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 
+	if (dpu_crtc_vfp_only_change(crtc, state, crtc_state)) {
+		DRM_DEBUG_ATOMIC("crtc%d: front porch change, no modeset\n",
+				 crtc->base.id);
+		crtc_state->mode_changed = false;
+	}
+
 	/* don't reallocate resources if only ACTIVE has beeen changed */
 	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
 	    crtc_state->color_mgmt_changed) {
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 8879cd96f966..6290a845bd31 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -133,8 +133,10 @@ enum dpu_enc_rc_states {
  * @gen:		bumped at every enable and disable
  * @crtc_idx:		index of the CRTC whose commit lock serialises the
  *			hardware access, -1 before the first enable
- * @mode:		the mode the encoder was enabled with; it is never
- *			changed, only its front porch is stretched
+ * @mode:		the mode the timing runs with: the one the encoder was
+ *			enabled with, or the mode of a later commit that only
+ *			changed the vertical front porch (dpu_vfp_inplace);
+ *			the idle rate only stretches its front porch
  * @idle_vtotal:	vertical total of the idle rate, 0 if there is none
  * @looked_up:		@idle_vtotal was looked up for this @gen
  * @lookup_hz:		dpu_idle_refresh_hz of that lookup
@@ -142,10 +144,13 @@ enum dpu_enc_rc_states {
  * @last_kick:		jiffies of the last commit
  * @drops:		number of drops to the idle rate
  * @raises:		number of returns to the mode rate
+ * @prev_vtotal:	vertical total that ran before the last in-place
+ *			front porch change, 0 if there was none
+ * @vfp_changes:	number of in-place front porch changes
  *
  * The fields are changed under kms->commit_lock[@crtc_idx] (the commit, the
- * encoder enable and disable all run under it); @crtc_idx, @low, @idle_vtotal
- * and @last_kick are also read without it.
+ * encoder enable and disable all run under it); @crtc_idx, @low, @idle_vtotal,
+ * @prev_vtotal and @last_kick are also read without it.
  */
 struct dpu_enc_idle_rr {
 	struct list_head node;
@@ -162,6 +167,8 @@ struct dpu_enc_idle_rr {
 	unsigned long last_kick;
 	unsigned int drops;
 	unsigned int raises;
+	u32 prev_vtotal;
+	unsigned int vfp_changes;
 };
 
 /**
@@ -379,6 +386,19 @@ module_param(dpu_pending_flush_clear, bool, 0644);
 MODULE_PARM_DESC(dpu_pending_flush_clear,
 		 "Clear the cached CTL pending flush mask before the physical encoder cleanup (default: on)");
 
+/*
+ * A commit whose mode differs from the running one only in the vertical front
+ * porch (e.g. 120 <-> 60 Hz on a panel that lists both with the same pixel
+ * clock) is applied in place when this is set: dpu_crtc_atomic_check() keeps
+ * it from being a modeset and the kickoff rewrites the vertical total of the
+ * running DSI and INTF timing (dpu_encoder_can_change_vfp()). Read at every
+ * atomic check, so it can be switched at runtime.
+ */
+static bool dpu_vfp_inplace = true;
+module_param(dpu_vfp_inplace, bool, 0644);
+MODULE_PARM_DESC(dpu_vfp_inplace,
+		 "Change the vertical front porch of a running DSI video mode timing in place instead of a modeset (default: on)");
+
 /* @b differs from @a at most in the length of the vertical front porch */
 static bool dpu_idle_rr_same_but_vfp(const struct drm_display_mode *a,
 				     const struct drm_display_mode *b)
@@ -426,7 +446,13 @@ static u32 dpu_idle_rr_find_vtotal(struct drm_connector *connector,
 	return best;
 }
 
-static bool dpu_idle_rr_capable(struct dpu_encoder_virt *dpu_enc)
+/*
+ * The DSI hosts and the INTFs of the encoder can change the vertical total of
+ * the running timing while it drives @mode (or a mode that differs from it
+ * only in the vertical front porch).
+ */
+static bool dpu_idle_rr_hw_capable(struct dpu_encoder_virt *dpu_enc,
+				   const struct drm_display_mode *mode)
 {
 	struct msm_drm_private *priv = dpu_enc->base.dev->dev_private;
 	struct msm_display_info *info = &dpu_enc->disp_info;
@@ -445,24 +471,30 @@ static bool dpu_idle_rr_capable(struct dpu_encoder_virt *dpu_enc)
 		struct dpu_encoder_phys *phys = dpu_enc->phys_encs[i];
 
 		if (!phys->ops.can_set_vtotal || !phys->ops.set_vtotal ||
-		    !phys->ops.can_set_vtotal(phys))
+		    !phys->ops.can_set_vtotal(phys, mode))
 			return false;
 	}
 
 	return true;
 }
 
+static bool dpu_idle_rr_capable(struct dpu_encoder_virt *dpu_enc)
+{
+	return dpu_idle_rr_hw_capable(dpu_enc, &dpu_enc->idle_rr.mode);
+}
+
 /*
  * The DSI hosts and the INTFs latch the new total at the next frame start.
  * Don't write it in the last lines of a frame, where a frame could start
  * between the DSI and the INTF writes: wait until the next one has begun.
- * The running frame ends at the mode or at the idle total.
+ * The running frame ends at @end0 or @end1 (the mode or the idle total, or
+ * the totals before and after an in-place front porch change).
  */
-static void dpu_idle_rr_avoid_frame_start(struct dpu_encoder_virt *dpu_enc)
+static void dpu_idle_rr_avoid_frame_start(struct dpu_encoder_virt *dpu_enc,
+					  u32 end0, u32 end1)
 {
 	struct dpu_encoder_phys *master = dpu_enc->cur_master;
-	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
-	const u32 ends[] = { idle->mode.vtotal, idle->idle_vtotal };
+	const u32 ends[] = { end0, end1 };
 	unsigned int n, i;
 
 	for (n = 0; n < DPU_IDLE_RR_GUARD_POLLS; n++) {
@@ -497,24 +529,20 @@ static bool dpu_idle_rr_first_on_ctl(struct dpu_encoder_virt *dpu_enc,
 }
 
 /*
- * Program the idle (@low) or the mode vertical total on the DSI hosts and the
- * INTFs and mark the INTFs for the flush. @flush: trigger the INTF flush here
- * (outside a commit); a commit kickoff triggers it right after this, in the
- * same section. Called under the commit lock with the encoder spinlock held,
- * so that nothing comes between the DSI and the CTL writes.
+ * Write @vtotal to the DSI hosts and the INTFs and mark the INTFs for the
+ * flush. @flush: trigger the INTF flush here (outside a commit); a commit
+ * kickoff triggers it right after this, in the same section. Called under the
+ * commit lock with the encoder spinlock held, so that nothing comes between
+ * the DSI and the CTL writes.
  */
-static int dpu_idle_rr_program(struct dpu_encoder_virt *dpu_enc, bool low,
-			       bool flush)
+static int dpu_idle_rr_write(struct dpu_encoder_virt *dpu_enc, u32 vtotal,
+			     bool flush)
 {
 	struct msm_drm_private *priv = dpu_enc->base.dev->dev_private;
 	struct msm_display_info *info = &dpu_enc->disp_info;
-	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
-	u32 vtotal = low ? idle->idle_vtotal : idle->mode.vtotal;
 	unsigned int i;
 	int ret = 0;
 
-	dpu_idle_rr_avoid_frame_start(dpu_enc);
-
 	for (i = 0; i < info->num_of_h_tiles && !ret; i++)
 		ret = msm_dsi_set_vtotal(priv->kms->dsi[info->h_tile_instance[i]],
 					 vtotal);
@@ -540,6 +568,24 @@ static int dpu_idle_rr_program(struct dpu_encoder_virt *dpu_enc, bool low,
 			ctl->ops.trigger_flush(ctl);
 	}
 
+	return ret;
+}
+
+/*
+ * Program the idle (@low) or the mode vertical total, see
+ * dpu_idle_rr_write().
+ */
+static int dpu_idle_rr_program(struct dpu_encoder_virt *dpu_enc, bool low,
+			       bool flush)
+{
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+	u32 vtotal = low ? idle->idle_vtotal : idle->mode.vtotal;
+	int ret;
+
+	dpu_idle_rr_avoid_frame_start(dpu_enc, idle->mode.vtotal,
+				      idle->idle_vtotal);
+
+	ret = dpu_idle_rr_write(dpu_enc, vtotal, flush);
 	if (ret) {
 		/* should not happen after dpu_idle_rr_capable(): stop here */
 		idle->capable = false;
@@ -796,6 +842,7 @@ static void dpu_idle_rr_enable(struct dpu_encoder_virt *dpu_enc)
 	idle->looked_up = false;
 	WRITE_ONCE(idle->idle_vtotal, 0);
 	WRITE_ONCE(idle->low, false);
+	WRITE_ONCE(idle->prev_vtotal, 0);
 	drm_mode_copy(&idle->mode, &crtc->state->adjusted_mode);
 	WRITE_ONCE(idle->crtc_idx, drm_crtc_index(crtc));
 	idle->capable = dpu_idle_rr_capable(dpu_enc);
@@ -846,6 +893,105 @@ static void dpu_idle_rr_kickoff_locked(struct dpu_encoder_virt *dpu_enc)
 		dpu_idle_rr_program(dpu_enc, false, false);
 }
 
+/**
+ * dpu_encoder_can_change_vfp - whether a mode change can skip the modeset
+ * @drm_enc: encoder pointer
+ * @old: the mode the encoder runs with (the old CRTC state's adjusted mode)
+ * @new: the new adjusted mode
+ *
+ * Called from the CRTC atomic check for an active encoder that stays on.
+ *
+ * Return: true if msm.dpu_vfp_inplace is set, @new differs from @old only in
+ * the length of the vertical front porch, and the DSI hosts and the INTFs of
+ * this video mode encoder can change the vertical total of the running timing
+ * for both modes. The commit then changes it at its kickoff, see
+ * dpu_encoder_vfp_kickoff_locked().
+ */
+bool dpu_encoder_can_change_vfp(struct drm_encoder *drm_enc,
+				const struct drm_display_mode *old,
+				const struct drm_display_mode *new)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+
+	if (!READ_ONCE(dpu_vfp_inplace) || old->vtotal == new->vtotal ||
+	    !dpu_idle_rr_same_but_vfp(old, new))
+		return false;
+
+	return dpu_idle_rr_hw_capable(dpu_enc, old) &&
+	       dpu_idle_rr_hw_capable(dpu_enc, new);
+}
+
+/*
+ * Commit kickoff, under the commit lock and the encoder spinlock, right
+ * before the CTL flush. If the CRTC mode differs from the one the timing runs
+ * with, dpu_crtc_atomic_check() found that only the vertical front porch
+ * changes and kept the commit from being a modeset: write the new vertical
+ * total to the DSI hosts and the INTFs with this frame's flush (they latch it
+ * at the same frame start) and make the new mode the one the encoder, its
+ * physical encoders and the DSI hosts work with from now on.
+ */
+static void dpu_encoder_vfp_kickoff_locked(struct dpu_encoder_virt *dpu_enc)
+{
+	struct msm_drm_private *priv = dpu_enc->base.dev->dev_private;
+	struct msm_display_info *info = &dpu_enc->disp_info;
+	struct dpu_enc_idle_rr *idle = &dpu_enc->idle_rr;
+	struct drm_crtc *crtc = dpu_enc->base.crtc;
+	const struct drm_display_mode *mode;
+	u32 running;
+	unsigned int i;
+	int ret;
+
+	if (!idle->enabled || !crtc || !crtc->state)
+		return;
+
+	mode = &crtc->state->adjusted_mode;
+	if (mode->vtotal == idle->mode.vtotal)
+		return;
+
+	if (!dpu_idle_rr_same_but_vfp(&idle->mode, mode) ||
+	    !dpu_idle_rr_hw_capable(dpu_enc, mode)) {
+		DPU_ERROR_ENC(dpu_enc, "in-place change %d -> %d lines refused\n",
+			      idle->mode.vtotal, mode->vtotal);
+		return;
+	}
+
+	running = idle->low ? idle->idle_vtotal : idle->mode.vtotal;
+	dpu_idle_rr_avoid_frame_start(dpu_enc, idle->mode.vtotal,
+				      idle->idle_vtotal);
+	ret = dpu_idle_rr_write(dpu_enc, mode->vtotal, false);
+	if (ret) {
+		idle->capable = false;
+		DPU_ERROR_ENC(dpu_enc, "in-place change %u -> %d lines failed: %d\n",
+			      running, mode->vtotal, ret);
+		return;
+	}
+
+	for (i = 0; i < info->num_of_h_tiles; i++) {
+		ret = msm_dsi_set_mode_vfp(priv->kms->dsi[info->h_tile_instance[i]],
+					   mode);
+		if (ret)
+			DPU_ERROR_ENC(dpu_enc, "DSI%d mode not updated: %d\n",
+				      info->h_tile_instance[i], ret);
+	}
+	for (i = 0; i < dpu_enc->num_phys_encs; i++)
+		drm_mode_copy(&dpu_enc->phys_encs[i]->cached_mode, mode);
+
+	DPU_DEBUG_ENC(dpu_enc, "in-place change %u -> %d lines\n",
+		      running, mode->vtotal);
+
+	if (idle->low)
+		atomic_dec(&dpu_idle_rr_nr_low);
+	WRITE_ONCE(idle->low, false);
+	WRITE_ONCE(idle->prev_vtotal, running);
+	drm_mode_copy(&idle->mode, mode);
+	/* look the idle rate up again for the new mode */
+	idle->gen++;
+	idle->looked_up = false;
+	WRITE_ONCE(idle->idle_vtotal, 0);
+	idle->capable = dpu_idle_rr_capable(dpu_enc);
+	idle->vfp_changes++;
+}
+
 /**
  * dpu_encoder_idle_rr_fini - stop the idle refresh rate handling
  * @drm_enc: encoder pointer
@@ -905,19 +1051,24 @@ static int dpu_idle_rr_init(struct dpu_encoder_virt *dpu_enc)
  * @line: the current INTF line count
  * @mode_vtotal: vertical total of the mode
  *
- * Return: the idle vertical total while the front porch is stretched,
- * else @mode_vtotal
+ * Return: the idle vertical total while the front porch is stretched, the
+ * previous total for the last frame before an in-place change that made the
+ * frame shorter, else @mode_vtotal
  */
 int dpu_encoder_frame_vtotal(struct drm_encoder *drm_enc, int line,
 			     int mode_vtotal)
 {
 	struct dpu_enc_idle_rr *idle = &to_dpu_encoder_virt(drm_enc)->idle_rr;
 	int idle_vtotal = READ_ONCE(idle->idle_vtotal);
+	int prev_vtotal = READ_ONCE(idle->prev_vtotal);
 
 	if (idle_vtotal > mode_vtotal &&
 	    (READ_ONCE(idle->low) || line > mode_vtotal))
 		return idle_vtotal;
 
+	if (prev_vtotal > mode_vtotal && line > mode_vtotal)
+		return prev_vtotal;
+
 	return mode_vtotal;
 }
 
@@ -2525,6 +2676,7 @@ static void _dpu_encoder_kickoff_phys(struct dpu_encoder_virt *dpu_enc)
 	/* update pending counts and trigger kickoff ctl flush atomically */
 	spin_lock_irqsave(&dpu_enc->enc_spinlock, lock_flags);
 
+	dpu_encoder_vfp_kickoff_locked(dpu_enc);
 	dpu_idle_rr_kickoff_locked(dpu_enc);
 
 	/* don't perform flush/start operations for slave encoders */
@@ -3269,6 +3421,9 @@ static int _dpu_encoder_status_show(struct seq_file *s, void *data)
 		   READ_ONCE(dpu_enc->idle_rr.idle_vtotal),
 		   READ_ONCE(dpu_enc->idle_rr.low),
 		   dpu_enc->idle_rr.drops, dpu_enc->idle_rr.raises);
+	seq_printf(s, "vfp_inplace: on:%d changes:%u prev_vtotal:%u\n",
+		   READ_ONCE(dpu_vfp_inplace), dpu_enc->idle_rr.vfp_changes,
+		   READ_ONCE(dpu_enc->idle_rr.prev_vtotal));
 
 	return 0;
 }
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
index 05908cccb012..956779c60bf6 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
@@ -68,6 +68,10 @@ struct drm_encoder *dpu_encoder_init(struct drm_device *dev,
 
 int dpu_encoder_get_linecount(struct drm_encoder *drm_enc);
 
+bool dpu_encoder_can_change_vfp(struct drm_encoder *drm_enc,
+				const struct drm_display_mode *old,
+				const struct drm_display_mode *new);
+
 int dpu_encoder_frame_vtotal(struct drm_encoder *drm_enc, int line,
 			     int mode_vtotal);
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
index 7af6113b6ad5..483ac7f5e11b 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
@@ -92,6 +92,7 @@ struct dpu_encoder_phys;
  * @get_line_count:		Obtain current vertical line count
  * @can_set_vtotal:		Whether @set_vtotal can change the vertical
  *				front porch of the running timing in place
+ *				while it drives the given mode
  * @set_vtotal:			Change the vertical total of the running
  *				timing; the caller flushes the INTF
