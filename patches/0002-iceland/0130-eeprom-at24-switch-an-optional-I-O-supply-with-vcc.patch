From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 16:43:14 +0300
Subject: [PATCH] eeprom: at24: switch an optional I/O supply with vcc

Get an optional "vio" regulator and switch it on before and off after
"vcc" wherever the driver powers the chip: at probe, in runtime PM and
on removal. Boards without the property behave as before; no dummy
regulator is requested for them.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/nvmem/at24.c | 48 ++++++++++++++++++++++++++++++++++++++------
 1 file changed, 42 insertions(+), 6 deletions(-)

diff --git a/drivers/nvmem/at24.c b/drivers/nvmem/at24.c
index 772c4d9fa651..24d3dd0eebe1 100644
--- a/drivers/nvmem/at24.c
+++ b/drivers/nvmem/at24.c
@@ -83,6 +83,7 @@ struct at24_data {
 
 	struct nvmem_device *nvmem;
 	struct regulator *vcc_reg;
+	struct regulator *vio_reg;
 	void (*read_post)(unsigned int off, char *buf, size_t count);
 
 	/*
@@ -592,6 +593,34 @@ static void at24_probe_temp_sensor(struct i2c_client *client)
 	i2c_new_client_device(client->adapter, &info);
 }
 
+static int at24_power_on(struct at24_data *at24)
+{
+	int err;
+
+	if (at24->vio_reg) {
+		err = regulator_enable(at24->vio_reg);
+		if (err)
+			return err;
+	}
+
+	err = regulator_enable(at24->vcc_reg);
+	if (err && at24->vio_reg)
+		regulator_disable(at24->vio_reg);
+
+	return err;
+}
+
+static int at24_power_off(struct at24_data *at24)
+{
+	int err;
+
+	err = regulator_disable(at24->vcc_reg);
+	if (!err && at24->vio_reg)
+		err = regulator_disable(at24->vio_reg);
+
+	return err;
+}
+
 static int at24_probe(struct i2c_client *client)
 {
 	struct regmap_config regmap_config = { };
@@ -702,6 +731,13 @@ static int at24_probe(struct i2c_client *client)
 	if (IS_ERR(at24->vcc_reg))
 		return PTR_ERR(at24->vcc_reg);
 
+	at24->vio_reg = devm_regulator_get_optional(dev, "vio");
+	if (IS_ERR(at24->vio_reg)) {
+		if (PTR_ERR(at24->vio_reg) != -ENODEV)
+			return PTR_ERR(at24->vio_reg);
+		at24->vio_reg = NULL;
+	}
+
 	writable = !(flags & AT24_FLAG_READONLY);
 	if (writable) {
 		at24->write_max = min_t(unsigned int,
@@ -753,7 +789,7 @@ static int at24_probe(struct i2c_client *client)
 
 	full_power = acpi_dev_state_d0(&client->dev);
 	if (full_power) {
-		err = regulator_enable(at24->vcc_reg);
+		err = at24_power_on(at24);
 		if (err)
 			return dev_err_probe(dev, err, "Failed to enable vcc regulator\n");
 
@@ -771,7 +807,7 @@ static int at24_probe(struct i2c_client *client)
 		if (err) {
 			pm_runtime_disable(dev);
 			if (!pm_runtime_status_suspended(dev))
-				regulator_disable(at24->vcc_reg);
+				at24_power_off(at24);
 			return -ENODEV;
 		}
 	}
@@ -780,7 +816,7 @@ static int at24_probe(struct i2c_client *client)
 	if (IS_ERR(at24->nvmem)) {
 		pm_runtime_disable(dev);
 		if (!pm_runtime_status_suspended(dev))
-			regulator_disable(at24->vcc_reg);
+			at24_power_off(at24);
 		return dev_err_probe(dev, PTR_ERR(at24->nvmem),
 				     "failed to register nvmem\n");
 	}
@@ -808,7 +844,7 @@ static void at24_remove(struct i2c_client *client)
 	pm_runtime_disable(&client->dev);
 	if (acpi_dev_state_d0(&client->dev)) {
 		if (!pm_runtime_status_suspended(&client->dev))
-			regulator_disable(at24->vcc_reg);
+			at24_power_off(at24);
 		pm_runtime_set_suspended(&client->dev);
 	}
 }
@@ -818,7 +854,7 @@ static int __maybe_unused at24_suspend(struct device *dev)
 	struct i2c_client *client = to_i2c_client(dev);
 	struct at24_data *at24 = i2c_get_clientdata(client);
 
-	return regulator_disable(at24->vcc_reg);
+	return at24_power_off(at24);
 }
 
 static int __maybe_unused at24_resume(struct device *dev)
@@ -826,7 +862,7 @@ static int __maybe_unused at24_resume(struct device *dev)
 	struct i2c_client *client = to_i2c_client(dev);
 	struct at24_data *at24 = i2c_get_clientdata(client);
 
-	return regulator_enable(at24->vcc_reg);
+	return at24_power_on(at24);
 }
 
 static const struct dev_pm_ops at24_pm_ops = {
-- 
2.43.0

