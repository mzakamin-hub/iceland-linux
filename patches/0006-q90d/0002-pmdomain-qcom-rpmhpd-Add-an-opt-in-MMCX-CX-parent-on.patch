From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Thu, 22 Oct 2026 00:12:00 +0300
Subject: [PATCH 2/3] pmdomain: qcom: rpmhpd: Add an opt-in MMCX -> CX parent
 on Kaanapali

SM8450 .. SM8750 describe MMCX with CX as its parent (mmcx_w_cx_parent),
so every MMCX level is also voted on CX. Kaanapali lists plain MMCX.
Add rpmhpd.kaanapali_mmcx_cx_parent (default off) to use the parent link
of the earlier SoCs for comparison; with it off nothing changes.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/pmdomain/qcom/rpmhpd.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index 2c9d4beeffbe..6168ef5a50da 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -700,6 +700,16 @@ static struct rpmhpd *kaanapali_rpmhpds[] = {
 	[RPMHPD_NSP2] = &nsp2,
 };
 
+/*
+ * Kaanapali lists MMCX without CX as its parent, unlike SM8450 .. SM8750.
+ * kaanapali_mmcx_cx_parent=1 uses the parent link of those SoCs, so every
+ * MMCX level is also voted on CX (default off: no evidence yet that the
+ * board needs it, and it raises CX with the display's MMCX level).
+ */
+static bool kaanapali_mmcx_cx_parent;
+module_param(kaanapali_mmcx_cx_parent, bool, 0444);
+MODULE_PARM_DESC(kaanapali_mmcx_cx_parent, "Kaanapali: MMCX votes forwarded to CX as on SM8450-SM8750 (default off)");
+
 static const struct rpmhpd_desc kaanapali_desc = {
 	.rpmhpds = kaanapali_rpmhpds,
 	.num_pds = ARRAY_SIZE(kaanapali_rpmhpds),
@@ -1175,6 +1185,12 @@ static int rpmhpd_probe(struct platform_device *pdev)
 	if (!desc)
 		return -EINVAL;
 
+	if (desc == &kaanapali_desc && kaanapali_mmcx_cx_parent) {
+		kaanapali_rpmhpds[RPMHPD_MMCX] = &mmcx_w_cx_parent;
+		kaanapali_rpmhpds[RPMHPD_MMCX_AO] = &mmcx_ao_w_cx_parent;
+		dev_info(dev, "MMCX with CX as its parent\n");
+	}
+
 	rpmhpds = desc->rpmhpds;
 	num_pds = desc->num_pds;
 
