From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Thu, 22 Oct 2026 00:12:00 +0300
Subject: [PATCH 1/3] usb: dwc3: qcom: Keep the interconnect votes across
 runtime suspend on Kaanapali

On the OnePlus Pad 4 (Kaanapali / SM8850) the display shows torn and
stale frames shortly after the screen is woken while the ADSP is busy,
whenever the USB controller is runtime-suspended. Bisected on the tablet
with switches in a test kernel: the controller dropping its usb-ddr /
apps-usb votes at runtime suspend is the trigger; keeping them cures it,
while a higher display peak vote, held USB GDSCs, PHY reference clocks
and PHY / repeater rails do not.

Keep both votes across runtime suspend on Kaanapali and drop them for
system suspend as before, so suspend-to-idle still reaches the DDR low
power states. keep_icc_runtime=0 restores the upstream behaviour.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/dwc3/dwc3-qcom.c | 63 ++++++++++++++++++++++++++++++------
 1 file changed, 53 insertions(+), 10 deletions(-)

diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index 2fe9c6696116..cb6e828ca7f1 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -65,6 +65,18 @@
  */
 #define DWC3_QCOM_PM_QOS_LATENCY_US	2
 
+/*
+ * Keep the interconnect votes while the controller is runtime-suspended, on
+ * the SoCs that need it (Kaanapali). There, dropping the usb-ddr vote at
+ * runtime suspend lets the display scan out torn / stale frames while the
+ * ADSP is busy (OnePlus Pad 4, with an upstream-sized display vote). The
+ * votes are still dropped for system suspend.
+ */
+static bool keep_icc_runtime = true;
+module_param(keep_icc_runtime, bool, 0644);
+MODULE_PARM_DESC(keep_icc_runtime,
+		 "Keep the interconnect votes during runtime suspend on SoCs that need it (default on)");
+
 /* Qualcomm SoCs with multiport support has up to 4 ports */
 #define DWC3_QCOM_MAX_PORTS	4
 
@@ -92,6 +104,8 @@ struct dwc3_qcom {
 	struct reset_control	*resets;
 	struct dwc3_qcom_port	ports[DWC3_QCOM_MAX_PORTS];
 	bool			has_eusb2_phy;
+	bool			runtime_keeps_icc;
+	bool			icc_off;
 	u8			num_ports;
 
 	enum usb_dr_mode	mode;
@@ -456,10 +470,38 @@ static void dwc3_qcom_enable_interrupts(struct dwc3_qcom *qcom)
 		dwc3_qcom_enable_port_interrupts(qcom, i);
 }
 
-static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
+static void dwc3_qcom_icc_off(struct dwc3_qcom *qcom)
+{
+	int ret;
+
+	if (qcom->icc_off)
+		return;
+
+	ret = dwc3_qcom_interconnect_disable(qcom);
+	if (ret)
+		dev_warn(qcom->dev, "failed to disable the interconnect paths: %d\n", ret);
+	else
+		qcom->icc_off = true;
+}
+
+static void dwc3_qcom_icc_on(struct dwc3_qcom *qcom)
+{
+	int ret;
+
+	if (!qcom->icc_off)
+		return;
+
+	ret = dwc3_qcom_interconnect_enable(qcom);
+	if (ret)
+		dev_warn(qcom->dev, "failed to enable the interconnect paths: %d\n", ret);
+	else
+		qcom->icc_off = false;
+}
+
+static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup, bool runtime)
 {
 	u32 val;
-	int i, ret;
+	int i;
 
 	if (qcom->is_suspended)
 		return 0;
@@ -471,9 +513,8 @@ static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
 	}
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 
-	ret = dwc3_qcom_interconnect_disable(qcom);
-	if (ret)
-		dev_warn(qcom->dev, "failed to disable interconnect: %d\n", ret);
+	if (!runtime || !qcom->runtime_keeps_icc || !READ_ONCE(keep_icc_runtime))
+		dwc3_qcom_icc_off(qcom);
 
 	/*
 	 * The role is stable during suspend as role switching is done from a
@@ -506,9 +547,7 @@ static int dwc3_qcom_resume(struct dwc3_qcom *qcom, bool wakeup)
 	if (ret < 0)
 		return ret;
 
-	ret = dwc3_qcom_interconnect_enable(qcom);
-	if (ret)
-		dev_warn(qcom->dev, "failed to enable interconnect: %d\n", ret);
+	dwc3_qcom_icc_on(qcom);
 
 	/* Clear existing events from PHY related to L2 in/out */
 	for (i = 0; i < qcom->num_ports; i++) {
@@ -753,6 +792,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 
 	qcom->dev = &pdev->dev;
 	qcom->has_eusb2_phy = of_device_is_compatible(pdev->dev.of_node, "qcom,kaanapali-dwc3");
+	qcom->runtime_keeps_icc = of_device_is_compatible(pdev->dev.of_node, "qcom,kaanapali-dwc3");
 
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
@@ -905,10 +945,13 @@ static int dwc3_qcom_pm_suspend(struct device *dev)
 	if (ret)
 		return ret;
 
-	ret = dwc3_qcom_suspend(qcom, wakeup);
+	ret = dwc3_qcom_suspend(qcom, wakeup, false);
 	if (ret)
 		return ret;
 
+	/* also when runtime suspend kept the votes: none across system sleep */
+	dwc3_qcom_icc_off(qcom);
+
 	qcom->pm_suspended = true;
 
 	return 0;
@@ -958,7 +1001,7 @@ static int dwc3_qcom_runtime_suspend(struct device *dev)
 	if (ret)
 		return ret;
 
-	return dwc3_qcom_suspend(qcom, true);
+	return dwc3_qcom_suspend(qcom, true, true);
 }
 
 static int dwc3_qcom_runtime_resume(struct device *dev)
