From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 24 Oct 2026 11:39:59 +0300
Subject: [PATCH 3/4] cpuidle: governor: add a configurable default governor

Add CONFIG_CPU_IDLE_GOV_DEFAULT, the initial value of cpuidle.governor=.
A kernel built for one device can then select its governor (e.g. teo)
without a command line option; cpuidle.governor= still overrides it.
The default, an empty string, keeps the current behaviour.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/cpuidle/Kconfig    | 9 +++++++++
 drivers/cpuidle/governor.c | 2 +-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/cpuidle/Kconfig b/drivers/cpuidle/Kconfig
index 00e2562041fd..b400144afea6 100644
--- a/drivers/cpuidle/Kconfig
+++ b/drivers/cpuidle/Kconfig
@@ -33,6 +33,15 @@ config CPU_IDLE_GOV_TEO
 	  Some workloads benefit from using it and it generally should be safe
 	  to use.  Say Y here if you are not happy with the alternatives.
 
+config CPU_IDLE_GOV_DEFAULT
+	string "Default cpuidle governor"
+	default ""
+	help
+	  The name of the cpuidle governor to use by default, as with
+	  cpuidle.governor= on the kernel command line (which still overrides
+	  it). Empty (the default): the registered governor with the highest
+	  rating, or the one the cpuidle driver asks for.
+
 config CPU_IDLE_GOV_HALTPOLL
 	bool "Haltpoll governor (for virtualized systems)"
 	depends on KVM_GUEST
diff --git a/drivers/cpuidle/governor.c b/drivers/cpuidle/governor.c
index 5d0e7f78c6c5..3551a94c5f3f 100644
--- a/drivers/cpuidle/governor.c
+++ b/drivers/cpuidle/governor.c
@@ -16,7 +16,7 @@
 
 #include "cpuidle.h"
 
-char param_governor[CPUIDLE_NAME_LEN];
+char param_governor[CPUIDLE_NAME_LEN] = CONFIG_CPU_IDLE_GOV_DEFAULT;
 
 LIST_HEAD(cpuidle_governors);
 struct cpuidle_governor *cpuidle_curr_governor;
