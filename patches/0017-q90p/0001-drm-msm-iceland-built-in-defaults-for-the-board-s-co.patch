 drivers/gpu/drm/msm/Makefile                |  1 +
 drivers/gpu/drm/msm/adreno/a6xx_gpu.c       |  2 +
 drivers/gpu/drm/msm/adreno/adreno_device.c  | 68 ++++++++++++++-
 drivers/gpu/drm/msm/adreno/adreno_gpu.h     |  8 ++
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c | 29 ++++++-
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h |  2 +
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c     |  2 +
 drivers/gpu/drm/msm/msm_iceland.c           | 95 +++++++++++++++++++++
 drivers/gpu/drm/msm/msm_iceland.h           | 34 ++++++++
 10 files changed, 252 insertions(+), 4 deletions(-)
 create mode 100644 drivers/gpu/drm/msm/msm_iceland.c
 create mode 100644 drivers/gpu/drm/msm/msm_iceland.h

diff --git a/drivers/gpu/drm/msm/Kconfig b/drivers/gpu/drm/msm/Kconfig
index ed1c4775d1e9..3fee914f50b6 100644
--- a/drivers/gpu/drm/msm/Kconfig
+++ b/drivers/gpu/drm/msm/Kconfig
@@ -71,6 +71,21 @@ config DRM_MSM_KMS
 	select DRM_PANEL
 	select DRM_PANEL_BRIDGE
 
+config DRM_MSM_ICELAND_DEFAULTS
+	bool "OnePlus Pad 4 (iceland) built-in defaults"
+	depends on DRM_MSM
+	select CRYPTO_LIB_SHA256
+	default n
+	help
+	  On the OnePlus Pad 4 (root compatible "oneplus,iceland") only, use
+	  the board's tested values as the defaults of a few msm and panel
+	  switches that its kernel command line used to set: DSC programmed
+	  once per enable, the 30 Hz idle refresh after 1 s, the panel's stock
+	  power timing and late backlight, and - only with the vendor GPU
+	  firmware pair the board was proven with - GPU preemption and the
+	  current limiter (CLX). An explicit value on the command line or in
+	  sysfs still wins; other boards are not affected.
+
 config DRM_MSM_KMS_FBDEV
 	def_bool DRM_FBDEV_EMULATION
 	depends on DRM_MSM_KMS
diff --git a/drivers/gpu/drm/msm/Makefile b/drivers/gpu/drm/msm/Makefile
index b5d64ee7eb74..fdb216e1112a 100644
--- a/drivers/gpu/drm/msm/Makefile
+++ b/drivers/gpu/drm/msm/Makefile
@@ -167,6 +167,7 @@ msm-display-$(CONFIG_DRM_MSM_DSI_10NM_PHY) += dsi/phy/dsi_phy_10nm.o
 msm-display-$(CONFIG_DRM_MSM_DSI_7NM_PHY) += dsi/phy/dsi_phy_7nm.o
 
