From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 7 Nov 2026 06:59:21 +0200
Subject: [PATCH 3/9] arm64: dts: qcom: kaanapali-oneplus-iceland: Horae shell
 sensor

Describe the stock shell models (decoded, iceland-firmware
thermal-model.json) for the iceland-horae-shell sensor.

Promoted to the default device tree after the q91e opt-in rows passed
(7 Nov 2026, owner rule: what passes becomes the default).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 ...kaanapali-oneplus-iceland-horae-optin.dtsi | 44 +++++++++++++++++++
 .../dts/qcom/kaanapali-oneplus-iceland.dts    |  1 +
 2 files changed, 45 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-horae-optin.dtsi

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-horae-optin.dtsi b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-horae-optin.dtsi
new file mode 100644
index 000000000..c0c976d93
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-horae-optin.dtsi
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * OPT-IN, rehearsal only (q91e-pre, 7 Nov 2026). GENERATED by wf/q91d/s/gen-horae-dt.py from iceland-firmware
+ * etc/iceland/thermal-model.json (stock Horae shell models, decoded; version 2026020911 / 2021081015, project 25978): the iceland-horae-shell sensor.
+ */
+/ {
+	horae-shell {
+		compatible = "oneplus,iceland-horae-shell";
+		period-ms = <5000>;
+		battery-bias-millicelsius = <2000>;
+		battery-zone-name = "qcom-battmgr-bat";
+		battery-supply-name = "qcom-battmgr-bat";
+
+		front {
+			zone-names = "skin-thermal", "wlan-thermal", "board-thermal", "chg-cp-thermal";
+			coefficients-micro = <94984 (-449923) 1829496 (-65122) 63965 (-385097) 211857 26368 76525 (-101313) (-1167455) 68456 140198 858361 (-175002) (-11899)>;
+			constant-micro-celsius = <(-1416100)>;
+		};
+
+		front-1 {
+			zone-names = "wlan-thermal", "board-thermal", "qcom-battmgr-bat", "chg-cp-thermal";
+			coefficients-micro = <(-50460) 1361582 376261 (-60746) (-437863) 1019404 272262 (-55036) (-597355) 559781 106510 (-115100) (-116505) (-1711061) (-315756) 708427>;
+			constant-micro-celsius = <(1739400)>;
+		};
+
+		frame {
+			zone-names = "skin-thermal", "wlan-thermal", "board-thermal", "qcom-battmgr-bat", "chg-cp-thermal";
+			coefficients-micro = <86325 (-295252) 1070811 44692 (-55295) 110197 (-284814) 358218 (-36653) 5648 98194 (-180718) (-279863) (-148428) 13844 137421 347350 (-72294) (-82431) 131111>;
+			constant-micro-celsius = <(-222600)>;
+		};
+
+		back {
+			zone-names = "skin-thermal", "wlan-thermal", "board-thermal", "qcom-battmgr-bat", "chg-cp-thermal";
+			coefficients-micro = <152302 (-177473) 1340440 (-129286) (-63388) 102490 (-296731) 545308 (-260550) 18606 63786 (-183312) 69828 (-365069) 13577 92480 176792 97647 (-364541) 121860>;
+			constant-micro-celsius = <(456600)>;
+		};
+
+		back-1 {
+			zone-names = "skin-thermal", "wlan-thermal", "board-thermal", "qcom-battmgr-bat", "chg-cp-thermal";
+			coefficients-micro = <23627 (-111185) 235102 (-174224) (-55890) 39721 (-88277) 561425 (-66857) 19010 46330 (-332330) 671352 (-88152) (-69641) 70980 (-216746) 180778 (-138645) 447351>;
+			constant-micro-celsius = <(258000)>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 1a4e7b462..3e05e3463 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -3940,3 +3940,4 @@ smp2p-sleepstate {
 };
 #include "kaanapali-oneplus-iceland-thermal-optin.dtsi"
 #include "kaanapali-oneplus-iceland-qmx-optin.dtsi"
