 /*
- * OPT-IN (cmpimpl, 2 Nov 2026): stock's shell-temperature gear policy as a kernel thermal zone. GENERATED by
- * wf/cmpimpl/scripts/gen-thermal-dt.py; do not edit. The default stays the userspace iceland-thermal.
+ * Default since q91e-r2 (7 Nov 2026; first an opt-in in cmpimpl, 2 Nov 2026): stock's shell-temperature gear
+ * policy as a kernel thermal zone. GENERATED by wf/cmpimpl/scripts/gen-thermal-dt.py; do not edit.
  * Estimate: stock's 'front' shell model at steady state (decoded horae model, iceland-firmware), positive terms
  * only: skin-thermal 0.376, board-thermal 0.699, chg-cp-thermal 0.018 (dropped: wlan-thermal -0.078); the model's
  * gain 1.0144 and offset -1.4 C are folded into the trip temperatures. No 4-sample lag terms (the kernel sensor
@@ -171,7 +171,7 @@ map-gear15 {
 };
 
 /* CPU-junction backstop (denialwm 405aa6965e8e's idea, our own values): stock throttles at 105 C (10 ms polling);
- * this opt-in trip starts the step-wise throttling at 95 C so a burst cannot outrun the slow shell loop. */
+ * this trip starts the step-wise throttling at 95 C so a burst cannot outrun the slow shell loop. */
 &{/thermal-zones/cpullc-0-0-thermal} {
 	trips {
 		cpullc_0_0_backstop: cpullc-0-0-backstop {
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 3e05e3463..e66681bb8 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
