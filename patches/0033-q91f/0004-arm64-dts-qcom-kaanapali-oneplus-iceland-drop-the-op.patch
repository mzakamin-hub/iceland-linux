- * OPT-IN, rehearsal only (q91e-pre, 7 Nov 2026). GENERATED by wf/q91d/s/gen-horae-dt.py from iceland-firmware
+ * Default since q91e-r2 (7 Nov 2026; first an opt-in in q91e-pre). GENERATED by wf/q91d/s/gen-horae-dt.py from iceland-firmware
  * etc/iceland/thermal-model.json (stock Horae shell models, decoded; version 2026020911 / 2021081015, project 25978): the iceland-horae-shell sensor.
  */
 / {
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx-optin.dtsi b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx.dtsi
similarity index 94%
rename from arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx-optin.dtsi
rename to arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx.dtsi
index b272ea8cc..513617c95 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx-optin.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-qmx.dtsi
@@ -1,8 +1,8 @@
 // SPDX-License-Identifier: BSD-3-Clause
 /*
- * OPT-IN, rehearsal only (q91d, 7 Nov 2026): CPU passive backstops on the eight QMX sensors, as Doctor Logix's
+ * Default since q91e-r2 (7 Nov 2026; first an opt-in in q91d): CPU passive backstops on the eight QMX sensors, as Doctor Logix's
  * kaanapali-cpu-cooling.dtsi (denialwm 8bd03159587a) does for every kaanapali board, with our value: 95 C and
- * 5 C hysteresis, the same as the cpu-* / cpullc-* backstops of kaanapali-oneplus-iceland-thermal-optin.dtsi
+ * 5 C hysteresis, the same as the cpu-* / cpullc-* backstops of kaanapali-oneplus-iceland-thermal.dtsi
  * (denialwm uses 90 C on the Pad 4). Stock throttles at 105 C.
  */
 
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal-optin.dtsi b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal.dtsi
similarity index 97%
rename from arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal-optin.dtsi
rename to arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal.dtsi
index 8066d376b..2760a99e7 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal-optin.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland-thermal.dtsi
@@ -1,7 +1,7 @@
