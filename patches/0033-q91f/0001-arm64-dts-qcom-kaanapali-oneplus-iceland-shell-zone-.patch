+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * OPT-IN (cmpimpl, 2 Nov 2026): stock's shell-temperature gear policy as a kernel thermal zone. GENERATED by
+ * wf/cmpimpl/scripts/gen-thermal-dt.py; do not edit. The default stays the userspace iceland-thermal.
+ * Estimate: stock's 'front' shell model at steady state (decoded horae model, iceland-firmware), positive terms
+ * only: skin-thermal 0.376, board-thermal 0.699, chg-cp-thermal 0.018 (dropped: wlan-thermal -0.078); the model's
+ * gain 1.0144 and offset -1.4 C are folded into the trip temperatures. No 4-sample lag terms (the kernel sensor
+ * averages the present samples). Brightness and charge caps stay in userspace: the ktz8869 and battmgr cooling
+ * devices are registered without a DT node and cannot be mapped here.
+ */
+/ {
+	shell_estimate: shell-estimate {
+		compatible = "weighted-thermal-sensor";
+		#thermal-sensor-cells = <0>;
+		zone-names = "skin-thermal", "board-thermal", "chg-cp-thermal";
+		weights = <344 640 16>;
+	};
+};
+
+&{/thermal-zones} {
+	shell-thermal {
+		polling-delay-passive = <1000>;
+		polling-delay = <5000>;
+		thermal-sensors = <&shell_estimate>;
+
+		trips {
+			shell_gear3: shell-gear3 {
+				/* stock gear 3: shell 33 C (leave below 31 C); CPU level 3, GPU level -1 */
+				temperature = <33900>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear4: shell-gear4 {
+				/* stock gear 4: shell 35 C (leave below 33 C); CPU level 4, GPU level -1 */
+				temperature = <35900>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear5: shell-gear5 {
+				/* stock gear 5: shell 37 C (leave below 35 C); CPU level 5, GPU level -1 */
+				temperature = <37900>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear6: shell-gear6 {
+				/* stock gear 6: shell 39 C (leave below 37 C); CPU level 6, GPU level -1 */
+				temperature = <39800>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear8: shell-gear8 {
+				/* stock gear 8: shell 41 C (leave below 40 C); CPU level 7, GPU level -1 */
+				temperature = <41800>;
+				hysteresis = <1000>;
+				type = "passive";
+			};
+			shell_gear9: shell-gear9 {
+				/* stock gear 9: shell 43 C (leave below 41 C); CPU level 8, GPU level 1 */
+				temperature = <43800>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear10: shell-gear10 {
+				/* stock gear 10: shell 45 C (leave below 43 C); CPU level 9, GPU level 2 */
+				temperature = <45800>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear11: shell-gear11 {
+				/* stock gear 11: shell 47 C (leave below 45 C); CPU level 11, GPU level 3 */
+				temperature = <47700>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear12: shell-gear12 {
+				/* stock gear 12: shell 49 C (leave below 47 C); CPU level 12, GPU level 3 */
+				temperature = <49700>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear13: shell-gear13 {
+				/* stock gear 13: shell 51 C (leave below 49 C); CPU level 13, GPU level 4 */
+				temperature = <51700>;
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			shell_gear14: shell-gear14 {
