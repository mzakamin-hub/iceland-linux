+						 <&gpu 8 8>;
+			};
+			map-gear14 {
+				trip = <&shell_gear14>;
+				cooling-device = <&cpu0 22 22>,
+						 <&cpu6 27 27>,
+						 <&gpu 11 11>;
+			};
+			map-gear15 {
+				trip = <&shell_gear15>;
+				cooling-device = <&cpu0 22 22>,
+						 <&cpu6 27 27>,
+						 <&gpu 13 13>;
+			};
+		};
+	};
+};
