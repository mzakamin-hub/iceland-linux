+				hysteresis = <2000>;
+				type = "passive";
+			};
+		};
+
+		cooling-maps {
+			map-gear3 {
+				trip = <&shell_gear3>;
+				cooling-device = <&cpu0 10 10>,
+						 <&cpu6 19 19>;
+			};
+			map-gear4 {
