From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 21 Nov 2026 21:53:16 +0200
Subject: [PATCH 102/117] drm/msm/dp: keep the display controller resumed while
 DP is

With the screen off the display controller runtime suspends, and AUX
transfers of the DP controller then time out: a monitor plugged in while
the screen is off takes up to half a minute to be detected, the
compositor waits in GETCONNECTOR and every DPCD read fails with
-ETIMEDOUT.

Add a runtime PM device link from the DP controller to the display
controller at bind time, so the display controller resumes whenever the
DP controller does, and remove it at unbind.

Found by Reixo0 (RedMagic 11 Pro), commit 7af8fe6f6db2 ("drm/msm/dp: keep
the display controller up while the DP controller is") in github
Reixo0/linux (no Signed-off-by); re-implemented.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index f5ed5dce1ca41..0449571cbd639 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -56,6 +56,9 @@ struct msm_dp_display_private {
 	bool phy_initialized;
 	bool audio_supported;
 
+	/* runtime PM link: the display controller is up while this one is */
+	struct device_link *mdp_link;
+
 	struct mutex plugged_lock;
 	bool plugged;
 	/* unplugged while the stream was on: retrain on the next plug */
@@ -308,6 +311,18 @@ static int msm_dp_display_bind(struct device *dev, struct device *master,
 
 	dp->drm_dev = drm;
 	dp->aux->drm_dev = drm;
+
+	/*
+	 * AUX transfers time out while the display controller is runtime
+	 * suspended (screen off), so a monitor plugged in then takes up to
+	 * half a minute to be detected. Make the display controller resume
+	 * whenever this controller does.
+	 */
+	dp->mdp_link = device_link_add(dev, drm->dev,
+				       DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME);
+	if (!dp->mdp_link)
+		dev_warn(dev, "no runtime PM link to the display controller\n");
+
 	rc = msm_dp_aux_register(dp->aux);
 	if (rc) {
 		DRM_ERROR("DRM DP AUX register failed\n");
@@ -316,6 +331,10 @@ static int msm_dp_display_bind(struct device *dev, struct device *master,
 
 	return 0;
 end:
+	if (dp->mdp_link) {
+		device_link_del(dp->mdp_link);
+		dp->mdp_link = NULL;
+	}
 	return rc;
 }
 
@@ -329,6 +348,10 @@ static void msm_dp_display_unbind(struct device *dev, struct device *master,
 	of_dp_aux_depopulate_bus(dp->aux);
 
 	msm_dp_aux_unregister(dp->aux);
+	if (dp->mdp_link) {
+		device_link_del(dp->mdp_link);
+		dp->mdp_link = NULL;
+	}
 	dp->drm_dev = NULL;
 	dp->aux->drm_dev = NULL;
 	priv->kms->dp[dp->id] = NULL;
-- 
