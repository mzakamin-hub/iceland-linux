 #include <linux/of.h>
 #include <linux/firmware.h>
 #include <linux/of_address.h>
@@ -2165,6 +2166,14 @@ static const struct qmi_elem_info qmi_wlanfw_fw_ready_ind_msg_v01_ei[] = {
 	},
 };
 
+static const struct qmi_elem_info qmi_wlanfw_cold_boot_cal_done_ind_msg_v01_ei[] = {
+	{
+		.data_type	= QMI_EOTI,
+		.array_type	= NO_ARRAY,
+		.tlv_type	= QMI_COMMON_TLV_TYPE,
+	},
+};
+
 static const struct qmi_elem_info qmi_wlanfw_wlan_ini_req_msg_v01_ei[] = {
 	{
 		.data_type	= QMI_OPT_FLAG,
@@ -3864,6 +3873,67 @@ out:
 	return ret;
 }
 
+/*
+ * Cold boot calibration (opt-in, ath12k.cold_boot_cal=1): on the first
+ * firmware ready of a PCI device, run the firmware in calibration mode. It
+ * writes its RF calibration into the CALDB region and sends
+ * COLD_BOOT_CAL_DONE; the device is then power cycled and boots into
+ * mission mode with cal_done set in the host capabilities, so the firmware
+ * uses that calibration. The CALDB chunk is kept across the power cycle
+ * (the target memory is reused when type and size are unchanged).
+ * Returns true when the calibration was started.
+ */
+static bool ath12k_qmi_cold_boot_cal_start(struct ath12k_base *ab)
+{
+	int ret;
+
+	if (!ath12k_cold_boot_cal || ath12k_ftm_mode ||
+	    ab->hif.bus != ATH12K_BUS_PCI ||
+	    ab->qmi.cal_done || ab->qmi.cold_boot_cal_tried)
+		return false;
+
+	ab->qmi.cold_boot_cal_tried = true;
+	ab->qmi.cold_boot_cal_running = true;
+
+	ath12k_info(ab, "starting cold boot calibration\n");
+	ret = ath12k_qmi_wlanfw_mode_send(ab, ATH12K_QMI_FIRMWARE_MODE_COLD_BOOT);
+	if (ret < 0) {
+		ath12k_warn(ab, "failed to start cold boot calibration: %d, continuing without it\n",
+			    ret);
+		ab->qmi.cold_boot_cal_running = false;
+		return false;
+	}
+
+	queue_delayed_work(ab->workqueue, &ab->cold_boot_cal_work,
+			   msecs_to_jiffies(ATH12K_COLD_BOOT_CAL_TIMEOUT_MS));
+	return true;
+}
+
+void ath12k_qmi_cold_boot_cal_work(struct work_struct *work)
+{
+	struct ath12k_base *ab = container_of(to_delayed_work(work),
+					      struct ath12k_base,
+					      cold_boot_cal_work);
+	int ret;
+
+	if (test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags))
+		return;
+
+	if (ab->qmi.cal_done)
+		ath12k_info(ab, "cold boot calibration done, restarting the firmware\n");
+	else
+		ath12k_warn(ab, "cold boot calibration timed out, restarting the firmware without it\n");
+
+	ath12k_qmi_wlanfw_mode_send(ab, ATH12K_QMI_FIRMWARE_MODE_OFF);
+	ath12k_hif_power_down(ab, false);
+	ab->qmi.cold_boot_cal_running = false;
+
+	ret = ath12k_hif_power_up(ab);
+	if (ret)
+		ath12k_err(ab, "failed to power up after cold boot calibration: %d\n",
+			   ret);
+}
+
 void ath12k_qmi_firmware_stop(struct ath12k_base *ab)
 {
 	int ret;
@@ -4162,6 +4232,18 @@ static void ath12k_qmi_msg_fw_ready_cb(struct qmi_handle *qmi_hdl,
 	ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_FW_READY, NULL);
 }
 
+static void ath12k_qmi_msg_cold_boot_cal_done_cb(struct qmi_handle *qmi_hdl,
+						 struct sockaddr_qrtr *sq,
+						 struct qmi_txn *txn,
+						 const void *decoded)
+{
+	struct ath12k_qmi *qmi = container_of(qmi_hdl, struct ath12k_qmi, handle);
+	struct ath12k_base *ab = qmi->ab;
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi cold boot calibration done\n");
+	ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_COLD_BOOT_CAL_DONE, NULL);
+}
+
 static const struct qmi_msg_handler ath12k_qmi_msg_handlers[] = {
 	{
 		.type = QMI_INDICATION,
@@ -4184,6 +4266,14 @@ static const struct qmi_msg_handler ath12k_qmi_msg_handlers[] = {
 		.decoded_size = sizeof(struct qmi_wlanfw_fw_ready_ind_msg_v01),
 		.fn = ath12k_qmi_msg_fw_ready_cb,
 	},
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_WLFW_COLD_BOOT_CAL_DONE_IND_V01,
+		.ei = qmi_wlanfw_cold_boot_cal_done_ind_msg_v01_ei,
+		.decoded_size =
+			sizeof(struct qmi_wlanfw_cold_boot_cal_done_ind_msg_v01),
+		.fn = ath12k_qmi_msg_cold_boot_cal_done_cb,
+	},
 
 	/* end of list */
 	{},
@@ -4294,6 +4384,10 @@ static void ath12k_qmi_driver_event_work(struct work_struct *work)
 
 			clear_bit(ATH12K_FLAG_CRASH_FLUSH,
 				  &ab->dev_flags);
+
+			if (ath12k_qmi_cold_boot_cal_start(ab))
+				break;
+
 			ret = ath12k_core_qmi_firmware_ready(ab);
 			if (!ret)
 				set_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE,
@@ -4305,6 +4399,12 @@ static void ath12k_qmi_driver_event_work(struct work_struct *work)
 			if (ret < 0)
 				set_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
 			break;
+		case ATH12K_QMI_EVENT_COLD_BOOT_CAL_DONE:
+			if (!ab->qmi.cold_boot_cal_running || ab->qmi.cal_done)
+				break;
+			ab->qmi.cal_done = 1;
+			mod_delayed_work(ab->workqueue, &ab->cold_boot_cal_work, 0);
+			break;
 		default:
 			ath12k_warn(ab, "invalid event type: %d\n", event->type);
 			break;
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
index 28ca7be46185..07f9ef441867 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -30,6 +30,10 @@
 #define QMI_WLFW_REQUEST_MEM_IND_V01		0x0035
 #define QMI_WLFW_FW_MEM_READY_IND_V01		0x0037
 #define QMI_WLFW_FW_READY_IND_V01		0x0038
+#define QMI_WLFW_COLD_BOOT_CAL_DONE_IND_V01	0x003E
+
+/* the calibration takes about 8 s on WCN7860; give up after this */
+#define ATH12K_COLD_BOOT_CAL_TIMEOUT_MS		30000
 
 #define QMI_WLANFW_MAX_DATA_SIZE_V01		6144
 
@@ -65,6 +69,7 @@ enum ath12k_qmi_event_type {
 	ATH12K_QMI_EVENT_POWER_UP,
 	ATH12K_QMI_EVENT_POWER_DOWN,
 	ATH12K_QMI_EVENT_HOST_CAP,
+	ATH12K_QMI_EVENT_COLD_BOOT_CAL_DONE,
 	ATH12K_QMI_EVENT_MAX,
 };
 
@@ -146,6 +151,10 @@ struct ath12k_qmi {
 	u32 target_mem_mode;
 	bool target_mem_delayed;
 	u8 cal_done;
+	/* a cold boot calibration was started for this device */
+	bool cold_boot_cal_tried;
+	/* the firmware runs in calibration mode, or is power cycled after it */
+	bool cold_boot_cal_running;
 
 	/* protected with struct ath12k_qmi::event_lock */
 	bool block_event;
@@ -378,6 +387,10 @@ struct qmi_wlanfw_fw_ready_ind_msg_v01 {
 	char placeholder;
 };
 
+struct qmi_wlanfw_cold_boot_cal_done_ind_msg_v01 {
+	char placeholder;
+};
+
 #define QMI_WLANFW_CAP_REQ_MSG_V01_MAX_LEN	0
 #define QMI_WLANFW_CAP_REQ_V01			0x0024
 
@@ -635,6 +648,9 @@ enum ath12k_qmi_firmware_mode {
 
 	/* firmware offline; values 2-3 reserved by firmware ABI */
 	ATH12K_QMI_FIRMWARE_MODE_OFF = 4,
+
+	/* cold boot calibration; values 5-6 reserved by firmware ABI */
+	ATH12K_QMI_FIRMWARE_MODE_COLD_BOOT = 7,
 };
 
 static inline void ath12k_qmi_set_event_block(struct ath12k_qmi *qmi, bool block)
@@ -654,6 +670,7 @@ static inline bool ath12k_qmi_get_event_block(struct ath12k_qmi *qmi)
 int ath12k_qmi_firmware_start(struct ath12k_base *ab,
 			      enum ath12k_qmi_firmware_mode mode);
 void ath12k_qmi_firmware_stop(struct ath12k_base *ab);
+void ath12k_qmi_cold_boot_cal_work(struct work_struct *work);
 void ath12k_qmi_deinit_service(struct ath12k_base *ab);
 int ath12k_qmi_init_service(struct ath12k_base *ab);
 void ath12k_qmi_free_resource(struct ath12k_base *ab);
