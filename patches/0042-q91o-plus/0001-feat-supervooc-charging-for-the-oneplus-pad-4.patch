index 0000000000000..0a654422dd56a
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/tests/check-construct.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Construction rules of iceland_supervooc.c that the host tests cannot reach (the file needs kernel headers): which function writes to which
+pump, what runs in the IRQ thread, the order of the two pump-off writes, the release of the charger hold. A source-level check, by
+function; `check(src)` returns the violations. usage: check-construct.py [file]"""
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def functions(src):
+    lines = src.split("\n")
+    out = {}
+    for i, ln in enumerate(lines):
+        if ln == "{" and i:
+            m = re.findall(r"(\w+)\(", lines[i - 1])
+            if not m:
+                continue
+            j = i + 1
+            while j < len(lines) and lines[j] != "}":
+                j += 1
+            out[m[0] if lines[i - 1].startswith(("static", "int", "void")) else m[-1]] = "\n".join(lines[i:j + 1])
+    return out
+
+
+def check(src):
+    f = functions(src)
+    bad = []
+
+    def need(c, msg):
+        if not c:
+            bad.append(msg)
+
+    # 1. the only pump writes: pw_raw -> M.cl with the primary's tables, ps_raw -> M.cl2 with the secondary's
+    wr = [n for n, b in f.items() if re.search(r"i2c_smbus_write_|i2c_transfer|i2c_master_send|regmap_write\(M\.|regmap_update", b)]
+    need(sorted(wr) == ["pw_raw", "ps_raw", "sw_wr"] or sorted(wr) == ["ps_raw", "pw_raw", "sw_wr"] or sorted(wr) == ["ps_raw", "pw_raw"], "pump writes outside pw_raw / ps_raw: %s" % wr)
+    for n in wr:
+        if n == "sw_wr":
+            continue
+        b = f[n]
+        need(("M.cl2" in b) == (n == "ps_raw") and (re.search(r"M\.cl\b", b) is not None) == (n == "pw_raw"), "%s uses the wrong client" % n)
+    need("vl_write_ok_m" in f.get("pw_raw", "") and "vl3_enable_ok" in f.get("pw_raw", "") and "vl3b_" not in f.get("pw_raw", ""), "pw_raw does not check the primary's tables only")
+    need("vl3b_write_ok" in f.get("ps_raw", "") and "vl3b_enable_ok" in f.get("ps_raw", "") and "vl_write_ok" not in f.get("ps_raw", "") and "vl3_enable_ok" not in f.get("ps_raw", ""),
+         "ps_raw does not check the secondary's tables only")
+    need("write_word_data" not in f.get("ps_raw", ""), "ps_raw writes words")
+    for n, b in f.items():
+        if n not in ("ps_raw", "vooc_init", "vooc_exit", "gates", "session", "sio_rd", "pump_client", "vooc_probe", "regs_show"):
+            need("M.cl2" not in b, "%s touches the secondary's client" % n)
+    need(len(re.findall(r"0x81", f.get("s3_sec_enable", ""))) == 1 and sum(b.count("ps_raw(REG_CTRL, 1, 0x81") for b in f.values()) == 1, "the secondary's enable value is not written in exactly one place")
+    need(sum(b.count("pw_raw(REG_CTRL, 1, 0x80") for b in f.values()) == 1, "the primary's enable value is not written in exactly one place")
+    need("S.sen_wr" in f.get("s3_sec_enable", "") and "!S.sen_wr" in f.get("s3_sec_enable", "") and "READ_ONCE(S.why)" in f.get("s3_sec_enable", "") and "S.en_wr" in f.get("s3_sec_enable", ""),
+         "s3_sec_enable: once, no end set, primary enabled")
+    need("vl3b_run(" in f.get("sec_post", ""), "sec_post does not run the secondary's logic")
+
+    # 2. both pumps off, the secondary first, raw, with no firmware call
+    p = f.get("pump_off_now", "")
+    need(0 <= p.find("ps_raw(REG_CTRL, 1, 0x01") < p.find("pw_raw(REG_CTRL, 1, 0x00"), "pump_off_now: the secondary's off must come first, then the primary's")
+    need(not re.search(r"fw_set|psv\(|power_supply_|qcom_battmgr|msleep|wait_event|flush_work", p), "pump_off_now calls firmware or sleeps")
+    need("mutex_lock(&M.pws)" in p and "mutex_lock(&M.pw)" in p and p.find("mutex_unlock(&M.pws)") < p.find("mutex_lock(&M.pw)"), "pump_off_now: the two mutexes are nested")
+    need("pump_off_now()" in f.get("set_end", ""), "set_end does not switch the pumps off")
+
+    # 3. nothing in the IRQ thread blocks in the firmware
+    for n in ("vooc_irq", "s3_tx", "s3_after", "s3_post", "sec_post", "check_pump", "s3_enable", "s3_sec_enable", "pw", "ps", "pw_raw", "ps_raw", "set_end", "pump_off_now", "sio_wr", "sio_rd", "sio_en", "sio_stop"):
+        need(n in f, "function %s not found" % n)
+        need(not re.search(r"fw_set|psv\(|power_supply_|qcom_battmgr|msleep|wait_event|flush_work|hold_release", f.get(n, "")), "%s (IRQ thread) calls firmware or sleeps" % n)
+
+    # 4. the charger hold: requested only through fw_set, released on every way out once requested; charge_behaviour is only read
+    need(sum(b.count("qcom_battmgr_oplus_pump_hold(") for b in f.values()) == 1 and "qcom_battmgr_oplus_pump_hold(" in f.get("fw_set", ""), "pump_hold is not called from fw_set only")
+    need(sum(b.count("qcom_battmgr_oplus_battery_authentic(") for b in f.values()) == 1 and "qcom_battmgr_oplus_battery_authentic(" in f.get("gates3", ""), "authentic is not read in gates3 only")
+    need(not re.search(r"power_supply_set_property\([^)]*CHARGE_BEHAVIOUR", src), "charge_behaviour is written")
+    need("FW_BEH" not in src, "FW_BEH rows are still in the C file")
+    s = f.get("s3_sample", "")
+    need(0 <= s.find("S.out_sent = true") < s.find("fw_set(FW_HOLD, FW_HOLD_ON"), "s3_sample: out_sent must be set before the hold is requested")
+    fe = f.get("fw_exit", "")
+    need("flush_work(&S.mon)" in fe and re.search(r"if \(S\.out_sent\)\s+S\.fw_out_rc = fw_set\(FW_HOLD, FW_HOLD_OFF", fe) and fe.find("FW_HOLD_OFF") < fe.find("FW_ICL_UNSUSPEND"),
+         "fw_exit: flush the monitor, release the hold if it was requested, then the input unsuspend")
+    need("fw_exit()" in f.get("exit_path", ""), "exit_path does not run fw_exit")
+    need(re.search(r"S\.out_sent && S\.fw_out_rc", f.get("vooc_exit", "")) and "hold_release()" in f.get("vooc_exit", ""), "vooc_exit does not retry a failed release")
+    need("hold_release()" in f.get("release_write", ""), "debugfs release is missing")
+    # the guard
+    need("vl3_guard(" in f.get("s3_sample", "") and "CHARGE_BEHAVIOUR" in f.get("s3_sample", ""), "s3_sample does not read charge_behaviour")
+    # every way out of the session runs the exit path
+    need("exit_path()" in f.get("session", ""), "session does not run exit_path")
+    # exit path: both pumps, offs confirmed before rows
+    e = f.get("exit_path", "")
+    need(0 <= e.find("vl3_off_confirm(&sec_io") < e.find("vl3_off_confirm(&lad_io") < e.find("vl3b_ladder_rows(&sec_io") < e.find("vl3_ladder_rows(&lad_io"), "exit_path: both offs confirmed (secondary first) before the rows")
+    # the secondary's init sits after the primary's rows and before the irq / handshake
+    se = f.get("session", "")
+    need(0 <= se.find("vl_init_rows[i]") < se.find("vl3b_init(&sec_io)") < se.find("request_threaded_irq") < se.find("vl_handshake"), "session: init order primary, secondary, irq, handshake")
+
+    # 5. stage 4: the ask, the workqueue, the wakeup source, the auto start
+    irq = f.get("vooc_irq", "")
+    need("S.r3.ask4 = READ_ONCE(S.ask);" in irq, "vooc_irq does not read the ask with READ_ONCE")
+    need("S.r3.lim4 = READ_ONCE(S.lim);" in irq, "vooc_irq does not read the limit's ask with READ_ONCE")
+    need(sorted(n for n, b in f.items() if re.search(r"WRITE_ONCE\(S\.lim|S\.lim\s*=[^=]", b)) == ["ask_step", "session"], "S.lim is written outside ask_step / session")
+    need("WRITE_ONCE(S.lim, S.v4.lim)" in f.get("ask_step", "") and "WRITE_ONCE(S.lim, S.v4.lim)" in f.get("session", ""), "S.lim: ask_step and session() set it")
+    need(sorted(n for n, b in f.items() if "S.ask" in b and re.search(r"WRITE_ONCE\(S\.ask|S\.ask\s*=[^=]", b)) == ["ask_step", "session"], "S.ask is written outside ask_step / session")
+    need(not any(re.search(r"S\.ask\s*=[^=]", b) for b in f.values()), "S.ask is written without WRITE_ONCE")
+    sm = f.get("s3_sample", "")
+    need(0 <= sm.find("vl3_bat(") < sm.find("ask_step()") and "POWER_SUPPLY_PROP_CAPACITY" in sm, "s3_sample: the SoC is read and ask_step() runs after vl3_bat()")
+    need("vl4_read(&S.v4" in f.get("ask_step", "") and "WRITE_ONCE(S.ask, S.v4.ask)" in f.get("ask_step", "") and "pr_info(\"ask " in f.get("ask_step", ""), "ask_step: vl4_read, WRITE_ONCE, the log line")
+    se = f.get("session", "")
+    need(all(x in se for x in ("vl4_init(&S.v4", "vl4_setup(&S.r3", "vl4_bs_setup(&S.bs)", "queue_work(M.q, &S.mon)", "arm = false;", "summary(log)")), "session: the stage 4 setup")
+    need("vl4_next(S.pump_wr || S.sec_wr, S.sw_wr) == V4N_RECHECK" in se and "vl4_new_refusal(M.last_why" in se and "auto_start && M.from_arm" in se, "session: the refusal decision")
+    need(not re.search(r"system_\w*wq", src), "a system workqueue is used")
+    need("tick3" in f and "vl4_session_ms()" in f["tick3"] and "c.stage4 = STAGE4" in f["tick3"], "tick3: the stage 4 clock")
+    need("cap_100ma, STAGE4 }" in f.get("gates3", ""), "gates3 does not pass stage4 to the gate")
+    wf = f.get("work_fn", "")
+    need(wf.count("__pm_stay_awake(M.ws)") == 2 and wf.count("__pm_relax(M.ws)") == 2 and wf.find("__pm_stay_awake(M.ws)") < wf.find("wait_event_timeout") < wf.find("session();") < wf.rfind("__pm_relax(M.ws)"),
+         "work_fn: the wakeup source is held on every path around session()")
+    need(wf.find("__pm_stay_awake(M.ws)", wf.find("} else {")) > wf.find("} else {") > 0 and wf.find("__pm_relax(M.ws)") < wf.find("return;", wf.find("M.unloading) {")), "work_fn: the wakeup source on the manual path and the unload path")
+    need(len(re.findall(r"\barm = true;", wf)) == 2 and sum(len(re.findall(r"\barm = true;", b)) for b in f.values()) == 2, "arm is set true outside work_fn (twice there: the unplug and the unused plug-in)")
+    need(re.search(r"if \(auto_start && vl4_rearm\(online, ms\)\)\s+arm = true;", wf) and "vl4_recheck_due(ms)" in wf and "M.refused = false;" in wf and "msecs_to_jiffies(M.refused ? V4_RECHECK_MS : V4_REARM_MS)" in wf and
+         re.search(r"if \(M\.refused\)\s+arm = true;", wf), "work_fn: the unplug and the recheck rules")
+    need("(arm || auto_start)" in f.get("psy_event", "") and "queue_work(M.q" in f.get("psy_event", "") and "rearm_fn" in f and "queue_work(M.q, &M.work)" in f["rearm_fn"], "psy_event / rearm_fn")
+    need("n++ % 10" in f.get("mon_fn", "") and "run_lines();" in f.get("mon_fn", ""), "mon_fn: stage 4 logs every 10 s")
+    sf = f.get("summary", "")
+    need('pr_info("end: %s' in sf and "S.exit_fail || (S.sw_wr && !S.mux_ok)" in sf and "pr_err(" in sf, "summary: the end reason and a failed exit reach the kernel log")
+    vi = f.get("vooc_init", "")
+    need(all(x in vi for x in ("alloc_workqueue(", "wakeup_source_register(", "arm |= auto_start;", "pumps = 2;", "vl4_params(", "vl4_auto_params(", "destroy_workqueue(M.q);", "wakeup_source_unregister(M.ws);")) and
+         re.search(r"if \(auto_start && !atomic_cmpxchg\(&M\.busy, 0, 1\)\) \{\s+M\.from_arm = true;\s+queue_work\(M\.q, &M\.work\);", vi) and
+         all(("%s = vl4_default(" % n) in vi for n in ("cap_100ma", "hold_s", "soc_min", "soc_max", "temp_min", "temp_max")), "vooc_init: queue, wakeup source, defaults, auto")
+    ve = f.get("vooc_exit", "")
+    need(0 <= ve.find("debugfs_remove_recursive") < ve.find("power_supply_unreg_notifier") < ve.find("cancel_work_sync(&M.work)") < ve.find("destroy_workqueue(M.q)") < ve.find("wakeup_source_unregister(M.ws)") and
+         ve.count("cancel_delayed_work_sync(&M.rearm)") == 2, "vooc_exit: order of the teardown")
+    return bad
+
+
+if __name__ == "__main__":
+    path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, "..", "iceland_supervooc.c")
+    v = check(open(path).read())
+    for x in v:
+        print("FAIL construction:", x)
+    print("PASS: construction rules" if not v else "FAIL: %d construction rules" % len(v))
+    sys.exit(1 if v else 0)
