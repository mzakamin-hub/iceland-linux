+static void summary(bool log)
+{
+	static const int edge[] = { 400, 600, 800, 1000, 1500, 1900 };
+	int us[MAXEV], bk[ARRAY_SIZE(edge) + 1] = {}, n = 0, i, j, len = 0;
+	char *p = S.sum;
+	size_t sz = sizeof(S.sum);
+
+	for (i = 0; i < min(S.nev, MAXEV); i++)
+		if (S.ev[i].tx && S.ev[i].us) {
+			us[n++] = S.ev[i].us;
+			for (j = 0; j < ARRAY_SIZE(edge) && S.ev[i].us >= edge[j]; j++)
+				;
+			bk[j]++;
+		}
+	sort(us, n, sizeof(int), cmp_us, NULL);
+
+	len += scnprintf(p + len, sz - len, KBUILD_MODNAME " stage %u summary\n", stage);
+	len += scnprintf(p + len, sz - len, "end: %s\n", S.why ?: "none");
+	len += scnprintf(p + len, sz - len, "exit: pump %s, D+/D- %s\n",
+			 !S.pump_wr ? "never written" : S.exit_fail ? "EXIT WRITES FAILED" : "exit rows done",
+			 !S.sw_wr ? "never switched" : S.mux_ok ? "restored" : "RESTORE FAILED");
+	len += scnprintf(p + len, sz - len, "gates: battery %d.%d C %d mV %d %%, usb online %d type %d %d mV\n",
+			 S.bat_t / 10, abs(S.bat_t % 10), S.bat_mv, S.bat_soc, S.usb_online, S.usb_type, S.usb_mv);
+	len += scnprintf(p + len, sz - len, "frames: %d answered, %d received (irq events %d), adapter id: 0x%02x\n",
+			 S.nreply, S.nframes, S.nev, S.vl.model);
+	len += scnprintf(p + len, sz - len, "identification code rl=%u rh=%u (adapter check %s)\n", S.vl.rl, S.vl.rh,
+			 (S.vl.seen & 4) ? "ok" : "not completed");
+	len += scnprintf(p + len, sz - len, "VBUS ADC mV: min %d max %d (%d reads)\n", S.nadc ? S.vmin : 0,
+			 S.nadc ? S.vmax : 0, S.nadc);
+	len += scnprintf(p + len, sz - len, "PHY flags seen (OR): 0x%02x\n", S.flags_or);
+	if (STAGE3)
+		len += summary3(p + len, sz - len);
+	if (n)
+		len += scnprintf(p + len, sz - len, "reply us (irq thread entry to after TX write): n=%d min %d median %d p99 %d max %d\n",
+				 n, us[0], us[n / 2], us[min(n - 1, n * 99 / 100)], us[n - 1]);
+	len += scnprintf(p + len, sz - len, "buckets: <400:%d <600:%d <800:%d <1000:%d <1500:%d <1900:%d >=1900:%d\n",
+			 bk[0], bk[1], bk[2], bk[3], bk[4], bk[5], bk[6]);
+	len += scnprintf(p + len, sz - len, "events: n rx tx flags us\n");
+	for (i = 0; i < min(S.nev, MAXEV); i++)
+		len += scnprintf(p + len, sz - len, "%2d %s 0x%02x %s 0x%04x 0x%02x %d\n", i + 1, S.ev[i].frame ? "rx" : "--",
+				 S.ev[i].rx, S.ev[i].tx ? "tx" : "--", S.ev[i].tx, S.ev[i].fl, S.ev[i].us);
+	if (S.nev > MAXEV)
+		len += scnprintf(p + len, sz - len, "(%d more events not recorded)\n", S.nev - MAXEV);
+	if (!log)
+		return;
+	pr_info("end: %s\n", S.why ?: "none");
+	if (S.exit_fail || (S.sw_wr && !S.mux_ok) || (S.out_sent && S.fw_out_rc) || (S.icl_sent && S.fw_in_rc))
+		pr_err("the exit did not complete (pump exit steps failed %d, D+/D- %s, hold release rc %d, input unsuspend rc %d): see the debugfs summary\n",
+		       S.exit_fail, !S.sw_wr || S.mux_ok ? "ok" : "NOT restored", S.out_sent ? S.fw_out_rc : 0, S.icl_sent ? S.fw_in_rc : 0);
+}
