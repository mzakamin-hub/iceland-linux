+/* firmware requests: one function, its own table (vl3_fwl); process context only. The hold is the kernel patch's, not charge_behaviour (user space's) */
+static int fw_set(u8 prop, int val, u8 phase)
+{
+	union power_supply_propval v = { .intval = val };
+	struct power_supply *p = prop == FW_ICL ? S.usb : S.bat;
+
+	if (!vl3_fw_ok(prop, val, phase, mode)) {
+		pr_err("refused firmware request prop %u = %d (phase %u)\n", prop, val, phase);
+		return -EPERM;
+	}
+	if (!p)
+		return -ENODEV;
+	if (prop == FW_HOLD)
+		return qcom_battmgr_oplus_pump_hold(p, val == FW_HOLD_ON);
+	return power_supply_set_property(p, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &v);
+}
+
+/* a hold that outlived its session (a failed release, or the debugfs file): needs the battery supply outside a session */
+static int hold_release(void)
+{
+	struct power_supply *b = power_supply_get_by_name("qcom-battmgr-bat");
+	int ret;
+
+	if (!b)
+		return -ENODEV;
+	S.bat = b;
+	ret = fw_set(FW_HOLD, FW_HOLD_OFF, FWP_EXIT);
+	S.bat = NULL;
+	power_supply_put(b);
+	return ret;
+}
+
+/*
+ * Connector temperature in whole C: the highest of what mainline exposes. Stock's USB-connector NTC (usb_con_therm_adc) is zone
+ * usb-therm-thermal; stock's connector protection reads usb_temp_l / usb_temp_r, zones usb-temp-l / usb-temp-r; the firmware's USB
+ * temperature comes through qcom-battmgr-usb (unit not verified: never the only source). Stock's battery-connector NTC
+ * (batt_con_therm_adc) has no mainline source.
+ * ponytail: thermal_zone_get_zone_by_name() takes no reference here (no put exists); the zones are static device-tree zones.
+ */
+static int conn_temp_c(void)
+{
+	static const char * const zone[] = { "usb-therm-thermal", "usb-temp-l-thermal", "usb-temp-r-thermal" };
+	int best = V3_NO_CONN, mc, t;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(zone); i++) {
+		struct thermal_zone_device *tz = thermal_zone_get_zone_by_name(zone[i]);
+
+		if (!IS_ERR(tz) && !thermal_zone_get_temp(tz, &mc))
+			best = max(best, mc / 1000);
+	}
+	if (S.usb && !psv(S.usb, POWER_SUPPLY_PROP_TEMP, &t))
+		best = max(best, t / 10);
+	return best;
+}
+
+/* the powered stages' start gates on top of the handshake's; reads only */
+static int gates3(void)
+{
+	struct vl3_g g = { S.bat_soc, S.bat_t, S.bat_mv, conn_temp_c(), soc_min, soc_max, temp_min, temp_max, conn_max_c, cap_100ma, STAGE4 };
+	const char *why = vl3_gate(&g);
+	int icl = -1, beh = -1;
+
+	S.conn_c = g.conn_c;
+	if (why) {
+		fail("gate: %s", why);
+		return -EINVAL;
+	}
+	if (psv(S.usb, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &icl) || psv(S.bat, POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &beh)) {
+		fail("gate: input_current_limit / charge_behaviour not readable");
+		return -EINVAL;
+	}
+	if (!icl || beh != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) {
+		fail("gate: input already suspended (%d) or charge_behaviour not auto (%d)", icl, beh);
+		return -EINVAL;
+	}
+	S.auth = qcom_battmgr_oplus_battery_authentic(S.bat);
+	S.auth_read = true;
+	if (!vl3_auth_ok(S.auth, auth_gate)) {
+		fail("gate: battery authentication reads %d, auth_gate needs 1", S.auth);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+/*
+ * Stage 4, monitor only: one gauge read through the ask rules (vl4_read). The only writer of S.ask once the session runs; every change
+ * is logged once with its reason and the readings that caused it.
+ */
+static int ask_step(void)
+{
+	int tdie = max(READ_ONCE(S.r3.tdie_max), READ_ONCE(S.r3.s.tdie_max)), rc, i;
+	u8 old = S.v4.ask;
+
+	rc = vl4_read(&S.v4, S.bat_soc, S.bat_mv, tdie);
+	if (S.v4.lim != S.lim)
+		WRITE_ONCE(S.lim, S.v4.lim);
+	for (i = 0; i < S.v4.nchg; i++) {
+		pr_info("ask %u -> %u x 100 mA (%s) at +%d ms: gauge SoC %d %% %d mV, TDIE max %d.%d C\n", old, S.v4.new_ask[i], vl4_ask_why(S.v4.why[i]),
+			ms_since_t0(), S.bat_soc, S.bat_mv, tdie / 10, tdie % 10);
+		old = S.v4.new_ask[i];
+	}
+	if (S.v4.nchg) {
+		WRITE_ONCE(S.ask, S.v4.ask);
+		if (S.nasks < ARRAY_SIZE(S.asks)) {
+			S.asks[S.nasks].ask = S.v4.ask;
+			S.asks[S.nasks++].ms = ms_since_t0();
+		}
+	}
+	if (rc)
+		set_end(vl4_why(rc));
+	return rc;
+}
+
+/* one 1 s tick of the battery monitor (process context, may block in the firmware) */
+static int s3_sample(void)
+{
+	int uv = 0, ma = 0, t = 0, soc = S.bat_soc, beh = -1, rc;
+	bool fresh;
+
+	rc = vl3_guard(psv(S.bat, POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &beh), beh);
+	if (rc) {
+		set_end(vl3_bat_why(rc));
+		return rc;
+	}
+	rc = psv(S.bat, POWER_SUPPLY_PROP_VOLTAGE_NOW, &uv) ?: psv(S.bat, POWER_SUPPLY_PROP_CURRENT_NOW, &ma) ?: psv(S.bat, POWER_SUPPLY_PROP_TEMP, &t) ?:
+	     (STAGE4 ? psv(S.bat, POWER_SUPPLY_PROP_CAPACITY, &soc) : 0);
+	fresh = !rc;
+	S.conn_c = conn_temp_c();
+	if (!rc) {
+		S.bat_soc = soc;
+		S.bat_mv = uv / 1000;
+		S.bat_ma = ma / 1000;
+		S.bat_t = t;
+		S.bat_n++;
+		S.ibat_max = max(S.ibat_max, S.bat_ma);
+		WRITE_ONCE(S.bat_ok, ktime_get());
+	}
+	if (S.conn_c != V3_NO_CONN) {
+		S.conn_min = min(S.conn_min, S.conn_c);
+		S.conn_max = max(S.conn_max, S.conn_c);
+	}
+	rc = vl3_bat(&S.bs, ktime_ms_delta(ktime_get(), READ_ONCE(S.bat_ok)), S.bat_t, S.bat_mv, S.bat_ma, S.conn_c, conn_max_c);
+	if (rc) {
+		set_end(vl3_bat_why(rc));
+		return rc;
+	}
+	if (STAGE4 && fresh && ask_step())
+		return -ECANCELED;
+	if (vl3_out_due(S.bat_ma, S.r3.enabled, S.out_sent)) {
+		S.out_sent = true;	/* before the request: a failed one is released too */
+		S.fw_hold_rc = fw_set(FW_HOLD, FW_HOLD_ON, FWP_RUN);
+		if (S.fw_hold_rc) {
+			fail("charger hold request failed (%d)", S.fw_hold_rc);
+			return -EIO;
+		}
+	}
+	return 0;
+}
+
+static void run_lines(void)
+{
+	if (READ_ONCE(S.r3.enabled))
+		pr_debug("run +%d ms: VBUS %d VBAT %d mV IBUS %d mA TDIE %d.%d C | battery %d mA %d mV %d.%d C connector %d C | 0x06 %#04x 0x07 %#04x 0x09 %#04x 0x0d %#04x 0x0e %#04x 0x0f %#04x | max reply %d us\n",
+			ms_since_t0() - S.en_ms, S.r3.adc.vbus, S.r3.adc.vbat, S.r3.adc.ibus, S.r3.adc.tdie / 10, S.r3.adc.tdie % 10, S.bat_ma, S.bat_mv, S.bat_t / 10,
+			abs(S.bat_t % 10), S.conn_c, S.blk[6], S.blk[7], S.blk[9], S.blk[13], S.blk[14], S.blk[15], S.us_max);
+	if (READ_ONCE(S.r3.s.enabled))
+		pr_debug("  secondary: IBUS %d mA TDIE %d.%d C | total %d mA | 0x06 %#04x 0x07 %#04x 0x09 %#04x 0x0d %#04x 0x0e %#04x 0x0f %#04x\n",
+			S.r3.s.adc.ibus, S.r3.s.adc.tdie / 10, S.r3.s.adc.tdie % 10, S.r3.adc.ibus + S.r3.s.adc.ibus, S.r3.s.blk[6], S.r3.s.blk[7],
+			S.r3.s.blk[9], S.r3.s.blk[13], S.r3.s.blk[14], S.r3.s.blk[15]);
+}
+
+/*
+ * Runs beside the session thread so that no firmware call can stall the clock checks or the frame loop. Order: wait for the first
+ * frame, suspend the buck input, read it back, take the first sample, only then allow the allow bit; then once a second: samples,
+ * limits, the charger hold, one live line.
+ */
+static void mon_fn(struct work_struct *w)
+{
+	int icl = -1, ret, n = 0;
+
+	while (!READ_ONCE(S.why) && !READ_ONCE(S.nframes))
+		wait_event_timeout(M.wq, READ_ONCE(S.why) || READ_ONCE(S.nframes), msecs_to_jiffies(10));
+	if (READ_ONCE(S.why))
+		return;
+	S.icl_sent = true;
+	S.fw_sus_rc = fw_set(FW_ICL, FW_ICL_SUSPEND, FWP_SUSPEND);
+	if (S.fw_sus_rc) {
+		fail("input suspend request failed (%d)", S.fw_sus_rc);
+		return;
+	}
+	ret = psv(S.usb, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &icl);
+	if (ret || icl) {
+		fail("input suspend not confirmed (read back %d, rc %d)", icl, ret);
+		return;
+	}
+	S.ms_susp = ms_since_t0();
+	if (s3_sample())
+		return;
+	WRITE_ONCE(S.r3.suspend_ok, 1);
+	while (!READ_ONCE(S.why)) {
+		wait_event_timeout(M.wq, READ_ONCE(S.why), HZ);
+		if (READ_ONCE(S.why) || s3_sample())
+			break;
+		if (!STAGE4 || !(n++ % 10) || S.v4.nchg)
+			run_lines();
+	}
+	if (STAGE4)
+		run_lines();
+}
+
+/* the 10 ms tick of the session thread in the powered stages */
+static void tick3(ktime_t now)
+{
+	struct vl3_clk c = {};
+	int rc;
+
+	if (ktime_ms_delta(now, S.t0) > (STAGE4 ? vl4_session_ms() : vl3_session_ms(pumps))) {
+		set_end(STAGE4 ? "session longer than 4530 s" : PUMPS2 ? "session longer than 630 s" : "session longer than 330 s");
+		return;
+	}
+	if (READ_ONCE(S.r3.suspend_ok) && ktime_ms_delta(now, READ_ONCE(S.bat_ok)) > V3_LIM_BAT_AGE_MS) {
+		set_end(vl3_bat_why(V3B_STALE));
+		return;
+	}
+	c.now = ktime_ms_delta(now, S.t0);
+	c.t_hs = ktime_ms_delta(S.t_hs, S.t0);
+	c.t_last = ktime_ms_delta(READ_ONCE(S.t_last), S.t0);
+	c.t_en = READ_ONCE(S.en_ms);
+	c.frames = READ_ONCE(S.nframes) > 0;
+	c.i600 = READ_ONCE(S.r3.i600);
+	c.hold_ms = hold_s * 1000;
+	c.long_hold = PUMPS2;
+	c.stage4 = STAGE4;
+	rc = vl3_time(&c);
+	if (rc)
+		set_end(vl3_time_why(rc));
+}
+
+/* every gate reads only; a failed gate leaves the pump and the switch unwritten */
+static int gates(void)
+{
+	struct power_supply *bat = power_supply_get_by_name("qcom-battmgr-bat");
+	struct power_supply *usb = power_supply_get_by_name("qcom-battmgr-usb");
+	struct device_node *np;
+	struct i2c_client *c = NULL;
+	int uv = 0, id, ctl, ret = -EINVAL, id2, c06, c07;
+
+	if (!bat || !usb) {
+		fail("gate: power supply qcom-battmgr-%s missing", bat ? "usb" : "bat");
+		goto out;
+	}
+	if (STAGE3) {
+		S.bat = bat;
+		S.usb = usb;
+	}
+	if (psv(bat, POWER_SUPPLY_PROP_TEMP, &S.bat_t) || psv(bat, POWER_SUPPLY_PROP_VOLTAGE_NOW, &uv) ||
+	    psv(bat, POWER_SUPPLY_PROP_CAPACITY, &S.bat_soc) || psv(usb, POWER_SUPPLY_PROP_ONLINE, &S.usb_online) ||
+	    psv(usb, POWER_SUPPLY_PROP_USB_TYPE, &S.usb_type) || psv(usb, POWER_SUPPLY_PROP_VOLTAGE_NOW, &S.usb_mv)) {
+		fail("gate: power supply read failed");
+		goto out;
+	}
+	S.bat_mv = uv / 1000;
+	S.usb_mv /= 1000;
+	if (S.bat_t < GATE_T_MIN || S.bat_t > GATE_T_MAX)
+		fail("gate: battery %d.%d C outside %d..%d (0.1 C)", S.bat_t / 10, abs(S.bat_t % 10), GATE_T_MIN, GATE_T_MAX);
+	else if (S.bat_mv < GATE_VBAT_MIN_MV)
+		fail("gate: battery %d mV below %u", S.bat_mv, GATE_VBAT_MIN_MV);
+	else if ((unsigned int)S.bat_soc > GATE_SOC_MAX)
+		fail("gate: SoC %d %% above %u", S.bat_soc, GATE_SOC_MAX);
+	else if (!S.usb_online)
+		fail("gate: usb not online");
+	if (S.why)
+		goto out;
+	if (STAGE3 && gates3())
+		goto out;
+
+	id = i2c_smbus_read_byte_data(M.cl, REG_ID);
+	ctl = i2c_smbus_read_byte_data(M.cl, REG_CTRL);
+	if (id != SC8547D_ID || ctl != 0) {
+		fail("gate: pump id 0x%x (want 0x49), 0x07 = 0x%x (want 0)", id, ctl);
+		goto out;
+	}
+	if (PUMPS2) {
+		id2 = i2c_smbus_read_byte_data(M.cl2, REG_ID);
+		c06 = i2c_smbus_read_byte_data(M.cl2, 0x06);
+		c07 = i2c_smbus_read_byte_data(M.cl2, REG_CTRL);
+		if (id2 != SC8547D_ID || c06 < 0 || c07 < 0 || !vl_pump_idle(c06, c07)) {
+			fail("gate: secondary id 0x%x (want 0x49), 0x06 = %d, 0x07 = %d (want idle: CHG_EN and switching clear)", id2, c06, c07);
+			goto out;
+		}
+	}
+
+	np = of_find_compatible_node(NULL, NULL, USBSS_COMPAT);
+	if (np) {
+		c = i2c_find_device_by_fwnode(of_fwnode_handle(np));
+		of_node_put(np);
+	}
+	S.sw = c ? dev_get_regmap(&c->dev, NULL) : NULL;
+	if (!S.sw) {
+		fail("gate: no regmap for the D+/D- switch (%s)", USBSS_COMPAT);
+		if (c)
+			put_device(&c->dev);
+		goto out;
+	}
+	S.swc = c;
+	if (regmap_read(S.sw, 0x403, &S.sv403) || regmap_read(S.sw, 0x404, &S.sv404)) {
+		fail("gate: D+/D- switch read failed");
+		goto out;
+	}
+	ret = 0;
+out:
+	if (STAGE3 && !ret)
+		return 0;
+	S.bat = S.usb = NULL;
+	if (bat)
+		power_supply_put(bat);
+	if (usb)
+		power_supply_put(usb);
+	return ret;
+}
+
+static void session(void)
+{
+	struct device *busdev = M.adap->dev.parent, *busdev2 = PUMPS2 ? M.adap2->dev.parent : NULL;
+	unsigned int i, rnd;
+	bool log;
+	int ret;
+
+	memset(&S, 0, sizeof(S));
+	get_random_bytes(&rnd, sizeof(rnd));
+	vl_init(&S.vl, rnd, rnd >> 8);
+	arm = false;
+	WRITE_ONCE(M.live, true);
+	if (STAGE3) {
+		vl3_init(&S.r3, cap_100ma, stock_start);
+		INIT_WORK(&S.mon, mon_fn);
+		S.en_ms = S.off_ms = S.allow_ms = S.ms_600 = S.ms_restore = S.ms_susp = -1;
+		S.conn_min = -V3_NO_CONN;
+		S.conn_max = V3_NO_CONN;
+		S.r3.pumps = pumps;
+		S.sen_ms = S.soff_ms = -1;
+	}
+
+	if (gates())
+		goto out;
+	if (STAGE4) {
+		vl4_init(&S.v4, cap_100ma, S.bat_soc);
+		vl4_setup(&S.r3, S.v4.ask);
+		vl4_bs_setup(&S.bs);
+		WRITE_ONCE(S.ask, S.v4.ask);
+		WRITE_ONCE(S.lim, S.v4.lim);
+		S.asks[0].ask = S.v4.ask;
+		S.nasks = 1;
+		S.soc0 = S.bat_soc;
+		S.mv0 = S.bat_mv;
+	}
+	pm_runtime_get_sync(busdev);	/* the first frame comes 0.5 s after the last transfer, past geni's 250 ms autosuspend */
+	if (busdev2)
+		pm_runtime_get_sync(busdev2);
+	cpu_latency_qos_add_request(&S.qos, 400);
+	S.qos_on = true;
+	S.t0 = ktime_get();
+	S.bat_ok = S.t0;
+	pr_info("gates passed (battery %d.%d C %d mV %d %%), starting\n", S.bat_t / 10, abs(S.bat_t % 10), S.bat_mv, S.bat_soc);
+	if (sw_enter())
+		goto exit;
+	msleep(10);	/* stock switches D+/D- 10 ms before the pump init */
+	for (i = 0; i < ARRAY_SIZE(vl_init_rows); i++)
+		if (pw(vl_init_rows[i].reg, vl_init_rows[i].w, vl_init_rows[i].val) < 0)
+			goto exit;
+	if (PUMPS2 && vl3b_init(&sec_io))		/* after the primary's rows, before the handshake, as stock */
+		goto exit;
+	ret = request_threaded_irq(M.irq, NULL, vooc_irq, IRQF_ONESHOT | IRQF_TRIGGER_FALLING, KBUILD_MODNAME, &S);
+	if (ret) {
+		fail("request_irq %d: %d", M.irq, ret);
+		goto exit;
+	}
+	S.irq_on = true;
+	S.t_hs = S.t_last = ktime_get();
+	if (STAGE3)
+		queue_work(M.q, &S.mon);
+	if (pw(vl_handshake.reg, vl_handshake.w, vl_handshake.val) < 0)
+		goto exit;
+
+	while (!READ_ONCE(S.why)) {
+		ktime_t now;
+
+		wait_event_timeout(M.wq, READ_ONCE(S.why) || M.unloading, msecs_to_jiffies(10));
+		now = ktime_get();
+		if (M.unloading)
+			set_end("module unload");
+		else if (STAGE3)
+			tick3(now);
+		else if (ktime_ms_delta(now, S.t0) > LIM_SESSION_MS)
+			set_end("session longer than 30 s");
+		else if (READ_ONCE(S.done)) {
+			if (ktime_ms_delta(now, S.t_done) >= stop_wait_ms)
+				set_end("complete: last battery-model row answered, second 0x04 not answered");
+		} else if (READ_ONCE(S.vl.state) == VL_WAIT) {
+			if (ktime_ms_delta(now, S.t_hs) > LIM_FIRST_MS)
+				set_end("no first frame within 2 s of the handshake");
+		} else if (ktime_ms_delta(now, READ_ONCE(S.t_last)) > LIM_NOFRAME_MS) {
+			set_end("no frame for 200 ms");
+		}
+	}
+exit:
+	exit_path();
+	if (busdev2)
+		pm_runtime_put(busdev2);
+	pm_runtime_put(busdev);
+out:
+	if (S.swc)
+		put_device(&S.swc->dev);
+	S.swc = NULL;
+	if (S.bat)
+		power_supply_put(S.bat);
+	if (S.usb)
+		power_supply_put(S.usb);
+	S.bat = S.usb = NULL;
+	WRITE_ONCE(M.live, false);
+	M.refused = auto_start && M.from_arm && vl4_next(S.pump_wr || S.sec_wr, S.sw_wr) == V4N_RECHECK;
+	log = !M.refused || vl4_new_refusal(M.last_why, S.why ?: "");
+	if (M.refused)
+		strscpy(M.last_why, S.why ?: "", sizeof(M.last_why));
+	else
+		M.last_why[0] = 0;
+	summary(log);
+}
+
+static void work_fn(struct work_struct *w)
+{
+	int online = 0, type = 0;
+
+	if (M.from_arm) {
+		struct power_supply *usb = power_supply_get_by_name("qcom-battmgr-usb");
+		int ms = M.ended ? min_t(s64, ktime_ms_delta(ktime_get(), M.t_end), INT_MAX) : INT_MAX;
+
+		if (usb) {
+			if (psv(usb, POWER_SUPPLY_PROP_ONLINE, &online) || psv(usb, POWER_SUPPLY_PROP_USB_TYPE, &type))
+				online = 0;
+			power_supply_put(usb);
+		}
+		if (auto_start && !online && M.refused) {	/* unplugged: that plug-in is over, the next one logs its first refusal */
+			M.refused = false;
+			M.last_why[0] = 0;
+		}
+		if (auto_start && vl4_rearm(online, ms))
+			arm = true;
+		if (!arm || !online || type != POWER_SUPPLY_USB_TYPE_DCP || (auto_start && M.refused && !vl4_recheck_due(ms))) {
+			atomic_set(&M.busy, 0);
+			return;
+		}
+		__pm_stay_awake(M.ws);
+		wait_event_timeout(M.wq, M.unloading, msecs_to_jiffies(start_delay_ms));
+		if (M.unloading) {
+			__pm_relax(M.ws);
+			atomic_set(&M.busy, 0);
+			return;
+		}
+	} else {
+		__pm_stay_awake(M.ws);
+	}
+	session();
+	M.t_end = ktime_get();
+	M.ended = true;
+	if (auto_start && !READ_ONCE(M.unloading)) {
+		if (M.refused)
+			arm = true;
+		queue_delayed_work(M.q, &M.rearm, msecs_to_jiffies(M.refused ? V4_RECHECK_MS : V4_REARM_MS));
+	}
+	__pm_relax(M.ws);
+	atomic_set(&M.busy, 0);
+}
+
+/* autostart: V4_REARM_MS after a session's end the work reads the usb supply and re-arms only if it is offline (vl4_rearm) */
+static void rearm_fn(struct work_struct *w)
+{
+	if (READ_ONCE(M.unloading))
+		return;
+	if (atomic_cmpxchg(&M.busy, 0, 1)) {
+		queue_delayed_work(M.q, &M.rearm, HZ);
+		return;
+	}
+	M.from_arm = true;
+	queue_work(M.q, &M.work);
+}
+
+static int psy_event(struct notifier_block *nb, unsigned long ev, void *data)
+{
+	struct power_supply *psy = data;
+
+	if ((arm || auto_start) && !strcmp(psy->desc->name, "qcom-battmgr-usb") && !atomic_cmpxchg(&M.busy, 0, 1)) {
+		M.from_arm = true;
+		queue_work(M.q, &M.work);
+	}
+	return NOTIFY_OK;
+}
+
+static ssize_t start_write(struct file *f, const char __user *buf, size_t len, loff_t *pos)
+{
+	bool v;
+	int ret = kstrtobool_from_user(buf, len, &v);
+
+	if (ret)
+		return ret;
+	if (!v)
+		return len;
+	if (atomic_cmpxchg(&M.busy, 0, 1))
+		return -EBUSY;
+	M.from_arm = false;
+	queue_work(M.q, &M.work);
+	return len;
+}
+
+static const struct file_operations start_fops = { .owner = THIS_MODULE, .write = start_write };
+
+/* ends a running session at once (the first thing that happens is the pump off), through the exit ladder */
+static ssize_t stop_write(struct file *f, const char __user *buf, size_t len, loff_t *pos)
+{
+	bool v;
+	int ret = kstrtobool_from_user(buf, len, &v);
+
+	if (ret)
+		return ret;
+	if (!v)
+		return len;
+	if (!READ_ONCE(M.live))
+		return -ENODEV;
+	set_end("stop requested (debugfs)");
+	return len;
+}
+
+static const struct file_operations stop_fops = { .owner = THIS_MODULE, .write = stop_write };
+
+/* ends a charger hold that outlived its session (a crashed module, a failed release); refused while a session runs */
+static ssize_t release_write(struct file *f, const char __user *buf, size_t len, loff_t *pos)
+{
+	bool v;
+	int ret = kstrtobool_from_user(buf, len, &v);
+
+	if (ret)
+		return ret;
+	if (!v)
+		return len;
+	if (atomic_cmpxchg(&M.busy, 0, 1))
+		return -EBUSY;
+	ret = hold_release();
+	atomic_set(&M.busy, 0);
+	pr_info("charger hold release: rc %d\n", ret);
+	return ret ?: len;
+}
+
+static const struct file_operations release_fops = { .owner = THIS_MODULE, .write = release_write };
+
+static ssize_t summary_read(struct file *f, char __user *buf, size_t len, loff_t *pos)
+{
+	const char *s = S.sum[0] ? S.sum : "no session yet\n";
+
+	if (atomic_read(&M.busy))
+		return -EBUSY;
+	return simple_read_from_buffer(buf, len, pos, s, strlen(s));
+}
+
+static const struct file_operations summary_fops = { .owner = THIS_MODULE, .read = summary_read };
+
+/* a register dump for diagnostics; the flag registers (0x06 0x09 0x0d 0x0f) last, reading them may clear them */
+static int regs_show(struct seq_file *m, void *unused)
+{
+	static const u8 regs[] = {
+		0x36, 0x07, 0x00, 0x01, 0x02, 0x04, 0x05, 0x08, 0x10, 0x11, 0x12, 0x21, 0x22, 0x2b, 0x30, 0x33, 0x34,
+		0x3b, 0x3c, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1f, 0x20, 0x0e, 0x06,
+		0x09, 0x0d, 0x0f,
+	};
+	unsigned int i;
+
+	if (atomic_cmpxchg(&M.busy, 0, 1))
+		return -EBUSY;
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		seq_printf(m, "0x%02x = %#x\n", regs[i], (unsigned int)i2c_smbus_read_byte_data(M.cl, regs[i]));
+	atomic_set(&M.busy, 0);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(regs);
+
+static int vooc_probe(struct i2c_client *c)
+{
+	if (PUMPS2 && c->adapter == M.adap2)	/* the secondary: bound only to hold the client; its interrupt is never requested */
+		return 0;
+	if (c->adapter != M.adap)
+		return -ENODEV;
+	if (c->irq <= 0)
+		return dev_err_probe(&c->dev, -ENXIO, "no interrupt resolved from the device tree node\n");
+	M.irq = c->irq;
+	return 0;
+}
+
+static const struct of_device_id vooc_of[] = { { .compatible = "southchip,sc8547d" }, {} };
+static const struct i2c_device_id vooc_id[] = { { "sc8547d" }, {} };
+
+static struct i2c_driver vooc_drv = {
+	.driver = { .name = KBUILD_MODNAME, .of_match_table = vooc_of },
+	.probe = vooc_probe,
+	.id_table = vooc_id,
+};
+
+/*
+ * The charger@6a node under the given bus node (never its twin on the other bus), its adapter and a client made from the disabled node.
+ * ponytail: the module instantiates the client from the disabled node; the in-tree version flips the node to okay.
+ */
+static int pump_client(const char *parent, struct i2c_adapter **adap, struct i2c_client **cl)
+{
+	struct device_node *np, *par = NULL;
+	struct i2c_board_info info;
+	int ret;
+
+	for_each_compatible_node(np, NULL, "southchip,sc8547d") {
+		par = of_get_parent(np);
+		if (par && !strcmp(kbasename(par->full_name), parent))
+			break;
+		of_node_put(par);
+		par = NULL;
+	}
+	if (!np) {
+		pr_err("no southchip,sc8547d node under %s\n", parent);
+		return -ENODEV;
+	}
+	*adap = of_get_i2c_adapter_by_node(par);
+	of_node_put(par);
+	if (!*adap) {
+		of_node_put(np);
+		return -ENODEV;
+	}
+	ret = of_i2c_get_board_info(&(*adap)->dev, np, &info);
+	of_node_put(np);
+	if (!ret) {
+		*cl = i2c_new_client_device(*adap, &info);
+		ret = PTR_ERR_OR_ZERO(*cl);
+	}
+	if (ret) {
+		*cl = NULL;
+		i2c_put_adapter(*adap);
+		*adap = NULL;
+	}
+	return ret;
+}
+
+static int __init vooc_init(void)
+{
+	const char *bad;
+	int ret;
+
+	if (cap_100ma == UNSET_U)
+		cap_100ma = vl4_default(stage, V4D_CAP);
+	if (hold_s == UNSET_U)
+		hold_s = vl4_default(stage, V4D_HOLD);
+	if (soc_min == UNSET_U)
+		soc_min = vl4_default(stage, V4D_SOC_MIN);
+	if (soc_max == UNSET_U)
+		soc_max = vl4_default(stage, V4D_SOC_MAX);
+	if (temp_min == UNSET_I)
+		temp_min = vl4_default(stage, V4D_T_MIN);
+	if (temp_max == UNSET_I)
+		temp_max = vl4_default(stage, V4D_T_MAX);
+	bad = STAGE4 ? vl4_params(cap_100ma, hold_s, conn_max_c) : vl3_params2(stage, pumps, cap_100ma, hold_s, conn_max_c);
+	if (!bad)
+		bad = vl4_auto_params(stage, auto_start);
+	if (!bad && STAGE3 && (soc_min > soc_max || temp_min > temp_max))
+		bad = "start window: minimum above maximum";
+	if (bad) {
+		pr_err("refused to load: %s\n", bad);
+		return -EINVAL;
+	}
+	if (STAGE4)
+		pumps = 2;
+	BUILD_BUG_ON(V3_BEH_AUTO != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO);
+	mode = VM_S2 | (STAGE3 ? VM_S3 | (stock_start ? VM_S3S : 0) | (PUMPS2 ? VM_S3B : 0) : 0);
+	mutex_init(&M.pw);
+	mutex_init(&M.pws);
+	spin_lock_init(&M.lk);
+	init_waitqueue_head(&M.wq);
+	INIT_WORK(&M.work, work_fn);
+	INIT_DELAYED_WORK(&M.rearm, rearm_fn);
+	M.nb.notifier_call = psy_event;
+	M.ws = wakeup_source_register(NULL, KBUILD_MODNAME);
+	if (!M.ws)
+		return -ENOMEM;
+	M.q = alloc_workqueue(KBUILD_MODNAME, WQ_UNBOUND, 0);
+	if (!M.q) {
+		ret = -ENOMEM;
+		goto ws;
+	}
+	arm |= auto_start;
+
+	ret = i2c_add_driver(&vooc_drv);
+	if (ret)
+		goto wq;
+	ret = pump_client(PUMP_NODE_PARENT, &M.adap, &M.cl);
+	if (ret)
+		goto del;
+	if (PUMPS2) {
+		ret = pump_client(PUMP_NODE_PARENT2, &M.adap2, &M.cl2);
+		if (ret)
+			goto unreg;
+	}
+	if (!M.cl->dev.driver || !M.irq || (PUMPS2 && !M.cl2->dev.driver)) {
+		pr_err("client %s%s did not bind (probe deferred or refused)\n", dev_name(&M.cl->dev), PUMPS2 ? " or the secondary's" : "");
+		ret = -ENODEV;
+		goto unreg2;
+	}
+	M.dir = debugfs_create_dir(KBUILD_MODNAME, NULL);
+	debugfs_create_file("start", 0200, M.dir, NULL, &start_fops);
+	debugfs_create_file("stop", 0200, M.dir, NULL, &stop_fops);
+	debugfs_create_file("release", 0200, M.dir, NULL, &release_fops);
+	debugfs_create_file("summary", 0444, M.dir, NULL, &summary_fops);
+	debugfs_create_file("regs", 0444, M.dir, NULL, &regs_fops);
+	ret = power_supply_reg_notifier(&M.nb);
+	if (ret)
+		goto rm;
+	/* autostart: a charger already plugged in at load (boot) sends no event: look once now */
+	if (auto_start && !atomic_cmpxchg(&M.busy, 0, 1)) {
+		M.from_arm = true;
+		queue_work(M.q, &M.work);
+	}
+	pr_info("stage %u, pumps %u, autostart %d\n", stage, pumps, auto_start);
+	return 0;
+rm:
+	debugfs_remove_recursive(M.dir);
+unreg2:
+	if (PUMPS2) {
+		i2c_unregister_device(M.cl2);
+		i2c_put_adapter(M.adap2);
+	}
+unreg:
+	i2c_unregister_device(M.cl);
+	i2c_put_adapter(M.adap);
+del:
+	i2c_del_driver(&vooc_drv);
+wq:
+	destroy_workqueue(M.q);
+ws:
+	wakeup_source_unregister(M.ws);
+	return ret;
+}
+
+static void __exit vooc_exit(void)
+{
+	debugfs_remove_recursive(M.dir);	/* first: no start can queue work behind the workqueue's destruction */
+	power_supply_unreg_notifier(&M.nb);
+	M.unloading = true;
+	wake_up(&M.wq);
+	cancel_delayed_work_sync(&M.rearm);
+	cancel_work_sync(&M.work);	/* a running session ends through its exit path first */
+	cancel_delayed_work_sync(&M.rearm);
+	destroy_workqueue(M.q);
+	if (STAGE3 && S.out_sent && S.fw_out_rc)
+		pr_info("charger hold release retried at unload: rc %d\n", hold_release());
+	if (PUMPS2) {
+		i2c_unregister_device(M.cl2);
+		i2c_put_adapter(M.adap2);
+	}
+	i2c_unregister_device(M.cl);
+	i2c_del_driver(&vooc_drv);
+	i2c_put_adapter(M.adap);
+	wakeup_source_unregister(M.ws);
+}
+
+module_init(vooc_init);
+module_exit(vooc_exit);
+MODULE_DESCRIPTION("SUPERVOOC charging for the OnePlus Pad 4: the VOOC protocol and the two SC8547D charge pumps");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/iceland-supervooc/patches/0001-arm64-dts-qcom-kaanapali-oneplus-iceland-enable-the-charge-pump-buses.patch b/drivers/power/supply/iceland-supervooc/patches/0001-arm64-dts-qcom-kaanapali-oneplus-iceland-enable-the-charge-pump-buses.patch
new file mode 100644
index 0000000000000..3595bf96c85f0
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/patches/0001-arm64-dts-qcom-kaanapali-oneplus-iceland-enable-the-charge-pump-buses.patch
@@ -0,0 +1,68 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: dappermint <198710911+dappermint@users.noreply.github.com>
+Date: Thu, 12 Nov 2026 02:10:00 +0400
+Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: enable the
+ charge pump buses
+
+The two SC8547D charge pumps sit at 0x6a on i2c12 (i2c@890000, the
+secondary pump) and on i2c_hub_0 (i2c@980000, the primary pump). The
+queue describes both chips but leaves both buses disabled. Enable the
+two buses so that /dev/i2c-N exists for each of them, for a read-only
+identification of the chips from user space before any driver exists.
+
+Both charger@6a nodes stay disabled, so no driver binds to address 0x6a
+and the kernel itself sends nothing on either bus. What changes at run
+time is that each bus's default pin state is applied (gpio66 / gpio67
+for i2c_hub_0 and gpio208 / gpio209 for i2c12: i2c function, 2 mA,
+pull-up, the settings of stock's active state) and the serial engines
+are set up at 400 kHz. The hub wrapper (i2c_master_hub) is already
+enabled for i2c_hub_1. The interrupt pins gpio0 and gpio3 are not
+touched.
+
+Link: https://github.com/mzakamin-hub/iceland-linux/issues/2
+Based-on: DocZ13's identification test, which enables the same two buses
+ in a test DTB (iceland-pps-handover, GPL-2.0)
+---
+ .../dts/qcom/kaanapali-oneplus-iceland.dts | 14 ++++++++++----
+ 1 file changed, 10 insertions(+), 4 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+index d115515739de..64cbed74b440 100644
+--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
++++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+@@ -1437,12 +1437,15 @@
+ 
+ /*
+  * The secondary SC8547D 2:1 charge pump of the VOOC / SuperVOOC path (stock:
+- * sc8547-charger-slave@6A on qupv3_se12_i2c, 400 kHz, IRQ on gpio3). Only
+- * described: the bus stays disabled and no driver binds to the chip.
++ * sc8547-charger-slave@6A on qupv3_se12_i2c, 400 kHz, IRQ on gpio3). The
++ * bus is enabled so that /dev/i2c-N exists for read-only tests; the chip
++ * node stays disabled, so no driver binds to it.
+  */
+ &i2c12 {
+ 	clock-frequency = <400000>;
+ 
++	status = "okay";
++
+ 	sc8547d_secondary: charger@6a {
+ 		compatible = "southchip,sc8547d";
+ 		reg = <0x6a>;
+@@ -1481,12 +1484,15 @@
+ 
+ /*
+  * The primary SC8547D 2:1 charge pump, also the VOOC / UFCS PHY (stock:
+- * oplus,sc8547d@6A on qupv3_hub_i2c0, 400 kHz, IRQ on gpio0). Only
+- * described: the bus stays disabled and no driver binds to the chip.
++ * oplus,sc8547d@6A on qupv3_hub_i2c0, 400 kHz, IRQ on gpio0). The bus is
++ * enabled so that /dev/i2c-N exists for read-only tests; the chip node
++ * stays disabled, so no driver binds to it.
+  */
+ &i2c_hub_0 {
+ 	clock-frequency = <400000>;
+ 
++	status = "okay";
++
+ 	sc8547d_primary: charger@6a {
+ 		compatible = "southchip,sc8547d";
+ 		reg = <0x6a>;
diff --git a/drivers/power/supply/iceland-supervooc/patches/0002-power-supply-qcom_battmgr-OPLUS-a-charger-hold-and-the-battery-authentication.patch b/drivers/power/supply/iceland-supervooc/patches/0002-power-supply-qcom_battmgr-OPLUS-a-charger-hold-and-the-battery-authentication.patch
new file mode 100644
index 0000000000000..e91d063aa0df7
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/patches/0002-power-supply-qcom_battmgr-OPLUS-a-charger-hold-and-the-battery-authentication.patch
@@ -0,0 +1,128 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: dappermint <198710911+dappermint@users.noreply.github.com>
+Date: Thu, 12 Nov 2026 12:00:00 +0400
+Subject: [PATCH] power: supply: qcom_battmgr: OPLUS: a charger hold and the battery authentication for a charge pump driver
+
+A charge pump driver for the OnePlus Pad 4 (two SC8547D behind the VOOC handshake) charges the battery past
+the charger and has to keep the charger's output off for that time, as the vendor's driver does. Writing
+charge_behaviour for it does not hold: user space owns that attribute (the battery guard writes "auto" back
+within one step). Give the driver its own hold, a third reason next to charge_behaviour and the charge limit,
+and the firmware's battery authentication (OPLUS property 76), which the vendor checks before any fast charge.
+
+Both are exported functions that take the battery supply; neither adds a power-supply property. While the
+hold is set the firmware's status describes its held charger ("Not charging"), not the battery the pump
+fills, so the status then follows the battery current instead.
+---
+--- a/drivers/power/supply/qcom_battmgr.c
++++ b/drivers/power/supply/qcom_battmgr.c
+@@ -123,6 +123,7 @@
+ #define OPLUS_USB_OTG_VBUS_ENABLE	19
+ #define OPLUS_USB_OTG_BOOST_CURRENT	59
+ #define OPLUS_CHG_EN			70
++#define OPLUS_BATTERY_AUTH		76
+ #define OPLUS_SET_PDO			71
+ 
+ /*
+@@ -470,6 +471,8 @@
+ 	unsigned long cool_state;
+ 	unsigned int cool_max_ua;	/* not OPLUS: the firmware's own maximum, 0 = not read yet */
+ 	bool chg_inhibit;
++	/* a charge pump driver charges past the charger and keeps its output off meanwhile */
++	bool chg_pump_hold;
+ 	/* the host's input suspend (input_current_limit 0), see qcom_battmgr_oplus_set_input_limit() */
+ 	bool input_suspend;
+ 	bool icl_unsuspended;		/* a suspend the firmware kept from an earlier boot was ended */
+@@ -649,10 +652,10 @@
+ 	return battmgr->usb.online || battmgr->wireless.online;
+ }
+ 
+-/* The host keeps the charger off: user space (charge_behaviour) or the charge limit */
++/* The host keeps the charger off: user space (charge_behaviour), the charge limit or a charge pump driver */
+ static bool qcom_battmgr_oplus_inhibited(struct qcom_battmgr *battmgr)
+ {
+-	return battmgr->chg_inhibit || battmgr->chg_limit_hold;
++	return battmgr->chg_inhibit || battmgr->chg_limit_hold || battmgr->chg_pump_hold;
+ }
+ 
+ /* The start threshold in use: the one written, else CHARGE_CTRL_DELTA_SOC below the end */
+@@ -785,6 +788,11 @@
+ 		return status == POWER_SUPPLY_STATUS_CHARGING ?
+ 			POWER_SUPPLY_STATUS_DISCHARGING : status;
+ 
++	/* a charge pump charges past the held charger: the firmware's status is that charger's, the current is the battery's */
++	if (battmgr->chg_pump_hold)
++		return qcom_battmgr_oplus_current(battmgr) > 0 ?
++			POWER_SUPPLY_STATUS_CHARGING : POWER_SUPPLY_STATUS_NOT_CHARGING;
++
+ 	if (status != POWER_SUPPLY_STATUS_CHARGING &&
+ 	    status != POWER_SUPPLY_STATUS_DISCHARGING)
+ 		return status;
+@@ -2700,12 +2708,68 @@
+ 	mutex_lock(&battmgr->lock);
+ 	battmgr->chg_inhibit = behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+ 	/* "auto" does not turn the charger on while the charge limit holds it */
++	ret = qcom_battmgr_oplus_set(battmgr, OPLUS_CHG_EN, !qcom_battmgr_oplus_inhibited(battmgr));
++	mutex_unlock(&battmgr->lock);
++
++	return ret;
++}
++
++/*
++ * For a charge pump driver (the SC8547D pair of the OnePlus Pad 4): while a pump charges the battery the
++ * charger's output is held off, as the vendor's driver does once more than 2 A flow into the battery. The
++ * hold is the driver's own and does not show in charge_behaviour, which stays user space's: a guard that
++ * writes "auto" there neither ends the hold nor is told to stop. Both take the battery supply.
++ */
++int qcom_battmgr_oplus_pump_hold(struct power_supply *psy, bool hold);
++int qcom_battmgr_oplus_battery_authentic(struct power_supply *psy);
++
++int qcom_battmgr_oplus_pump_hold(struct power_supply *psy, bool hold)
++{
++	struct qcom_battmgr *battmgr;
++	int ret;
++
++	if (psy->desc->get_property != qcom_battmgr_bat_get_property)
++		return -EINVAL;
++	battmgr = power_supply_get_drvdata(psy);
++	if (battmgr->variant != QCOM_BATTMGR_OPLUS)
++		return -EINVAL;
++
++	mutex_lock(&battmgr->lock);
++	battmgr->chg_pump_hold = hold;
+ 	ret = qcom_battmgr_oplus_set(battmgr, OPLUS_CHG_EN, !qcom_battmgr_oplus_inhibited(battmgr));
++	/* the attach poll sends a failed "off" again by itself, and a failed "on" through this */
++	battmgr->chg_en_retry = ret && !qcom_battmgr_oplus_inhibited(battmgr);
+ 	mutex_unlock(&battmgr->lock);
++	dev_info(battmgr->dev, "charger output %s by the charge pump driver%s\n", hold ? "held off" : "released",
++		 ret ? ", the request failed" : "");
++	power_supply_changed(psy);
+ 
+ 	return ret;
+ }
++EXPORT_SYMBOL_GPL(qcom_battmgr_oplus_pump_hold);
+ 
++/* The firmware's battery authentication (the vendor's fast-charge gate): 1, 0, or the error of the request */
++int qcom_battmgr_oplus_battery_authentic(struct power_supply *psy)
++{
++	struct qcom_battmgr *battmgr;
++	int ret;
++
++	if (psy->desc->get_property != qcom_battmgr_bat_get_property)
++		return -EINVAL;
++	battmgr = power_supply_get_drvdata(psy);
++	if (battmgr->variant != QCOM_BATTMGR_OPLUS)
++		return -EINVAL;
++
++	mutex_lock(&battmgr->lock);
++	ret = qcom_battmgr_request_property(battmgr, OPLUS_PROPERTY_GET, OPLUS_BATTERY_AUTH, 0);
++	if (!ret)
++		ret = !!battmgr->oplus_value;
++	mutex_unlock(&battmgr->lock);
++
++	return ret;
++}
