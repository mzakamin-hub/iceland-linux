+/* the battery-voltage reply follows the total only while the secondary is on */
+static void reply_total(void)
+{
+	struct vl3 r;
+	struct vl s;
+	u16 tx;
+	int k, rc;
+
+	for (k = 0; k < 3; k++) {		/* pumps=1; pumps=2, secondary off but reading 700; pumps=2, secondary on */
+		vl_init(&s, CAP_RL, CAP_RH);
+		s.state = VL_DONE;
+		vl3_init(&r, 20, 0);
+		r.pumps = k ? 2 : 1;
+		r.ph = V3_RUN;
+		r.adc_ok = 1;
+		r.adc.vbus = 7800; r.adc.vbat = 3900; r.adc.vout = 3900; r.adc.ibus = 800;
+		r.s.enabled = k == 2;
+		r.s.adc.ibus = 700;
+		tx = 0;
+		rc = vl3_irq(&s, &r, 0x82, VF_RXDONE, &tx);
+		CHECK(rc == VL_TX && tx == vl3_data_word(vl_batt_code2(&r.adc, k == 2 ? 1500 : 800)), "reply case %d: rc %d tx 0x%04x", k, rc, tx);
+	}
+	CHECK(vl3_data_word(vl_batt_code2(&r.adc, 800)) != vl3_data_word(vl_batt_code2(&r.adc, 1500)), "the reply depends on the current");
+}
+
+/* ---- 5: the way out for both pumps, with failures injected on each ---- */
+
+static int count_reg(const struct bus *b, int reg)
+{
+	int i, n = 0;
+
+	for (i = 0; i < b->n; i++)
+		n += b->w[i].reg == reg;
+	return n;
+}
+
+/* pump_off_now() then exit_path() of the C file for pumps=2 */
+static void end_both(int sec_en, int pri_en, int sec_wr, int stock_start, int restored, struct vl3_lad *lp, struct vl3_lad *ls)
+{
+	int soff = 0, poff = 0;
+
+	if (sec_en)
+		soff = bus_wr(&sb, 1, 0x07, 1, 0x01, 0) >= 0;
+	if (pri_en)
+		poff = bus_wr(&pb, 0, 0x07, 1, 0x00, 0) >= 0;
+	memset(lp, 0, sizeof(*lp));
+	memset(ls, 0, sizeof(*ls));
+	if (sec_wr)
+		vl3_off_confirm(&sio, ls, soff, 0x01);
+	vl3_off_confirm(&pio, lp, poff, 0x00);
+	if (sec_wr)
+		vl3b_ladder_rows(&sio, ls);
+	vl3_ladder_rows(&pio, lp, stock_start, restored);
+}
+
+static void fresh(void)
+{
+	bus_reset(&pb);
+	bus_reset(&sb);
+	pb.r06 = sb.r06 = 0x06;
+	pb.r07 = sb.r07 = 0x80;
+	g_seq = 0;
+}
+
+static void ladders2(void)
+{
+	struct vl3_lad lp, ls;
+	int i, ss, rs;
+
+	for (ss = 0; ss < 2; ss++)
+		for (rs = 0; rs < 2; rs++) {
+			fresh();
+			end_both(1, 1, 1, ss, rs, &lp, &ls);
+			CHECK(sb.w[0].reg == 0x07 && sb.w[0].val == 0x01 && pb.w[0].reg == 0x07 && pb.w[0].val == 0x00 && sb.seq[0] < pb.seq[0], "both offs first, the secondary's before the primary's");
+			CHECK(lp.off_ok && ls.off_ok && !lp.wdt_kept && !ls.wdt_kept && !lp.rows_fail && !ls.rows_fail, "normal end");
+			CHECK(sb.n == (int)VL3B_NEXIT && !sb.refused && !pb.refused, "secondary writes %d", sb.n);
+			for (i = 0; i < (int)VL3B_NEXIT; i++)
+				CHECK(sb.w[i].reg == vl3b_exit_rows[i].reg && sb.w[i].val == vl3b_exit_rows[i].val, "secondary exit row %d", i);
+			CHECK(pb.n == (int)VL3_NEXIT + ((ss && !rs) ? 1 : 0), "primary writes %d", pb.n);
+		}
+	/* the secondary never written: nothing goes to its bus */
+	fresh();
+	end_both(0, 1, 0, 0, 0, &lp, &ls);
+	CHECK(sb.n == 0 && pb.w[0].reg == 0x07 && lp.off_ok, "secondary untouched");
+	/* the secondary configured but never enabled: its ladder writes the off itself, first */
+	fresh();
+	sb.r07 = 0x07; sb.r06 = 0x02;
+	end_both(0, 1, 1, 0, 0, &lp, &ls);
+	CHECK(sb.w[0].reg == 0x07 && sb.w[0].val == 0x01 && ls.off_ok && sb.n == (int)VL3B_NEXIT, "configured, not enabled");
+
+	/* failures on one pump never skip or delay the other's rows */
+	for (i = 0; i < 2; i++) {		/* the first off write fails once */
+		struct bus *f = i ? &pb : &sb;
+
+		fresh();
+		f->fail_reg = 0x07;
+		f->fail_left = 1;
+		end_both(1, 1, 1, 0, 0, &lp, &ls);
+		CHECK(sb.n >= (int)VL3B_NEXIT && pb.n >= (int)VL3_NEXIT, "failed off on bus %d: both ladders complete (%d, %d writes)", i, sb.n, pb.n);
+		CHECK(count_reg(&sb, 0x07) == (i ? 1 : 2) && count_reg(&pb, 0x07) == (i ? 2 : 1), "off written again on the failing bus only");
+		CHECK(lp.off_ok && ls.off_ok && !lp.wdt_kept && !ls.wdt_kept, "failed off: both confirmed after the retry");
+		CHECK(pb.w[0].reg == 0x07 && sb.w[0].reg == 0x07, "both offs first");
+	}
+	for (i = 0; i < 2; i++) {		/* a pump that stays on: 10 tries, no 0x09 row on it, every other row, and the other pump complete */
+		struct bus *f = i ? &pb : &sb, *o = i ? &sb : &pb;
+
+		fresh();
+		f->stuck = 1;
+		end_both(1, 1, 1, 0, 0, &lp, &ls);
+		CHECK(!(i ? lp.off_ok : ls.off_ok) && (i ? lp.wdt_kept : ls.wdt_kept) && count_reg(f, 0x09) == 0, "stuck bus %d: off %d wdt_kept %d 0x09 rows %d", i, i ? lp.off_ok : ls.off_ok, i ? lp.wdt_kept : ls.wdt_kept, count_reg(f, 0x09));
+		CHECK((i ? lp.off_tries : ls.off_tries) == VL3_OFF_TRIES - 1, "stuck: tries");
+		CHECK(f->w[f->n - 1].reg == 0x10, "stuck bus %d: the other rows still ran", i);
+		CHECK((i ? ls.off_ok : lp.off_ok) && (i ? !ls.wdt_kept : !lp.wdt_kept) && count_reg(o, 0x09) == (i ? 2 : 1), "the other pump is complete (0x09 rows %d)", count_reg(o, 0x09));
+	}
+	fresh();				/* both stuck */
+	sb.stuck = pb.stuck = 1;
+	end_both(1, 1, 1, 0, 0, &lp, &ls);
+	CHECK(!lp.off_ok && !ls.off_ok && lp.wdt_kept && ls.wdt_kept && count_reg(&sb, 0x09) == 0 && count_reg(&pb, 0x09) == 0, "both stuck: both watchdog rows kept");
+	for (i = 0; i < 2; i++) {		/* reads fail on one bus: not confirmed there, the other is */
+		fresh();
+		(i ? &pb : &sb)->rd_fail = 1;
+		end_both(1, 1, 1, 0, 0, &lp, &ls);
+		CHECK((i ? !lp.off_ok && lp.rd_fail >= 10 && ls.off_ok : !ls.off_ok && ls.rd_fail >= 10 && lp.off_ok), "read failures on bus %d", i);
+		CHECK(sb.n >= 1 && pb.n >= 1, "both buses written");
+	}
+	for (i = 0; i < 2; i++) {		/* a failing exit row on one bus costs that row only */
+		fresh();
+		(i ? &pb : &sb)->fail_reg = 0x04;
+		(i ? &pb : &sb)->fail_left = 99;
+		end_both(1, 1, 1, 0, 0, &lp, &ls);
+		CHECK((i ? lp.rows_fail : ls.rows_fail) == 1 && (i ? !ls.rows_fail : !lp.rows_fail) && lp.off_ok && ls.off_ok && sb.n == (int)VL3B_NEXIT && pb.n == (int)VL3_NEXIT,
+		      "failing 0x04 row on bus %d: %d / %d", i, lp.rows_fail, ls.rows_fail);
+	}
+	fresh();				/* the off write of both fail, and keep failing: still tried again and the rows are still written */
+	sb.fail_reg = pb.fail_reg = 0x07;
+	sb.fail_left = pb.fail_left = 3;
+	end_both(1, 1, 1, 0, 0, &lp, &ls);
+	CHECK(lp.off_ok && ls.off_ok, "three failed off writes on both buses, then confirmed");
+}
+
+/* ---- 6: the new small rules ---- */
+
+static void small_rules(void)
+{
+	unsigned int st, pumps, cap, hold, conn;
+	struct vl3_clk c = { 0 };
+
+	CHECK(vl3_guard(0, V3_BEH_AUTO) == 0 && vl3_guard(0, 1) == V3B_GUARD && vl3_guard(0, 2) == V3B_GUARD && vl3_guard(-5, V3_BEH_AUTO) == V3B_GUARD && vl3_guard(-5, 1) == V3B_GUARD, "guard");
+	CHECK(V3_BEH_AUTO == 0, "auto is 0");
+	CHECK(vl3_auth_ok(1, 0) && vl3_auth_ok(0, 0) && vl3_auth_ok(-5, 0) && vl3_auth_ok(1, 1) && !vl3_auth_ok(0, 1) && !vl3_auth_ok(-5, 1) && !vl3_auth_ok(2, 1), "auth gate");
+	for (st = 0; st < 5; st++)
+		for (pumps = 0; pumps < 4; pumps++)
+			for (cap = 0; cap < 80; cap++)
+				for (hold = 0; hold < 700; hold += 7)
+					for (conn = 0; conn < 100; conn += 11) {
+						int ok = (st == 2 && pumps == 1) ||
+							 (st == 3 && pumps == 1 && cap >= 1 && cap <= 13 && hold >= 1 && hold <= 300 && conn >= 1 && conn <= 80) ||
+							 (st == 3 && pumps == 2 && cap >= 1 && cap <= 73 && hold >= 1 && hold <= 600 && conn >= 1 && conn <= 80);
+
+						CHECK((vl3_params2(st, pumps, cap, hold, conn) == 0) == ok, "params %u %u %u %u %u", st, pumps, cap, hold, conn);
+					}
+	CHECK(vl3_params2(3, 2, 73, 600, 80) == 0 && vl3_params2(3, 2, 74, 120, 60) && vl3_params2(3, 2, 73, 601, 60) && vl3_params2(3, 1, 14, 120, 60) && vl3_params2(3, 1, 13, 301, 60) &&
+	      vl3_params2(2, 2, 13, 120, 60) && vl3_params2(3, 0, 13, 120, 60) && vl3_params2(3, 3, 13, 120, 60), "param edges");
+	CHECK(vl3_params(3, 13, 300, 80) == 0 && vl3_params(3, 14, 120, 60), "vl3_params is pumps=1");
+	CHECK(vl3_session_ms(1) == 330000 && vl3_session_ms(2) == 630000, "session limits");
+
+	c.t_hs = 100;
+	c.t_en = 10000;
+	c.hold_ms = 900000;
+	c.i600 = 1;
+	c.frames = 1;
+	for (c.now = 10000 + 299900; c.now <= 10000 + 300100; c.now++) {		/* A1 300 s with pumps=1, 600 s with pumps=2 */
+		c.t_last = c.now;
+		c.long_hold = 0;
+		CHECK((vl3_time(&c) == V3T_A1) == (c.now - c.t_en > 300000), "A1 at %d", c.now);
+		c.long_hold = 1;
+		CHECK(vl3_time(&c) == V3T_NONE, "long A1 at %d", c.now);
+	}
+	c.long_hold = 1;
+	for (c.now = 10000 + 599900; c.now <= 10000 + 600100; c.now++) {
+		c.t_last = c.now;
+		CHECK((vl3_time(&c) == V3T_A1) == (c.now - c.t_en > 600000), "A1 (pumps=2) at %d", c.now);
+	}
+	c.hold_ms = 600000;
+	c.now = 10000 + 600000;
+	c.t_last = c.now;
+	CHECK(vl3_time(&c) == V3T_HOLD, "hold 600 s is not reported as A1");
+}
