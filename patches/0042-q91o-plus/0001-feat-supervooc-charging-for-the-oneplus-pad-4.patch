+  * input_current_limit on the USB supply: 0 suspends the charger input, any
+  * other value ends the suspend. That is stock's lever for a too hot USB-C
diff --git a/drivers/power/supply/iceland-supervooc/tests/Makefile b/drivers/power/supply/iceland-supervooc/tests/Makefile
new file mode 100644
index 0000000000000..242ffbc286495
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/tests/Makefile
@@ -0,0 +1,23 @@
+# host tests: cc and python3, no kernel tree
+#   make test       the frame logic against a trace of the stock firmware, every limit crossed, the write tables, the driver's construction rules
+#   make mutations  the same tests against deliberately broken copies of the logic and of the driver; each copy must fail (about 10 minutes)
+CFLAGS ?= -Wall -Wextra -O1
+TESTS := test_logic test_stage3 test_stage3b test_stage4
+
+test: $(TESTS)
+	./test_logic
+	./test_stage3
+	./test_stage3b
+	./test_stage4
+	python3 check-construct.py
+
+test_%: test_%.c ../vooc_logic.h $(wildcard capture_*.h)
+	$(CC) $(CFLAGS) -I.. $< -o $@
+
+mutations:
+	python3 mutation-check.py
+
+clean:
+	rm -f $(TESTS)
+
+.PHONY: test mutations clean
