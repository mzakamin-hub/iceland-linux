+/* ---- the tables (--tables) ---- */
+
+static void print_rows(const struct vl_row *rw, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		printf(" %02x%s=%02x", rw[i].reg, rw[i].w == 2 ? "(w)" : "", rw[i].val);
+}
+
+static void tables(void)
+{
+	unsigned int i;
+	static const char *ph[] = { "init", "session", "exit", "hw_setting", "run", "enable", "start", "ladder" };
+
+	printf("| bus | reg | width | value | phase | mode | what |\n|---|---|---|---|---|---|---|\n");
+	for (i = 0; i < VL_NW + VL3_NW + VL3S_NW + VL3B_NW; i++) {
+		const struct vl_w *e = i < VL_NW ? &vl_wl[i] : i < VL_NW + VL3_NW ? &vl3_wl[i - VL_NW] : i < VL_NW + VL3_NW + VL3S_NW ? &vl3s_wl[i - VL_NW - VL3_NW] : &vl3b_wl[i - VL_NW - VL3_NW - VL3S_NW];
+		int sec = i >= VL_NW + VL3_NW + VL3S_NW, m = i < VL_NW ? 0 : i < VL_NW + VL3_NW ? 1 : i < VL_NW + VL3_NW + VL3S_NW ? 2 : 3;
+		char v[32], p[64] = "";
+		int b;
+
+		if (e->w == 2 && e->mask == 0x00ff)
+			snprintf(v, sizeof(v), "0x??%02x", e->val);
+		else if (e->mask == 0xff || e->mask == 0xffff)
+			snprintf(v, sizeof(v), e->w == 2 ? "0x%04x" : "0x%02x", e->val);
+		else
+			snprintf(v, sizeof(v), "0x%04x & 0x%04x", e->val, e->mask);
+		for (b = 0; b < 8; b++)
+			if (e->phase & (1 << b))
+				strcat(strcat(p, p[0] ? " " : ""), ph[b]);
+		printf("| %s | 0x%02x | %s | %s | %s | %s | %s |\n", sec ? "secondary" : "primary", e->reg, e->w == 2 ? "word" : "byte", v, p,
+		       m == 0 ? "stage 2, 3 (pumps 1 and 2)" : m == 1 ? "stage 3 (pumps 1 and 2)" : m == 2 ? "stage 3 + stock_start" : "stage 3 pumps=2", e->what);
+	}
+	printf("\nsecondary rows, in order:\n");
+	printf("init (after the primary's init rows, before the handshake):");
+	print_rows(vl3b_init_rows, VL3B_NINIT);
+	printf("\nround 1, around the 0x13 read, every frame:");
+	print_rows(vl3b_adc1_rows, 2);
+	printf("\nhw_setting (allow frame, after the primary's hw rows and start rows):");
+	print_rows(vl3b_hw_rows, VL3B_NHW);
+	printf("\nrun, every frame around the 0x13 read:");
+	print_rows(vl3b_adc_rows, 2);
+	printf("\nenable (one write, once per session):");
+	printf(" 07=81");
+	printf("\nexit (after the pump is off and confirmed; the 0x09 rows are skipped if the secondary is not confirmed off):");
+	print_rows(vl3b_exit_rows, VL3B_NEXIT);
+	printf("\n\nfirmware requests:\n| request | value | phase | what |\n|---|---|---|---|\n");
+	for (i = 0; i < VL3_NFW; i++)
+		printf("| %s | %d | %s | %s |\n", vl3_fwl[i].prop == FW_ICL ? "qcom-battmgr-usb input_current_limit" : "qcom_battmgr_oplus_pump_hold(qcom-battmgr-bat, hold)", vl3_fwl[i].val,
+		       vl3_fwl[i].phase == FWP_SUSPEND ? "suspend" : vl3_fwl[i].phase == FWP_RUN ? "run" : "exit", vl3_fwl[i].what);
+}
+
+int main(int argc, char **argv)
+{
+	if (argc > 1 && !strcmp(argv[1], "--tables")) {
+		tables();
+		return 0;
+	}
+	replays();
+	total_oracle();
+	orders();
+	enable_conditions();
+	enable_once();
+	limits2();
+	tables_cross();
+	ladders2();
+	reply_total();
+	small_rules();
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+	return fails != 0;
+}
diff --git a/drivers/power/supply/iceland-supervooc/tests/test_stage4.c b/drivers/power/supply/iceland-supervooc/tests/test_stage4.c
