diff --git a/drivers/power/supply/iceland-supervooc/iceland_supervooc.c b/drivers/power/supply/iceland-supervooc/iceland_supervooc.c
new file mode 100644
index 0000000000000..218964cf5310a
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/iceland_supervooc.c
@@ -0,0 +1,1577 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SUPERVOOC (80 W) charging on the OnePlus Pad 4 through its two SC8547D charge pumps.
+ *
+ * The primary pump (i2c@980000) also carries the VOOC PHY. A session switches D+/D- to it, sends the handshake, answers the
+ * adapter's frames (identification, model, battery model, VBUS window, current, battery voltage) and enables the pump once
+ * the adapter has brought VBUS into the window above twice the battery voltage. The secondary pump (i2c@890000) joins once
+ * the total bus current exceeds 1.4 A. Every way out switches the pumps off first, then runs stock's exit rows and gives
+ * D+/D- and the charger back.
+ *
+ * The stage parameter selects how far a session goes:
+ *   2  handshake only (the default): the adapter's first round is answered, the pumps are never enabled
+ *   3  one capped run started by hand: pumps=1 the primary alone (cap_100ma <= 13, hold_s <= 300), pumps=2 both pumps
+ *      (cap_100ma <= 73, hold_s <= 600)
+ *   4  automatic: both pumps, the current follows the battery's state of charge as stock's does, steps down when a pump
+ *      reaches 66 C and tapers at 4.45 V; with autostart=1 one session per plug-in
+ *
+ * vooc_logic.h holds the frame logic, the write tables and every limit without kernel dependencies, so the host tests run
+ * the same code. The charger's output is held through qcom_battmgr_oplus_pump_hold(), which a qcom_battmgr patch exports.
+ *
+ * The kernel log gets the start, each change of the current and the end of a session. The whole summary of the last
+ * session is in debugfs (summary); the readings of each second are pr_debug lines (dyndbg=+p).
+ *
+ * Register defines, ADC scale and the write-whitelist idea after sc8547d_cp.c by DocZ13 (GPL-2.0,
+ * mzakamin-hub/iceland-linux issue #2). The VOOC handshake and frame engine are from OnePlus's GPL charger v2.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/debugfs.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_qos.h>
+#include <linux/pm_runtime.h>
+#include <linux/pm_wakeup.h>
+#include <linux/power_supply.h>
+#include <linux/mutex.h>
+#include <linux/random.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/sort.h>
+#include <linux/spinlock.h>
+#include <linux/thermal.h>
+#include <linux/workqueue.h>
+
+#include "vooc_logic.h"
+
+#define PUMP_NODE_PARENT	"i2c@980000"	/* primary pump bus */
+#define PUMP_NODE_PARENT2	"i2c@890000"	/* secondary pump bus, pumps=2 only */
+#define USBSS_COMPAT		"qcom,wcd9395-usbss"
+#define REG_ID			0x36
+#define REG_CTRL		0x07
+#define REG_PHY_RX		0x2e
+#define REG_TX			0x2c
+#define SC8547D_ID		0x49
+#define MAXEV			64
+#define LIM_SESSION_MS		30000
+#define LIM_NOFRAME_MS		200
+#define LIM_FIRST_MS		2000
+#define LIM_VBUS_MV		6000
+#define LIM_REPLY_US		1900
+#define LIM_SLOW_US		1500
+#define MAXCAND			8
+#define STAGE4			(stage == 4)
+#define STAGE3			(stage == 3 || STAGE4)
+#define PUMPS2			(STAGE3 && pumps == 2)
+#define UNSET_U			UINT_MAX
+#define UNSET_I			INT_MIN
+
+/* exported by the qcom_battmgr patch, which has no header yet */
+extern int qcom_battmgr_oplus_pump_hold(struct power_supply *psy, bool hold);
+extern int qcom_battmgr_oplus_battery_authentic(struct power_supply *psy);
+
+/* stock's own limits for a fast charge; the start window (soc_min .. temp_max) is narrower */
+#define GATE_T_MIN		0	/* 0.1 C */
+#define GATE_T_MAX		500
+#define GATE_VBAT_MIN_MV	3450U
+#define GATE_SOC_MAX		90U
+
+static unsigned int start_delay_ms = 498;	/* stock: plug-in to the D+/D- switch */
+static unsigned int stop_wait_ms = 100;
+static bool arm;
+/* read-only after load: a bad combination is refused at load, a runtime write could not be checked */
+static unsigned int stage = 2, pumps = 1, cap_100ma = UNSET_U, hold_s = UNSET_U, conn_max_c = 60, soc_min = UNSET_U, soc_max = UNSET_U;
+static int temp_min = UNSET_I, temp_max = UNSET_I;	/* 0.1 C; an unset value takes the stage's default (vl4_default) at load */
+static bool stock_start, auth_gate, auto_start;
+static u8 mode = VM_S2;
+module_param(stage, uint, 0444);
+module_param_named(autostart, auto_start, bool, 0444);	/* not "auto": the kernel defines auto as __auto_type */
+module_param(pumps, uint, 0444);
+module_param(auth_gate, bool, 0444);
+module_param(cap_100ma, uint, 0444);
+module_param(hold_s, uint, 0444);
+module_param(conn_max_c, uint, 0444);
+module_param(soc_min, uint, 0444);
+module_param(soc_max, uint, 0444);
+module_param(temp_min, int, 0444);
+module_param(temp_max, int, 0444);
+module_param(stock_start, bool, 0444);
+MODULE_PARM_DESC(stage, "2 = handshake only (default), 3 = one capped run started by hand, 4 = automatic: both pumps, the current follows the state of charge");
+MODULE_PARM_DESC(autostart, "stage 4: 1 = one session per plug-in; 0 = started by hand (arm or the debugfs start file)");
+MODULE_PARM_DESC(pumps, "stage 3: 1 = primary pump only (default), 2 = both pumps");
+MODULE_PARM_DESC(auth_gate, "1 = refuse the start unless the battery authentication reads 1; 0 = only report it");
+MODULE_PARM_DESC(cap_100ma, "highest bus current asked of the adapter, 100 mA units: stage 3 1..13 with pumps=1, 1..73 with pumps=2 (default 13); stage 4 1..73 (default 73)");
+MODULE_PARM_DESC(hold_s, "longest time the pumps run, s: stage 3 1..300 with pumps=1, 1..600 with pumps=2 (default 120); stage 4 1..4500 (default 4500)");
+MODULE_PARM_DESC(conn_max_c, "connector temperature limit, whole C, 1..80 (default 60, stock 80)");
+MODULE_PARM_DESC(soc_min, "start window: lowest state of charge, % (stage 3: 30, stage 4: 0)");
+MODULE_PARM_DESC(soc_max, "start window: highest state of charge, % (stage 3: 60, stage 4: 80)");
+MODULE_PARM_DESC(temp_min, "start window: lowest battery temperature, 0.1 C (stage 3: 200, stage 4: 210)");
+MODULE_PARM_DESC(temp_max, "start window: highest battery temperature, 0.1 C (default 350)");
+MODULE_PARM_DESC(stock_start, "stage 3: stock's start pattern (UCP and soft-start timeout off until IBUS > 600 mA); 0 = UCP stays on, those two writes are refused");
+module_param(start_delay_ms, uint, 0644);
+module_param(stop_wait_ms, uint, 0644);
+module_param(arm, bool, 0644);
+MODULE_PARM_DESC(arm, "run one session at the next plug-in (DCP on qcom-battmgr-usb); cleared when it starts");
+MODULE_PARM_DESC(start_delay_ms, "wait after the plug-in event before the D+/D- switch");
+MODULE_PARM_DESC(stop_wait_ms, "stage 2: listen this long after the last row for the second 0x04 (never answered)");
+
+struct ev {
+	u16 rx, tx;
+	u8 fl;
+	bool frame;
+	int us;
+};
+
+static struct {
+	struct i2c_client *cl, *cl2;
+	struct i2c_adapter *adap, *adap2;
+	struct dentry *dir;
+	struct notifier_block nb;
+	struct work_struct work;
+	struct delayed_work rearm;	/* autostart: the unplug check after a session's end */
+	struct workqueue_struct *q;	/* the module's own: a 75 min session must not occupy a system worker */
+	struct wakeup_source *ws;	/* held from the start of a session to the end of its exit ladder and firmware restore */
+	ktime_t t_end;
+	bool ended;
+	bool refused;			/* autostart: the last start was refused before any write, so the gates are read again */
+	char last_why[96];		/* its reason, to log a refusal only when it changes */
+	wait_queue_head_t wq;
+	atomic_t busy;
+	bool from_arm, unloading, live;
+	int irq;
+	struct mutex pw;	/* the primary's enable and its off write exclude each other */
+	struct mutex pws;	/* the same for the secondary; never held together with pw */
+	spinlock_t lk;		/* end reasons */
+} M;
+
+/* one session; zeroed before every run */
+static struct {
+	struct vl vl;
+	struct pm_qos_request qos;
+	struct regmap *sw;
+	struct i2c_client *swc;
+	unsigned int sv403, sv404;
+	bool pump_wr, sw_wr, irq_on, qos_on, exited, mux_ok, done;
+	int exit_fail;
+	const char *why;
+	char whybuf[96];
+	ktime_t t0, t_hs, t_done, t_last;
+	int nev, nframes, nreply, nslow, nadc, vmin, vmax;
+	u8 flags_or;
+	struct ev ev[MAXEV];
+	int bat_t, bat_mv, bat_soc, usb_online, usb_type, usb_mv;
+	int ncand;
+	char cand[MAXCAND][96];
+	/* the powered stages */
+	struct vl3 r3;
+	struct vl3_bs bs;
+	struct vl3_lad lad;
+	struct power_supply *bat, *usb;
+	struct work_struct mon;
+	bool en_wr, off_wr, icl_sent, out_sent, out_ok;
+	int en_ms, off_ms, cond_ms, allow_ms, ms_600, ms_restore, ms_susp, off_rc;
+	int fw_sus_rc, fw_out_rc, fw_in_rc, fw_hold_rc;
+	/* the secondary pump, and the battery authentication of the start gates */
+	struct vl3_lad lads;
+	bool sec_wr, sen_wr, soff_wr, auth_read;
+	int sen_ms, soff_ms, soff_rc, auth;
+	int bat_ma, conn_c, conn_min, conn_max, bat_n, us_max;
+	int ibat_max, vbus_pk;
+	ktime_t bat_ok;
+	u8 blk[17];
+	u8 fl3[4];
+	/* the automatic stage */
+	struct vl4 v4;
+	u8 ask;				/* the ask the IRQ thread replies with: READ_ONCE there, written by the monitor only (and once by session() before any thread runs) */
+	u8 lim;				/* the ask the total-current limit uses (vl4.lim), the same writers and readers */
+	struct {
+		u8 ask;
+		int ms;
+	} asks[10];
+	int nasks, soc0, mv0;
+	char sum[8192];
+} S;
+
+static int ms_since_t0(void)
+{
+	return ktime_ms_delta(ktime_get(), S.t0);
+}
+
+/*
+ * The first reason wins (S.why points into S.cand[0], which is never rewritten); every later one is kept as a candidate for the
+ * summary. The winner switches the pumps off before anything else: this runs in the context that saw the condition (IRQ
+ * thread, session thread, battery monitor, debugfs) and waits for no firmware call.
+ */
+static void pump_off_now(void);
+
+static void set_end(const char *why)
+{
+	bool first = false;
+	int i;
+
+	spin_lock(&M.lk);
+	for (i = 0; i < S.ncand; i++)
+		if (!strcmp(S.cand[i], why))
+			break;
+	if (i == S.ncand && S.ncand < MAXCAND)
+		strscpy(S.cand[S.ncand++], why, sizeof(S.cand[0]));
+	if (!S.why && S.ncand) {
+		S.cond_ms = ms_since_t0();
+		WRITE_ONCE(S.why, S.cand[0]);
+		first = true;
+	}
+	spin_unlock(&M.lk);
+	if (first) {
+		pump_off_now();
+		wake_up(&M.wq);
+	}
+}
+
+#define fail(...) do { \
+	char b_[96]; \
+	snprintf(b_, sizeof(b_), __VA_ARGS__); \
+	set_end(b_); \
+} while (0)
+
+/* the one pump write: every register write is checked against the tables in vooc_logic.h; no side effect on the session */
+static int pw_raw(u8 reg, u8 w, u16 val, bool enable)
+{
+	if (enable ? !vl3_enable_ok(reg, w, val, mode) : !vl_write_ok_m(reg, w, val, mode))
+		return -EPERM;
+	S.pump_wr = true;
+	return w == 2 ? i2c_smbus_write_word_data(M.cl, reg, val) : i2c_smbus_write_byte_data(M.cl, reg, val);
+}
+
+static int pw(u8 reg, u8 w, u16 val)
+{
+	int ret = pw_raw(reg, w, val, false);
+
+	if (ret == -EPERM) {
+		pr_err("refused write 0x%02x%s = 0x%x\n", reg, w == 2 ? " (word)" : "", val);
+		fail("write refused: 0x%02x = 0x%x", reg, val);
+	} else if (ret < 0) {
+		pr_err("i2c write 0x%02x failed: %d\n", reg, ret);
+		fail("i2c error (write 0x%02x: %d)", reg, ret);
+	}
+	return ret;
+}
+
+/* the secondary's one write function: its own client, its own table (vl3b_write_ok), byte writes only. The primary's pw_raw() never sees it */
+static int ps_raw(u8 reg, u8 w, u16 val, bool enable)
+{
+	if (enable ? !vl3b_enable_ok(reg, w, val, mode) : !vl3b_write_ok(reg, w, val, mode))
+		return -EPERM;
+	S.sec_wr = true;
+	return i2c_smbus_write_byte_data(M.cl2, reg, val);
+}
+
+static int ps(u8 reg, u8 w, u16 val)
+{
+	int ret = ps_raw(reg, w, val, false);
+
+	if (ret == -EPERM) {
+		pr_err("refused secondary write 0x%02x%s = 0x%x\n", reg, w == 2 ? " (word)" : "", val);
+		fail("secondary write refused: 0x%02x = 0x%x", reg, val);
+	} else if (ret < 0) {
+		pr_err("i2c write to the secondary 0x%02x failed: %d\n", reg, ret);
+		fail("i2c error (secondary write 0x%02x: %d)", reg, ret);
+	}
+	return ret;
+}
+
+/*
+ * Both pumps off once an enable was attempted, the secondary first as stock does: 0x07 = 0x01 and
+ * 0x07 = 0x00. Each write is raw, from the context that saw the condition, and a failure of one does not skip the other; the session
+ * thread's ladder confirms both and writes again what failed.
+ */
+static void pump_off_now(void)
+{
+	if (!STAGE3)
+		return;
+	if (PUMPS2) {
+		mutex_lock(&M.pws);
+		if (S.sen_wr && !S.soff_wr) {
+			S.soff_rc = ps_raw(REG_CTRL, 1, 0x01, false);
+			S.soff_ms = ms_since_t0();
+			S.soff_wr = S.soff_rc >= 0;
+		}
+		mutex_unlock(&M.pws);
+	}
+	mutex_lock(&M.pw);
+	if (S.en_wr && !S.off_wr) {
+		S.off_rc = pw_raw(REG_CTRL, 1, 0x00, false);
+		S.off_ms = ms_since_t0();
+		S.off_wr = S.off_rc >= 0;
+	}
+	mutex_unlock(&M.pw);
+}
+
+/* the one enable: only while no end is set, only with the protection image read back by the last frame's check */
+static int s3_enable(void)
+{
+	int ret = -ECANCELED;
+
+	mutex_lock(&M.pw);
+	if (!READ_ONCE(S.why) && S.r3.prot_ok) {
+		S.en_wr = true;
+		WRITE_ONCE(S.en_ms, ms_since_t0());
+		ret = pw_raw(REG_CTRL, 1, 0x80, true);
+	}
+	mutex_unlock(&M.pw);
+	if (ret < 0)
+		fail("pump enable not written (%d)", ret);
+	return ret;
+}
+
+/*
+ * The secondary's one enable: only while no end is set, only after the primary's enable was written, never twice. vl3b_due() has judged
+ * the rest (primary switching with its image ok, input suspend confirmed, window NORMAL, total IBUS, the secondary's own image of this frame).
+ */
+static int s3_sec_enable(void)
+{
+	int ret = -ECANCELED;
+
+	mutex_lock(&M.pws);
+	if (!READ_ONCE(S.why) && S.en_wr && !S.sen_wr) {
+		S.sen_wr = true;
+		WRITE_ONCE(S.sen_ms, ms_since_t0());
+		ret = ps_raw(REG_CTRL, 1, 0x81, true);
+	}
+	mutex_unlock(&M.pws);
+	if (ret < 0)
+		fail("secondary enable not written (%d)", ret);
+	return ret;
+}
+
+/*
+ * ponytail: writes the mux's regmap behind the typec driver's back, limited to the D+/D- switch values below;
+ * in-tree this becomes an exported function in wcd939x-usbss.c
+ */
+static int sw_wr(unsigned int reg, unsigned int val)
+{
+	int ret;
+
+	if (!((reg == 0x403 && (val == 0x80 || val == 0x98 || val == S.sv403)) ||
+	      (reg == 0x404 && (val == 0x28 || val == 0x14 || val == S.sv404)))) {
+		fail("mux write refused: 0x%x = 0x%x", reg, val);
+		return -EPERM;
+	}
+	S.sw_wr = true;
+	ret = regmap_write(S.sw, reg, val);
+	if (ret)
+		fail("mux write error 0x%x: %d", reg, ret);
+	return ret;
+}
+
+static int sw_enter(void)
+{
+	return sw_wr(0x403, 0x80) ?: sw_wr(0x404, 0x28) ?: sw_wr(0x403, 0x98);
+}
+
+static int sw_exit(void)
+{
+	return sw_wr(0x403, 0x80) | sw_wr(0x404, 0x14) | sw_wr(0x403, 0x98) | sw_wr(0x404, S.sv404) |
+	       sw_wr(0x403, S.sv403);
+}
+
+static int io_wr(void *c, u8 reg, u8 w, u16 val)
+{
+	return pw(reg, w, val);
+}
+
+static int io_rd(void *c, u8 reg, u8 n, u8 *b)
+{
+	return i2c_smbus_read_i2c_block_data(M.cl, reg, n, b);
+}
+
+static void io_dly(void *c, int ms)
+{
+	msleep(ms);
+}
+
+static const struct vl3_io lad_io = { NULL, io_wr, io_rd, io_dly };
+
+static int sio_wr(void *c, u8 reg, u8 w, u16 val)
+{
+	return ps(reg, w, val);
+}
+
+static int sio_rd(void *c, u8 reg, u8 n, u8 *b)
+{
+	return i2c_smbus_read_i2c_block_data(M.cl2, reg, n, b);
+}
+
+static int sio_en(void *c)
+{
+	return s3_sec_enable();
+}
+
+static int sio_stop(void *c)
+{
+	return READ_ONCE(S.why) != NULL;
+}
+
+static const struct vl3_io sec_io = { NULL, sio_wr, sio_rd, io_dly, sio_en, sio_stop };
+
+static int fw_set(u8 prop, int val, u8 phase);
+
+/* after the pumps are off and the mux is back: wait for the monitor, then the hold is released (if it was ever requested, also when the request failed), then the input unsuspend */
+static void fw_exit(void)
+{
+	flush_work(&S.mon);
+	if (S.out_sent)
+		S.fw_out_rc = fw_set(FW_HOLD, FW_HOLD_OFF, FWP_EXIT);
+	if (S.icl_sent)
+		S.fw_in_rc = fw_set(FW_ICL, FW_ICL_UNSUSPEND, FWP_EXIT);
+}
+
+static void exit_path(void)
+{
+	unsigned int i;
+
+	if (S.exited)
+		return;
+	S.exited = true;
+	if (S.irq_on)
+		free_irq(M.irq, &S);
+	S.irq_on = false;
+	if (S.qos_on)
+		cpu_latency_qos_remove_request(&S.qos);
+	S.qos_on = false;
+	if (S.pump_wr) {
+		if (PUMPS2) {
+			/* both offs are confirmed before any exit row is written; the secondary first, as stock */
+			if (S.sec_wr)
+				vl3_off_confirm(&sec_io, &S.lads, S.soff_wr, 0x01);
+			vl3_off_confirm(&lad_io, &S.lad, S.off_wr, 0x00);
+			if (S.sec_wr)
+				vl3b_ladder_rows(&sec_io, &S.lads);
+			vl3_ladder_rows(&lad_io, &S.lad, stock_start, S.r3.restored);
+			S.exit_fail = S.lad.rows_fail + !S.lad.off_ok + (S.sec_wr ? S.lads.rows_fail + !S.lads.off_ok : 0);
+		} else if (STAGE3) {
+			vl3_ladder_pump(&lad_io, &S.lad, S.off_wr, stock_start, S.r3.restored);
+			S.exit_fail = S.lad.rows_fail + !S.lad.off_ok;
+		} else {
+			for (i = 0; i < ARRAY_SIZE(vl_exit_rows); i++)
+				if (pw(vl_exit_rows[i].reg, vl_exit_rows[i].w, vl_exit_rows[i].val) < 0)
+					S.exit_fail++;
+		}
+	}
+	if (S.sw_wr)
+		S.mux_ok = !sw_exit();
+	else
+		S.mux_ok = true;
+	if (STAGE3)
+		fw_exit();
+}
+
+/* after the reply, never before: freeze, ADC block, unfreeze, then 0x06/0x07 (pump must stay idle) */
+static void check_pump(void)
+{
+	u8 b[10], c[2];
+	int n, mv;
+
+	if (pw(0x11, 1, 0xa0) < 0)
+		return;
+	n = i2c_smbus_read_i2c_block_data(M.cl, 0x13, sizeof(b), b);
+	if (pw(0x11, 1, 0x80) < 0)
+		return;
+	if (n != sizeof(b)) {
+		fail("i2c error (ADC read: %d)", n);
+		return;
+	}
+	mv = (((b[2] & 0x0f) << 8) | b[3]) * 375 / 100;
+	S.vmin = S.nadc ? min(S.vmin, mv) : mv;
+	S.vmax = S.nadc ? max(S.vmax, mv) : mv;
+	S.nadc++;
+	if (mv > LIM_VBUS_MV) {
+		fail("VBUS ADC above %d mV (%d)", LIM_VBUS_MV, mv);
+		return;
+	}
+	n = i2c_smbus_read_i2c_block_data(M.cl, 0x06, sizeof(c), c);
+	if (n != sizeof(c))
+		fail("i2c error (read 0x06: %d)", n);
+	else if (!vl_pump_idle(c[0], c[1]))
+		fail("pump not idle (0x06 = 0x%02x, 0x07 = 0x%02x)", c[0], c[1]);
+}
+
+/* the enable goes before the TX word, as stock */
+static int s3_tx(u16 tx)
+{
+	if ((S.r3.act & V3A_ENABLE) && s3_enable() < 0)
+		return -ECANCELED;
+	return pw(REG_TX, 2, tx);
+}
+
+/* after the TX word, as stock: the predata word, the hw_setting rows (and stock's start pattern) at the allow frame */
+static int s3_after(void)
+{
+	unsigned int i;
+
+	if (S.r3.act & V3A_PREDATA)
+		if (pw(0x31, 2, S.r3.predata) < 0)
+			return -EIO;
+	if (!(S.r3.act & V3A_HW))
+		return 0;
+	S.allow_ms = ms_since_t0();
+	for (i = 0; i < VL3_NHW && !READ_ONCE(S.why); i++)
+		if (pw(vl3_hw_rows[i].reg, vl3_hw_rows[i].w, vl3_hw_rows[i].val) < 0)
+			return -EIO;
+	for (i = 0; stock_start && i < VL3_NSTART && !READ_ONCE(S.why); i++)
+		if (pw(vl3_start_rows[i].reg, vl3_start_rows[i].w, vl3_start_rows[i].val) < 0)
+			return -EIO;
+	if (PUMPS2 && vl3b_hw(&sec_io, &S.r3) == -1)		/* -2: an end was set meanwhile */
+		return -EIO;
+	return 0;
+}
+
+static int rdn(u8 reg, u8 n, u8 *b)
+{
+	int r = i2c_smbus_read_i2c_block_data(M.cl, reg, n, b);
+
+	return r == n ? 0 : r < 0 ? r : -EIO;
+}
+
+/*
+ * After every frame once the allow bit is out: the registers 0x00..0x10 the checks need (0x06..0x0f in one 10-byte read as stock
+ * does, which also covers 0x07), the ADC block with the freeze toggles as stock, then every limit of the frame logic.
+ */
+static void s3_post(void)
+{
+	u8 blk[17] = {}, b[14];
+	struct vl_adc a;
+	unsigned int i;
+	int n, rc;
+
+	n = rdn(0x06, 10, blk + 6) ?: rdn(0x04, 2, blk + 4) ?: rdn(0x00, 3, blk) ?: rdn(0x10, 1, blk + 16);
+	if (n) {
+		fail("i2c error (flag / protection read: %d)", n);
+		return;
+	}
+	if (pw(0x11, 1, 0xa0) < 0)
+		return;
+	n = i2c_smbus_read_i2c_block_data(M.cl, 0x13, sizeof(b), b);
+	if (pw(0x11, 1, 0x80) < 0)
+		return;
+	if (n != sizeof(b)) {
+		fail("i2c error (ADC read: %d)", n);
+		return;
+	}
+	vl_adc_decode(&a, b);
+	memcpy(S.blk, blk, sizeof(blk));
+	S.fl3[0] |= blk[0x06];
+	S.fl3[1] |= blk[0x09];
+	S.fl3[2] |= blk[0x0d] | blk[0x0e];
+	S.fl3[3] |= blk[0x0f];
+	rc = vl3_post(&S.r3, blk, &a, S.en_ms >= 0 ? ms_since_t0() - S.en_ms : 0);
+	S.r3.adc = a;
+	S.r3.adc_ok = 1;
+	S.nadc++;
+	S.vbus_pk = max(S.vbus_pk, a.vbus);
+	if (rc) {
+		set_end(vl3_why(rc));
+		return;
+	}
+	if (S.r3.i600 && S.ms_600 < 0)
+		S.ms_600 = ms_since_t0();
+	if (vl3_restore_due(&S.r3)) {
+		for (i = 0; i < 2 && !READ_ONCE(S.why); i++)
+			if (pw(vl3_restore_rows[i].reg, vl3_restore_rows[i].w, vl3_restore_rows[i].val) < 0)
+				return;
+		S.r3.restored = 1;
+		S.ms_restore = ms_since_t0();
+	}
+}
+
+/* after the primary's post: the secondary's rows, reads and limits (all in vooc_logic.h); a failed write was already reported by ps() */
+static void sec_post(void)
+{
+	int rc = vl3b_run(&sec_io, &S.r3, ms_since_t0());
+
+	if (rc > 0)
+		set_end(vl3_why(rc));
+	else if (rc == -V3S_RD)
+		fail("i2c error (secondary read)");
+}
+
+static irqreturn_t vooc_irq(int irq, void *data)
+{
+	ktime_t t0 = ktime_get();
+	struct ev *e = NULL;
+	u16 tx = 0;
+	int w, r, us = 0;
+
+	if (READ_ONCE(S.why))
+		return IRQ_HANDLED;
+	w = i2c_smbus_read_word_data(M.cl, REG_PHY_RX);
+	if (w < 0) {
+		fail("i2c error (read 0x2e: %d)", w);
+		return IRQ_HANDLED;
+	}
+	if (STAGE4) {
+		S.r3.ask4 = READ_ONCE(S.ask);
+		S.r3.lim4 = READ_ONCE(S.lim);
+	}
+	r = STAGE3 ? vl3_irq(&S.vl, &S.r3, w & 0xff, w >> 8, &tx) : vl_irq(&S.vl, w & 0xff, w >> 8, &tx);
+	if (r > 0 && (STAGE3 ? s3_tx(tx) : pw(REG_TX, 2, tx)) >= 0) {
+		us = ktime_us_delta(ktime_get(), t0);
+		S.nreply++;
+		S.us_max = max(S.us_max, us);
+	}
+	if (S.nev < MAXEV) {
+		e = &S.ev[S.nev];
+		e->rx = w & 0xff;
+		e->fl = w >> 8;
+		e->frame = w & (VF_RXDONE << 8);
+		e->tx = r > 0 ? tx : 0;
+		e->us = us;
+	}
+	S.nev++;
+	S.flags_or |= w >> 8;
+	if (w & (VF_RXDONE << 8)) {
+		S.nframes++;
+		WRITE_ONCE(S.t_last, t0);
+	}
+	if (r < 0) {
+		set_end(vl_why(r));
+		return IRQ_HANDLED;
+	}
+	if (S.vl.state == VL_STOP)
+		set_end(STAGE3 && !S.r3.suspend_ok ? "second 0x04: input suspend not confirmed, allow bit withheld (ends as a handshake-only session)" :
+			"second 0x04 before the last battery-model row (not answered)");
+	if (r == VL_NONE || READ_ONCE(S.why))
+		return IRQ_HANDLED;
+	if (us > LIM_REPLY_US)
+		fail("reply took %d us (limit %d)", us, LIM_REPLY_US);
+	else if (us > LIM_SLOW_US && ++S.nslow == 2)
+		fail("two replies over %d us", LIM_SLOW_US);
+	if (!STAGE3) {
+		check_pump();
+		if (r == VL_LAST) {
+			S.t_done = ktime_get();
+			WRITE_ONCE(S.done, true);
+		}
+		return IRQ_HANDLED;
+	}
+	if (READ_ONCE(S.why) || s3_after() < 0)
+		return IRQ_HANDLED;
+	if (S.r3.ph == V3_ASK)
+		check_pump();
+	else
+		s3_post();
+	if (PUMPS2 && !READ_ONCE(S.why))
+		sec_post();
+	return IRQ_HANDLED;
+}
+
+static int cmp_us(const void *a, const void *b)
+{
+	return cmp_int(*(const int *)a, *(const int *)b);
+}
+
+static int summary3(char *p, size_t sz)
+{
+	int len = 0, i;
+
+	len += scnprintf(p + len, sz - len, "stage %u: pumps %u, cap %u x 100 mA, hold %u s, stock_start %d, connector limit %u C, start window SoC %u..%u %% battery %d..%d (0.1 C), auth_gate %d\n",
+			 stage, pumps, cap_100ma, hold_s, stock_start, conn_max_c, soc_min, soc_max, temp_min, temp_max, auth_gate);
+	if (STAGE4) {
+		len += scnprintf(p + len, sz - len, "stage 4: autostart %d; gauge at the start %d %% %d mV, at the end %d %% %d mV; asks used (x 100 mA, from):", auto_start, S.soc0, S.mv0,
+				 S.bat_soc, S.bat_mv);
+		for (i = 0; i < S.nasks; i++)
+			len += scnprintf(p + len, sz - len, "%s %u at +%d ms", i ? "," : "", S.asks[i].ask, S.asks[i].ms);
+		len += scnprintf(p + len, sz - len, "\n");
+	}
+	len += scnprintf(p + len, sz - len, "end reasons that fired (first = the reason):");
+	for (i = 0; i < S.ncand; i++)
+		len += scnprintf(p + len, sz - len, "%s [%d] %s", i ? ";" : "", i + 1, S.cand[i]);
+	len += scnprintf(p + len, sz - len, "\n");
+	if (S.allow_ms >= 0)
+		len += scnprintf(p + len, sz - len, "allow bit sent at +%d ms, input suspend confirmed at +%d ms\n", S.allow_ms, S.ms_susp);
+	else
+		len += scnprintf(p + len, sz - len, "allow bit never sent (input suspend %s)\n", !S.icl_sent ? "never requested" : S.ms_susp < 0 ? "not confirmed" : "confirmed");
+	if (S.en_ms >= 0)
+		len += scnprintf(p + len, sz - len, "pump enabled at +%d ms (%d ms after the allow reply = time to NORMAL); IBUS > 600 mA %s; UCP back %s\n",
+				 S.en_ms, S.en_ms - S.allow_ms, S.ms_600 >= 0 ? "reached" : "NOT reached", S.ms_restore >= 0 ? "written" : stock_start ? "NOT written" : "n/a (stock_start 0)");
+	else
+		len += scnprintf(p + len, sz - len, "pump never enabled\n");
+	if (S.ms_600 >= 0)
+		len += scnprintf(p + len, sz - len, "enable to IBUS > 600 mA: %d ms\n", S.ms_600 - S.en_ms);
+	if (S.r3.nrun)
+		len += scnprintf(p + len, sz - len, "VBUS - 2 x VBAT (pump ADC) while enabled: min %d max %d mV over %d reads; IBUS max %d mA; TDIE max %d.%d C\n",
+				 S.r3.vdiff_min, S.r3.vdiff_max, S.r3.nrun, S.r3.ibus_max, S.r3.tdie_max / 10, S.r3.tdie_max % 10);
+	len += scnprintf(p + len, sz - len, "VBUS peak %d mV; flags seen (OR): 0x06 %#04x 0x09 %#04x 0x0d|0x0e %#04x 0x0f %#04x; max reply %d us\n",
+			 S.vbus_pk, S.fl3[0], S.fl3[1], S.fl3[2], S.fl3[3], S.us_max);
+	len += scnprintf(p + len, sz - len, "battery (qcom-battmgr, current is the driver's one-minute mean): %d mV %d mA %d.%d C, %d reads; connector %d..%d C (limit %u)\n",
+			 S.bat_mv, S.bat_ma, S.bat_t / 10, abs(S.bat_t % 10), S.bat_n, S.conn_max < S.conn_min ? 0 : S.conn_min, S.conn_max < S.conn_min ? 0 : S.conn_max, conn_max_c);
+	if (S.en_wr)
+		len += scnprintf(p + len, sz - len, "end condition at +%d ms; pump off written at +%d ms (rc %d); ", S.cond_ms, S.off_ms, S.off_rc);
+	if (S.pump_wr)
+		len += scnprintf(p + len, sz - len, "ladder: off %s after %d extra writes (0x06 = %#04x, 0x07 = %#04x, %d read failures), watchdog row %s, %d exit rows failed\n",
+				 S.lad.off_ok ? "CONFIRMED" : "NOT CONFIRMED", S.lad.off_tries, S.lad.r06, S.lad.r07, S.lad.rd_fail, S.lad.wdt_kept ? "KEPT (pump not confirmed off)" : "written",
+				 S.lad.rows_fail);
+	if (PUMPS2) {
+		struct vl3s *q = &S.r3.s;
+
+		if (S.sen_wr)
+			len += scnprintf(p + len, sz - len, "secondary enabled at +%d ms (%d ms after the primary); status check %s; IBUS max %d mA, TDIE max %d.%d C, TOTAL IBUS max %d mA over %d reads; flags seen (OR): 0x06 %#04x 0x09 %#04x 0x0d|0x0e %#04x 0x0f %#04x\n",
+					 S.sen_ms, S.sen_ms - S.en_ms, q->checked ? "passed" : "NOT passed", q->ibus_max, q->tdie_max / 10, q->tdie_max % 10,
+					 q->tot_max, q->nrun, q->fl_or[0], q->fl_or[1], q->fl_or[2], q->fl_or[3]);
+		else
+			len += scnprintf(p + len, sz - len, "secondary never enabled (total IBUS did not exceed %d mA at a %d ms tick while the primary ran, or the session ended first): a valid session, the primary alone ran\n",
+					 V3B_ENABLE_MA, V3B_TICK_MS);
+		if (S.sen_wr)
+			len += scnprintf(p + len, sz - len, "secondary off written at +%d ms (rc %d); ", S.soff_ms, S.soff_rc);
+		if (S.sec_wr)
+			len += scnprintf(p + len, sz - len, "secondary ladder: off %s after %d extra writes (0x06 = %#04x, 0x07 = %#04x, %d read failures), watchdog row %s, %d exit rows failed\n",
+					 S.lads.off_ok ? "CONFIRMED" : "NOT CONFIRMED", S.lads.off_tries, S.lads.r06, S.lads.r07, S.lads.rd_fail,
+					 S.lads.wdt_kept ? "KEPT (pump not confirmed off)" : "written", S.lads.rows_fail);
+	}
+	len += scnprintf(p + len, sz - len, "firmware: input suspend rc %d, charger hold %s (rc %d), hold release %s (rc %d), input unsuspend %s\n", S.fw_sus_rc,
+			 !S.out_sent ? "not needed" : S.fw_hold_rc ? "FAILED" : "done", S.fw_hold_rc, !S.out_sent ? "not needed" : S.fw_out_rc ? "FAILED" : "done",
+			 S.fw_out_rc, !S.icl_sent ? "not needed" : S.fw_in_rc ? "FAILED" : "done");
+	len += scnprintf(p + len, sz - len, "D+/D- switch before the session: 0x403 = %#x, 0x404 = %#x\n", S.sv403, S.sv404);
+	if (S.auth_read)
+		len += scnprintf(p + len, sz - len, "battery authentication (qcom_battmgr_oplus_battery_authentic): %d (%s; auth_gate %d)\n", S.auth,
+				 S.auth == 1 ? "authentic" : S.auth == 0 ? "NOT authentic" : "request failed", auth_gate);
+	else
+		len += scnprintf(p + len, sz - len, "battery authentication: not read (a gate ended the start first)\n");
+	return len;
+}
