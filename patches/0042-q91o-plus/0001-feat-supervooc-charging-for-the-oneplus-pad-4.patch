+#!/usr/bin/env python3
+"""Deliberate breakages of copies of vooc_logic.h; test_logic.c (stage 2), test_stage3.c (3a), test_stage3b.c (3b) and test_stage4.c (4) must, between them, FAIL
+against every one (proves they are not blind). A mutation is a list of (old, new) pairs; each old text must occur exactly once. The last
+section breaks copies of iceland_supervooc.c, which check-construct.py must reject."""
+import os
+import importlib.util
+from concurrent.futures import ThreadPoolExecutor
+import re
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SRC = open(os.path.join(HERE, "..", "vooc_logic.h")).read()
+TESTS = ["test_stage4.c", "test_stage3b.c", "test_logic.c", "test_stage3.c"]  # fastest first; a mutation needs one failing test
+
+
+def one(what, a, b):
+    return (what, [(a, b)])
+
+
+def define(what, name, old, new):
+    m = re.search(r"#define %s\s+%s(?=\s|$)" % (re.escape(name.strip()), re.escape(old)), SRC, re.M)
+    assert m, (what, name, old)
+    return one(what, m.group(0), m.group(0)[:-len(old)] + new)
+
+
+MUTS = [
+    # stage 2
+    one("first 0x04 reply with the allow bit set", "tx0 |= 0x06 << 3;", "tx0 |= 0x07 << 3;"),
+    one("whitelist accepts 0x07 = 0x80 (CHG_EN)", "{ 0x07, 1, VW_EXIT,\t\t0xff,   0x00,", "{ 0x07, 1, VW_EXIT,\t\t0x7f,   0x00,"),
+    one("PHY flag 0x08 no longer aborts", "#define VF_ABORT\t0xd8", "#define VF_ABORT\t0xd0"),
+    one("identification echo not verified", "if (s->far != s->local)", "if (0)"),
+    one("second 0x04 is answered", "if (s->seen & 1) {", "if (s->seen & 128) {"),
+    one("init rows in the wrong order", "{ 0x07, 1, 0x40 }, { 0x11, 1, 0x00 }, { 0x02, 1, 0x01 }", "{ 0x07, 1, 0x40 }, { 0x02, 1, 0x01 }, { 0x11, 1, 0x00 }"),
+    one("wrong battery-model row", "0x49, 0x40, 0x2c, 0x3f, 0x68, 0x3f", "0x49, 0x40, 0x2c, 0x3f, 0x69, 0x3f"),
+    # stage 3a: the allow bit, the window, the enable
+    one("allow bit without the input suspend confirmed", "if (!r->suspend_ok) {", "if (0) {"),
+    one("enable without the protection read-back", "if (!r->prot_ok)\n\t\t\t\treturn VL_E_PROT;", "if (0)\n\t\t\t\treturn VL_E_PROT;"),
+    one("enable on every NORMAL answer", "if (st == VB_NORMAL && r->ph == V3_PRE) {", "if (st == VB_NORMAL) {"),
+    one("the enable action is never raised", "r->act = V3A_ENABLE;", "r->act = 0;"),
+    one("VBUS window LOW threshold 90", "d < 100 ? VB_LOW", "d < 90 ? VB_LOW"),
+    one("VBUS window HIGH threshold 250", "d > 200 ? VB_HIGH", "d > 250 ? VB_HIGH"),
+    one("cap not applied to the ask-current reply", "r->cap < r->stock_ask ? r->cap : r->stock_ask", "r->stock_ask"),
+    one("battery-voltage reply with the wrong IBUS term", "ibus * 75 / 1000", "ibus * 50 / 1000"),
+    one("battery-voltage reply without predata", "r->predata = *tx;\n\t\tr->act = V3A_PREDATA;", "r->act = 0;"),
+    one("low VBUS / VBAT counter never ends the session", "if (r->vb_err >= 3)", "if (r->vb_err >= 30)"),
+    # per-frame limits
+    one("A5 margin 500 mA", "r->cap * 100 + 300", "r->cap * 100 + 500"),
+    one("A5 four reads", "if (++r->n_ibus >= 3)", "if (++r->n_ibus >= 4)"),
+    define("IBUS 5300 limit raised", "V3_LIM_IBUS_MAX_MA", "5300", "6300"),
+    define("VDIFF limit 600", "V3_LIM_VDIFF_MV", "500", "600"),
+    one("VDIFF four reads", "if (++r->n_vdiff >= 3)", "if (++r->n_vdiff >= 4)"),
+    define("TDIE limit 80 C", "V3_LIM_TDIE_DC", "700", "800"),
+    define("pump VBAT limit 4500", "V3_LIM_VBAT_MV", "4450", "4500"),
+    define("VBUS limit 11 V after the allow", "V3_LIM_VBUS_MV", "10000", "11000"),
+    define("VBUS limit 7 V before the allow", "V3_LIM_VBUS_PRE_MV", "6000", "7000"),
+    define("stale ADC: nine identical blocks", "V3_STALE_N", "6", "9"),
+    one("stale ADC check removed", "if (r->adc_ok && same) {", "if (0) {"),
+    one("0x0f flags ignored", "(blk[0x0f] & 0xfc)", "(blk[0x0f] & 0x00)"),
+    one("0x0f UCP bits ignored", "(blk[0x0f] & 0xfc)", "(blk[0x0f] & 0xf8)"),
+    one("0x06 fault bits ignored", "(blk[0x06] & 0xc9)", "(blk[0x06] & 0x49)"),
+    one("watchdog flag ignored", "(blk[0x09] & 0x08)", "(blk[0x09] & 0x00)"),
+    one("0x0d PMID2OUT flags ignored", "(blk[0x0d] & 0x0c)", "(blk[0x0d] & 0x00)"),
+    one("0x0e flags ignored", "(blk[0x0e] & 0xf8)", "(blk[0x0e] & 0x78)"),
+    one("image: 0x05 not judged against stock_start", "if (blk[0x05] != (ucp_off ? 0xaf : 0x2f))", "if (blk[0x05] != 0x2f && blk[0x05] != 0xaf)"),
+    one("image: 0x08 not judged", "if (blk[0x08] != (ucp_off ? 0x00 : 0xe0))", "if (0)"),
+    one("image: 0x00 not judged", "if (blk[0x00] != 0x36)", "if (0)"),
+    one("image: 0x04 (VBUS OVP) not judged", "if (blk[0x04] != 0x5a)", "if (0)"),
+    one("image: 0x0d not judged", "if ((blk[0x0d] & 0xf0) != 0x70)", "if (0)"),
+    one("CHG_EN drop not noticed", "if (!(blk[0x07] & 0x80))\n\t\t\treturn V3E_CHGEN;", "if (0)\n\t\t\treturn V3E_CHGEN;"),
+    define("CHG_EN grace 1 s", "V3_ENABLE_GRACE_MS", "100", "1000"),
+    one("stopped switching needs 30 reads", "++r->n_lost >= 3", "++r->n_lost >= 30"),
+    one("pump not idle before the enable is accepted", "if (!vl_pump_idle(blk[0x06], blk[0x07]))\n\t\t\treturn V3E_IDLE;", "if (0)\n\t\t\treturn V3E_IDLE;"),
+    one("UCP back when IBUS > 100 mA", "r->adc.ibus > 600;", "r->adc.ibus > 100;"),
+    one("600 mA mark at 100 mA", "if (a->ibus > 600)\n\t\tr->i600 = 1;", "if (a->ibus > 100)\n\t\tr->i600 = 1;"),
+    # clock and battery limits
+    define("no-frame limit 300 ms", "V3_LIM_NOFRAME_MS", "200", "300"),
