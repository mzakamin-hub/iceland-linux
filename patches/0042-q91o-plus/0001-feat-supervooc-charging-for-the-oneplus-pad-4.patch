index 0000000000000..3116a63f83c9a
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/tests/test_logic.c
@@ -0,0 +1,359 @@
+/*
+ * Host test for vooc_logic.h: replays round 1 of the stock capture through the frame logic and checks the abort,
+ * stop and write-whitelist rules. cc -I.. test_logic.c -o test_logic && ./test_logic     (./test_logic --table prints the write table)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vooc_logic.h>
+#include "capture_round1.h"
+
+static int fails, checks;
+
+#define CHECK(c, ...) do { \
+	checks++; \
+	if (!(c)) { \
+		fails++; \
+		printf("FAIL %s:%d: %s  ", __FILE__, __LINE__, #c); \
+		printf(__VA_ARGS__); \
+		printf("\n"); \
+	} \
+} while (0)
+
+static int feed(struct vl *s, u8 rx, u8 fl, u16 *tx)
+{
+	*tx = 0;
+	return vl_irq(s, rx, fl, tx);
+}
+
+static void replay(void)
+{
+	struct vl s;
+	u16 tx;
+	int i, r;
+
+	vl_init(&s, CAP_RL, CAP_RH);
+	CHECK(s.local == 0x9cf0, "local code 0x%04x, stock logged code_id_local 0x9cf0", s.local);
+	CHECK(feed(&s, 0x00, 0x20, &tx) == VL_NONE && s.state == VL_WAIT, "TXSEQ_DONE after the handshake: no reply");
+	for (i = 0; i < CAP_N; i++) {
+		r = feed(&s, cap_rx[i], cap_flags[i], &tx);
+		CHECK(r == (i == CAP_N - 1 ? VL_LAST : VL_TX), "frame %d returned %d", i + 1, r);
+		CHECK(tx == cap_tx[i], "frame %d: tx 0x%04x, capture 0x%04x", i + 1, tx, cap_tx[i]);
+	}
+	CHECK(s.state == VL_DONE, "state %d after the last row", s.state);
+	CHECK(s.model == CAP_ID && vl_id_ok(s.model), "adapter id 0x%02x", s.model);
+	CHECK(s.seen & 4, "adapter check not marked ok");
+	r = feed(&s, CAP_SECOND_RX, CAP_SECOND_FLAGS, &tx);
+	CHECK(r == VL_NONE && tx == 0 && s.state == VL_DONE, "second 0x04 after the last row: reply %d tx 0x%x", r, tx);
+}
+
+static void second_ask(void)
+{
+	struct vl s;
+	u16 tx;
+	int i, n;
+
+	for (n = 1; n <= CAP_N; n++) {		/* a second 0x04 after n frames, wherever it lands */
+		vl_init(&s, CAP_RL, CAP_RH);
+		for (i = 0; i < n; i++)
+			feed(&s, cap_rx[i], cap_flags[i], &tx);
+		if (s.pend)			/* inside a follow-up an 0x88 is data, not a command */
+			continue;
+		CHECK(feed(&s, 0x88, 0x07, &tx) == VL_NONE && tx == 0, "second 0x04 after frame %d answered", n);
+		CHECK(s.state == (n == CAP_N ? VL_DONE : VL_STOP), "state %d after the second 0x04 at frame %d", s.state, n);
+		CHECK(feed(&s, cap_rx[(n < CAP_N) ? n : 0], 0x07, &tx) == VL_NONE && tx == 0, "reply after STOP at frame %d", n);
+	}
+}
+
+static void echo_and_id(void)
+{
+	struct vl s;
+	u16 tx;
+	int i, r, k, m1, m2;
+
+	/*
+	 * Flip each bit of each echoed nibble (frames 4..7). Frame 7 decides. Stock masks the code with 0xfefe, so a flip of
+	 * far bit 0 (frame 7, nibble bit 0) or far bit 8 (frame 5, nibble bit 0) is not seen: those two are expected to pass.
+	 */
+	for (k = 3; k <= 6; k++)
+		for (m1 = 0; m1 < 4; m1++) {
+			static const int far_lsb[4] = { 12, 8, 4, 0 };
+			int far_bit = far_lsb[k - 3] + m1, masked = far_bit == 0 || far_bit == 8;
+			u8 rx[CAP_N];
+
+			memcpy(rx, cap_rx, sizeof(rx));
+			rx[k] ^= 2 << m1;
+			vl_init(&s, CAP_RL, CAP_RH);
+			for (i = 0; i < 6; i++)
+				CHECK(feed(&s, rx[i], cap_flags[i], &tx) == VL_TX, "frame %d", i + 1);
+			r = feed(&s, rx[6], 0x07, &tx);
+			CHECK(r == (masked ? VL_TX : VL_E_ECHO) && (r != VL_E_ECHO || tx == 0),
+			      "echo flip frame %d nibble bit %d: %d", k + 1, m1, r);
+		}
+	vl_init(&s, CAP_RL + 1, CAP_RH);	/* a different local code against the capture's echo */
+	for (i = 0; i < 6; i++)
+		feed(&s, cap_rx[i], cap_flags[i], &tx);
+	CHECK(feed(&s, cap_rx[6], 0x07, &tx) == VL_E_ECHO && tx == 0, "wrong local code accepted");
+
+	for (m1 = 0; m1 < 16; m1++)		/* the model id is two nibbles, bit 7 dropped; only 4b 4c 4d 4e 65 pass */
+		for (m2 = 0; m2 < 16; m2++) {
+			int id = ((m1 << 4) | m2) & 0x7f;
+
+			vl_init(&s, CAP_RL, CAP_RH);
+			for (i = 0; i < 8; i++)
+				feed(&s, cap_rx[i], cap_flags[i], &tx);
+			feed(&s, 0x80 | (m1 << 1), 0x07, &tx);
+			r = feed(&s, 0x80 | (m2 << 1), 0x07, &tx);
+			CHECK(r == (vl_id_ok(id) ? VL_TX : VL_E_ID), "id 0x%02x: %d", id, r);
+		}
+	for (m1 = 0; m1 < 256; m1++)
+		CHECK(vl_id_ok(m1) == (m1 == 0x4b || m1 == 0x4c || m1 == 0x4d || m1 == 0x4e || m1 == 0x65), "vl_id_ok(0x%02x)", m1);
+}
+
+static void flags_and_start(void)
+{
+	struct vl s;
+	u16 tx;
+	int fl, st, i, r;
+
+	for (fl = 0; fl < 256; fl++)		/* every abort flag ends the session in every state */
+		for (st = 0; st < 3; st++) {
+			vl_init(&s, CAP_RL, CAP_RH);
+			for (i = 0; i < (st == 0 ? 0 : st == 1 ? 3 : CAP_N); i++)
+				feed(&s, cap_rx[i], cap_flags[i], &tx);
+			r = feed(&s, 0x98, fl, &tx);
+			CHECK((r == VL_E_FLAG) == !!(fl & 0xd8), "flags 0x%02x state %d: %d", fl, st, r);
+			if (fl & 0xd8)
+				CHECK(tx == 0, "flags 0x%02x: reply sent with an abort flag", fl);
+		}
+	CHECK(VF_ABORT == (0x80 | 0x40 | 0x10 | 0x08), "abort mask 0x%02x", VF_ABORT);
+
+	vl_init(&s, CAP_RL, CAP_RH);		/* 5 frames that are not 0xa8 are ignored, the 6th ends the session */
+	for (i = 1; i <= 5; i++)
+		CHECK(feed(&s, 0x88, 0x07, &tx) == VL_NONE && tx == 0 && s.state == VL_WAIT, "ignored frame %d", i);
+	CHECK(feed(&s, VL_FIRST, 0x06, &tx) == VL_TX && tx == 0x3002, "0xa8 after 5 junk frames");
+	vl_init(&s, CAP_RL, CAP_RH);
+	for (i = 1; i <= 5; i++)
+		feed(&s, 0x88, 0x07, &tx);
+	CHECK(feed(&s, 0x88, 0x07, &tx) == VL_E_START, "6 frames without 0xa8");
+
+	for (fl = 0; fl < 256; fl++) {		/* the only first frame that gets a reply is 0xa8, and the reply is 0x3002 */
+		vl_init(&s, CAP_RL, CAP_RH);
+		r = feed(&s, fl, 0x06, &tx);
+		CHECK((r == VL_TX) == (fl == VL_FIRST) && (r != VL_TX || tx == 0x3002), "first frame 0x%02x -> %d 0x%04x", fl, r, tx);
+	}
+	vl_init(&s, CAP_RL, CAP_RH);		/* head, order */
+	feed(&s, cap_rx[0], 0x06, &tx);
+	for (fl = 0; fl < 256; fl++) {
+		struct vl c = s;
+
+		r = feed(&c, fl, 0x07, &tx);
+		if ((fl & 0xe0) != 0x80)
+			CHECK(r == VL_E_HEAD, "head 0x%02x: %d", fl, r);
+		else if (((fl & 0x1e) >> 1) == VC_IDENT)
+			CHECK(r == VL_TX, "0x0c rejected");
+		else if (((fl & 0x1e) >> 1) == VC_ASK)
+			CHECK(r == VL_NONE && c.state == VL_STOP, "second 0x04 %d", r);
+		else
+			CHECK(r == VL_E_CMD, "command 0x%02x out of order: %d", (fl & 0x1e) >> 1, r);
+	}
+}
+
+/* an honest adapter for every identification code: 17 replies, the allow bit never set, every word ends in 0x02 */
+static void all_codes(void)
+{
+	struct vl s;
+	u16 tx;
+	int rl, rh, i, r, n;
+
+	for (rl = 0; rl < 128; rl++)
+		for (rh = 0; rh < 128; rh++) {
+			u8 rx[CAP_N];
+			unsigned int loc = (rh << 9) | (rl << 1);
+
+			memcpy(rx, cap_rx, sizeof(rx));
+			rx[3] = 0x80 | (((loc >> 12) & 15) << 1);
+			rx[4] = 0x80 | (((loc >> 8) & 15) << 1);
+			rx[5] = 0x80 | (((loc >> 4) & 15) << 1);
+			rx[6] = 0x80 | ((loc & 15) << 1);
+			vl_init(&s, rl, rh);
+			for (i = 0, n = 0; i < CAP_N; i++) {
+				r = feed(&s, rx[i], cap_flags[i], &tx);
+				if (r > 0) {
+					n++;
+					CHECK((tx & 0xff) == 0x02, "tx 0x%04x", tx);
+					CHECK(s.now != VC_ASK || tx == 0x3002, "0x04 answered with 0x%04x", tx);
+				}
+				if (i >= 3 && i <= 6)	/* frames 4..7 are the same reply whatever the code */
+					CHECK(tx == 0x1002, "echo reply 0x%04x", tx);
+			}
+			CHECK(n == CAP_N && s.state == VL_DONE, "code %d/%d: %d replies", rl, rh, n);
+			if (fails > 20)
+				return;
+		}
+}
+
+/* random garbage in every state: the 0x04 reply is 0x3002 or absent, nothing else touches the allow reply */
+static void fuzz(void)
+{
+	struct vl s;
+	u16 tx;
+	int run, i, r;
+
+	srand(1);
+	for (run = 0; run < 3000; run++) {
+		vl_init(&s, rand(), rand());
+		for (i = 0; i < 40; i++) {
+			u8 rx = rand() % 3 ? cap_rx[rand() % CAP_N] : rand();
+			u8 fl = rand() % 4 ? 0x07 : rand();
+
+			r = feed(&s, rx, fl, &tx);
+			if (r > 0) {
+				CHECK((tx & 0xff) == 0x02, "tx 0x%04x", tx);
+				CHECK(s.now != VC_ASK || tx == 0x3002, "0x04 answered with 0x%04x", tx);
+			} else {
+				CHECK(tx == 0, "tx written without a reply");
+			}
+			if (r < 0 || s.state >= VL_DONE)
+				break;
+		}
+	}
+}
+
+/* the table is the whitelist: exactly these byte writes, these word writes, nothing else */
+static void whitelist(void)
+{
+	static const struct { u8 reg, val; } okb[] = {
+		{ 0x07, 0x40 }, { 0x07, 0x00 }, { 0x11, 0x00 }, { 0x11, 0x80 }, { 0x11, 0xa0 }, { 0x02, 0x01 },
+		{ 0x04, 0x5a }, { 0x00, 0x36 }, { 0x05, 0x2f }, { 0x01, 0xbf }, { 0x2b, 0x00 }, { 0x2b, 0x81 },
+		{ 0x34, 0x60 }, { 0x09, 0x10 }, { 0x10, 0x02 }, { 0x21, 0x21 }, { 0x21, 0xc0 }, { 0x22, 0x00 },
+		{ 0x33, 0xd1 }, { 0x30, 0x05 }, { 0x30, 0x7f }, { 0x3b, 0x04 },
+	};
+	int reg, val, w, n, i, ok, want;
+
+	for (reg = 0; reg < 256; reg++)
+		for (val = 0; val < 65536; val++)
+			for (w = 1; w <= 2; w++) {
+				ok = vl_write_ok(reg, w, val);
+				want = 0;
+				if (w == 1 && val < 256)
+					for (i = 0; i < (int)(sizeof(okb) / sizeof(okb[0])); i++)
+						want |= okb[i].reg == reg && okb[i].val == val;
+				if (w == 2)
+					want = (reg == 0x2c && ((val & 0xff) == 0x02 || val == 0)) || (reg == 0x31 && val == 0);
+				if (ok != want) {
+					CHECK(ok == want, "write 0x%02x w%d 0x%x: whitelist %d, expected %d", reg, w, val, ok, want);
+					return;
+				}
+			}
+	for (reg = 0, n = 0; reg < 256; reg++)
+		for (val = 0; val < 256; val++)
+			n += vl_write_ok(reg, 1, val);
+	CHECK(n == (int)(sizeof(okb) / sizeof(okb[0])), "%d byte writes accepted", n);
+
+	CHECK(!vl_write_ok(0x07, 1, 0x80) && !vl_write_ok(0x07, 1, 0x81) && !vl_write_ok(0x07, 1, 0xc0), "0x07 with bit 7");
+	for (val = 0; val < 256; val++) {	/* 0x07 with CHG_EN set is refused, whatever the other bits */
+		CHECK(!(val & 0x80) || !vl_write_ok(0x07, 1, val), "0x07 = 0x%02x", val);
+		CHECK(!vl_write_ok(0x08, 1, val) && !vl_write_ok(0x0d, 1, val) &&
+		      !vl_write_ok(0x0c, 1, val) && !vl_write_ok(0x3c, 1, val), "0x08/0x0d/0x0c/0x3c = 0x%02x", val);
+		CHECK(!vl_write_ok(0x3b, 1, val) || val == 0x04, "0x3b = 0x%02x", val);
+		CHECK(!vl_write_ok(0x05, 1, val) || val == 0x2f, "0x05 = 0x%02x", val);
+		CHECK(!vl_write_ok(0x09, 1, val) || val == 0x10, "0x09 = 0x%02x", val);
+		for (reg = 0x40; reg <= 0xcc; reg++)
+			CHECK(!vl_write_ok(reg, 1, val) && !vl_write_ok(reg, 2, val), "reg 0x%02x", reg);
+	}
+}
+
+/* what the module writes (the row lists it runs) against the capture, an independently typed list and the table */
+static void rows(void)
+{
+	/* stock's exit sequence, typed here as an independent oracle */
+	static const struct { u8 reg, w; u16 val; } plan_exit[] = {
+		{ 0x07, 1, 0x00 }, { 0x09, 1, 0x10 }, { 0x00, 1, 0x36 }, { 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x05, 1, 0x2f },
+		{ 0x11, 1, 0x00 }, { 0x2c, 2, 0x0000 }, { 0x30, 1, 0x7f }, { 0x21, 1, 0xc0 }, { 0x2b, 1, 0x00 }, { 0x31, 2, 0x0000 },
+		{ 0x10, 1, 0x02 },
+	};
+	unsigned int i, j, n = 0, nin = sizeof(vl_init_rows) / sizeof(vl_init_rows[0]);
+	int hit[VL_NW] = { 0 };
+
+	/* capture init sequence = our rows + handshake, write for write */
+	for (i = 0; i < sizeof(cap_init) / sizeof(cap_init[0]); i++) {
+		const struct vl_row *r;
+
+		r = n < nin ? &vl_init_rows[n] : &vl_handshake;
+		CHECK(n <= nin && r->reg == cap_init[i].reg && r->w == cap_init[i].w && r->val == cap_init[i].val,
+		      "init write %u: capture 0x%02x/%d/0x%x, module 0x%02x/%d/0x%x", n, cap_init[i].reg, cap_init[i].w,
+		      cap_init[i].val, r->reg, r->w, r->val);
+		n++;
+	}
+	CHECK(n == nin + 1, "capture has %u writes, module %u", n, nin + 1);
+
+	CHECK(sizeof(vl_exit_rows) / sizeof(vl_exit_rows[0]) == sizeof(plan_exit) / sizeof(plan_exit[0]), "exit row count");
+	for (i = 0; i < sizeof(plan_exit) / sizeof(plan_exit[0]); i++)
+		CHECK(vl_exit_rows[i].reg == plan_exit[i].reg && vl_exit_rows[i].w == plan_exit[i].w &&
+		      vl_exit_rows[i].val == plan_exit[i].val, "exit row %u", i);
+
+	/* every row the module runs is allowed in its phase; every init/exit table entry is used by a row (no dead entries) */
+	for (i = 0; i < nin + 1; i++) {
+		const struct vl_row *r = i < nin ? &vl_init_rows[i] : &vl_handshake;
+
+		CHECK(vl_write_phase(r->reg, r->w, r->val) & VW_INIT, "init row %u not allowed in init", i);
+		for (j = 0; j < VL_NW; j++)
+			if ((vl_wl[j].phase & VW_INIT) && vl_wl[j].reg == r->reg && vl_wl[j].w == r->w &&
+			    (r->val & vl_wl[j].mask) == vl_wl[j].val)
+				hit[j] |= VW_INIT;
+	}
+	for (i = 0; i < sizeof(vl_exit_rows) / sizeof(vl_exit_rows[0]); i++) {
+		const struct vl_row *r = &vl_exit_rows[i];
+
+		CHECK(vl_write_phase(r->reg, r->w, r->val) & VW_EXIT, "exit row %u not allowed in exit", i);
+		for (j = 0; j < VL_NW; j++)
+			if ((vl_wl[j].phase & VW_EXIT) && vl_wl[j].reg == r->reg && vl_wl[j].w == r->w &&
+			    (r->val & vl_wl[j].mask) == vl_wl[j].val)
+				hit[j] |= VW_EXIT;
+	}
+	for (j = 0; j < VL_NW; j++)
+		CHECK((vl_wl[j].phase & (VW_INIT | VW_EXIT) & ~hit[j]) == 0, "table entry %u (%s) is never written", j, vl_wl[j].what);
+	CHECK(vl_write_phase(0x11, 1, 0xa0) == VW_SESS && vl_write_phase(0x11, 1, 0x80) == (VW_INIT | VW_SESS) &&
+	      vl_write_phase(0x2c, 2, 0x6e02) == VW_SESS, "session phases");
+}
+
+static void table(void)
+{
+	unsigned int i;
+
+	printf("| reg | width | value | phase | what |\n|---|---|---|---|---|\n");
+	for (i = 0; i < VL_NW; i++) {
+		const struct vl_w *e = &vl_wl[i];
+		char v[32], ph[16] = "";
+
+		if (e->mask == 0xff || e->mask == 0xffff)
+			snprintf(v, sizeof(v), e->w == 2 ? "0x%04x" : "0x%02x", e->val);
+		else
+			snprintf(v, sizeof(v), "0x%04x & 0x%04x", e->val, e->mask);
+		snprintf(ph, sizeof(ph), "%s%s%s", e->phase & VW_INIT ? "init " : "", e->phase & VW_SESS ? "session " : "",
+			 e->phase & VW_EXIT ? "exit" : "");
+		printf("| 0x%02x | %s | %s | %s | %s |\n", e->reg, e->w == 2 ? "word" : "byte", v, ph, e->what);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	if (argc > 1 && !strcmp(argv[1], "--table")) {
+		table();
+		return 0;
+	}
+	replay();
+	second_ask();
+	echo_and_id();
+	flags_and_start();
+	all_codes();
+	fuzz();
+	whitelist();
+	rows();
+	/* idle check: the values stock and this tablet read after the soft reset are idle; CHG_EN or switching is not */
+	CHECK(vl_pump_idle(0x22, 0x07) && vl_pump_idle(0x22, 0x00) && vl_pump_idle(0x22, 0x01), "idle values refused");
+	CHECK(!vl_pump_idle(0x22, 0x80) && !vl_pump_idle(0x22, 0x87) && !vl_pump_idle(0x26, 0x07), "running pump accepted");
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+	return fails != 0;
+}
diff --git a/drivers/power/supply/iceland-supervooc/tests/test_stage3.c b/drivers/power/supply/iceland-supervooc/tests/test_stage3.c
new file mode 100644
index 0000000000000..248799403aefd
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/tests/test_stage3.c
@@ -0,0 +1,1220 @@
+/*
+ * Host test for the stage 3a part of vooc_logic.h. cc -I.. test_stage3.c -o test_stage3 && ./test_stage3     (./test_stage3 --tables prints the write tables)
+ * test_logic.c is the stage 2 test and is not touched. Data: capture_round1.h and capture_round2.h, both generated from the stock capture.
+ * What the capture does not contain is synthesised here and says so: the registers 0x00..0x05 and
+ * 0x10 of the flag block (stage 1 / stage 2 hardware read-backs), TDIE (0x1f/0x20), 0x05/0x08 when replaying stock_start = 0.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vooc_logic.h>
+#include "capture_round1.h"
+#include "capture_round2.h"
+
+static int fails, checks;
+
+#define CHECK(c, ...) do { \
+	checks++; \
+	if (!(c)) { \
+		fails++; \
+		printf("FAIL %s:%d: %s  ", __FILE__, __LINE__, #c); \
+		printf(__VA_ARGS__); \
+		printf("\n"); \
+	} \
+} while (0)
+
+#define ALL_MODES (VM_S2 | VM_S3 | VM_S3S)
+
+/* ---- helpers ---- */
+
+static void feed_round1(struct vl *s, struct vl3 *r)
+{
+	u16 tx;
+	int i;
+
+	for (i = 0; i < CAP_N; i++)
+		if (vl3_irq(s, r, cap_rx[i], cap_flags[i], &tx) <= 0)
+			CHECK(0, "round 1 frame %d not answered", i + 1);
+}
+
+/* session in the state after the allow reply: round 1 done, suspend confirmed, second 0x04 answered */
+static void ready_pre(struct vl *s, struct vl3 *r, int cap, int stock_start)
+{
+	u16 tx;
+	int rc;
+
+	vl_init(s, CAP_RL, CAP_RH);
+	vl3_init(r, cap, stock_start);
+	r->suspend_ok = 1;
+	feed_round1(s, r);
+	rc = vl3_irq(s, r, 0x88, 0x07, &tx);
+	CHECK(rc == VL_TX && tx == 0x7002 && r->ph == V3_PRE && (r->act & V3A_HW) && r->predata == 0x2002, "allow reply rc %d tx 0x%04x", rc, tx);
+}
+
+/* decoded values set directly: the raw LSBs (3.75 mV, 1.25 mV) cannot hit every integer mV */
+static void set_mv(struct vl3 *r, int vbus, int vbat)
+{
+	memset(&r->adc, 0, sizeof(r->adc));
+	r->adc.vbus = vbus;
+	r->adc.vbat = vbat;
+	r->adc.vout = vbat;
+	r->adc_ok = 1;
+}
+
+static void set_adc(struct vl3 *r, int ibus, int vbus, int vout, int vbat, int tdie)
+{
+	u8 b[14] = { 0 };
+
+	b[0] = (ibus * 1000 / 1875) >> 8;
+	b[1] = (ibus * 1000 / 1875) & 0xff;
+	b[2] = (vbus * 100 / 375) >> 8;
+	b[3] = (vbus * 100 / 375) & 0xff;
+	b[6] = (vout * 100 / 125) >> 8;
+	b[7] = (vout * 100 / 125) & 0xff;
+	b[8] = (vbat * 100 / 125) >> 8;
+	b[9] = (vbat * 100 / 125) & 0xff;
+	b[12] = (tdie / 5) >> 8;
+	b[13] = (tdie / 5) & 0xff;
+	vl_adc_decode(&r->adc, b);
+	r->adc_ok = 1;
+}
+
+/* a flag/protection block as it reads when everything is fine */
+static void good_blk(u8 *blk, int enabled, int stock_start, int restored)
+{
+	int ucp_off = stock_start && !restored;
+
+	memset(blk, 0, 17);
+	blk[0x00] = 0x36; blk[0x01] = 0xbf; blk[0x02] = 0x01; blk[0x04] = 0x5a;
+	blk[0x05] = ucp_off ? 0xaf : 0x2f;
+	blk[0x06] = enabled ? 0x06 : 0x02;
+	blk[0x07] = enabled ? 0x80 : 0x00;
+	blk[0x08] = ucp_off ? 0x00 : 0xe0;
+	blk[0x09] = 0x13;
+	blk[0x0d] = 0x70;
+	blk[0x0e] = 0x03;
+	blk[0x10] = 0x02;
+}
+
+static void adc_raw(struct vl_adc *a, int ibus_raw, int vbus_raw, int vbat_raw, int seed)
+{
+	u8 b[14] = { 0 };
+
+	b[0] = ibus_raw >> 8; b[1] = ibus_raw;
+	b[2] = vbus_raw >> 8; b[3] = vbus_raw;
+	b[8] = vbat_raw >> 8; b[9] = vbat_raw;
+	b[10] = seed;
+	vl_adc_decode(a, b);
+}
+
+/* ---- a: the capture, round 2, from the second 0x04 to the secondary pump's start ---- */
+
+static void replay(int cap, int stock_start)
+{
+	struct vl s;
+	struct vl3 r;
+	struct vl_adc a, prev;
+	u8 blk[17], b14[14];
+	int k, i, rc, ndiff = 0, t_en = -1, nrestore = 0, ncheck_post = 0;
+	unsigned int hw_n;
+	u16 tx;
+	u8 r05 = 0x2f;
+	struct vl_row hw[12];
+
+	vl_init(&s, CAP_RL, CAP_RH);
+	vl3_init(&r, cap, stock_start);
+	r.suspend_ok = 1;
+	feed_round1(&s, &r);
+	CHECK(s.state == VL_DONE, "state %d after round 1", s.state);
+
+	for (k = 0; k < C2_N; k++) {
+		const struct c2_frame *f = &c2[k];
+		int want_ask = ((f->rx & 0x1e) >> 1) == 3;
+		u16 want = f->tx;
+
+		if (cap != V3_STOCK_ASK && want_ask)
+			want = (cap << 8) | 0x0002;	/* the ask-current word is (value << 8) | 2 for every value: the 7 bits mirror onto themselves */
+		tx = 0;
+		rc = vl3_irq(&s, &r, f->rx, f->fl, &tx);
+		CHECK(rc == VL_TX, "frame %d (uptime 18910.%06u) returned %d", k, f->t_us, rc);
+		CHECK(tx == want, "frame %d (rx 0x%02x): tx 0x%04x, capture 0x%04x, expected 0x%04x", k, f->rx, tx, f->tx, want);
+		if (tx != f->tx) {
+			ndiff++;
+			CHECK(want_ask && cap != V3_STOCK_ASK, "frame %d differs from the capture and is not an ask-current reply", k);
+		}
+		CHECK(!!(r.act & V3A_ENABLE) == f->en, "frame %d: enable action %d, capture %d", k, !!(r.act & V3A_ENABLE), f->en);
+		CHECK(!!(r.act & V3A_PREDATA) == !!f->pre && (!f->pre || r.predata == f->pre), "frame %d: predata act %d value 0x%04x, capture 0x%04x", k, r.act & V3A_PREDATA, r.predata, f->pre);
+		CHECK(!!(r.act & V3A_HW) == !!f->nhw, "frame %d: hw action %d, capture %d writes", k, !!(r.act & V3A_HW), f->nhw);
+		if (f->en && t_en < 0)
+			t_en = f->t_us;
+		if (r.act & V3A_HW) {		/* our rows against the capture's, in order; the capture's RMW reads are not writes */
+			hw_n = 0;
+			for (i = 0; i < (int)VL3_NHW; i++)
+				hw[hw_n++] = vl3_hw_rows[i];
+			if (stock_start)
+				for (i = 0; i < VL3_NSTART; i++)
+					hw[hw_n++] = vl3_start_rows[i];
+			CHECK(hw_n == f->nhw - (stock_start ? 0 : 2), "hw rows: ours %u, capture %d", hw_n, f->nhw);
+			for (i = 0; i < (int)hw_n && i < f->nhw; i++)
+				CHECK(hw[i].reg == f->hw[i][0] && hw[i].val == f->hw[i][1] && hw[i].w == 1, "hw row %d: ours %02x=%02x, capture %02x=%02x", i, hw[i].reg, hw[i].val, f->hw[i][0], f->hw[i][1]);
+		}
+
+		/* what stock reads after the frame: flag block, ADC block; 0x00..0x05 and 0x10 are synthetic (hardware read-backs of stage 1) */
+		good_blk(blk, 0, 0, 0);
+		memcpy(blk + 6, f->blk, 10);
+		if (f->r05)
+			r05 = f->r05;
+		blk[0x05] = stock_start ? r05 : 0x2f;
+		CHECK(!stock_start || r05 == (k <= 15 ? 0xaf : 0x2f), "frame %d: 0x05 = 0x%02x", k, r05);
+		if (!stock_start)
+			blk[0x08] = blk[0x08] == 0x00 ? 0xe0 : blk[0x08];	/* our writes never turn the soft-start timeout off */
+		memcpy(b14, f->adc, 10);
+		b14[10] = b14[11] = b14[12] = b14[13] = 0;			/* TDIE is not in the capture: 0 C */
+		vl_adc_decode(&a, b14);
+		rc = vl3_post(&r, blk, &a, t_en < 0 ? 0 : (f->t_us - t_en) / 1000);
+		CHECK(rc == 0, "frame %d: our checks ended stock's own session: %s (block %02x %02x %02x %02x, adc ibus %d vbus %d vbat %d)", k, vl3_why(rc), f->blk[0], f->blk[1], f->blk[3], f->blk[7], a.ibus, a.vbus, a.vbat);
+		CHECK(r.prot_ok, "frame %d: image not accepted", k);
+		ncheck_post++;
+		prev = r.adc;
+		r.adc = a;
+		r.adc_ok = 1;
+		(void)prev;
+		if (vl3_restore_due(&r)) {
+			nrestore++;
+			CHECK(f->npost == 2 && f->post[0][0] == 0x05 && f->post[0][1] == 0x2f && f->post[1][0] == 0x08 && f->post[1][1] == 0xe0, "frame %d: UCP back due, capture post writes %d", k, f->npost);
+			CHECK(vl3_restore_rows[0].reg == 0x05 && vl3_restore_rows[0].val == 0x2f && vl3_restore_rows[1].reg == 0x08 && vl3_restore_rows[1].val == 0xe0, "restore rows");
+			r.restored = 1;
+		} else {
+			CHECK(!(stock_start && f->npost), "frame %d: capture wrote UCP back, we did not", k);
+		}
+	}
+	CHECK(r.ph == V3_RUN && r.enabled && r.i600, "end state ph %d enabled %d i600 %d", r.ph, r.enabled, r.i600);
+	CHECK(nrestore == (stock_start ? 1 : 0), "UCP back %d times", nrestore);
+	CHECK(r.restored == !!stock_start, "restored %d", r.restored);
+	CHECK(ncheck_post == C2_N, "posts %d", ncheck_post);
+	CHECK(ndiff == (cap == V3_STOCK_ASK ? 0 : 1), "%d frames differ from the capture (cap %d)", ndiff, cap);
+	CHECK(r.vdiff_max < 500 && r.vdiff_min > 0, "vdiff %d .. %d", r.vdiff_min, r.vdiff_max);
+	CHECK(r.ibus_max > 1400 && r.ibus_max < 1500, "ibus max %d", r.ibus_max);
+	CHECK(t_en > 0, "no enable seen");
+}
+
+static void replay_all(void)
+{
+	replay(V3_STOCK_ASK, 1);	/* cap = stock's value: identical to the capture, stock_start verbatim */
+	replay(13, 1);			/* cap 13: only the ask-current reply differs */
+	replay(V3_CAP_MAX, 0);		/* stock_start = 0: the same minus the two start rows and the UCP-back rows */
+}
+
+/* ---- c: the VBUS window ---- */
+
+static void window(void)
+{
+	struct vl s;
+	struct vl3 r;
+	static const struct { int d; u16 tx; int st; } t[] = {
+		{ -2000, 0x1002, VB_LOW }, { 0, 0x1002, VB_LOW }, { 99, 0x1002, VB_LOW }, { 100, 0x3002, VB_NORMAL }, { 101, 0x3002, VB_NORMAL },
+		{ 150, 0x3002, VB_NORMAL }, { 199, 0x3002, VB_NORMAL }, { 200, 0x3002, VB_NORMAL }, { 201, 0x2002, VB_HIGH }, { 202, 0x2002, VB_HIGH },
+		{ 3000, 0x2002, VB_HIGH },
+	};
+	unsigned int i;
+	int d, rc;
+	u16 tx;
+
+	/* the capture's own numbers: first answers LOW (diff -2183), nine HIGH, then NORMAL at 137 */
+	CHECK(vl_window(5415, 3799) == VB_LOW && vl_window(8044, 3790) == VB_HIGH && vl_window(7717, 3790) == VB_NORMAL, "capture's diffs");
+	for (i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		ready_pre(&s, &r, 13, 1);
+		r.prot_ok = 1;
+		set_mv(&r, 7600 + t[i].d, 3800);
+		CHECK(vl_window(r.adc.vbus, r.adc.vbat) == t[i].st, "diff %d: window %d", t[i].d, vl_window(r.adc.vbus, r.adc.vbat));
+		tx = 0;
+		rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+		CHECK(rc == VL_TX && tx == t[i].tx, "diff %d: rc %d tx 0x%04x want 0x%04x", t[i].d, rc, tx, t[i].tx);
+		CHECK(!!(r.act & V3A_ENABLE) == (t[i].st == VB_NORMAL), "diff %d: enable %d", t[i].d, r.act & V3A_ENABLE);
+		CHECK(r.ph == (t[i].st == VB_NORMAL ? V3_RUN : V3_PRE), "diff %d: phase %d", t[i].d, r.ph);
+	}
+	for (d = -300; d < 600; d++)		/* every diff: the reply is the window's, the enable only on NORMAL, only once */
+		for (i = 0; i < 2; i++) {
+			ready_pre(&s, &r, 13, 1);
+			r.prot_ok = 1;
+			set_mv(&r, 7600 + d, 3800);
+			rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+			if (i && rc == VL_TX && (r.act & V3A_ENABLE)) {		/* a second NORMAL answer never enables again */
+				rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+				CHECK(rc == VL_TX && !r.act && tx == 0x3002, "second NORMAL: rc %d act %d", rc, r.act);
+			}
+		}
+
+	/* the enable needs the protection image: a mismatch refuses it and the reply is not sent */
+	ready_pre(&s, &r, 13, 1);
+	r.prot_ok = 0;
+	set_mv(&r, 7740, 3800);
+	tx = 0;
+	rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+	CHECK(rc == VL_E_PROT && tx == 0 && !r.act && !r.enabled && r.ph == V3_PRE, "enable without the read-back: rc %d", rc);
+
+	/* VBUS or VBAT below 2000 mV counts HIGH three times, then the session is abnormal; any other answer in between resets it */
+	ready_pre(&s, &r, 13, 1);
+	r.prot_ok = 1;
+	set_mv(&r, 2100, 1000);			/* diff 100, NORMAL but below 2000 mV */
+	for (i = 0; i < 3; i++) {
+		rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+		CHECK(rc == VL_TX && tx == 0x2002 && !r.act && !r.enabled, "low VBAT %u: rc %d tx 0x%04x", i, rc, tx);
+	}
+	CHECK(vl3_irq(&s, &r, 0x84, 0x07, &tx) == VL_E_VBUS, "fourth");
+	ready_pre(&s, &r, 13, 1);
+	r.prot_ok = 1;
+	for (i = 0; i < 20; i++) {
+		set_mv(&r, 2100, 1000);
+		rc = vl3_irq(&s, &r, 0x84, 0x07, &tx);
+		set_mv(&r, 2500, 1000);			/* diff 500: HIGH, resets the count */
+		rc |= vl3_irq(&s, &r, 0x84, 0x07, &tx);
+		CHECK(rc == VL_TX, "reset by another answer, round %u: %d", i, rc);
+	}
+	ready_pre(&s, &r, 13, 1);
+	r.adc_ok = 0;
+	CHECK(vl3_irq(&s, &r, 0x84, 0x07, &tx) == VL_E_VBUS, "no ADC value");
+}
+
+/* ---- e: the allow bit ---- */
+
+static void allow_bit(void)
+{
+	struct vl s;
+	struct vl3 r;
+	u16 tx;
+	int rc, i, n, k, allowed;
+
+	/* not confirmed: the second 0x04 is not answered (stage 2's end), nothing after it either */
+	vl_init(&s, CAP_RL, CAP_RH);
+	vl3_init(&r, 13, 0);
+	feed_round1(&s, &r);
+	tx = 0;
+	rc = vl3_irq(&s, &r, 0x88, 0x07, &tx);
+	CHECK(rc == VL_NONE && tx == 0 && s.state == VL_STOP && r.ph == V3_ASK && !r.act, "unconfirmed: rc %d state %d", rc, s.state);
+	r.suspend_ok = 1;			/* too late: the dialogue has ended */
+	for (i = 0; i < 256; i++) {
+		tx = 0;
+		rc = vl3_irq(&s, &r, i, 0x07, &tx);
+		CHECK(rc == VL_NONE && tx == 0, "after the withheld allow: rx 0x%02x rc %d", i, rc);
+	}
+	/* the same call with the confirmation answers 0x7002 and only once */
+	ready_pre(&s, &r, 13, 0);
+	rc = vl3_irq(&s, &r, 0x88, 0x07, &tx);
+	CHECK(rc == VL_E_CMD, "third 0x04: %d", rc);
+
+	/* every reply that carries the allow bit is the reply to the 0x04 that came after the confirmation; fuzz over random frames */
+	srand(3);
+	for (n = 0; n < 4000; n++) {
+		vl_init(&s, rand(), rand());
+		vl3_init(&r, 1 + rand() % 13, rand() & 1);
+		r.suspend_ok = 0;
+		allowed = 0;
+		for (k = 0; k < 60; k++) {
+			u8 rx = rand() % 3 ? cap_rx[rand() % CAP_N] : rand();
+			u8 fl = rand() % 5 ? 0x07 : rand();
+			u8 was_ok = r.suspend_ok;
+
+			if (rand() % 20 == 0)
+				r.suspend_ok ^= 1;
+			if (s.state == VL_DONE && rand() % 2) {
+				set_adc(&r, rand() % 2000, 7000 + rand() % 1500, 3600 + rand() % 400, 3600 + rand() % 400, 0);
+				r.prot_ok = rand() & 1;
+			}
+			if (s.state < VL_DONE && !(rand() % 3))		/* walk round 1 so that the later states get visited */
+				rx = cap_rx[k < CAP_N ? k : 0], fl = k < CAP_N ? cap_flags[k] : 0x07;
+			tx = 0;
+			rc = vl3_irq(&s, &r, rx, fl, &tx);
+			if (rc > 0 && s.now == VC_ASK && s.state == VL_DONE && r.ph != V3_ASK) {
+				CHECK(tx == 0x7002 && r.suspend_ok && !allowed, "allow reply 0x%04x with suspend_ok %d (was %d), second %d", tx, r.suspend_ok, was_ok, allowed);
+				allowed++;
+			} else if (rc > 0 && s.now == VC_ASK) {
+				CHECK(tx == 0x3002, "round 1 0x04 reply 0x%04x", tx);
+			}
+			if (rc < 0 || s.state == VL_STOP)
+				break;
+		}
+	}
+}
+
+/* ---- the other replies and the dispatcher ---- */
+
+static void dispatcher(void)
+{
+	struct vl s, c;
+	struct vl3 r, rc3;
+	u16 tx;
+	int rc, i, fl, v;
+
+	/* stage 2 unchanged: before the last row vl3_irq is vl_irq, byte for byte */
+	srand(5);
+	for (i = 0; i < 3000; i++) {
+		struct vl a, b;
+		struct vl3 x;
+		int k;
+
+		vl_init(&a, rand(), rand());
+		b = a;
+		vl3_init(&x, 13, 1);
+		for (k = 0; k < 40 && a.state < VL_DONE; k++) {
+			u8 rx = rand() % 3 ? cap_rx[rand() % CAP_N] : rand();
+			u8 fl2 = rand() % 4 ? 0x07 : rand();
+			u16 t1 = 0, t2 = 0;
+			int r1 = vl_irq(&a, rx, fl2, &t1), r2 = vl3_irq(&b, &x, rx, fl2, &t2);
+
+			CHECK(r1 == r2 && t1 == t2 && a.state == b.state && a.seen == b.seen && a.pend == b.pend, "round 1 differs: %d %d", r1, r2);
+			if (r1 < 0)
+				break;
+		}
+	}
+
+	ready_pre(&s, &r, 13, 1);
+	for (fl = 0; fl < 256; fl++) {		/* every PHY abort flag ends it, after the allow reply too */
+		c = s;
+		rc3 = r;
+		tx = 0;
+		rc = vl3_irq(&c, &rc3, 0x82, fl, &tx);
+		set_adc(&rc3, 0, 7700, 3770, 3800, 0);
+		CHECK((rc == VL_E_FLAG) == !!(fl & VF_ABORT) && (rc != VL_E_FLAG || (tx == 0 && !rc3.act)), "flags 0x%02x: %d", fl, rc);
+	}
+	for (i = 0; i < 256; i++) {
+		c = s;
+		rc3 = r;
+		set_adc(&rc3, 0, 7700, 3770, 3800, 0);
+		rc3.prot_ok = 1;
+		tx = 0;
+		rc = vl3_irq(&c, &rc3, i, 0x07, &tx);
+		if ((i & 0xe0) != 0x80)
+			CHECK(rc == VL_E_HEAD && tx == 0, "head 0x%02x: %d", i, rc);
+		else switch ((i & 0x1e) >> 1) {
+		case 1: case 2: case 0x0a:
+			CHECK(rc == VL_TX, "cmd 0x%02x rejected: %d", (i & 0x1e) >> 1, rc);
+			break;
+		case 3:				/* ask-current before the enable: stock's copycat check ends it */
+			CHECK(rc == VL_E_CMD && tx == 0, "ask-current before the enable: %d", rc);
+			break;
+		default:
+			CHECK(rc == VL_E_CMD && tx == 0, "cmd 0x%02x: %d", (i & 0x1e) >> 1, rc);
+		}
+	}
+	CHECK(vl3_irq(&s, &r, 0x88, 0x00, &tx) == VL_NONE, "no RXDATA_DONE");
+
+	/* ask-current: min(cap, stock's table value) for every cap and every table value */
+	for (v = 1; v <= 127; v++)
+		for (i = 1; i <= 13; i++) {
+			ready_pre(&s, &r, i, 0);
+			r.stock_ask = v;
+			r.ph = V3_RUN;
+			tx = 0;
+			rc = vl3_irq(&s, &r, 0x86, 0x07, &tx);
+			CHECK(rc == VL_TX && tx == (u16)(((i < v ? i : v) << 8) | 2) && !r.act, "cap %d stock %d: tx 0x%04x", i, v, tx);
+		}
+
+	/* battery voltage: stock's formula on stock's own inputs (its kernel log: vbus 7642 vsys 3765 vbat 3783 ichg 1 -> 0x2a) and clamps */
+	ready_pre(&s, &r, 13, 0);
+	r.ph = V3_RUN;
+	set_mv(&r, 7642, 3783);
+	r.adc.vout = 3765;
+	r.adc.ibus = 1;
+	CHECK(vl_batt_code(&r.adc) == 0x2a, "stock's code 0x%02x", vl_batt_code(&r.adc));
+	set_mv(&r, 6000, 3000);
+	CHECK(vl_batt_code(&r.adc) == 0, "low clamp");
+	set_mv(&r, 9990, 4600);
+	CHECK(vl_batt_code(&r.adc) == 125, "high clamp %d", vl_batt_code(&r.adc));
+	tx = 0;
+	rc = vl3_irq(&s, &r, 0x82, 0x07, &tx);
+	CHECK(rc == VL_TX && (r.act & V3A_PREDATA) && r.predata == tx && !(r.act & (V3A_ENABLE | V3A_HW)), "battery-voltage reply: predata 0x%04x tx 0x%04x", r.predata, tx);
+	CHECK(vl3_data_word(0x2a) == 0x2a02 && vl3_data_word(0x49) == 0x4902 && vl3_data_word(0x7f) == 0x7f02 && vl3_data_word(0) == 0x0002, "data word");
+}
+
+/* ---- b: the limits, each one crossed, and the pump-off write first ---- */
+
+static struct sim {
+	int n;
+	u8 reg[128];
+	u16 val[128];
+	u8 w[128];
+	u8 r06, r07;
+	int stuck, fail_reg, fail_once, rd_fail;
+	int unwhitelisted;
+} sim;
+
+static int sim_wr(void *c, u8 reg, u8 w, u16 val)
+{
+	(void)c;
+	if (!(vl_write_ok_m(reg, w, val, ALL_MODES)))
+		sim.unwhitelisted++;
+	if (sim.n < 128) {
+		sim.reg[sim.n] = reg;
+		sim.w[sim.n] = w;
+		sim.val[sim.n++] = val;
+	}
+	if (reg == sim.fail_reg && (!sim.fail_once || sim.fail_once-- > 0)) {
+		if (sim.fail_once == 0)
+			sim.fail_reg = -1;
+		return -5;
+	}
+	if (reg == 0x07 && val == 0 && !sim.stuck) {
+		sim.r07 &= 0x7f;
+		sim.r06 &= ~0x04;
+	}
+	return 0;
+}
+
+static int sim_rd(void *c, u8 reg, u8 n, u8 *b)
+{
+	(void)c;
+	if (sim.rd_fail)
+		return -5;
+	CHECK(reg == 0x06 && n == 2, "ladder read %02x/%d", reg, n);
+	b[0] = sim.r06;
+	b[1] = sim.r07;
+	return 2;
+}
+
+static void sim_dly(void *c, int ms)
+{
+	(void)c;
+	(void)ms;
+}
+
+static const struct vl3_io simio = { 0, sim_wr, sim_rd, sim_dly, 0, 0 };
+
+static void sim_reset(int running)
+{
+	memset(&sim, 0, sizeof(sim));
+	sim.fail_reg = -1;
+	sim.r06 = running ? 0x06 : 0x02;
+	sim.r07 = running ? 0x80 : 0x07;
+}
+
+/* what the module does when anything ends a session while the pump runs: off at once in the context that saw it, then the ladder */
+static void sim_end(int running, int stock_start, int restored, struct vl3_lad *l)
+{
+	memset(l, 0, sizeof(*l));
+	if (running)
+		sim_wr(0, 0x07, 1, 0x00);
+	vl3_ladder_pump(&simio, l, running, stock_start, restored);
+}
+
+static void ladder_rows_ok(int stock_start, int restored)
+{
+	unsigned int i, k = 1;			/* sim.reg[0] is the off, then the confirm read, then the rows */
+
+	CHECK(sim.reg[0] == 0x07 && sim.val[0] == 0 && sim.w[0] == 1, "first write 0x%02x = 0x%x", sim.reg[0], sim.val[0]);
+	for (i = 1; i < VL3_NEXIT; i++) {
+		CHECK(k < (unsigned int)sim.n && sim.reg[k] == vl_exit_rows[i].reg && sim.val[k] == vl_exit_rows[i].val && sim.w[k] == vl_exit_rows[i].w, "exit row %u: got %02x=%x", i, sim.reg[k], sim.val[k]);
+		k++;
+		if (vl_exit_rows[i].reg == 0x05 && stock_start && !restored) {
+			CHECK(sim.reg[k] == 0x08 && sim.val[k] == 0xe0, "soft-start timeout back after 0x05");
+			k++;
+		}
+	}
+	CHECK(k == (unsigned int)sim.n, "%d writes, %u expected", sim.n, k);
+	CHECK(!sim.unwhitelisted, "%d ladder writes outside the table", sim.unwhitelisted);
+}
+
+static void ladder(void)
+{
+	struct vl3_lad l;
+	int ss, rs;
+
+	for (ss = 0; ss < 2; ss++)
+		for (rs = 0; rs < 2; rs++) {
+			sim_reset(1);
+			sim_end(1, ss, rs, &l);
+			CHECK(l.off_ok && l.off_tries == 0 && !l.wdt_kept && !l.rows_fail && !(sim.r07 & 0x80), "normal end: ok %d tries %d", l.off_ok, l.off_tries);
+			ladder_rows_ok(ss, rs);
+		}
+	sim_reset(0);					/* never enabled: the ladder itself writes the off first */
+	sim_end(0, 0, 0, &l);
+	CHECK(l.off_ok && sim.reg[0] == 0x07 && sim.val[0] == 0, "not enabled: first write");
+
+	sim_reset(1);					/* the first off write fails: written again, the rest follows */
+	sim.fail_reg = 0x07;
+	sim.fail_once = 1;
+	sim_end(1, 0, 0, &l);
+	CHECK(l.off_ok && l.off_tries >= 1 && sim.reg[0] == 0x07 && sim.reg[1] == 0x07 && sim.val[1] == 0, "failed off write: tries %d ok %d", l.off_tries, l.off_ok);
+
+	sim_reset(1);					/* the pump stays on: 10 tries, the watchdog row is NOT written, every other row is */
+	sim.stuck = 1;
+	sim_end(1, 0, 0, &l);
+	{
+		unsigned int i;
+		int wdt = 0;
+
+		for (i = 0; i < (unsigned int)sim.n; i++)
+			wdt += sim.reg[i] == 0x09;
+		CHECK(!l.off_ok && l.wdt_kept && wdt == 0 && l.off_tries == VL3_OFF_TRIES - 1, "stuck pump: ok %d wdt_kept %d wdt rows %d tries %d", l.off_ok, l.wdt_kept, wdt, l.off_tries);
+		CHECK(sim.reg[sim.n - 1] == 0x10 && sim.val[sim.n - 1] == 0x02, "the rest of the rows still ran");
+	}
+	sim_reset(1);					/* reads fail: not confirmed either */
+	sim.rd_fail = 1;
+	sim_end(1, 0, 0, &l);
+	CHECK(!l.off_ok && l.wdt_kept && l.rd_fail >= 10, "read failures: ok %d", l.off_ok);
+
+	sim_reset(1);					/* a failing row does not stop the others */
+	sim.fail_reg = 0x04;
+	sim_end(1, 0, 0, &l);
+	CHECK(l.rows_fail == 1 && l.off_ok && sim.n == 1 + (int)VL3_NEXIT - 1, "failing row: fails %d writes %d", l.rows_fail, sim.n);
+}
+
+/* a clean running state to cross limits from */
+static void run_state(struct vl3 *r, int cap)
+{
+	vl3_init(r, cap, 0);
+	r->ph = V3_RUN;
+	r->enabled = 1;
+	r->vbus_st = VB_NORMAL;
+	r->adc_ok = 1;
+	adc_raw(&r->adc, 700, 2090, 3040, 1);	/* ibus 1312, vbus 7837, vbat 3800 */
+	r->sw_seen = 1;
+}
+
+static int post1(struct vl3 *r, const u8 *blk, int ibus_raw, int vbus_raw, int vbat_raw, int seed, int ms_on)
+{
+	struct vl_adc a;
+	int rc;
+
+	adc_raw(&a, ibus_raw, vbus_raw, vbat_raw, seed);
+	rc = vl3_post(r, blk, &a, ms_on);
+	r->adc = a;
+	r->adc_ok = 1;
+	return rc;
+}
+
+/* every crossing ends the session, the end writes the off first and then the exit rows */
+static void ends_with_off(const char *what, int code)
+{
+	struct vl3_lad l;
+
+	CHECK(code != 0, "%s: no abort", what);
+	sim_reset(1);
+	sim_end(1, 1, 0, &l);
+	CHECK(sim.reg[0] == 0x07 && sim.val[0] == 0 && l.off_ok, "%s: the first write is 0x%02x = 0x%x", what, sim.reg[0], sim.val[0]);
+}
+
+static void limits(void)
+{
+	struct vl3 r;
+	u8 blk[17];
+	int i, b, rc, n;
+	static const struct { int reg; u8 mask; } fl[] = {
+		{ 0x06, 0x80 }, { 0x06, 0x40 }, { 0x06, 0x08 }, { 0x06, 0x01 }, { 0x09, 0x08 }, { 0x0d, 0x08 }, { 0x0d, 0x04 }, { 0x0e, 0x80 }, { 0x0e, 0x40 },
+		{ 0x0e, 0x20 }, { 0x0e, 0x10 }, { 0x0e, 0x08 }, { 0x0f, 0x80 }, { 0x0f, 0x40 }, { 0x0f, 0x20 }, { 0x0f, 0x10 }, { 0x0f, 0x08 }, { 0x0f, 0x04 },
+	};
+
+	/* the quiet state passes */
+	run_state(&r, 13);
+	good_blk(blk, 1, 0, 0);
+	CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == 0, "quiet state");
+
+	/* L1: every listed fault flag, enabled or not, with and without stock_start */
+	for (i = 0; i < (int)(sizeof(fl) / sizeof(fl[0])); i++) {
+		int en;
+
+		for (en = 0; en < 2; en++) {
+			run_state(&r, 13);
+			r.enabled = en;
+			good_blk(blk, en, 0, 0);
+			blk[fl[i].reg] |= fl[i].mask;
+			rc = post1(&r, blk, 700, 2090, 3040, 2, 500);
+			CHECK(rc == V3E_FLAGS, "flag %02x.%02x enabled %d: %d", fl[i].reg, fl[i].mask, en, rc);
+			ends_with_off("L1", rc);
+		}
+	}
+	/* flags that stock's own blocks show set are not faults: 0x06 0x22 / 0x02 / 0x06, 0x09 0x33 (UCP rise), 0x0e 0x03, 0x0f 0x02 */
+	run_state(&r, 13);
+	good_blk(blk, 1, 0, 0);
+	blk[0x09] = 0x33;
+	blk[0x0f] = 0x02;
+	CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == 0, "UCP-rise flag is not a fault");
+	run_state(&r, 13);
+	r.enabled = 0;
+	good_blk(blk, 0, 0, 0);
+	blk[0x06] = 0x22;
+	blk[0x07] = 0x07;
+	CHECK(post1(&r, blk, 0, 1445, 3040, 2, 0) == 0, "0x06 = 0x22, 0x07 = 0x07 before the enable are idle");
+
+	/* the image: every protection register, every bit */
+	for (i = 0; i < 17; i++) {
+		static const u8 chk[] = { 0x00, 0x01, 0x02, 0x04, 0x05, 0x08, 0x09, 0x0d, 0x10 };
+		unsigned int j;
+
+		for (j = 0; j < sizeof(chk); j++) {
+			if (chk[j] != i)
+				continue;
+			for (b = 0; b < 8; b++) {
+				int ss;
+
+				for (ss = 0; ss < 2; ss++) {
+					run_state(&r, 13);
+					r.stock_start = ss;
+					good_blk(blk, 1, ss, 0);
+					blk[i] ^= 1 << b;
+					rc = post1(&r, blk, 700, 2090, 3040, 2, 500);
+					/* bits the image masks are judged elsewhere (0x02.4, 0x09 flags, 0x0d flags) */
+					if (rc == 0)
+						CHECK((i == 0x02 && b == 4) || (i == 0x09 && (b == 6 || b == 5 || b == 3)) || (i == 0x0d && b < 4), "image %02x bit %d not noticed", i, b);
+					else if (!(rc == V3E_FLAGS))
+						CHECK(rc == V3E_IMAGE, "image %02x bit %d: %d", i, b, rc);
+					if (rc == V3E_IMAGE)
+						ends_with_off("image", rc);
+				}
+			}
+		}
+	}
+	run_state(&r, 13);					/* a pump that reset itself: POR flag and default registers */
+	good_blk(blk, 1, 0, 0);
+	blk[0x09] = 0x40;
+	CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == V3E_IMAGE, "reset pump");
+	for (b = 0; b < 2; b++) {				/* stock_start: the image follows the UCP-back state */
+		run_state(&r, 13);
+		r.stock_start = 1;
+		r.restored = b;
+		good_blk(blk, 1, 1, !b);			/* the other state's image */
+		CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == V3E_IMAGE, "stock_start image restored %d", b);
+		run_state(&r, 13);
+		r.stock_start = 1;
+		r.restored = b;
+		good_blk(blk, 1, 1, b);
+		CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == 0, "stock_start image restored %d, right one", b);
+	}
+
+	/* pump not idle before the enable; CHG_EN dropped, VBUS error and stopped switching while enabled */
+	run_state(&r, 13);
+	r.enabled = 0;
+	good_blk(blk, 0, 0, 0);
+	blk[0x07] = 0x80;
+	rc = post1(&r, blk, 0, 1445, 3040, 2, 0);
+	CHECK(rc == V3E_IDLE, "CHG_EN before the enable: %d", rc);
+	ends_with_off("idle", rc);
+	run_state(&r, 13);
+	r.enabled = 0;
+	good_blk(blk, 0, 0, 0);
+	blk[0x06] = 0x06;
+	CHECK(post1(&r, blk, 0, 1445, 3040, 2, 0) == V3E_IDLE, "switching before the enable");
+	for (n = 0; n <= 1100; n += 20) {			/* 100 ms grace after the enable, then CHG_EN must read set */
+		run_state(&r, 13);
+		good_blk(blk, 1, 0, 0);
+		blk[0x07] = 0x00;
+		rc = post1(&r, blk, 700, 2090, 3040, 2, n);
+		CHECK(rc == (n >= 100 ? V3E_CHGEN : 0), "CHG_EN clear %d ms after the enable: %d", n, rc);
+		run_state(&r, 13);
+		good_blk(blk, 1, 0, 0);
+		blk[0x06] |= 0x10;
+		rc = post1(&r, blk, 700, 2090, 3040, 2, n);
+		CHECK(rc == (n >= 100 ? V3E_VERR : 0), "VBUS error %d ms after the enable: %d", n, rc);
+	}
+	ends_with_off("CHG_EN", V3E_CHGEN);
+	run_state(&r, 13);
+	good_blk(blk, 1, 0, 0);
+	blk[0x06] = 0x02;					/* not switching: 3 reads, only after switching was seen */
+	CHECK(post1(&r, blk, 700, 2090, 3040, 2, 500) == 0 && post1(&r, blk, 700, 2090, 3040, 3, 500) == 0, "two reads without switching");
+	rc = post1(&r, blk, 700, 2090, 3040, 4, 500);
+	CHECK(rc == V3E_LOST, "third read without switching: %d", rc);
+	ends_with_off("LOST", rc);
+	run_state(&r, 13);
+	r.sw_seen = 0;
+	blk[0x06] = 0x02;
+	for (i = 0; i < 20; i++)
+		CHECK(post1(&r, blk, 700, 2090, 3040, i, 500) == 0, "never switched yet: no LOST");
+
+	/* ADC limits: VBUS 10.0 V after the allow bit (6.0 V before it), IBUS 5300, cap + 300 on 3 reads, VDIFF 500 on 3 reads, TDIE 70.0, VBAT 4450 */
+	good_blk(blk, 1, 0, 0);
+	for (n = 2660; n <= 2680; n++) {			/* VBUS raw * 3.75: 9975 .. 10050 mV around 10000 */
+		struct vl_adc a;
+
+		run_state(&r, 13);
+		adc_raw(&a, 700, n, 3040, 2);
+		rc = vl3_post(&r, blk, &a, 500);
+		CHECK((rc == V3E_VBUS) == (a.vbus > 10000), "vbus %d: %d", a.vbus, rc);
+		if (rc == V3E_VBUS)
+			ends_with_off("VBUS 10 V", rc);
+	}
+	for (n = 1590; n <= 1620; n++) {			/* 6000 mV before the allow */
+		struct vl_adc a;
+
+		run_state(&r, 13);
+		r.ph = V3_ASK;
+		r.enabled = 0;
+		good_blk(blk, 0, 0, 0);
+		adc_raw(&a, 0, n, 3040, 2);
+		rc = vl3_post(&r, blk, &a, 0);
+		CHECK((rc == V3E_VBUS) == (a.vbus > 6000), "pre-allow vbus %d: %d", a.vbus, rc);
+	}
+	good_blk(blk, 1, 0, 0);
+	run_state(&r, 13);
+	rc = post1(&r, blk, 2900, 2090, 3040, 2, 500);		/* 5437 mA */
+	CHECK(rc == V3E_IBUS_MAX, "ibus 5437: %d", rc);
+	ends_with_off("IBUS max", rc);
+	for (n = 2780; n <= 2830; n++) {			/* 5213 .. 5306 mA around 5300 */
+		struct vl_adc a;
+
+		run_state(&r, 40);
+		adc_raw(&a, n, 2090, 3040, 2);
+		rc = vl3_post(&r, blk, &a, 500);
+		CHECK((rc == V3E_IBUS_MAX) == (a.ibus > 5300), "ibus %d: %d", a.ibus, rc);
+	}
+	for (b = 1; b <= 13; b++) {				/* A5: above cap + 300 mA on three consecutive reads, any cap */
+		int thr = b * 100 + 300, raw = (thr + 1) * 1000 / 1875 + 1;
+
+		run_state(&r, b);
+		CHECK(post1(&r, blk, thr * 1000 / 1875 - 2, 2090, 3040, 2, 500) == 0, "cap %d: at the limit", b);
+		CHECK(post1(&r, blk, raw, 2090, 3040, 3, 500) == 0 && post1(&r, blk, raw, 2090, 3040, 4, 500) == 0, "cap %d: two reads over", b);
+		rc = post1(&r, blk, raw, 2090, 3040, 5, 500);
+		CHECK(rc == V3E_IBUS_CAP, "cap %d: third read over: %d (adc %d vs %d)", b, rc, r.adc.ibus, thr);
+		ends_with_off("A5", rc);
+		run_state(&r, b);				/* a read below in between resets the count: two over, one below, forever */
+		for (i = 0; i < 30; i++)
+			CHECK(post1(&r, blk, i % 3 == 2 ? 100 : raw, 2090, 3040, 10 + i, 500) == 0, "cap %d: no reset at read %d", b, i);
+	}
+	for (n = 2150; n <= 2170; n++) {			/* VBUS - 2 x VBAT above 500 mV on three reads: raw VBUS 2160 = 8100 mV, vbat 3040 raw = 3800 mV */
+		int d;
+
+		run_state(&r, 13);
+		d = n * 375 / 100 - 2 * 3800;
+		rc = post1(&r, blk, 400, n, 3040, 2, 500);
+		rc |= post1(&r, blk, 400, n, 3040, 3, 500);
+		CHECK(rc == 0, "diff %d: two reads", d);
+		rc = post1(&r, blk, 400, n, 3040, 4, 500);
+		CHECK((rc == V3E_VDIFF) == (d > 500) && (d > 500 || rc == 0), "diff %d third read: %d", d, rc);
+		if (n == 2160 || n == 2161)
+			CHECK(d == (n == 2160 ? 500 : 503), "test arithmetic: diff %d at raw %d", d, n);
+	}
+	{							/* the limit grows above 1 A: 500 + 0.30 mV per mA (stock: 970 mV at 3.7 A) */
+		static const int ib[] = { 750, 1000, 1312, 2000, 2500, 3000, 3700, 5000 };
+		unsigned int k;
+
+		for (k = 0; k < sizeof(ib) / sizeof(ib[0]); k++) {
+			int raw = ib[k] * 1000 / 1875, ma = raw * 1875 / 1000, lim = 500 + (ma > 1000 ? (ma - 1000) * 3 / 10 : 0);
+
+			for (n = 2100; n <= 2700; n++) {
+				int d = n * 375 / 100 - 2 * 3800;
+
+				if (d < lim - 4 || d > lim + 4)
+					continue;
+				run_state(&r, 73);
+				rc = post1(&r, blk, raw, n, 3040, 2, 500) | post1(&r, blk, raw, n, 3040, 3, 500);
+				rc |= post1(&r, blk, raw, n, 3040, 4, 500);
+				CHECK((rc == V3E_VDIFF) == (d > lim), "IBUS %d mA: diff %d against %d: %d", ma, d, lim, rc);
+			}
+		}
+		CHECK(vl3_vdiff_max(3688) == 1306 && vl3_vdiff_max(1000) == 500 && vl3_vdiff_max(0) == 500, "vdiff limit values");
+	}
+	run_state(&r, 13);
+	post1(&r, blk, 700, 2400, 3040, 7, 500);		/* diff 1200, two reads, then a good one, then two more: no abort */
+	post1(&r, blk, 700, 2400, 3040, 8, 500);
+	CHECK(post1(&r, blk, 700, 2090, 3040, 9, 500) == 0 && post1(&r, blk, 700, 2400, 3040, 10, 500) == 0 && post1(&r, blk, 700, 2400, 3040, 11, 500) == 0, "vdiff count resets");
+	rc = post1(&r, blk, 700, 2400, 3040, 12, 500);
+	CHECK(rc == V3E_VDIFF, "vdiff third: %d", rc);
+	ends_with_off("VDIFF", rc);
+	for (n = 135; n <= 145; n++) {				/* TDIE in 0.5 C counts: 700 = 70.0 C is raw 140 */
+		struct vl_adc a;
+		u8 raw14[14] = { 0 };
+
+		run_state(&r, 13);
+		raw14[2] = (u8)(2090 >> 8); raw14[3] = (u8)2090; raw14[8] = (u8)(3040 >> 8); raw14[9] = (u8)3040; raw14[1] = 100;
+		raw14[12] = (u8)(n >> 8); raw14[13] = (u8)n;
+		vl_adc_decode(&a, raw14);
+		rc = vl3_post(&r, blk, &a, 500);
+		CHECK((rc == V3E_TDIE) == (a.tdie > 700) && a.tdie == n * 5, "tdie %d: %d", a.tdie, rc);
+		if (rc == V3E_TDIE)
+			ends_with_off("A3", rc);
+	}
+	for (n = 3555; n <= 3565; n++) {			/* VBAT 4450 mV = raw 3560 */
+		struct vl_adc a;
+
+		run_state(&r, 13);
+		adc_raw(&a, 700, 2090 + 2 * (n - 3040) * 125 / 375, n, 2);
+		rc = vl3_post(&r, blk, &a, 500);
+		if (a.vbat > 4450)
+			CHECK(rc == V3E_VBAT || rc == V3E_VBUS, "vbat %d: %d", a.vbat, rc);
+		else
+			CHECK(rc != V3E_VBAT, "vbat %d: %d", a.vbat, rc);
+	}
+	run_state(&r, 13);
+	{
+		struct vl_adc a;
+
+		adc_raw(&a, 700, 2090, 3560 + 1, 2);
+		rc = vl3_post(&r, blk, &a, 500);
+		CHECK(rc == V3E_VBAT, "pump VBAT 4451: %d", rc);
+		ends_with_off("A6 pump", rc);
+	}
+
+	/* stale ADC: six identical blocks end it, the capture's longest run is two */
+	run_state(&r, 13);
+	for (i = 1; i < 12; i++) {
+		rc = post1(&r, blk, 700, 2090, 3040, 9, 500);
+		CHECK(rc == (i >= 6 ? V3E_STALE : 0), "identical block %d: %d", i, rc);
+		if (rc)
+			break;
+	}
+	CHECK(i == 6, "stale ended it at read %d, wanted 6", i);
+	ends_with_off("stale", rc);
+	run_state(&r, 13);
+	for (i = 0; i < 40; i++)				/* the capture's pattern: runs of two */
+		CHECK(post1(&r, blk, 700, 2090, 3040, i / 2, 500) == 0, "runs of two %d", i);
+
+	/* 600 mA: the UCP-back mark and the start mark, at the boundary */
+	good_blk(blk, 1, 0, 0);
+	for (n = 598; n <= 603; n++) {
+		struct vl_adc a;
+
+		run_state(&r, 13);
+		r.stock_start = 1;
+		adc_raw(&a, 1, 1, 1, 1);
+		a.ibus = n;
+		r.adc = a;
+		CHECK(vl3_restore_due(&r) == (n > 600), "restore due at %d mA", n);
+		run_state(&r, 13);
+		adc_raw(&a, 700, 2090, 3040, 2);
+		a.ibus = n;
+		a.raw[1] ^= 1;
+		rc = vl3_post(&r, blk, &a, 500);
+		CHECK(rc == 0 && r.i600 == (n > 600), "600 mA mark at %d mA: rc %d i600 %d", n, rc, r.i600);
+	}
+
+	/* clock limits */
+	{
+		struct vl3_clk c = { 0 };
+
+		c.t_hs = 100;
+		c.hold_ms = 120000;
+		c.t_en = -1;
+		for (c.now = 100; c.now <= 3300; c.now++)
+			CHECK((vl3_time(&c) == V3T_FIRST) == (c.now - c.t_hs > 2000), "no first frame at %d", c.now);
+		c.frames = 1;
+		c.t_last = 1000;
+		for (c.now = 1000; c.now <= 1250; c.now++)
+			CHECK((vl3_time(&c) == V3T_NOFRAME) == (c.now - c.t_last > 200), "no frame at %d", c.now);
+		c.t_last = 4900;
+		for (c.now = 4900; c.now <= 5200; c.now += 1) {		/* not enabled within 5 s of the start */
+			c.t_last = c.now;
+			CHECK((vl3_time(&c) == V3T_PRE) == (c.now - c.t0 > 5000), "pre-enable at %d", c.now);
+		}
+		ends_with_off("PRE", V3T_PRE);
+		c.t_en = 10000;
+		c.t0 = 0;
+		for (c.now = 10000; c.now <= 11100; c.now++) {		/* IBUS above 600 mA within 1.0 s of the enable */
+			c.t_last = c.now;
+			c.i600 = 0;
+			CHECK((vl3_time(&c) == V3T_START) == (c.now - c.t_en > 1000), "start at %d", c.now);
+			c.i600 = 1;
+			CHECK(vl3_time(&c) == V3T_NONE, "start ok at %d", c.now);
+		}
+		ends_with_off("START", V3T_START);
+		c.i600 = 1;
+		for (c.now = 10000 + 119900; c.now <= 10000 + 120100; c.now++) {	/* hold_s */
+			c.t_last = c.now;
+			CHECK((vl3_time(&c) == V3T_HOLD) == (c.now - c.t_en >= 120000), "hold at %d", c.now);
+		}
+		ends_with_off("HOLD", V3T_HOLD);
+		c.hold_ms = 400000;					/* A1 as a backstop for a hold that did not end */
+		for (c.now = 10000 + 299900; c.now <= 10000 + 300100; c.now++) {
+			c.t_last = c.now;
+			CHECK((vl3_time(&c) == V3T_A1) == (c.now - c.t_en > 300000), "A1 at %d", c.now);
+		}
+		ends_with_off("A1", V3T_A1);
+		c.hold_ms = 300000;					/* the hold maximum ends before A1 */
+		c.now = 10000 + 300000;
+		c.t_last = c.now;
+		CHECK(vl3_time(&c) == V3T_HOLD, "hold 300 s is not reported as A1");
+	}
+
+	/* battery monitor: L2, L3 (more than 7 ticks), temperature, voltage, connector, stale */
+	{
+		struct vl3_bs s = { 0 };
+		int t;
+
+		for (t = 1; t <= 10; t++) {
+			rc = vl3_bat(&s, 100, 300, 3900, 16001, 40, 60);
+			CHECK((rc == V3B_L2) == (t > 7), "L2 tick %d: %d", t, rc);
+			if (rc)
+				break;
+		}
+		ends_with_off("L2", rc);
+		memset(&s, 0, sizeof(s));
+		for (t = 1; t <= 10; t++) {
+			rc = vl3_bat(&s, 100, 300, 3900, -3001, 40, 60);
+			CHECK((rc == V3B_L3) == (t > 7), "L3 tick %d: %d", t, rc);
+			if (rc)
+				break;
+		}
+		ends_with_off("L3", rc);
+		memset(&s, 0, sizeof(s));
+		CHECK(vl3_bat(&s, 100, 300, 3900, 16000, 40, 60) == 0 && vl3_bat(&s, 100, 300, 3900, -3000, 40, 60) == 0, "16000 / -3000 are not over");
+		for (t = 435; t <= 445; t++)
+			CHECK((vl3_bat(&s, 100, t, 3900, 2500, 40, 60) == V3B_TEMP) == (t > 440), "temp %d", t);
+		CHECK(vl3_bat(&s, 100, 0, 3900, 2500, 40, 60) == 0 && vl3_bat(&s, 100, -1, 3900, 2500, 40, 60) == V3B_TEMP, "low temperature");
+		for (t = 3440; t <= 3460; t++)
+			CHECK((vl3_bat(&s, 100, 300, t, 2500, 40, 60) == V3B_VLOW) == (t < 3450), "vlow %d", t);
+		for (t = 4440; t <= 4460; t++)
+			CHECK((vl3_bat(&s, 100, 300, t, 2500, 40, 60) == V3B_VHIGH) == (t > 4450), "A6 gauge %d", t);
+		ends_with_off("A6", V3B_VHIGH);
+		for (t = 2990; t <= 3010; t += 5)
+			CHECK((vl3_bat(&s, t, 300, 3900, 2500, 40, 60) == V3B_STALE) == (t > 3000), "age %d", t);
+		memset(&s, 0, sizeof(s));
+		for (t = 55; t <= 65; t++) {				/* connector: at or above the limit on 3 reads */
+			memset(&s, 0, sizeof(s));
+			rc = vl3_bat(&s, 100, 300, 3900, 2500, t, 60) | vl3_bat(&s, 100, 300, 3900, 2500, t, 60);
+			CHECK(rc == 0, "connector %d: two reads", t);
+			CHECK((vl3_bat(&s, 100, 300, 3900, 2500, t, 60) == V3B_CONN) == (t >= 60), "connector %d third read", t);
+		}
+		ends_with_off("CONN", V3B_CONN);
+		memset(&s, 0, sizeof(s));
+		vl3_bat(&s, 100, 300, 3900, 2500, 70, 60);
+		vl3_bat(&s, 100, 300, 3900, 2500, 70, 60);
+		vl3_bat(&s, 100, 300, 3900, 2500, 40, 60);
+		CHECK(vl3_bat(&s, 100, 300, 3900, 2500, 70, 60) == 0, "connector count resets");
+		memset(&s, 0, sizeof(s));
+		CHECK(vl3_bat(&s, 100, 300, 3900, 2500, V3_NO_CONN, 60) == 0 && vl3_bat(&s, 100, 300, 3900, 2500, V3_NO_CONN, 60) == 0, "two ticks without a connector reading");
+		CHECK(vl3_bat(&s, 100, 300, 3900, 2500, 40, 60) == 0 && vl3_bat(&s, 100, 300, 3900, 2500, V3_NO_CONN, 60) == 0 && vl3_bat(&s, 100, 300, 3900, 2500, V3_NO_CONN, 60) == 0, "a reading in between resets the count");
+		CHECK(vl3_bat(&s, 100, 300, 3900, 2500, V3_NO_CONN, 60) == V3B_CONN, "third tick without a connector reading");
+		CHECK(vl3_out_due(2001, 1, 0) && !vl3_out_due(2000, 1, 0) && !vl3_out_due(3000, 0, 0) && !vl3_out_due(3000, 1, 1), "output suspend rule");
+	}
+}
+
+static void gates_and_params(void)
+{
+	struct vl3_g g = { 40, 300, 3900, 30, 30, 60, 200, 350, 60, 0, 0 };
+	unsigned int st, cap, hold, conn;
+
+	CHECK(!vl3_gate(&g), "good start: %s", vl3_gate(&g));
+	for (g.soc = 25; g.soc <= 65; g.soc++)
+		CHECK((vl3_gate(&g) == 0) == (g.soc >= 30 && g.soc <= 60), "soc %d", g.soc);
+	g.soc = 40;
+	for (g.t = 190; g.t <= 360; g.t++)
+		CHECK((vl3_gate(&g) == 0) == (g.t >= 200 && g.t <= 350), "temp %d", g.t);
+	g.t = 300;
+	for (g.mv = 3440; g.mv <= 4460; g.mv++)
+		CHECK((vl3_gate(&g) == 0) == (g.mv >= 3450 && g.mv <= 4450), "mv %d", g.mv);
+	g.mv = 3900;
+	for (g.conn_c = 20; g.conn_c <= 70; g.conn_c++)
+		CHECK((vl3_gate(&g) == 0) == (g.conn_c < 60), "conn %d", g.conn_c);
+	g.conn_c = V3_NO_CONN;
+	CHECK(vl3_gate(&g), "no connector source must refuse");
+	g.conn_c = 30;
+	for (g.cap = 0; g.cap <= 73; g.cap++)		/* stock's curve: above 4.0 A only below 35 %, above 2.5 A only below 55 % */
+		for (g.soc = 30; g.soc <= 60; g.soc++)
+			CHECK((vl3_gate(&g) == 0) == (g.cap > 40 ? g.soc < 35 : g.cap > 25 ? g.soc < 55 : 1), "cap %d soc %d", g.cap, g.soc);
+	g.cap = 0;
+	g.soc = 40;
+
+	for (st = 0; st < 5; st++)
+		for (cap = 0; cap < 20; cap++)
+			for (hold = 0; hold < 400; hold += 7)
+				for (conn = 0; conn < 100; conn += 9) {
+					int ok = (st == 2) || (st == 3 && cap >= 1 && cap <= 13 && hold >= 1 && hold <= 300 && conn >= 1 && conn <= 80);
+
+					CHECK((vl3_params(st, cap, hold, conn) == 0) == ok, "params %u %u %u %u", st, cap, hold, conn);
+				}
+	CHECK(vl3_params(3, 13, 300, 80) == 0 && vl3_params(3, 14, 120, 60) && vl3_params(3, 13, 301, 60) && vl3_params(3, 13, 120, 81), "param edges");
+}
+
+/* ---- d: the whitelist per stage over every register and value ---- */
+
+static int in_list(const u8 (*l)[2], int n, int reg, int val)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (l[i][0] == reg && l[i][1] == val)
+			return 1;
+	return 0;
+}
+
+static void whitelist(void)
+{
+	/* typed here as the oracle, not taken from the header */
+	static const u8 s3_byte[][2] = { { 0x02, 0x01 }, { 0x04, 0x5a }, { 0x05, 0x2f }, { 0x09, 0x13 }, { 0x11, 0x80 }, { 0x0d, 0x70 }, { 0x33, 0xd1 }, { 0x34, 0x60 } };
+	static const u8 s3s_byte[][2] = { { 0x05, 0xaf }, { 0x08, 0x00 }, { 0x08, 0xe0 }, { 0x05, 0x2f } };
+	int reg, val, w, mode, ok, want, stage2;
+
+	for (mode = 1; mode < 8; mode++) {
+		if (!(mode & VM_S2))
+			continue;
+		for (reg = 0; reg < 256; reg++)
+			for (val = 0; val < 65536; val++)
+				for (w = 1; w <= 2; w++) {
+					if (w == 1 && val >= 512)
+						continue;
+					ok = vl_write_ok_m(reg, w, val, mode);
+					stage2 = vl_write_ok(reg, w, val);
+					want = stage2;
+					if (w == 1 && val < 256 && (mode & VM_S3))
+						want |= in_list(s3_byte, 8, reg, val);
+					if (w == 1 && val < 256 && (mode & VM_S3) && (mode & VM_S3S))
+						want |= in_list(s3s_byte, 4, reg, val);
+					if (w == 2 && (mode & VM_S3) && reg == 0x31 && (val & 0xff) == 0x02)
+						want = 1;
+					if (ok != want) {
+						CHECK(ok == want, "mode %d: write 0x%02x w%d 0x%x: whitelist %d, expected %d", mode, reg, w, val, ok, want);
+						return;
+					}
+					if (mode == VM_S2)
+						CHECK(ok == stage2, "stage 2 mode differs from the stage 2 table");
+				}
+	}
+	/* stage 2 refuses every stage 3 row; stage 3 refuses the stock_start rows without the parameter */
+	for (reg = 0; reg < 8; reg++) {
+		int r_ = s3_byte[reg][0], v = s3_byte[reg][1], in2 = vl_write_ok(r_, 1, v);
+
+		CHECK(vl_write_ok_m(r_, 1, v, VM_S2) == in2, "stage 2 mode: %02x=%02x", r_, v);
+		CHECK(vl_write_ok_m(r_, 1, v, VM_S2 | VM_S3), "stage 3: %02x=%02x", r_, v);
+	}
+	CHECK(!vl_write_ok_m(0x09, 1, 0x13, VM_S2) && !vl_write_ok_m(0x0d, 1, 0x70, VM_S2) && !vl_write_ok_m(0x31, 2, 0x2002, VM_S2) && !vl_write_ok_m(0x31, 2, 0x2a02, VM_S2), "stage 2 accepts a stage 3 row");
+	CHECK(!vl_write_ok_m(0x05, 1, 0xaf, VM_S2 | VM_S3) && !vl_write_ok_m(0x08, 1, 0x00, VM_S2 | VM_S3) && !vl_write_ok_m(0x08, 1, 0xe0, VM_S2 | VM_S3) &&
+	      vl_write_ok_m(0x05, 1, 0xaf, ALL_MODES) && vl_write_ok_m(0x08, 1, 0x00, ALL_MODES) && vl_write_ok_m(0x08, 1, 0xe0, ALL_MODES), "stock_start rows without stock_start");
+	CHECK(!vl_write_ok_m(0x05, 1, 0xaf, VM_S2 | VM_S3S) && !vl_write_ok_m(0x08, 1, 0x00, VM_S2 | VM_S3S), "VM_S3S alone");
+
+	/* the enable: 0x07 = 0x80 in no general write, only vl3_enable_ok() and only in stage 3 */
+	for (mode = 1; mode < 8; mode++)
+		for (val = 0; val < 65536; val++)
+			for (w = 1; w <= 2; w++) {
+				if (w == 1 && val >= 512)
+					continue;
+				CHECK(!(val & 0x80) || w != 1 || !vl_write_ok_m(0x07, w, val, mode), "0x07 = 0x%x in the general table, mode %d", val, mode);
+				ok = vl3_enable_ok(0x07, w, val, mode);
+				CHECK(ok == (w == 1 && val == 0x80 && (mode & VM_S3)), "enable_ok(0x07, %d, 0x%x, mode %d) = %d", w, val, mode, ok);
+			}
+	for (reg = 0; reg < 256; reg++)
+		for (val = 0; val < 512; val++)
+			for (mode = 1; mode < 8; mode += 2)
+				if (reg != 0x07 || val != 0x80)
+					CHECK(!vl3_enable_ok(reg, 1, val, mode), "enable_ok accepts 0x%02x = 0x%x", reg, val);
+
+	/* never, in any mode: 0x05 = 0xcf, bit 7 of 0x09 (1:1), 0x0c, 0x3c, 0x40..0xcc, 0x07 with bit 6 after the reset row, the secondary has no client at all */
+	for (mode = 1; mode < 8; mode++)
+		for (val = 0; val < 256; val++) {
+			CHECK(!vl_write_ok_m(0x05, 1, 0xcf, mode), "0x05 = 0xcf");
+			CHECK(!(val & 0x80) || !vl_write_ok_m(0x09, 1, val, mode), "0x09 = 0x%02x in mode %d", val, mode);
+			CHECK(!vl_write_ok_m(0x0c, 1, val, mode) && !vl_write_ok_m(0x3c, 1, val, mode), "0x0c / 0x3c = 0x%02x", val);
+			CHECK(!vl_write_ok_m(0x3c, 2, val, mode) && !vl_write_ok_m(0x0c, 2, val, mode), "word 0x0c / 0x3c");
+			for (reg = 0x40; reg <= 0xcc; reg++)
+				CHECK(!vl_write_ok_m(reg, 1, val, mode) && !vl_write_ok_m(reg, 2, val, mode), "reg 0x%02x = 0x%02x in mode %d", reg, val, mode);
+			CHECK(!(val & 0x80) || !vl_write_ok_m(0x00, 1, val, mode) || 0, "0x00 bit 7");
+		}
+	CHECK(vl_write_ok_m(0x07, 1, 0x40, ALL_MODES) && vl_write_ok_m(0x07, 1, 0x00, ALL_MODES) && !vl_write_ok_m(0x07, 1, 0xc0, ALL_MODES) && !vl_write_ok_m(0x07, 1, 0x41, ALL_MODES), "0x07 values");
+
+	/* firmware requests: one table, stage 3 only, exactly four rows (the charger hold replaced the charge_behaviour rows) */
+	{
+		int prop, ph, n = 0;
+
+		for (mode = 1; mode < 8; mode++)
+			for (prop = 0; prop < 4; prop++)
+				for (ph = 0; ph < 8; ph++)
+					for (val = -2; val < 2000002; val += (val > 5 && val < 1999990) ? 999983 : 1) {
+						ok = vl3_fw_ok(prop, val, ph, mode);
+						want = (mode & VM_S3) && (
+							(prop == FW_ICL && val == 0 && (ph & FWP_SUSPEND)) ||
+							(prop == FW_HOLD && val == 1 && (ph & FWP_RUN)) ||
+							(prop == FW_HOLD && val == 0 && (ph & FWP_EXIT)) ||
+							(prop == FW_ICL && val == 2000000 && (ph & FWP_EXIT)));
+						n += ok;
+						if (ok != want) {
+							CHECK(ok == want, "fw write prop %d val %d phase %d mode %d: %d", prop, val, ph, mode, ok);
+							return;
+						}
+					}
+		CHECK(n > 0, "no fw row accepted");
+		CHECK(!vl3_fw_ok(FW_ICL, 0, FWP_SUSPEND, VM_S2) && !vl3_fw_ok(FW_HOLD, 1, FWP_RUN, VM_S2) && !vl3_fw_ok(FW_ICL, 0, FWP_EXIT, VM_S3), "stage 2 firmware write or wrong phase");
+	}
+}
+
+/* every table entry is used by a row list; the module's row lists are the capture's */
+static void rows(void)
+{
+	unsigned int i, j;
+	int hit[VL3_NW] = { 0 }, hit_s[VL3S_NW] = { 0 };
+	static const u8 plan_hw[][2] = { { 0x02, 0x01 }, { 0x04, 0x5a }, { 0x05, 0x2f }, { 0x09, 0x13 }, { 0x11, 0x80 }, { 0x0d, 0x70 }, { 0x33, 0xd1 }, { 0x34, 0x60 } };
+
+	CHECK(VL3_NHW == 8, "hw rows %u", (unsigned int)VL3_NHW);
+	for (i = 0; i < VL3_NHW; i++) {
+		CHECK(vl3_hw_rows[i].reg == plan_hw[i][0] && vl3_hw_rows[i].val == plan_hw[i][1] && vl3_hw_rows[i].w == 1, "hw row %u", i);
+		CHECK(vl_write_phase_m(vl3_hw_rows[i].reg, 1, vl3_hw_rows[i].val, VM_S2 | VM_S3), "hw row %u refused", i);
+		for (j = 0; j < VL3_NW; j++)
+			if ((vl3_wl[j].phase & VW_HW) && vl3_wl[j].reg == vl3_hw_rows[i].reg && vl3_wl[j].val == vl3_hw_rows[i].val)
+				hit[j] = 1;
+	}
+	for (i = 0; i < VL3_NSTART; i++) {
+		CHECK(vl_write_ok_m(vl3_start_rows[i].reg, 1, vl3_start_rows[i].val, ALL_MODES) && !vl_write_ok_m(vl3_start_rows[i].reg, 1, vl3_start_rows[i].val, VM_S2 | VM_S3), "start row %u", i);
+		for (j = 0; j < VL3S_NW; j++)
+			if ((vl3s_wl[j].phase & VW_START) && vl3s_wl[j].reg == vl3_start_rows[i].reg && vl3s_wl[j].val == vl3_start_rows[i].val)
+				hit_s[j] = 1;
+	}
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < VL3S_NW; j++)
+			if ((vl3s_wl[j].phase & VW_RUN) && vl3s_wl[j].reg == vl3_restore_rows[i].reg && vl3s_wl[j].val == vl3_restore_rows[i].val)
+				hit_s[j] = 1;
+	hit[0] = 1;					/* the predata word: replay */
+	hit[9] = 1;					/* the enable: vl3_enable_ok */
+	for (j = 0; j < VL3S_NW; j++)
+		if (vl3s_wl[j].phase & VW_LAD)
+			hit_s[j] = 1;			/* ladder row, vl3_ladder_pump */
+	for (j = 0; j < VL3_NW; j++)
+		CHECK(hit[j], "stage 3 table entry %u (%s) is never written", j, vl3_wl[j].what);
+	for (j = 0; j < VL3S_NW; j++)
+		CHECK(hit_s[j], "stock_start table entry %u (%s) is never written", j, vl3s_wl[j].what);
+	CHECK(VL3_NEXIT == 13, "exit rows %u", (unsigned int)VL3_NEXIT);
+}
+
+static void tables(void)
+{
+	unsigned int i;
+	static const char *ph[] = { "init", "session", "exit", "hw_setting", "run", "enable", "start", "ladder" };
+
+	printf("| reg | width | value | phase | mode | what |\n|---|---|---|---|---|---|\n");
+	for (i = 0; i < VL3_NW + VL3S_NW; i++) {
+		const struct vl_w *e = i < VL3_NW ? &vl3_wl[i] : &vl3s_wl[i - VL3_NW];
+		char v[32], p[64] = "";
+		int b;
+
+		if (e->w == 2 && e->mask == 0x00ff)
+			snprintf(v, sizeof(v), "0x??%02x", e->val);
+		else if (e->mask == 0xff || e->mask == 0xffff)
+			snprintf(v, sizeof(v), e->w == 2 ? "0x%04x" : "0x%02x", e->val);
+		else
+			snprintf(v, sizeof(v), "0x%04x & 0x%04x", e->val, e->mask);
+		for (b = 0; b < 8; b++)
+			if (e->phase & (1 << b))
+				strcat(strcat(p, p[0] ? " " : ""), ph[b]);
+		printf("| 0x%02x | %s | %s | %s | %s | %s |\n", e->reg, e->w == 2 ? "word" : "byte", v, p, i < VL3_NW ? "stage 3" : "stage 3 + stock_start", e->what);
+	}
+	printf("\nhw_setting rows, in order (after the TX word and the 0x31 = 0x2002 predata):");
+	for (i = 0; i < VL3_NHW; i++)
+		printf(" %02x=%02x", vl3_hw_rows[i].reg, vl3_hw_rows[i].val);
+	printf("\nstock_start rows (after them):");
+	for (i = 0; i < VL3_NSTART; i++)
+		printf(" %02x=%02x", vl3_start_rows[i].reg, vl3_start_rows[i].val);
+	printf("\nUCP-back rows (IBUS > 600 mA):");
+	for (i = 0; i < 2; i++)
+		printf(" %02x=%02x", vl3_restore_rows[i].reg, vl3_restore_rows[i].val);
+	printf("\nexit ladder, pump side, in order:");
+	for (i = 0; i < VL3_NEXIT; i++)
+		printf(" %02x%s=%02x%s", vl_exit_rows[i].reg, vl_exit_rows[i].w == 2 ? "(w)" : "", vl_exit_rows[i].val, i == 0 ? " (then 0x06/0x07 read until idle)" : vl_exit_rows[i].reg == 0x09 ? " (skipped if the pump is not confirmed off)" : "");
+	printf("\n\nfirmware writes (power-supply properties):\n| property | value | phase | what |\n|---|---|---|---|\n");
+	for (i = 0; i < VL3_NFW; i++)
+		printf("| %s | %d | %s | %s |\n", vl3_fwl[i].prop == FW_ICL ? "qcom-battmgr-usb input_current_limit" : "qcom-battmgr-bat pump_hold", vl3_fwl[i].val,
+		       vl3_fwl[i].phase == FWP_SUSPEND ? "suspend" : vl3_fwl[i].phase == FWP_RUN ? "run" : "exit", vl3_fwl[i].what);
+}
+
+int main(int argc, char **argv)
+{
+	if (argc > 1 && !strcmp(argv[1], "--tables")) {
+		tables();
+		return 0;
+	}
+	replay_all();
+	window();
+	allow_bit();
+	dispatcher();
+	limits();
+	gates_and_params();
+	ladder();
+	whitelist();
+	rows();
+	printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+	return fails != 0;
+}
diff --git a/drivers/power/supply/iceland-supervooc/tests/test_stage3b.c b/drivers/power/supply/iceland-supervooc/tests/test_stage3b.c
new file mode 100644
index 0000000000000..0729167bbc626
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/tests/test_stage3b.c
@@ -0,0 +1,1395 @@
+/*
+ * Host test for the stage 3b part of vooc_logic.h (both pumps). cc -I.. test_stage3b.c -o test_stage3b && ./test_stage3b
+ * (./test_stage3b --tables prints the write tables of both buses). test_logic.c (stage 2) and test_stage3.c (3a) are separate.
+ * Data: capture_round1.h and capture_dual.h, generated from the stock capture: both buses of the
+ * pumps from the first frame of round 1 to 18913.7, the init and the end. What the capture does not contain is synthesised here and
+ * marked "synthetic": the secondary's 0x06..0x0f block (its 0x0f and 0x07 are real), the registers 0x00..0x05 and 0x10 of both pumps,
+ * TDIE (0x1f / 0x20) and the secondary's ADC bytes beyond IBUS (taken from the primary's block of the same frame, the pumps share VBUS).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vooc_logic.h>
+#include "capture_round1.h"
+#include "capture_dual.h"
+
+static int fails, checks;
+
+#define CHECK(c, ...) do { \
+	checks++; \
+	if (!(c)) { \
+		fails++; \
+		printf("FAIL %s:%d: %s  ", __FILE__, __LINE__, #c); \
+		printf(__VA_ARGS__); \
+		printf("\n"); \
+	} \
+} while (0)
+
+#define M3B (VM_S2 | VM_S3 | VM_S3S | VM_S3B)
+/* the replay ends before frame 72 (18913.2422): there stock changes its own ask (battery-voltage reply 0x7f02, then ask-current 0x2802 = 4.0 A),
+ * which this module never does. Frames 0..71 are stock's session with the ask at 7.3 A */
+#define D_LAST 72
+
+/* ---- two simulated buses: every write is checked against that bus's own table, as pw_raw() / ps_raw() do ---- */
+
+struct bus {
+	int n, refused, rd_fail, stuck, fail_reg, fail_left, fail_skip;
+	int seq[1024];
+	struct d_w w[1024];
+	u8 enable[1024];
+	u8 r06, r07;
+};
+static struct bus pb, sb;
+static int g_seq;
+
+static int bus_wr(struct bus *b, int sec, u8 reg, u8 w, u16 val, int enable)
+{
+	int ok = sec ? (enable ? vl3b_enable_ok(reg, w, val, M3B) : vl3b_write_ok(reg, w, val, M3B)) :
+		       (enable ? vl3_enable_ok(reg, w, val, M3B) : vl_write_ok_m(reg, w, val, M3B));
+
+	if (!ok) {
+		b->refused++;
+		return -1;
+	}
+	if (b->n < 1024) {
+		b->seq[b->n] = g_seq++;
+		b->w[b->n].reg = reg;
+		b->w[b->n].w = w;
+		b->w[b->n].val = val;
+		b->enable[b->n++] = enable;
+	}
+	if (reg == b->fail_reg) {
+		if (b->fail_skip > 0) {
+			b->fail_skip--;
+		} else if (b->fail_left > 0) {
+			b->fail_left--;
+			return -5;
+		}
+	}
+	if (reg == 0x07 && !enable && !b->stuck && (val == 0x00 || val == 0x01)) {
+		b->r07 &= 0x7f;
+		b->r06 &= ~0x04;
+	}
+	return 0;
+}
+
+static void bus_reset(struct bus *b)
+{
+	memset(b, 0, sizeof(*b));
+	b->fail_reg = -1;
+	b->r06 = 0x06;
+	b->r07 = 0x81;
+}
+
+/* what the secondary's reads return; the tests set it */
+static struct {
+	u8 blk[17];
+	u8 adc[14];
+	int fail_rd;		/* register whose read fails, -1 none */
+	int en_calls, en_fail, stop;
+	int en_primary_ok;	/* the primary state at the enable call */
+	const struct vl3 *r;
+} syn;
+
+static int pio_wr(void *c, u8 reg, u8 w, u16 val) { (void)c; return bus_wr(&pb, 0, reg, w, val, 0); }
+static int sio_wr(void *c, u8 reg, u8 w, u16 val) { (void)c; return bus_wr(&sb, 1, reg, w, val, 0); }
+
+static int pio_rd(void *c, u8 reg, u8 n, u8 *b)
+{
+	(void)c;
+	if (pb.rd_fail)
+		return -5;
+	CHECK(reg == 0x06 && n == 2, "primary ladder read %02x/%d", reg, n);
+	b[0] = pb.r06;
+	b[1] = pb.r07;
+	return 2;
+}
+
+static int sio_rd(void *c, u8 reg, u8 n, u8 *b)
+{
+	(void)c;
+	if (sb.rd_fail || syn.fail_rd == reg)
+		return -5;
+	if (reg == 0x06 && n == 2) {			/* the ladder's confirmation */
+		b[0] = sb.r06;
+		b[1] = sb.r07;
+		return 2;
+	}
+	if (reg == 0x06 && n == 10)
+		memcpy(b, syn.blk + 6, 10);
+	else if (reg == 0x04 && n == 2)
+		memcpy(b, syn.blk + 4, 2);
+	else if (reg == 0x00 && n == 3)
+		memcpy(b, syn.blk, 3);
+	else if (reg == 0x10 && n == 1)
+		b[0] = syn.blk[16];
+	else if (reg == 0x13 && (n == 14 || n == 2))
+		memcpy(b, syn.adc, n);
+	else {
+		CHECK(0, "unexpected secondary read %02x/%d", reg, n);
+		return -5;
+	}
+	return n;
+}
+
+static int sio_en(void *c)
+{
+	const struct vl3 *r = syn.r;
+
+	(void)c;
+	syn.en_calls++;
+	if (r)
+		syn.en_primary_ok = r->pumps == 2 && r->enabled && r->sw_seen && !r->n_lost && r->prot_ok && r->suspend_ok && r->vbus_st == VB_NORMAL && r->s.prot_ok &&
+				    r->s.hw_done && r->adc.ibus > 1400;
+	if (syn.en_fail)
+		return -1;
+	return bus_wr(&sb, 1, 0x07, 1, 0x81, 1);
+}
+
+static int sio_stop(void *c) { (void)c; return syn.stop; }
+static void nodly(void *c, int ms) { (void)c; (void)ms; }
+
+static const struct vl3_io pio = { 0, pio_wr, pio_rd, nodly, 0, 0 };
+static const struct vl3_io sio = { 0, sio_wr, sio_rd, nodly, sio_en, sio_stop };
+
+/* ---- helpers shared by the tests ---- */
+
+static void adc_bytes(u8 *b, int ibus_raw, int vbus_raw, int vbat_raw, int tdie_raw, int seed)
+{
+	memset(b, 0, 14);
+	b[0] = ibus_raw >> 8; b[1] = ibus_raw;
+	b[2] = vbus_raw >> 8; b[3] = vbus_raw;
+	b[8] = vbat_raw >> 8; b[9] = vbat_raw;
+	b[10] = seed;			/* the 4 bytes of IBAT / unused: a moving byte so that blocks differ */
+	b[12] = tdie_raw >> 8; b[13] = tdie_raw;
+}
+
+/* the secondary's blocks as they read when everything is fine (synthetic: 0x00..0x05, 0x10 and the 0x06..0x0f block) */
+static void good_sblk(u8 *blk, int enabled)
+{
+	memset(blk, 0, 17);
+	blk[0x00] = 0x36; blk[0x01] = 0xbf; blk[0x02] = 0x01; blk[0x04] = 0x5a; blk[0x05] = 0x2e;
+	blk[0x06] = enabled ? 0x06 : 0x02;
+	blk[0x07] = enabled ? 0x81 : 0x07;
+	blk[0x08] = 0xe0; blk[0x09] = 0x13; blk[0x0d] = 0x70; blk[0x0e] = 0x03; blk[0x10] = 0x02;
+}
+
+/* a dual running state: the primary enabled and switching, the secondary enabled at t = 0 and past its status check */
+static void run2(struct vl3 *r, int cap)
+{
+	vl3_init(r, cap, 0);
+	r->pumps = 2;
+	r->suspend_ok = 1;
+	r->ph = V3_RUN;
+	r->enabled = 1;
+	r->vbus_st = VB_NORMAL;
+	r->adc_ok = 1;
+	r->sw_seen = 1;
+	r->prot_ok = 1;
+	vl_adc_decode(&r->adc, (u8[14]){ 0 });
+	r->adc.ibus = 700;
+	r->s.hw_done = 1;
+	r->s.enabled = 1;
+	r->s.done = 1;
+	r->s.t_en = 0;
+	r->s.sw_seen = 1;
+	r->s.checked = 1;
+	r->s.tick_init = 1;
+	r->s.next_tick = 1000000;
+	r->s.prot_ok = 1;
+	r->s.fresh = 1;
+	good_sblk(syn.blk, 1);
+	adc_bytes(syn.adc, 373, 2090, 3040, 64, 1);	/* 700 mA, 7.8 V, 32.0 C */
+	r->s.adc_ok = 0;
+}
+
+static int frame2(struct vl3 *r, int now, int seed)
+{
+	syn.adc[10] = seed;
+	syn.r = r;
+	return vl3b_run(&sio, r, now);
+}
+
+/* ---- 1: the capture, both buses, round 1 to 18913.7 ---- */
+
+static void filt_p(const struct d_frame *f, int k, int ss, int cap, struct d_w *out, int *n)
+{
+	int i, m = 0, cmd = k > 17 ? ((f->rx & 0x1e) >> 1) : 0;		/* ask-current exists after the allow frame (index 17) only */
+
+	for (i = 0; i < f->npw; i++) {
+		struct d_w w = f->pw[i];
+
+		if (!ss && ((w.reg == 0x05 && w.val == 0xaf) || (w.reg == 0x08 && w.val == 0x00)))
+			continue;
+		if (!ss && i >= 2 && i == f->npw - 2 && w.reg == 0x05 && w.val == 0x2f && f->pw[i + 1].reg == 0x08 && f->pw[i + 1].val == 0xe0 &&
+		    f->pw[i - 1].reg == 0x11 && f->pw[i - 1].val == 0x80)
+			break;
+		if (cap != V3_STOCK_ASK && w.reg == 0x2c && cmd == 3)
+			w.val = (cap << 8) | 0x0002;
+		out[m++] = w;
+	}
+	*n = m;
+}
+
+static void dual_replay(int cap, int ss, int *end_k, int *end_code, int *en_k)
+{
+	struct vl s;
+	struct vl3 r;
+	struct vl_adc a;
+	static struct d_w exp_s[D_LAST * 20];
+	struct d_w exp_p[20];
+	int k, i, n_exp_s = 0, rc, t_en = -1, ndiff = 0, sen_cap = -1, nexp;
+	u8 blk[17], b14[14];
+	u8 r05 = 0x2f;
+
+	bus_reset(&pb);
+	bus_reset(&sb);
+	g_seq = 0;
+	memset(&syn, 0, sizeof(syn));
+	syn.fail_rd = -1;
+	*end_k = *end_code = *en_k = -1;
+	vl_init(&s, CAP_RL, CAP_RH);
+	vl3_init(&r, cap, ss);
+	r.pumps = 2;
+	r.suspend_ok = 1;
+
+	for (k = 0; k < D_LAST; k++)
+		for (i = 0; i < df[k].nsw; i++) {
+			if (df[k].sw[i].reg == 0x07 && df[k].sw[i].val == 0x81)
+				sen_cap = k;
+			exp_s[n_exp_s++] = df[k].sw[i];
+		}
+
+	for (k = 0; k < D_LAST; k++) {
+		const struct d_frame *f = &df[k];
+		int now = f->t_us / 1000 + 5, p0 = pb.n;
+		u16 tx = 0;
+		int allow;
+
+		rc = vl3_irq(&s, &r, f->rx, f->fl, &tx);
+		CHECK(rc == VL_TX || rc == VL_LAST, "frame %d (rx 0x%02x) returned %d", k, f->rx, rc);
+		if (rc < 0)
+			break;
+		allow = !!(r.act & V3A_HW);
+
+		/* the primary's side, as the C file does it (s3_tx, s3_after, check_pump / s3_post) */
+		if (r.act & V3A_ENABLE) {
+			bus_wr(&pb, 0, 0x07, 1, 0x80, 1);
+			t_en = f->t_us;
+		}
+		bus_wr(&pb, 0, 0x2c, 2, tx, 0);
+		if (r.act & V3A_PREDATA)
+			bus_wr(&pb, 0, 0x31, 2, r.predata, 0);
+		if (allow) {
+			for (i = 0; i < (int)VL3_NHW; i++)
+				bus_wr(&pb, 0, vl3_hw_rows[i].reg, 1, vl3_hw_rows[i].val, 0);
+			for (i = 0; ss && i < VL3_NSTART; i++)
+				bus_wr(&pb, 0, vl3_start_rows[i].reg, 1, vl3_start_rows[i].val, 0);
+			CHECK(vl3b_hw(&sio, &r) == 0, "secondary hw rows");
+		}
+		bus_wr(&pb, 0, 0x11, 1, 0xa0, 0);
+		bus_wr(&pb, 0, 0x11, 1, 0x80, 0);
+		if (r.ph != V3_ASK) {
+			memset(blk, 0, 17);
+			blk[0x00] = 0x36; blk[0x01] = 0xbf; blk[0x02] = 0x01; blk[0x04] = 0x5a; blk[0x10] = 0x02;	/* synthetic */
+			memcpy(blk + 6, f->pblk, 10);
+			if (f->r05)
+				r05 = f->r05;
+			blk[0x05] = ss ? r05 : 0x2f;
+			if (!ss && blk[0x08] == 0x00)
+				blk[0x08] = 0xe0;
+			memcpy(b14, f->padc, 10);
+			memset(b14 + 10, 0, 4);					/* TDIE: synthetic 0 C */
+			vl_adc_decode(&a, b14);
+			rc = vl3_post(&r, blk, &a, t_en < 0 ? 0 : (f->t_us - t_en) / 1000);
+			CHECK(rc == 0 || cap != V3_STOCK_ASK, "frame %d: the primary's checks ended stock's own run: %s", k, vl3_why(rc));
+			r.adc = a;
+			r.adc_ok = 1;
+			if (rc && *end_k < 0) {
+				*end_k = k;
+				*end_code = rc;
+			}
+			if (vl3_restore_due(&r)) {
+				bus_wr(&pb, 0, 0x05, 1, 0x2f, 0);
+				bus_wr(&pb, 0, 0x08, 1, 0xe0, 0);
+				r.restored = 1;
+			}
+		}
+
+		/* the secondary: its reads from the capture where the capture has them */
+		{
+			u8 sib[14];
+
+			good_sblk(syn.blk, 0);
+			memcpy(syn.blk + 6, f->pblk, 10);					/* synthetic: the primary's block of this frame ... */
+			{
+				int sen = 0, sib_ma = (((f->s13[0] & 0x0f) << 8) | f->s13[1]) * 1875 / 1000;
+
+				for (i = 0; i < sb.n; i++)
+					sen |= sb.enable[i];
+				syn.blk[0x06] = sen ? (sib_ma > 100 ? 0x06 : 0x02) : (f->pblk[0] & ~0x04);	/* switching once it carries current */
+				syn.blk[0x07] = f->s07 >= 0 ? (u8)f->s07 : sen ? 0x81 : 0x07;
+			}
+			syn.blk[0x0f] = f->s0f;							/* ... with the secondary's real 0x07 and 0x0f */
+			syn.blk[0x04] = 0x5a; syn.blk[0x05] = 0x2e; syn.blk[0x00] = 0x36; syn.blk[0x01] = 0xbf; syn.blk[0x02] = 0x01; syn.blk[0x10] = 0x02;
+			if (r.ph != V3_ASK) {
+				syn.blk[0x09] = 0x13;
+				syn.blk[0x0d] = 0x70;
+			}
+			memcpy(sib, f->padc, 10);
+			sib[0] = f->s13[0];
+			sib[1] = f->s13[1];
+			memset(sib + 10, 0, 4);
+			sib[12] = 0; sib[13] = 64;							/* synthetic TDIE 32.0 C */
+			memcpy(syn.adc, sib, 14);
+			if (f->s06 >= 0 && (syn.blk[0x07] & 0x80))
+				CHECK(syn.blk[0x06] == f->s06, "frame %d: synthetic secondary 0x06 0x%02x, capture 0x%02x", k, syn.blk[0x06], f->s06);
+			syn.r = &r;
+			rc = vl3b_run(&sio, &r, now);
+			CHECK(rc == 0 || cap != V3_STOCK_ASK, "frame %d (uptime 18910.%06u): the secondary's checks ended stock's own run: %s (%d)", k, f->t_us, rc > 0 ? vl3_why(rc) : "i2c", rc);
+			if (rc && *end_k < 0) {
+				*end_k = k;
+				*end_code = rc;
+			}
+			if (r.s.enabled && *en_k < 0)
+				*en_k = k;
+		}
+
+		/* the primary's writes of this frame against the capture's, in order */
+		filt_p(f, k, ss, cap, exp_p, &nexp);
+		CHECK(pb.n - p0 == nexp, "frame %d: %d primary writes, capture %d", k, pb.n - p0, nexp);
+		for (i = 0; i < nexp && i < pb.n - p0; i++)
+			if (pb.w[p0 + i].reg != exp_p[i].reg || pb.w[p0 + i].w != exp_p[i].w || pb.w[p0 + i].val != exp_p[i].val) {
+				CHECK(0, "frame %d primary write %d: ours %02x/%d=%04x, capture %02x/%d=%04x", k, i, pb.w[p0 + i].reg, pb.w[p0 + i].w, pb.w[p0 + i].val,
+				      exp_p[i].reg, exp_p[i].w, exp_p[i].val);
+				ndiff++;
+				break;
+			}
+		if (*end_k >= 0)
+			break;
+	}
+
+	if (*end_k < 0) {
+		/* the secondary's whole stream against the capture's (the enable falls in the next frame's window: the stream is what is compared) */
+		CHECK(sb.n == n_exp_s, "secondary: %d writes, capture %d", sb.n, n_exp_s);
+		for (i = 0; i < sb.n && i < n_exp_s; i++)
+			if (sb.w[i].reg != exp_s[i].reg || sb.w[i].w != exp_s[i].w || sb.w[i].val != exp_s[i].val) {
+				CHECK(0, "secondary write %d: ours %02x=%02x, capture %02x=%02x", i, sb.w[i].reg, sb.w[i].val, exp_s[i].reg, exp_s[i].val);
+				break;
+			}
+		CHECK(sen_cap >= 0 && *en_k == sen_cap + 1, "secondary enable: ours in frame %d, stock's write in the window of frame %d", *en_k, sen_cap);
+		CHECK(sb.refused == 0 && pb.refused == 0, "refused writes: primary %d secondary %d", pb.refused, sb.refused);
+	}
+	(void)ndiff;
+}
+
+static void replays(void)
+{
+	int k, c, e;
+
+	dual_replay(V3_STOCK_ASK, 1, &k, &c, &e);			/* stock's own ask, stock_start verbatim: both buses equal the capture */
+	CHECK(k < 0 && e >= 0, "verbatim replay ended at frame %d code %d", k, c);
+	dual_replay(V3_STOCK_ASK, 0, &k, &c, &e);			/* stock_start = 0: minus the start and UCP-back rows */
+	CHECK(k < 0 && e >= 0, "stock_start=0 replay ended at frame %d code %d", k, c);
+	dual_replay(14, 0, &k, &c, &e);					/* cap 14: only the ask-current word differs; stock's real current (1.76 A with both pumps) is over 1.4 A + 300 mA */
+	CHECK(k >= 0 && c == V3E_TOTAL, "cap 14 over stock's current: frame %d code %d", k, c);
+	dual_replay(20, 0, &k, &c, &e);					/* cap 20: the current stays below 2.3 A in this window: no limit, streams equal */
+	CHECK(k < 0 && e >= 0, "cap 20 ended at frame %d code %d", k, c);
+}
+
+/* the total / primary A5 rule on the capture's own current, computed here from the raw bytes (independent of vl3_post / vl3b_adc): the first frame
+ * on which three consecutive reads exceed cap + 300 mA ends the run, for the primary alone and for the sum once the secondary is enabled */
+static void total_oracle(void)
+{
+	int cap, k, c, e, n_p, n_t, first, sen = -1, pen = -1, fired = 0, quiet = 0;
+
+	for (k = 0; k < D_LAST; k++)
+		for (e = 0; e < df[k].nsw; e++)
+			if (df[k].sw[e].reg == 0x07 && df[k].sw[e].val == 0x81)
+				sen = k + 1;				/* the module's enable frame, see dual_replay() */
+	for (k = 0; k < D_LAST && pen < 0; k++)
+		for (e = 0; e < df[k].npw; e++)
+			if (df[k].pw[e].reg == 0x07 && df[k].pw[e].val == 0x80)
+				pen = k;
+	CHECK(sen > 0 && pen > 17, "no secondary enable in the capture");
+	for (cap = 14; cap <= 30; cap += 2) {
+		int lim = cap * 100 + 300;
+
+		first = -1;
+		n_p = n_t = 0;
+		for (k = 0; k < D_LAST && first < 0; k++) {
+			int p = (((df[k].padc[0] & 0x0f) << 8) | df[k].padc[1]) * 1875 / 1000;
+			int s = (((df[k].s13[0] & 0x0f) << 8) | df[k].s13[1]) * 1875 / 1000;
+
+			if (k < pen)
+				continue;			/* the pump is not enabled before the frame stock enabled it */
+			n_p = p > lim ? n_p + 1 : 0;
+			n_t = k >= sen && p + s > lim ? n_t + 1 : 0;
+			if (n_p >= 3 || n_t >= 3)
+				first = k;
+		}
+		dual_replay(cap, 0, &k, &c, &e);
+		fired += first >= 0;
+		quiet += first < 0;
+		if (first >= 0)
+			CHECK(k == first, "cap %d: oracle frame %d, module frame %d code %d", cap, first, k, c);
+		else
+			CHECK(k < 0, "cap %d: oracle says no limit, module ended at %d code %d", cap, k, c);
+	}
+	CHECK(fired >= 1 && quiet >= 1, "oracle: %d caps end, %d do not", fired, quiet);
+}
+
+static void orders(void)
+{
+	/* the init: the secondary's rows come after the primary's last init row and before the handshake, as in the capture (18909.6836 .. .6857) */
+	{
+		unsigned int i;
+		int n = 0, bad = 0;
+		struct d_row ours[64];
+
+		for (i = 0; i < sizeof(vl_init_rows) / sizeof(vl_init_rows[0]); i++)
+			if (vl_init_rows[i].w == 1) {
+				ours[n].bus = 'P'; ours[n].reg = vl_init_rows[i].reg; ours[n++].val = vl_init_rows[i].val;
+			}
+		for (i = 0; i < VL3B_NINIT; i++) {
+			ours[n].bus = 'S'; ours[n].reg = vl3b_init_rows[i].reg; ours[n++].val = vl3b_init_rows[i].val;
+		}
+		ours[n].bus = 'P'; ours[n].reg = vl_handshake.reg; ours[n++].val = vl_handshake.val;
+		CHECK(n == D_NINIT, "init rows: ours %d, capture %d", n, D_NINIT);
+		for (i = 0; i < D_NINIT && (int)i < n; i++)
+			if (ours[i].bus != d_init[i].bus || ours[i].reg != d_init[i].reg || ours[i].val != d_init[i].val)
+				bad++;
+		CHECK(!bad, "%d init rows differ from the capture", bad);
+		bus_reset(&sb);
+		CHECK(vl3b_init(&sio) == 0 && sb.n == (int)VL3B_NINIT && !sb.refused, "secondary init through its own writer");
+	}
+	/* the end: ours per bus against the capture's first pass; the secondary's 0x09 = 0x30 is written 0x10 here (bit 5 is the UCP-rise flag), the second pass is not repeated */
+	{
+		struct vl3_lad lp, ls;
+		int i, ns = 0, np = 0, soff_seq, poff_seq;
+		struct d_xrow cs[40], cp[40];
+		struct d_w os[40], op[40];
+
+		for (i = 0; i < D_NEXIT; i++) {
+			if (d_exit[i].bus == 'S' && d_exit[i].t_us < 552000)
+				cs[ns++] = d_exit[i];
+			if (d_exit[i].bus == 'P' && d_exit[i].t_us < 560000 && d_exit[i].reg != 0x2d)
+				cp[np++] = d_exit[i];
+		}
+		CHECK(cs[2].reg == 0x11 && cs[1].reg == 0x09, "capture: 07, 09, 11 order");
+		CHECK(cs[0].reg == 0x07 && cs[0].val == 0x01 && cp[0].reg == 0x07 && cp[0].val == 0x00 && cs[0].t_us < cp[0].t_us,
+		      "capture: the secondary's off (%u us) precedes the primary's (%u us)", cs[0].t_us, cp[0].t_us);
+		bus_reset(&pb);
+		bus_reset(&sb);
+		g_seq = 0;
+		bus_wr(&sb, 1, 0x07, 1, 0x01, 0);
+		bus_wr(&pb, 0, 0x07, 1, 0x00, 0);
+		memset(&lp, 0, sizeof(lp));
+		memset(&ls, 0, sizeof(ls));
+		vl3_off_confirm(&sio, &ls, 1, 0x01);
+		vl3_off_confirm(&pio, &lp, 1, 0x00);
+		vl3b_ladder_rows(&sio, &ls);
+		vl3_ladder_rows(&pio, &lp, 0, 0);
+		soff_seq = sb.seq[0];
+		poff_seq = pb.seq[0];
+		CHECK(soff_seq < poff_seq, "ours: secondary off before the primary's");
+		ns = np = 0;
+		for (i = 0; i < sb.n; i++)
+			os[ns++] = sb.w[i];
+		for (i = 0; i < pb.n; i++)
+			if (pb.w[i].reg != 0x11 && pb.w[i].reg != 0x2c && pb.w[i].reg != 0x31)
+				op[np++] = pb.w[i];
+		{
+			int ncs = 0, ncp = 0;
+
+			for (i = 0; i < D_NEXIT; i++) {
+				if (d_exit[i].bus == 'S' && d_exit[i].t_us < 552000) ncs++;
+				if (d_exit[i].bus == 'P' && d_exit[i].t_us < 560000 && d_exit[i].reg != 0x2d) ncp++;
+			}
+			CHECK(ns == ncs && np == ncp, "exit rows: secondary %d vs %d, primary %d vs %d", ns, ncs, np, ncp);
+		}
+		for (i = 0; i < ns; i++)
+			CHECK(os[i].reg == cs[i].reg && (os[i].val == cs[i].val || (cs[i].reg == 0x09 && cs[i].val == 0x30 && os[i].val == 0x10)), "secondary exit row %d: ours %02x=%02x, capture %02x=%02x", i, os[i].reg, os[i].val, cs[i].reg, cs[i].val);
+		for (i = 0; i < np; i++)
+			CHECK(op[i].reg == cp[i].reg && op[i].val == cp[i].val, "primary exit row %d: ours %02x=%02x, capture %02x=%02x", i, op[i].reg, op[i].val, cp[i].reg, cp[i].val);
+		CHECK(!sb.refused && !pb.refused && ls.off_ok && lp.off_ok, "exit writes refused or not confirmed");
+	}
+	/* every write stock made to the secondary in the window is in the secondary's table, and none to the primary table's rows that the table refuses */
+	{
+		int k, i;
+
+		for (k = 0; k < D_N; k++)
+			for (i = 0; i < df[k].nsw; i++) {
+				const struct d_w *w = &df[k].sw[i];
+
+				CHECK(w->w == 1 && (vl3b_write_ok(w->reg, 1, w->val, M3B) || vl3b_enable_ok(w->reg, 1, w->val, M3B)), "stock's secondary write %02x=%02x is not in the table", w->reg, w->val);
+			}
+		for (i = 0; i < D_NEXIT; i++)
+			if (d_exit[i].bus == 'S')
+				CHECK(vl3b_write_ok(d_exit[i].reg, 1, d_exit[i].reg == 0x09 && d_exit[i].val == 0x30 ? 0x10 : d_exit[i].val, M3B), "stock's secondary exit write %02x=%02x not in the table", d_exit[i].reg, d_exit[i].val);
+	}
+}
+
+/* ---- 2: the enable conditions, each at its threshold ---- */
+
+static void due_ready(struct vl3 *r, int cap)
+{
+	vl3_init(r, cap, 0);
+	r->pumps = 2;
+	r->suspend_ok = 1;
+	r->ph = V3_RUN;
+	r->enabled = 1;
+	r->vbus_st = VB_NORMAL;
+	r->adc_ok = 1;
+	r->sw_seen = 1;
+	r->prot_ok = 1;
+	r->adc.ibus = 1401;
+	r->s.hw_done = 1;
+	r->s.prot_ok = 1;
+	r->s.tick_init = 1;
+	r->s.next_tick = 5000;
+}
+
+static void enable_conditions(void)
+{
+	struct vl3 r;
+	int i, n;
+
+	due_ready(&r, 30);
+	CHECK(vl3b_due(&r, 5000) == 1, "all conditions met");
+	CHECK(r.s.next_tick == 6000 && r.s.tick_now, "the tick is consumed and the next one is 1000 ms later");
+	CHECK(vl3b_due(&r, 5000) == 0 && vl3b_due(&r, 5999) == 0, "no second evaluation inside the tick");
+	r.s.done = 0;
+	CHECK(vl3b_due(&r, 6000) == 1, "next tick");
+
+	due_ready(&r, 30);
+	CHECK(vl3b_due(&r, 4999) == 0 && vl3b_due(&r, 5000) == 1, "tick time");
+	for (n = 1398; n <= 1403; n++) {				/* stock: cp_ichg > 1400 */
+		due_ready(&r, 30);
+		r.adc.ibus = n;
+		CHECK(vl3b_due(&r, 5000) == (n > 1400), "total %d mA", n);
+	}
+	due_ready(&r, 30);					/* a tick that fails the condition is spent */
+	r.adc.ibus = 1400;
+	CHECK(vl3b_due(&r, 5000) == 0, "1400 mA");
+	r.adc.ibus = 1500;
+	CHECK(vl3b_due(&r, 5999) == 0 && vl3b_due(&r, 6000) == 1, "failed tick spent, next at +1000");
+
+	for (i = 0; i < 12; i++) {					/* every other condition, alone */
+		due_ready(&r, 30);
+		switch (i) {
+		case 0: r.pumps = 1; break;
+		case 1: r.enabled = 0; break;
+		case 2: r.sw_seen = 0; break;
+		case 3: r.n_lost = 1; break;
+		case 4: r.prot_ok = 0; break;
+		case 5: r.s.prot_ok = 0; break;
+		case 6: r.s.hw_done = 0; break;
+		case 7: r.suspend_ok = 0; break;
+		case 8: r.vbus_st = VB_HIGH; break;
+		case 9: r.adc_ok = 0; break;
+		case 10: r.s.done = 1; break;
+		case 11: r.s.enabled = 1; break;
+		}
+		CHECK(vl3b_due(&r, 5000) == 0, "condition %d missing: still due", i);
+		if (i == 8) {
+			due_ready(&r, 30);
+			r.vbus_st = VB_LOW;
+			CHECK(vl3b_due(&r, 5000) == 0, "window LOW");
+		}
+	}
+	due_ready(&r, 30);					/* the first tick is at the primary's enable (stock: the monitor start) */
+	r.s.tick_init = 0;
+	r.adc.ibus = 3;
+	CHECK(vl3b_due(&r, 777) == 0 && r.s.next_tick == 1777 && r.s.tick_init, "first tick at the first post after the primary's enable");
+	due_ready(&r, 30);
+	r.enabled = 0;
+	r.s.tick_init = 0;
+	CHECK(vl3b_due(&r, 777) == 0 && !r.s.tick_init, "no tick before the primary is enabled");
+}
+
+/* through vl3b_run: the enable call, once, and only with the primary running; fuzz */
+static void enable_once(void)
+{
+	struct vl3 r;
+	int n, k, bad_en = 0, twice = 0;
+
+	srand(11);
+	for (n = 0; n < 3000; n++) {
+		int now = 0, calls = 0;
+
+		bus_reset(&sb);
+		memset(&syn, 0, sizeof(syn));
+		syn.fail_rd = -1;
+		due_ready(&r, 1 + rand() % 30);
+		r.ph = V3_PRE;
+		r.s.tick_init = 0;
+		for (k = 0; k < 80; k++) {
+			int ib;
+
+			now += 20 + rand() % 60;
+			r.enabled = rand() % 8 != 0;
+			r.sw_seen = rand() % 8 != 0;
+			r.n_lost = rand() % 8 == 0;
+			r.prot_ok = rand() % 8 != 0;
+			r.suspend_ok = rand() % 8 != 0;
+			r.vbus_st = rand() % 8 == 0 ? VB_HIGH : VB_NORMAL;
+			r.adc.ibus = 1300 + rand() % 200;
+			r.s.hw_done = rand() % 8 != 0;
+			good_sblk(syn.blk, r.s.enabled);
+			if (rand() % 10 == 0)
+				syn.blk[0x05] = 0x2f;
+			ib = r.s.enabled ? 700 : 1;
+			adc_bytes(syn.adc, ib * 1000 / 1875, 2090, 3040, 64, rand());
+			syn.r = &r;
+			syn.en_fail = rand() % 20 == 0;
+			vl3b_run(&sio, &r, now);
+			if (r.s.enabled && !calls && syn.en_calls)
+				calls = syn.en_calls;
+			if (syn.en_calls > 1)
+				twice++;
+			if (syn.en_calls && !syn.en_primary_ok)
+				bad_en++;
+			if (r.s.done)
+				r.s.enabled = r.s.enabled;
+			if (sb.n) {		/* the secondary can only be enabled by a write of 0x07 = 0x81 that came through the enable path */
+				int i, e = 0;
+
+				for (i = 0; i < sb.n; i++)
+					e += sb.enable[i];
+				if (e > 1)
+					twice++;
+			}
+		}
+	}
+	CHECK(!twice, "the secondary was enabled twice in %d sessions", twice);
+	CHECK(!bad_en, "the enable was called %d times without every condition", bad_en);
+	/* a refused enable, or a failed one, still counts: never again */
+	bus_reset(&sb);
+	memset(&syn, 0, sizeof(syn));
+	syn.fail_rd = -1;
+	due_ready(&r, 30);
+	r.ph = V3_PRE;
+	good_sblk(syn.blk, 0);
+	adc_bytes(syn.adc, 1, 2090, 3040, 64, 1);
+	syn.en_fail = 1;
+	n = vl3b_run(&sio, &r, 5000);
+	CHECK(n == -V3S_EN && r.s.done && !r.s.enabled && syn.en_calls == 1, "enable failed: rc %d", n);
+	syn.en_fail = 0;
+	r.s.next_tick = 5000;
+	good_sblk(syn.blk, 0);
+	n = vl3b_run(&sio, &r, 5000);
+	CHECK(syn.en_calls == 1 && !r.s.enabled, "no second try after a failed enable");
+	/* pumps=1 never reaches the secondary's enable even with every condition true */
+	bus_reset(&sb);
+	due_ready(&r, 30);
+	r.pumps = 1;
+	r.ph = V3_PRE;
+	memset(&syn, 0, sizeof(syn));
+	syn.fail_rd = -1;
+	good_sblk(syn.blk, 0);
+	adc_bytes(syn.adc, 1, 2090, 3040, 64, 1);
+	vl3b_run(&sio, &r, 5000);
+	CHECK(!syn.en_calls && !sb.enable[0], "pumps=1: enable called");
+	/* the enable is refused by the write table in any other mode and by io_wr in every mode */
+	CHECK(!vl3b_enable_ok(0x07, 1, 0x81, VM_S2 | VM_S3 | VM_S3S) && vl3b_enable_ok(0x07, 1, 0x81, M3B) && !vl3b_write_ok(0x07, 1, 0x81, M3B), "enable table");
+}
+
+/* ---- 3: the secondary's limits, each crossed ---- */
+
+static void limits2(void)
+{
+	struct vl3 r;
+	int i, b, n, rc, now;
+	static const struct { int reg; u8 mask; } fl[] = {
+		{ 0x06, 0x80 }, { 0x06, 0x40 }, { 0x06, 0x08 }, { 0x06, 0x01 }, { 0x09, 0x08 }, { 0x0d, 0x08 }, { 0x0d, 0x04 }, { 0x0e, 0x80 }, { 0x0e, 0x40 },
+		{ 0x0e, 0x20 }, { 0x0e, 0x10 }, { 0x0e, 0x08 }, { 0x0f, 0x80 }, { 0x0f, 0x40 }, { 0x0f, 0x20 }, { 0x0f, 0x10 }, { 0x0f, 0x08 }, { 0x0f, 0x04 },
+	};
+
+	memset(&syn, 0, sizeof(syn));
+	syn.fail_rd = -1;
+	bus_reset(&sb);
+	run2(&r, 20);
+	CHECK(frame2(&r, 500, 2) == 0, "quiet state");
+
+	for (i = 0; i < (int)(sizeof(fl) / sizeof(fl[0])); i++) {		/* L1 flags: enabled, not enabled, round 1 */
+		int st;
+
+		for (st = 0; st < 3; st++) {
+			run2(&r, 20);
+			r.s.enabled = st == 0;
+			r.ph = st == 2 ? V3_ASK : V3_RUN;
+			good_sblk(syn.blk, st == 0);
+			syn.blk[fl[i].reg] |= fl[i].mask;
+			rc = st == 2 ? vl3b_run(&sio, &r, 500) : frame2(&r, 500, 2);
+			CHECK(rc == V3E_SFLAGS, "flag %02x.%02x state %d: %d", fl[i].reg, fl[i].mask, st, rc);
+		}
+	}
+	run2(&r, 20);						/* flags stock's own blocks show are no faults: 0x09 0x33, 0x0f 0x02, 0x06 0x22 */
+	syn.blk[0x09] = 0x33;
+	syn.blk[0x0f] = 0x02;
+	CHECK(frame2(&r, 500, 2) == 0, "UCP-rise flag");
+	run2(&r, 20);
+	r.s.enabled = 0;
+	r.ph = V3_ASK;
+	good_sblk(syn.blk, 0);
+	syn.blk[0x06] = 0x22;
+	memset(syn.adc, 0, 14);
+	CHECK(vl3b_run(&sio, &r, 500) == 0, "round 1: 0x06 = 0x22 is idle");
+
+	for (i = 0; i < 17; i++) {					/* the image: exactly these bits are judged; a flipped bit that is no flag must end it as SIMAGE, an unjudged one must not */
+		static const u8 judged[17] = { [0x00] = 0xff, [0x01] = 0xff, [0x02] = 0xef, [0x04] = 0xff, [0x05] = 0xff, [0x09] = 0x97, [0x0d] = 0xf0, [0x10] = 0xff };
+		static const u8 flagm[17] = { [0x09] = 0x08, [0x0d] = 0x0c, [0x0e] = 0xf8, [0x0f] = 0xfc, [0x06] = 0xc9 };
+
+		if (i == 0x06 || i == 0x07 || i == 0x0e || i == 0x0f)
+			continue;
+		for (b = 0; b < 8; b++) {
+			run2(&r, 20);
+			syn.blk[i] ^= 1 << b;
+			rc = frame2(&r, 500, 2);
+			if (flagm[i] >> b & 1)
+				CHECK(rc == V3E_SFLAGS, "reg %02x bit %d is a flag: %d", i, b, rc);
+			else if (judged[i] >> b & 1)
+				CHECK(rc == V3E_SIMAGE, "reg %02x bit %d is judged: %d", i, b, rc);
+			else
+				CHECK(rc == 0, "reg %02x bit %d is not judged: %d", i, b, rc);
+		}
+	}
+	run2(&r, 20);
+	syn.blk[0x05] = 0x2f;
+	CHECK(frame2(&r, 500, 2) == V3E_SIMAGE, "the primary's 0x05 on the secondary");
+	run2(&r, 20);
+	syn.blk[0x09] = 0x10;
+	CHECK(frame2(&r, 500, 2) == V3E_SIMAGE, "0x09 watchdog not armed");
+	run2(&r, 20);
+	r.ph = V3_ASK;
+	syn.blk[0x05] = 0x00;				/* round 1: the image is not judged yet */
+	syn.blk[0x07] = 0x07; syn.blk[0x06] = 0x02;
+	memset(syn.adc, 0, 14);
+	r.s.enabled = 0;
+	CHECK(vl3b_run(&sio, &r, 500) == 0, "round 1 without an image check");
+
+	for (n = 0; n <= 400; n += 20) {			/* CHG_EN and the VBUS error, 100 ms of grace */
+		run2(&r, 20);
+		syn.blk[0x07] = 0x01;
+		rc = frame2(&r, n, 2);
+		CHECK(rc == (n >= 100 ? V3E_SCHGEN : 0), "CHG_EN clear %d ms after the enable: %d", n, rc);
+		run2(&r, 20);
+		syn.blk[0x06] |= 0x10;
+		rc = frame2(&r, n, 2);
+		CHECK(rc == (n >= 100 ? V3E_SVERR : 0), "VBUS error %d ms after the enable: %d", n, rc);
+	}
+	run2(&r, 20);					/* before the enable: not idle */
+	r.s.enabled = 0;
+	syn.blk[0x07] = 0x87;
+	CHECK(frame2(&r, 500, 2) == V3E_SIDLE, "CHG_EN before the enable");
+	run2(&r, 20);
+	r.s.enabled = 0;
+	syn.blk[0x06] = 0x06; syn.blk[0x07] = 0x07;
+	CHECK(frame2(&r, 500, 2) == V3E_SIDLE, "switching before the enable");
+	run2(&r, 20);					/* stopped switching: 3 reads, after it was seen */
+	syn.blk[0x06] = 0x02;
+	CHECK(frame2(&r, 500, 2) == 0 && frame2(&r, 540, 3) == 0, "two reads without switching");
+	CHECK(frame2(&r, 580, 4) == V3E_SLOST, "third read without switching");
+	run2(&r, 20);
+	r.s.sw_seen = 0;
+	syn.blk[0x06] = 0x02;
+	for (i = 0; i < 20; i++)
+		CHECK(frame2(&r, 500 + 40 * i, i) == 0, "never switched yet: no LOST");
+	run2(&r, 20);					/* two reads without switching, switching again, two again: the count restarts */
+	for (i = 0; i < 12; i++) {
+		syn.blk[0x06] = i % 3 == 2 ? 0x06 : 0x02;
+		CHECK(frame2(&r, 500 + 40 * i, i) == 0, "lost count restarts (read %d)", i);
+	}
+
+	for (n = 2810; n <= 2840; n++) {			/* per pump IBUS 5300 mA (raw * 1.875) */
+		run2(&r, 30);
+		r.s.checked = 1;
+		adc_bytes(syn.adc, n, 2090, 3040, 64, 2);
+		rc = frame2(&r, 500, 2);
+		{
+			int ib = n * 1875 / 1000;
+
+			CHECK((rc == V3E_SIBUS_MAX) == (ib > 5300), "secondary IBUS %d: %d", ib, rc);
+		}
+	}
+	for (n = 130; n <= 150; n++) {				/* TDIE 70.0 C = raw 140 */
+		run2(&r, 30);
+		adc_bytes(syn.adc, 373, 2090, 3040, n, 2);
+		rc = frame2(&r, 500, 2);
+		CHECK((rc == V3E_STDIE) == (n * 5 > 700), "secondary TDIE %d.%d: %d", n * 5 / 10, n * 5 % 10, rc);
+	}
+	for (n = 320; n <= 330; n++) {				/* a pump that is not enabled carries less than 600 mA */
+		run2(&r, 30);
+		r.s.enabled = 0;
+		good_sblk(syn.blk, 0);
+		adc_bytes(syn.adc, n, 2090, 3040, 64, 2);
+		rc = frame2(&r, 500, 2);
+		CHECK((rc == V3E_SCURR) == (n * 1875 / 1000 > 600), "idle secondary at %d mA: %d", n * 1875 / 1000, rc);
+		run2(&r, 30);
+		r.s.enabled = 0;
+		r.ph = V3_ASK;
+		good_sblk(syn.blk, 0);
+		memset(syn.adc, 0, 14);
+		syn.adc[0] = n >> 8; syn.adc[1] = n;
+		rc = vl3b_run(&sio, &r, 500);
+		CHECK(rc == 0, "round 1: the ADC is off, its latched %d mA is not judged: %d", n * 1875 / 1000, rc);
+	}
+	/* seen on the tablet: the secondary's ADC still held android's last fast charge (0x13/0x14 = 01 e1, 901 mA; 0x15/0x16 = 09 b1, 9.3 V) */
+	run2(&r, 30);
+	r.s.enabled = 0;
+	r.ph = V3_ASK;
+	good_sblk(syn.blk, 0);
+	memset(syn.adc, 0, 14);
+	syn.adc[0] = 0x01; syn.adc[1] = 0xe1; syn.adc[2] = 0x09; syn.adc[3] = 0xb1;
+	CHECK(vl3b_run(&sio, &r, 500) == 0, "round 1: android's latched 901 mA is not judged");
+	run2(&r, 30);
+	r.s.enabled = 0;
+	r.s.fresh = 0;
+	good_sblk(syn.blk, 0);
+	CHECK(frame2(&r, 500, 2) == 0, "allow frame: the read right after the ADC switch-on (still 901 mA) is not judged");
+	CHECK(r.s.fresh == 1, "allow frame: the next read is judged");
+	CHECK(frame2(&r, 547, 3) == V3E_SCURR, "next frame: 901 mA on a secondary that is not enabled ends the session");
+	/* the secondary's own VBAT / VBUS / VOUT bytes are not judged: its VBAT pin is not wired */
+	run2(&r, 30);
+	adc_bytes(syn.adc, 373, 4000, 4095, 64, 2);
+	syn.adc[6] = 0x0f; syn.adc[7] = 0xff; syn.adc[4] = 0x0f; syn.adc[5] = 0xff;
+	CHECK(frame2(&r, 500, 2) == 0, "garbage VBUS / VBAT / VOUT / VAC bytes on the secondary are not a limit");
+
+	for (b = 1; b <= 73; b++) {				/* the total: above cap + 300 mA on 3 reads, any cap; primary and secondary summed */
+		int thr = b * 100 + 300, half = thr / 2 + 40;
+		u8 raw[2];
+		int sraw = half * 1000 / 1875 + 1;
+
+		run2(&r, b);
+		r.adc.ibus = thr - half - 2;			/* just at the limit with the secondary at half+... */
+		adc_bytes(syn.adc, sraw, 2090, 3040, 64, 2);
+		raw[0] = 0;
+		r.adc.ibus = thr - (sraw * 1875 / 1000);	/* total == thr exactly */
+		CHECK(frame2(&r, 500, 2) == 0 && frame2(&r, 540, 3) == 0 && frame2(&r, 580, 4) == 0, "cap %d: total at the limit", b);
+		r.adc.ibus += 1;				/* total == thr + 1 */
+		CHECK(frame2(&r, 620, 5) == 0 && frame2(&r, 660, 6) == 0, "cap %d: two reads over", b);
+		rc = frame2(&r, 700, 7);
+		CHECK(rc == V3E_TOTAL, "cap %d: third read over: %d", b, rc);
+		run2(&r, b);					/* reset by a read below */
+		adc_bytes(syn.adc, sraw, 2090, 3040, 64, 2);
+		for (i = 0; i < 30; i++) {
+			r.adc.ibus = thr - (sraw * 1875 / 1000) + (i % 3 == 2 ? -200 : 5);
+			CHECK(frame2(&r, 500 + 40 * i, 10 + i) == 0, "cap %d: no reset at read %d", b, i);
+		}
+		(void)raw;
+	}
+
+	/* the status check after the enable: 300 ms, then up to 3 s (stock: 300 ms sleep, 60 x 50 ms) */
+	for (n = 290; n <= 310; n += 1) {
+		run2(&r, 30);
+		r.s.checked = 0;
+		adc_bytes(syn.adc, 100, 2090, 3040, 64, 2);	/* 187 mA: below 500 */
+		rc = frame2(&r, n, 2);
+		CHECK(rc == 0 && !r.s.checked, "status check at %d ms with a low secondary: %d", n, rc);
+	}
+	for (n = 3290; n <= 3310; n++) {
+		run2(&r, 30);
+		r.s.checked = 0;
+		adc_bytes(syn.adc, 100, 2090, 3040, 64, 2);
+		rc = frame2(&r, n, 2);
+		CHECK((rc == V3E_STROUBLE) == (n >= 3300), "trouble at %d ms: %d", n, rc);
+	}
+	for (n = 297; n <= 300; n++) {				/* not checked before 300 ms, even when everything is fine */
+		run2(&r, 30);
+		r.s.checked = 0;
+		rc = frame2(&r, n, 2);
+		CHECK(rc == 0 && r.s.checked == (n >= 300), "check at %d ms: checked %d", n, r.s.checked);
+	}
+	for (n = 497; n <= 503; n++) {				/* 500 mA on the secondary: raw * 1.875 >= 500 */
+		run2(&r, 30);
+		r.s.checked = 0;
+		adc_bytes(syn.adc, n * 1000 / 1875 + (n * 1000 % 1875 ? 1 : 0), 2090, 3040, 64, 2);
+		r.adc.ibus = 700;
+		frame2(&r, 400, 2);
+		CHECK(r.s.checked == (r.s.adc.ibus >= 500), "secondary %d mA: checked %d", r.s.adc.ibus, r.s.checked);
+	}
+	for (n = 998; n <= 1003; n++) {				/* |primary - secondary| at most 1000 mA */
+		run2(&r, 30);
+		r.s.checked = 0;
+		adc_bytes(syn.adc, 800, 2090, 3040, 64, 2);	/* 1500 mA */
+		r.adc.ibus = 1500 - n;
+		frame2(&r, 400, 2);
+		CHECK(r.s.checked == (n <= 1000), "deviation %d: checked %d", n, r.s.checked);
+	}
+	run2(&r, 30);					/* not switching (0x06.2 / CHG_EN) */
+	r.s.checked = 0;
+	syn.blk[0x06] = 0x02;
+	frame2(&r, 400, 2);
+	CHECK(!r.s.checked, "not switching: no check");
+
+	/* total below 1100 mA on 4 ticks ends it (stock disables the secondary after 4 ticks) */
+	for (n = 1098; n <= 1102; n++) {
+		int t;
+
+		run2(&r, 30);
+		r.adc.ibus = n - 373 * 1875 / 1000 - 0;
+		rc = 0;
+		for (t = 0; t < 4 && !rc; t++) {
+			r.s.next_tick = 10000 + 1000 * t;
+			rc = frame2(&r, 10000 + 1000 * t, 2 + t);
+			CHECK(rc == 0 || t == 3, "total %d: ended on tick %d", n, t);
+		}
+		CHECK((rc == V3E_SLOW) == (r.adc.ibus + r.s.adc.ibus < 1100), "total %d mA over 4 ticks: %d", r.adc.ibus + r.s.adc.ibus, rc);
+	}
+	run2(&r, 30);					/* a tick above resets the count; frames between ticks do not count */
+	r.adc.ibus = 100;
+	for (i = 0; i < 40; i++) {
+		r.s.next_tick = 1000000;
+		CHECK(frame2(&r, 10000 + 40 * i, i) == 0, "frames that are not ticks do not count");
+	}
+	for (i = 0; i < 3; i++) {
+		r.s.next_tick = 20000 + i;
+		CHECK(frame2(&r, 20000 + i, 50 + i) == 0, "tick %d", i);
+	}
+	r.adc.ibus = 2000;
+	r.s.next_tick = 21000;
+	CHECK(frame2(&r, 21000, 60) == 0 && r.s.n_low == 0, "high tick resets");
+	r.adc.ibus = 100;
+	for (i = 0; i < 3; i++) {
+		r.s.next_tick = 22000 + i;
+		CHECK(frame2(&r, 22000 + i, 70 + i) == 0, "tick again %d", i);
+	}
+	r.s.next_tick = 23000;
+	CHECK(frame2(&r, 23000, 80) == V3E_SLOW, "fourth low tick");
+	run2(&r, 30);					/* not before the status check passed */
+	r.s.checked = 0;
+	r.adc.ibus = 10;
+	r.s.next_tick = 200;
+	CHECK(frame2(&r, 200, 2) == 0 && r.s.n_low == 0 && !r.s.checked, "low rule off before the check");
+
+	/* stale: six identical blocks */
+	run2(&r, 30);
+	for (i = 1; i < 12; i++) {
+		now = 500 + 40 * i;
+		rc = frame2(&r, now, 9);
+		CHECK(rc == (i >= 6 ? V3E_SSTALE : 0), "identical block %d: %d", i, rc);
+		if (rc)
+			break;
+	}
+	CHECK(i == 6, "stale ended it at read %d, wanted 6", i);
+	run2(&r, 30);
+	for (i = 0; i < 40; i++)
+		CHECK(frame2(&r, 500 + 40 * i, i / 2) == 0, "runs of two %d", i);
+	run2(&r, 30);					/* identical only in the secondary's IBUS bytes, as stock's own run does up to 8 times: not stale */
+	for (i = 0; i < 40; i++) {
+		syn.adc[2] = (i / 7) & 0x0f;
+		syn.adc[3] = i & 0xff;
+		CHECK(frame2(&r, 500 + 40 * i, 3) == 0, "IBUS alone repeated, rest moving: %d", i);
+	}
+
+	/* read and write failures */
+	for (i = 0; i < 6; i++) {
+		static const u8 rr[] = { 0x06, 0x04, 0x00, 0x10, 0x13, 0x13 };
+
+		run2(&r, 30);
+		syn.fail_rd = rr[i];
+		rc = frame2(&r, 500, 2);
+		CHECK(rc == -V3S_RD, "read of 0x%02x fails: %d", rr[i], rc);
+		syn.fail_rd = -1;
+	}
+	bus_reset(&sb);
+	run2(&r, 30);
+	sb.fail_reg = 0x11;
+	sb.fail_left = 1;
+	CHECK(frame2(&r, 500, 2) == -V3S_WR, "freeze write fails");
+	bus_reset(&sb);
+	run2(&r, 30);
+	sb.fail_reg = 0x11;
+	sb.fail_skip = 1;
+	sb.fail_left = 1;
+	CHECK(frame2(&r, 500, 2) == -V3S_WR && sb.n == 2, "unfreeze write fails after the freeze");
+}
+
+/* ---- 4: the write tables of both buses, cross-refusal, every register and value ---- */
+
+static int has(const u8 (*l)[2], int n, int reg, int val)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (l[i][0] == reg && l[i][1] == val)
+			return 1;
+	return 0;
+}
+
+static void tables_cross(void)
+{
+	/* typed here as the oracle, not taken from the header: the secondary's byte rows, and the ones that are the primary's only */
+	static const u8 sec[][2] = {
+		{ 0x07, 0x41 }, { 0x07, 0x01 }, { 0x11, 0x00 }, { 0x11, 0x20 }, { 0x11, 0x80 }, { 0x11, 0xa0 }, { 0x02, 0x01 }, { 0x04, 0x5a }, { 0x00, 0x36 },
+		{ 0x05, 0x2e }, { 0x01, 0xbf }, { 0x2b, 0x00 }, { 0x34, 0x60 }, { 0x09, 0x10 }, { 0x09, 0x13 }, { 0x10, 0x02 }, { 0x0d, 0x70 }, { 0x33, 0xd1 },
+	};
+	static const u8 sec_only[][2] = { { 0x07, 0x41 }, { 0x07, 0x01 }, { 0x11, 0x20 }, { 0x05, 0x2e } };
+	static const u8 pri_only[][2] = { { 0x07, 0x40 }, { 0x07, 0x00 }, { 0x05, 0x2f }, { 0x05, 0xaf }, { 0x08, 0x00 }, { 0x08, 0xe0 }, { 0x21, 0x21 }, { 0x21, 0xc0 },
+		{ 0x22, 0x00 }, { 0x30, 0x05 }, { 0x30, 0x7f }, { 0x3b, 0x04 }, { 0x2b, 0x81 } };
+	int reg, val, w, mode, i;
+
+	for (mode = 0; mode < 16; mode++)
+		for (reg = 0; reg < 256; reg++)
+			for (val = 0; val < 512; val++)
+				for (w = 1; w <= 2; w++) {
+					int ok = vl3b_write_ok(reg, w, val, mode), want = (mode & VM_S3B) && w == 1 && val < 256 && has(sec, 18, reg, val);
+
+					if (ok != want) {
+						CHECK(ok == want, "secondary table: mode %d write %02x w%d 0x%x: %d", mode, reg, w, val, ok);
+						return;
+					}
+				}
+	for (reg = 0; reg < 256; reg++)
+		for (val = 0; val < 512; val++)
+			for (mode = 0; mode < 16; mode++)
+				for (w = 1; w <= 2; w++)
+					if (vl3b_enable_ok(reg, w, val, mode) != ((mode & VM_S3B) && reg == 0x07 && w == 1 && val == 0x81)) {
+						CHECK(0, "secondary enable_ok %02x w%d %x mode %d", reg, w, val, mode);
+						return;
+					}
+	/* cross: a write that only one pump's table has is refused by the other's, in every mode; the secondary's word writes do not exist */
+	for (i = 0; i < 4; i++)
+		for (mode = 1; mode < 16; mode++)
+			CHECK(!vl_write_ok_m(sec_only[i][0], 1, sec_only[i][1], mode) && !vl3_enable_ok(sec_only[i][0], 1, sec_only[i][1], mode), "primary accepts the secondary's %02x=%02x (mode %d)", sec_only[i][0], sec_only[i][1], mode);
+	for (i = 0; i < 13; i++)
+		for (mode = 0; mode < 16; mode++)
+			CHECK(!vl3b_write_ok(pri_only[i][0], 1, pri_only[i][1], mode), "secondary accepts the primary's %02x=%02x (mode %d)", pri_only[i][0], pri_only[i][1], mode);
+	for (mode = 0; mode < 16; mode++) {
+		CHECK(!vl3b_write_ok(0x07, 1, 0x80, mode) && !vl3b_write_ok(0x07, 1, 0x00, mode) && !vl3b_write_ok(0x07, 1, 0x81, mode) && !vl3b_enable_ok(0x07, 1, 0x80, mode),
+		      "secondary 0x07 = 0x80 / 0x00 / enable value in the general table");
+		CHECK(!vl3_enable_ok(0x07, 1, 0x81, mode) && !vl_write_ok_m(0x07, 1, 0x81, mode), "primary accepts 0x07 = 0x81");
+		CHECK(!vl3b_write_ok(0x2c, 2, 0x0002, mode) && !vl3b_write_ok(0x31, 2, 0x2002, mode) && !vl3b_write_ok(0x2c, 1, 0x02, mode), "secondary accepts a TX or predata word");
+	}
+	/* never on the secondary, in any mode: 0x05 = 0x2f (primary's OCP), 0x09 with bit 7 (1:1), 0x0c, 0x3c, 0x40..0xcc */
+	for (val = 0; val < 256; val++)
+		for (mode = 0; mode < 16; mode++) {
+			CHECK(!(val & 0x80) || !vl3b_write_ok(0x09, 1, val, mode), "secondary 0x09 = 0x%02x", val);
+			CHECK(!vl3b_write_ok(0x0c, 1, val, mode) && !vl3b_write_ok(0x3c, 1, val, mode) && !vl3b_write_ok(0x05, 1, 0xcf, mode), "secondary 0x0c / 0x3c");
+			for (reg = 0x40; reg <= 0xcc; reg++)
+				CHECK(!vl3b_write_ok(reg, 1, val, mode), "secondary reg 0x%02x", reg);
+		}
+	/* the phase of every row: typed here, compared over every register and value (a row in a phase it does not belong to is a write stock makes at another time) */
+	{
+		static const struct { u8 reg, val, ph; } ph[] = {
+			{ 0x07, 0x41, VW_INIT }, { 0x07, 0x01, VW_EXIT }, { 0x11, 0x00, VW_INIT | VW_EXIT | VW_SESS }, { 0x11, 0x20, VW_SESS }, { 0x11, 0x80, VW_HW | VW_RUN },
+			{ 0x11, 0xa0, VW_RUN }, { 0x02, 0x01, VW_INIT | VW_HW | VW_EXIT }, { 0x04, 0x5a, VW_INIT | VW_HW | VW_EXIT }, { 0x00, 0x36, VW_INIT | VW_EXIT },
+			{ 0x05, 0x2e, VW_INIT | VW_HW | VW_EXIT }, { 0x01, 0xbf, VW_INIT | VW_EXIT }, { 0x2b, 0x00, VW_INIT | VW_EXIT }, { 0x34, 0x60, VW_INIT | VW_HW | VW_EXIT },
+			{ 0x09, 0x10, VW_INIT | VW_EXIT }, { 0x09, 0x13, VW_HW }, { 0x10, 0x02, VW_INIT | VW_EXIT }, { 0x0d, 0x70, VW_HW }, { 0x33, 0xd1, VW_HW },
+		};
+		int want;
+
+		for (reg = 0; reg < 256; reg++)
+			for (val = 0; val < 256; val++) {
+				want = 0;
+				for (i = 0; i < 18; i++)
+					if (ph[i].reg == reg && ph[i].val == val)
+						want = ph[i].ph;
+				if (vl3b_write_phase(reg, 1, val, M3B) != want) {
+					CHECK(0, "secondary phases of %02x=%02x: ours %d, want %d", reg, val, vl3b_write_phase(reg, 1, val, M3B), want);
+					return;
+				}
+			}
+	}
+	/* the rows lists are in the table, in the right phase; every table row is used by a list */
+	{
+		unsigned int j;
+		int hit[VL3B_NW] = { 0 };
+		const struct { const struct vl_row *rw; unsigned int n; int ph; } L[] = {
+			{ vl3b_init_rows, VL3B_NINIT, VW_INIT }, { vl3b_hw_rows, VL3B_NHW, VW_HW }, { vl3b_adc1_rows, 2, VW_SESS }, { vl3b_adc_rows, 2, VW_RUN }, { vl3b_exit_rows, VL3B_NEXIT, VW_EXIT },
+		};
+
+		for (i = 0; i < 5; i++)
+			for (j = 0; j < L[i].n; j++) {
+				unsigned int t;
+
+				CHECK(vl3b_write_phase(L[i].rw[j].reg, 1, L[i].rw[j].val, M3B) & L[i].ph, "list %d row %u (%02x=%02x) not in its phase", i, j, L[i].rw[j].reg, L[i].rw[j].val);
+				for (t = 0; t < VL3B_NW; t++)
+					if ((vl3b_wl[t].phase & L[i].ph) && vl3b_wl[t].reg == L[i].rw[j].reg && vl3b_wl[t].val == L[i].rw[j].val)
+						hit[t] = 1;
+			}
+		hit[2] = 1;						/* the enable: vl3b_enable_ok */
+		for (j = 0; j < VL3B_NW; j++)
+			CHECK(hit[j], "secondary table entry %u (%s) is never written", j, vl3b_wl[j].what);
+		CHECK(VL3B_NINIT == 11 && VL3B_NHW == 8 && VL3B_NEXIT == 12, "row counts");
+	}
+	/* the firmware requests: exactly four rows, the hold replaced charge_behaviour */
+	{
+		int prop, ph, v, n = 0;
+
+		for (mode = 1; mode < 16; mode++)
+			for (prop = 0; prop < 4; prop++)
+				for (ph = 0; ph < 8; ph++)
+					for (v = -2; v < 3; v++) {
+						int ok = vl3_fw_ok(prop, v, ph, mode), want = (mode & VM_S3) && ((prop == FW_ICL && v == 0 && (ph & FWP_SUSPEND)) || (prop == FW_HOLD && v == 1 && (ph & FWP_RUN)) ||
+							(prop == FW_HOLD && v == 0 && (ph & FWP_EXIT)));
+						n += ok;
+						CHECK(ok == want, "fw request prop %d val %d phase %d mode %d", prop, v, ph, mode);
+					}
+		CHECK(n > 0 && !vl3_fw_ok(FW_HOLD, 1, FWP_SUSPEND, M3B) && !vl3_fw_ok(FW_HOLD, 1, FWP_EXIT, M3B) && !vl3_fw_ok(FW_HOLD, 0, FWP_RUN, M3B) && !vl3_fw_ok(FW_HOLD, 1, FWP_RUN, VM_S2), "hold phases");
+		CHECK(VL3_NFW == 4 && vl3_fw_ok(FW_ICL, 2000000, FWP_EXIT, M3B), "four firmware rows");
+	}
+}
