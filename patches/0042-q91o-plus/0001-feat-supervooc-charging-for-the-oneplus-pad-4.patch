+/*
+ * Host test for the stage 4 part of vooc_logic.h (automatic SUPERVOOC: the ask by SoC, the thermal cap, the taper, the new ends, the
+ * parameters, the start gate, the long-session clock, auto re-arm). cc -I.. test_stage4.c -o test_stage4 && ./test_stage4
+ * Every expected number in this file is a literal: nothing is read from the header's macros. The replay is capture_batt4.h, the battery
+ * blocks of stock's 80 W session (derived, nothing synthesised); TDIE is not in that trace, it is 0 there.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vooc_logic.h>
+#include "capture_batt4.h"
+
+static int fails, checks;
+
+#define CHECK(c, ...) do { \
+	checks++; \
+	if (!(c)) { \
+		fails++; \
+		printf("FAIL %s:%d: %s  ", __FILE__, __LINE__, #c); \
+		printf(__VA_ARGS__); \
+		printf("\n"); \
+	} \
+} while (0)
+
+/* ---- the pure functions, table-driven ---- */
+
+static void start_env(void)
+{
+	static const int env[][2] = { { 0, 73 }, { 31, 73 }, { 39, 73 }, { 40, 50 }, { 41, 50 }, { 54, 50 }, { 55, 38 }, { 56, 38 }, { 89, 38 }, { 100, 38 } };
+	static const int below[][2] = { { 74, 73 }, { 73, 60 }, { 72, 60 }, { 61, 60 }, { 60, 50 }, { 59, 50 }, { 51, 50 }, { 50, 38 }, { 49, 38 }, { 39, 38 },
+					{ 38, 30 }, { 37, 30 }, { 31, 30 }, { 30, 25 }, { 29, 25 }, { 26, 25 }, { 25, 20 }, { 24, 20 }, { 21, 20 }, { 20, 0 },
+					{ 19, 0 }, { 1, 0 }, { 0, 0 } };
+	unsigned int i;
+
+	for (i = 0; i < sizeof(env) / sizeof(env[0]); i++)
+		CHECK(vl4_env_ask(env[i][0]) == env[i][1], "envelope at SoC %d: %d", env[i][0], vl4_env_ask(env[i][0]));
+	for (i = 0; i < sizeof(below) / sizeof(below[0]); i++)
+		CHECK(vl4_below(below[i][0]) == below[i][1], "ladder below %d: %d", below[i][0], vl4_below(below[i][0]));
+}
+
+static void init(void)
+{
+	/* cap, start SoC, ask: the minimum of the cap and the envelope (no start table: a start at 55 % or more gets 38 like any session there) */
+	static const int t[][3] = {
+		{ 73, 15, 73 }, { 73, 31, 73 }, { 73, 39, 73 }, { 73, 40, 50 }, { 73, 54, 50 }, { 73, 55, 38 }, { 73, 56, 38 }, { 73, 80, 38 }, { 73, 0, 73 },
+		{ 60, 31, 60 }, { 45, 31, 45 }, { 20, 31, 20 }, { 1, 15, 1 }, { 40, 40, 40 }, { 51, 40, 50 }, { 29, 55, 29 }, { 31, 55, 31 }, { 39, 55, 38 }, { 38, 54, 38 },
+	};
+	unsigned int i;
+	struct vl4 s;
+
+	for (i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		vl4_init(&s, t[i][0], t[i][1]);
+		CHECK(s.ask == t[i][2] && s.n_hi == 0 && s.nchg == 0, "init cap %d SoC %d: ask %d", t[i][0], t[i][1], s.ask);
+	}
+}
+
+static struct vl4 at(int cap, int soc)
+{
+	struct vl4 s;
+
+	vl4_init(&s, cap, soc);
+	return s;
+}
+
+static void envelope(void)
+{
+	struct vl4 s = at(73, 31);
+
+	CHECK(vl4_read(&s, 31, 4000, 0) == 0 && s.ask == 73 && s.nchg == 0, "31 %%");
+	CHECK(vl4_read(&s, 39, 4000, 0) == 0 && s.ask == 73 && s.nchg == 0, "39 %%");
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 50 && s.nchg == 1 && s.new_ask[0] == 50 && s.why[0] == 1, "40 %% -> 50 (envelope)");
+	CHECK(vl4_read(&s, 41, 4000, 0) == 0 && s.ask == 50 && s.nchg == 0, "41 %%: no second change");
+	CHECK(vl4_read(&s, 54, 4000, 0) == 0 && s.ask == 50 && s.nchg == 0, "54 %%");
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38 && s.nchg == 1 && s.new_ask[0] == 38 && s.why[0] == 1, "55 %% -> 38");
+	CHECK(vl4_read(&s, 89, 4000, 0) == 0 && s.ask == 38 && s.nchg == 0, "89 %%");
+
+	/* a jump over a threshold: one change, the new level */
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38 && s.nchg == 1, "31 -> 55 in one read");
+
+	/* the running minimum: a later lower envelope then a higher one never raises the ask */
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38, "to 38");
+	CHECK(vl4_read(&s, 39, 4000, 0) == 0 && s.ask == 38 && s.nchg == 0, "SoC back to 39 (envelope 73): ask stays 38");
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 38 && s.nchg == 0, "SoC 40 (envelope 50): ask stays 38");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 50, "to 50");
+	CHECK(vl4_read(&s, 39, 4000, 0) == 0 && s.ask == 50 && s.nchg == 0, "back to 39: stays 50");
+	CHECK(vl4_read(&s, 31, 4000, 0) == 0 && s.ask == 50 && s.nchg == 0, "back to 31: stays 50");
+
+	/* a cap below the envelope stays */
+	s = at(45, 31);
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 45 && s.nchg == 0, "cap 45 at 40 %%");
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38 && s.nchg == 1, "cap 45 at 55 %%");
+
+	/* a start at 55 % or more: 38, never raised by anything */
+	s = at(73, 55);
+	CHECK(s.ask == 38 && vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38 && s.nchg == 0, "start 55: 38");
+	CHECK(vl4_read(&s, 70, 4000, 0) == 0 && s.ask == 38 && s.nchg == 0, "start 55, later 70 %%: 38");
+	s = at(73, 63);
+	CHECK(s.ask == 38 && s.lim == 38, "start 63: 38 (the current stock runs at that SoC)");
+}
+
+static void thermal(void)
+{
+	struct vl4 s = at(73, 31);
+
+	CHECK(vl4_read(&s, 31, 4000, 659) == 0 && s.ask == 73 && s.nchg == 0, "TDIE 65.9 C");
+	CHECK(vl4_read(&s, 31, 4000, 660) == 0 && s.ask == 60 && s.nchg == 1 && s.new_ask[0] == 60 && s.why[0] == 2, "TDIE 66.0 C -> 60 (thermal)");
+	CHECK(vl4_read(&s, 31, 4000, 0) == 0 && s.ask == 60 && s.nchg == 0, "cooler again: still 60");
+	CHECK(vl4_read(&s, 31, 4000, 700) == 0 && s.ask == 60 && s.nchg == 0, "hotter: 60, no second change");
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 50 && s.nchg == 1 && s.why[0] == 1, "then the envelope 50 (cooler, 40 %%)");
+	CHECK(vl4_read(&s, 39, 4000, 0) == 0 && s.ask == 50, "back to 39: 50 stays");
+
+	s = at(73, 40);
+	CHECK(vl4_read(&s, 40, 4000, 660) == 0 && s.ask == 50 && s.nchg == 0, "ask 50 is below 60: thermal changes nothing");
+	s = at(60, 31);
+	CHECK(vl4_read(&s, 31, 4000, 660) == 0 && s.ask == 60 && s.nchg == 0, "cap 60: thermal changes nothing");
+	s = at(61, 31);
+	CHECK(vl4_read(&s, 31, 4000, 660) == 0 && s.ask == 60 && s.nchg == 1, "cap 61 -> 60");
+
+	/* envelope and thermal in one read: two changes, in that order */
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 55, 4000, 660) == 0 && s.ask == 38 && s.nchg == 1 && s.why[0] == 1, "38 beats 60: envelope only");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 31, 4000, 1000) == 0 && s.ask == 60 && s.nchg == 1, "TDIE 100 C");
+}
+
+static void taper(void)
+{
+	static const int steps[] = { 60, 50, 38, 30, 25, 20 };
+	struct vl4 s = at(73, 31);
+	unsigned int i;
+	int k;
+
+	for (k = 0; k < 10; k++)
+		CHECK(vl4_read(&s, 31, 4449, 0) == 0 && s.ask == 73 && s.n_hi == 0, "4449 mV never counts");
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && s.ask == 73 && s.n_hi == 1, "4450 #1");
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && s.ask == 73 && s.n_hi == 2, "4450 #2");
+	CHECK(vl4_read(&s, 31, 4449, 0) == 0 && s.ask == 73 && s.n_hi == 0, "an interruption restarts the count");
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && s.ask == 73, "#1 again");
+	CHECK(vl4_read(&s, 31, 4451, 0) == 0 && s.ask == 73, "#2 again");
+	CHECK(vl4_read(&s, 31, 4452, 0) == 0 && s.ask == 60 && s.nchg == 1 && s.new_ask[0] == 60 && s.why[0] == 3 && s.n_hi == 0, "the third consecutive read: 73 -> 60 (taper)");
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && s.ask == 60 && s.nchg == 0 && s.n_hi == 0 && s.lim == 73, "after a step the taper waits, the limit keeps 73");
+	for (k = 2; k < 30; k++)
+		CHECK(vl4_read(&s, 31, 4460, 0) == 0 && s.ask == 60 && s.n_hi == 0 && s.lim == 73, "wait read %d", k);
+	CHECK(vl4_read(&s, 31, 4460, 0) == 0 && s.ask == 60 && s.n_hi == 1 && s.lim == 60, "read 30 after the step: the limit takes 60, the count starts");
+	CHECK(vl4_read(&s, 31, 4460, 0) == 0 && s.n_hi == 2 && vl4_read(&s, 31, 4460, 0) == 0 && s.ask == 50 && s.nchg == 1 && s.why[0] == 3 && s.lim == 60,
+	      "32 reads after the first step: 60 -> 50");
+
+	/* a voltage that never drops: the first step after 3 reads, each further one 32 reads later (29 waiting, 3 counted), then the floor */
+	s = at(73, 31);
+	{
+		int n = 0, step_at[6] = { 0 }, ni = 0, rc = 0;
+
+		while (!rc && n < 1000) {
+			u8 before = s.ask;
+
+			rc = vl4_read(&s, 31, 4460, 0);
+			n++;
+			if (!rc && s.ask != before) {
+				CHECK(ni < 6 && s.ask == steps[ni] && s.nchg == 1 && s.why[0] == 3, "step %d -> %d", ni, s.ask);
+				if (ni < 6)
+					step_at[ni] = n;
+				ni++;
+			}
+		}
+		CHECK(ni == 6 && step_at[0] == 3 && step_at[1] == 35 && step_at[2] == 67 && step_at[3] == 99 && step_at[4] == 131 && step_at[5] == 163,
+		      "steps at reads %d %d %d %d %d %d", step_at[0], step_at[1], step_at[2], step_at[3], step_at[4], step_at[5]);
+		CHECK(rc == 3 && n == 195 && s.ask == 20, "the floor ends it at read %d: %d", n, rc);
+	}
+
+	/* an interruption at the floor */
+	s = at(20, 31);
+	CHECK(vl4_read(&s, 31, 4460, 0) == 0 && vl4_read(&s, 31, 4460, 0) == 0 && vl4_read(&s, 31, 4000, 0) == 0 && s.n_hi == 0, "floor, interrupted");
+	CHECK(vl4_read(&s, 31, 4460, 0) == 0 && vl4_read(&s, 31, 4460, 0) == 0 && vl4_read(&s, 31, 4460, 0) == 3, "floor after the restart");
+
+	/* an ask off the ladder steps to the next level below it; at or below 20 it ends */
+	{
+		static const int off[][2] = { { 70, 60 }, { 61, 60 }, { 45, 38 }, { 39, 38 }, { 37, 30 }, { 28, 25 }, { 22, 20 }, { 21, 20 } };
+
+		for (i = 0; i < sizeof(off) / sizeof(off[0]); i++) {
+			s = at(off[i][0], 31);
+			CHECK(s.ask == off[i][0], "cap %d", off[i][0]);
+			CHECK(vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 0 && s.ask == off[i][1], "cap %d steps to %d: %d",
+			      off[i][0], off[i][1], s.ask);
+		}
+		for (k = 1; k <= 20; k++) {
+			s = at(k, 31);
+			CHECK(vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 3, "cap %d is at the floor", k);
+		}
+	}
+
+	/* a change of the envelope or the thermal cap restarts the wait: no taper step in the same read */
+	s = at(73, 54);
+	CHECK(s.ask == 50 && vl4_read(&s, 54, 4450, 0) == 0 && vl4_read(&s, 54, 4450, 0) == 0 && s.n_hi == 2, "start 54: 50, two reads counted");
+	CHECK(vl4_read(&s, 55, 4450, 0) == 0 && s.ask == 38 && s.nchg == 1 && s.new_ask[0] == 38 && s.why[0] == 1 && s.n_hi == 0, "envelope 38: the taper waits");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 660) == 0 && s.ask == 60 && s.nchg == 1 && s.new_ask[0] == 60 &&
+	      s.why[0] == 2 && s.n_hi == 0, "thermal 60: the taper waits");
+}
+
+static void ends(void)
+{
+	struct vl4 s = at(73, 31);
+
+	CHECK(vl4_read(&s, 31, 4480, 0) == 0, "4480 mV does not end");
+	CHECK(vl4_read(&s, 31, 4481, 0) == 1 && s.ask == 73 && s.nchg == 0, "4481 mV ends at once (battery voltage above 4480 mV)");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 31, 5000, 0) == 1, "5000 mV");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 89, 4000, 0) == 0, "89 %% does not end");
+	CHECK(vl4_read(&s, 90, 4000, 0) == 2 && s.nchg == 0, "90 %% ends (complete: 90 %%)");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 100, 4000, 0) == 2, "100 %%");
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 90, 4481, 0) == 1, "both: the voltage first");
+
+	/* a read that ends does not count, change or log */
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4450, 0) == 0 && vl4_read(&s, 31, 4481, 0) == 1 && s.ask == 73, "an end read leaves the ask");
+	CHECK(strcmp(vl4_why(1), "battery voltage above 4480 mV") == 0 && strcmp(vl4_why(2), "complete: 90 %") == 0 && strcmp(vl4_why(3), "complete: taper reached 2.0 A") == 0,
+	      "end texts");
+	CHECK(strcmp(vl4_ask_why(1), "envelope") == 0 && strcmp(vl4_ask_why(2), "thermal") == 0 && strcmp(vl4_ask_why(3), "taper") == 0, "ask change texts");
+}
+
+static int sec_frame(struct vl3 *r, int prim, int sec, int now)
+{
+	struct vl_adc a;
+
+	memset(&a, 0, sizeof(a));
+	a.ibus = sec;
+	a.tdie = 400;
+	a.raw[0] = now & 0xff;
+	a.raw[1] = (now >> 8) & 0xff;
+	r->adc.ibus = prim;
+	return vl3b_adc(r, &a, now);
+}
+
+/* the wait after an ask change and the total-current limit that follows the ask in force */
+static void settle(void)
+{
+	struct vl4 s = at(73, 31);
+	struct vl3 r;
+	int k;
+
+	CHECK(s.lim == 73 && s.since == 255, "start: the limit is the start ask, nothing to wait for");
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 50 && s.lim == 73 && s.since == 0, "40 %%: ask 50, the limit keeps 73");
+	for (k = 1; k < 30; k++)
+		CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.lim == 73 && s.since == k, "read %d after the change: limit 73", k);
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.lim == 50 && s.since == 30, "read 30: limit 50");
+	/* a second change inside the wait: the limit keeps the older ask, then goes straight to the newest */
+	s = at(73, 31);
+	CHECK(vl4_read(&s, 40, 4000, 0) == 0 && s.ask == 50 && s.lim == 73, "to 50");
+	for (k = 1; k < 10; k++)
+		vl4_read(&s, 40, 4000, 0);
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.ask == 38 && s.lim == 73 && s.since == 0, "38 inside the wait: limit still 73");
+	for (k = 1; k < 30; k++)
+		CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.lim == 73, "second wait read %d: 73", k);
+	CHECK(vl4_read(&s, 55, 4000, 0) == 0 && s.lim == 38, "then 38");
+	s = at(73, 31);
+	for (k = 0; k < 600; k++)
+		vl4_read(&s, 31, 4000, 0);
+	CHECK(s.since == 255 && s.lim == 73 && s.ask == 73, "since stays at 255");
+	s = at(73, 55);
+	CHECK(s.ask == 38 && s.lim == 38, "start 55: ask and limit 38");
+
+	vl3_init(&r, 73, 0);
+	CHECK(vl3_tot_lim(&r) == 7600, "stage 3, cap 73: 7600 mA");
+	r.lim4 = 20;
+	CHECK(vl3_tot_lim(&r) == 7600, "stage 3 ignores lim4");
+	vl4_setup(&r, 50);
+	CHECK(r.lim4 == 50 && vl3_tot_lim(&r) == 5300, "stage 4 ask 50: 5300 mA");
+	r.lim4 = 20;
+	CHECK(vl3_tot_lim(&r) == 2300, "lim 20: 2300 mA, whatever ask4 says");
+	vl3_init(&r, 45, 0);
+	vl4_setup(&r, 73);
+	CHECK(vl3_tot_lim(&r) == 4800, "the cap below the ask: 4800 mA");
+
+	/* vl3b_adc ends the session on the total above the limit of lim4 for 3 reads */
+	vl3_init(&r, 73, 0);
+	vl4_setup(&r, 73);
+	r.lim4 = 50;
+	r.s.enabled = 1;
+	r.s.checked = 1;
+	CHECK(sec_frame(&r, 2650, 2650, 1000) == 0 && sec_frame(&r, 2650, 2650, 1010) == 0 && sec_frame(&r, 2650, 2650, 1020) == 0, "lim 50: 5300 mA is at the limit");
+	CHECK(sec_frame(&r, 2651, 2650, 1030) == 0 && sec_frame(&r, 2651, 2650, 1040) == 0 && sec_frame(&r, 2651, 2650, 1050) == V3E_TOTAL, "5301 mA on 3 reads ends it");
+	vl3_init(&r, 73, 0);
+	vl4_setup(&r, 73);
+	r.s.enabled = 1;
+	r.s.checked = 1;
+	CHECK(sec_frame(&r, 2651, 2650, 1000) == 0 && sec_frame(&r, 2651, 2650, 1010) == 0 && sec_frame(&r, 2651, 2650, 1020) == 0, "lim 73: 5301 mA is fine");
+}
+
+/* ---- the replay of stock's capture 2 battery trace ---- */
+
+static void replay(void)
+{
+	struct vl4 s;
+	int i, floor_i = -1, end = 0, end_i = -1, first_hi = -1, taper_steps = 0, first_taper = -1, run_min = 73, n_env = 0, bad_env = 0, last = 73;
+	int first40 = -1, first55 = -1, soc_first_hi = 0;
+
+	CHECK(CAPTURE_BATT4_N == 2689, "trace length %d", CAPTURE_BATT4_N);
+	CHECK(capture_batt4[0].soc == 31 && capture_batt4[0].mv == 3710, "trace start");
+	vl4_init(&s, 73, capture_batt4[0].soc);
+	CHECK(s.ask == 73, "start ask 73 at 31 %%");
+	printf("replay (stock's battery blocks, one read each; the module reads once a second, stock's blocks are ~2.1 s apart):\n");
+	printf("  start SoC %d %% %d mV, ask 73\n", capture_batt4[0].soc, capture_batt4[0].mv);
+	for (i = 0; i < CAPTURE_BATT4_N; i++) {
+		int soc = capture_batt4[i].soc, mv = capture_batt4[i].mv, rc, k, env;
+
+		if (mv >= 4450 && first_hi < 0) {
+			first_hi = i;
+			soc_first_hi = soc;
+		}
+		rc = vl4_read(&s, soc, mv, 0);
+		env = soc < 40 ? 73 : soc < 55 ? 50 : 38;
+		if (env < run_min)
+			run_min = env;
+		if (soc >= 40 && first40 < 0)
+			first40 = i;
+		if (soc >= 55 && first55 < 0)
+			first55 = i;
+		for (k = 0; k < s.nchg; k++) {
+			printf("  read %4d: SoC %3d %% %d mV: ask %d -> %d (%s)\n", i, soc, mv, last, s.new_ask[k], vl4_ask_why(s.why[k]));
+			if (s.why[k] == 3) {
+				taper_steps++;
+				if (first_taper < 0)
+					first_taper = i;
+			} else {
+				n_env++;
+			}
+			last = s.new_ask[k];
+		}
+		if (first_taper < 0 || i < first_taper) {		/* before the first taper step the ask is the envelope's running minimum */
+			if (s.ask != run_min)
+				bad_env++;
+		}
+		if (rc) {
+			end = rc;
+			end_i = i;
+			break;
+		}
+		if (s.ask == 20 && floor_i < 0)
+			floor_i = i;
+	}
+	CHECK(bad_env == 0, "ask differs from the envelope before the first taper step: %d reads", bad_env);
+	CHECK(first40 == 360 && first55 == 723, "SoC 40 / 55 first seen at reads %d / %d", first40, first55);
+	CHECK(n_env == 2, "envelope changes: %d", n_env);
+	CHECK(first_hi == 1559 && soc_first_hi == 82, "first VBAT >= 4450: read %d at %d %%", first_hi, soc_first_hi);
+	CHECK(first_taper > first_hi, "no taper step before the first VBAT >= 4450 (first step at read %d, first >= 4450 at %d)", first_taper, first_hi);
+	CHECK(first_taper == first_hi + 2 || first_taper > first_hi + 2, "the third consecutive read at the earliest");
+	printf("  first VBAT >= 4450 at read %d (%d %%), first taper step at read %d, %d taper steps\n", first_hi, soc_first_hi, first_taper, taper_steps);
+	printf("  end: code %d at read %d (SoC %d %%, %d mV)%s\n", end, end_i, end_i >= 0 ? capture_batt4[end_i].soc : -1, end_i >= 0 ? capture_batt4[end_i].mv : -1,
+	       end == 1 ? " battery voltage above 4480 mV" : end == 2 ? " complete: 90 %" : end == 3 ? " complete: taper reached 2.0 A" : "");
+	/* what the rules give on this trace, literal: asks 73 until 40 %, 50 until 55 %, 38 after; VBAT stays at or above 4450 from read 1559, so
+	 * the taper steps 38 -> 30 at read 1561 and, after the 30-read wait and 3 counted reads, 30 -> 25 at 1593; stock kept its own 7.5 A, so
+	 * the trace's voltage does not answer the lower ask and reaches 4481 mV at read 1625 (85 %): the 4480 mV end. On the tablet a lower ask
+	 * lowers the voltage; the replay only shows the order of the rules */
+	CHECK(taper_steps == 2 && first_taper == 1561 && floor_i == -1 && end == 1 && end_i == 1625 && capture_batt4[1593].mv >= 4450,
+	      "the rules' result on the trace: taper steps %d (first at %d), ask 20 at %d, end %d at read %d", taper_steps, first_taper, floor_i, end, end_i);
+}
+
+/* ---- stage 4 in the shared logic: reply, limits, clock, gate, parameters ---- */
+
+/* the value of a reply word: the inverse of vl3_data_word(), written out here */
+static int decode_ask(u16 tx)
+{
+	unsigned int des = ((tx >> 8) & 0xff) | ((tx & 3) << 8), src = 0, i;
+	unsigned int l, h;
+
+	for (i = 0; i < 10; i++)
+		if (des & (1u << i))
+			src |= 1u << (9 - i);
+	l = (src & 0xff) >> 3;
+	h = (src >> 8) & 3;
+	return ((l & 1) << 6) | (((l >> 1) & 1) << 5) | (((l >> 2) & 1) << 4) | (((l >> 3) & 1) << 3) | (((l >> 4) & 1) << 2) | ((h & 1) << 1) | ((h >> 1) & 1);
+}
+
+static int reply(struct vl3 *r)
+{
+	struct vl s;
+	u16 tx = 0;
+
+	vl_init(&s, 0x12, 0x34);
+	s.state = VL_DONE;
+	r->ph = V3_RUN;
+	r->adc_ok = 1;
+	if (vl3_irq(&s, r, 0x86, VF_RXDONE, &tx) != VL_TX)
+		return -1;
+	return decode_ask(tx);
+}
+
+static void replies(void)
+{
+	static const int asks[] = { 0, 1, 20, 25, 30, 38, 50, 60, 73 };
+	static const int caps[] = { 1, 20, 45, 60, 73 };
+	unsigned int i, j;
+	struct vl3 r;
+
+	CHECK(decode_ask(vl3_data_word(73)) == 73 && vl3_data_word(73) == 0x4902, "73 is stock's 0x4902");
+	for (i = 0; i < 128; i++)
+		CHECK(decode_ask(vl3_data_word(i)) == (int)i, "decode %u", i);
+	for (j = 0; j < sizeof(caps) / sizeof(caps[0]); j++)
+		for (i = 0; i < sizeof(asks) / sizeof(asks[0]); i++) {
+			int want = asks[i] < caps[j] ? asks[i] : caps[j];
+
+			vl3_init(&r, caps[j], 0);
+			r.pumps = 2;
+			vl4_setup(&r, asks[i]);
+			CHECK(reply(&r) == want, "stage 4 cap %d ask %d: reply %d", caps[j], asks[i], reply(&r));
+			vl3_init(&r, caps[j], 0);
+			r.pumps = 2;
+			r.ask4 = asks[i];
+			CHECK(reply(&r) == caps[j], "stage 3 ignores ask4: cap %d ask4 %d: reply %d", caps[j], asks[i], reply(&r));
+		}
+	vl3_init(&r, 73, 0);
+	CHECK(r.stage4 == 0 && r.ask4 == 0 && r.vbat_hi == 0 && reply(&r) == 73, "vl3_init is stage 3");
+	vl3_init(&r, 73, 0);
+	vl4_setup(&r, 50);
+	CHECK(r.stage4 == 1 && r.ask4 == 50 && r.pumps == 2 && r.vbat_hi == 4480, "vl4_setup");
+	r.ask4 = 38;
+	CHECK(reply(&r) == 38, "the reply follows ask4 live");
+	r.ask4 = 20;
+	CHECK(reply(&r) == 20, "and goes down");
+}
+
+static u16 frame(struct vl3 *r, u8 rx)
+{
+	struct vl s;
+	u16 tx = 0;
+
+	vl_init(&s, 0x12, 0x34);
+	s.state = VL_DONE;
+	r->ph = V3_RUN;
+	r->adc_ok = 1;
+	r->adc.vbus = 8800;
+	r->adc.vbat = 4300;
+	r->adc.ibus = 1500;
+	return vl3_irq(&s, r, rx, VF_RXDONE, &tx) == VL_TX ? tx : 0xffff;
+}
+
+/* a lower ask reaches the adapter: the brick asks 0x03 only after the 0x7f battery code (seen on the tablet: it never asked again, and the limit ended the session) */
+static void change_code(void)
+{
+	struct vl3 r;
+	u16 code = vl3_data_word(V3_CHG_CODE), t;
+	int i;
+
+	CHECK(code == 0x7f02, "the change code is stock's 0x1f / 0x3");
+	vl3_init(&r, 73, 0);
+	vl4_setup(&r, 38);
+	CHECK(frame(&r, 0x82) != code, "no change code before the first ask-current reply");
+	CHECK(decode_ask(frame(&r, 0x86)) == 38 && r.sent == 38, "first ask 38");
+	for (i = 0; i < 20; i++)
+		CHECK(frame(&r, 0x82) != code, "steady ask: battery codes only (%d)", i);
+	r.ask4 = 30;
+	/* stock's ap_need_change_current = 5, written out */
+	for (i = 0; i < 5; i++)
+		CHECK((t = frame(&r, 0x82)) == code && r.predata == code, "lower ask: change code %d of 5 (0x%04x)", i + 1, t);
+	CHECK(frame(&r, 0x82) != code, "at most 5 change codes per ask");
+	CHECK(decode_ask(frame(&r, 0x86)) == 30 && r.sent == 30, "the adapter asks late: 30");
+	CHECK(frame(&r, 0x82) != code, "taken: battery codes again");
+	r.ask4 = 25;
+	CHECK(frame(&r, 0x82) == code, "the next change gets codes again");
+	CHECK(decode_ask(frame(&r, 0x86)) == 25 && frame(&r, 0x82) != code, "25 taken after one code");
+	vl3_init(&r, 73, 0);
+	r.pumps = 2;
+	CHECK(decode_ask(frame(&r, 0x86)) == 73, "stage 3 ask");
+	r.ask4 = 20;
+	for (i = 0; i < 20; i++)
+		CHECK(frame(&r, 0x82) != code, "stage 3: never a change code (%d)", i);
+}
+
+static void good_blk(u8 *b)
+{
+	memset(b, 0, 17);
+	b[0x00] = 0x36;
+	b[0x01] = 0xbf;
+	b[0x02] = 0x01;
+	b[0x04] = 0x5a;
+	b[0x05] = 0x2f;
+	b[0x06] = 0x04;
+	b[0x07] = 0x80;
+	b[0x08] = 0xe0;
+	b[0x09] = 0x13;
+	b[0x0d] = 0x70;
+	b[0x10] = 0x02;
+}
+
+static int post_vbat(int stage4, int vbat)
+{
+	struct vl3 r;
+	struct vl_adc a;
+	u8 b[17];
+
+	vl3_init(&r, 73, 0);
+	if (stage4)
+		vl4_setup(&r, 73);
+	r.ph = V3_RUN;
+	r.enabled = 1;
+	r.sw_seen = 1;
+	good_blk(b);
+	memset(&a, 0, sizeof(a));
+	a.vbus = 9000;
+	a.vbat = vbat;
+	a.ibus = 3000;
+	a.tdie = 400;
+	return vl3_post(&r, b, &a, 1000);
+}
+
+static int bat_mv(int stage4, int mv)
+{
+	struct vl3_bs s = { 0 };
+
+	if (stage4)
+		vl4_bs_setup(&s);
+	return vl3_bat(&s, 100, 300, mv, 5000, 30, 60);
+}
+
+static void limits(void)
+{
+	CHECK(post_vbat(0, 4450) == 0 && post_vbat(0, 4451) == V3E_VBAT, "stage 3: the pump's VBAT limit is 4450");
+	CHECK(post_vbat(1, 4451) == 0 && post_vbat(1, 4480) == 0 && post_vbat(1, 4481) == V3E_VBAT, "stage 4: the pump's VBAT limit is 4480");
+	CHECK(bat_mv(0, 4450) == 0 && bat_mv(0, 4451) == V3B_VHIGH, "stage 3: the gauge limit is 4450");
+	CHECK(bat_mv(1, 4451) == 0 && bat_mv(1, 4481) == 0 && bat_mv(1, 6000) == 0, "stage 4: vl3_bat leaves the gauge voltage to vl4_read");
+	CHECK(bat_mv(1, 3449) == V3B_VLOW && bat_mv(1, 3450) == 0, "stage 4: the low limit stays");
+	{
+		struct vl3_bs s = { 0 };
+
+		vl4_bs_setup(&s);
+		CHECK(vl3_bat(&s, 3001, 300, 4000, 5000, 30, 60) == V3B_STALE && vl3_bat(&s, 100, 441, 4000, 5000, 30, 60) == V3B_TEMP &&
+		      vl3_bat(&s, 100, 300, 4000, 5000, 60, 60) == 0, "stage 4: the other battery limits stay");
+	}
+}
+
+static void clock4(void)
+{
+	struct vl3_clk c = { 0 };
+
+	c.t_hs = 100;
+	c.t_en = 10000;
+	c.i600 = 1;
+	c.frames = 1;
+	c.long_hold = 1;
+	c.stage4 = 1;
+	c.hold_ms = 4500000;
+	for (c.now = 10000 + 4499990; c.now <= 10000 + 4500010; c.now++) {
+		c.t_last = c.now;
+		CHECK(vl3_time(&c) == (c.now - c.t_en >= 4500000 ? V3T_HOLD : V3T_NONE), "hold 4500 s at %d", c.now);
+	}
+	c.hold_ms = 9000000;
+	c.now = 10000 + 600001;
+	c.t_last = c.now;
+	CHECK(vl3_time(&c) == V3T_NONE, "stage 4: no 600 s limit");
+	c.now = 10000 + 4500000;
+	c.t_last = c.now;
+	CHECK(vl3_time(&c) == V3T_NONE, "A1 4500 s is not reached at 4500 s");
+	c.now = 10000 + 4500001;
+	c.t_last = c.now;
+	CHECK(vl3_time(&c) == V3T_A1, "A1 4500 s at 4500.001 s");
+	c.stage4 = 0;
+	c.now = 10000 + 600001;
+	c.t_last = c.now;
+	CHECK(vl3_time(&c) == V3T_A1, "stage 3b unchanged: A1 600 s");
+	CHECK(vl4_session_ms() == 4530000 && vl3_session_ms(2) == 630000 && vl3_session_ms(1) == 330000, "session limits");
+}
+
+static void gate4(void)
+{
+	struct vl3_g g = { 40, 300, 3900, 30, 0, 80, 210, 350, 60, 73, 1 };
+	int soc, cap;
+
+	CHECK(!vl3_gate(&g), "good start: %s", vl3_gate(&g) ?: "");
+	for (soc = 0; soc <= 100; soc++) {
+		g.soc = soc;
+		CHECK((vl3_gate(&g) == 0) == (soc >= 0 && soc <= 80), "stage 4 SoC %d", soc);
+	}
+	g.soc = 40;
+	for (g.t = 200; g.t <= 360; g.t++)
+		CHECK((vl3_gate(&g) == 0) == (g.t >= 210 && g.t <= 350), "stage 4 temperature %d", g.t);
+	g.t = 300;
+	for (g.mv = 3440; g.mv <= 4460; g.mv++)
+		CHECK((vl3_gate(&g) == 0) == (g.mv >= 3450 && g.mv <= 4450), "stage 4 mV %d", g.mv);
+	g.mv = 3900;
+	for (g.conn_c = 55; g.conn_c <= 65; g.conn_c++)
+		CHECK((vl3_gate(&g) == 0) == (g.conn_c < 60), "stage 4 connector %d", g.conn_c);
+	g.conn_c = V3_NO_CONN;
+	CHECK(vl3_gate(&g), "no connector source");
+	g.conn_c = 30;
+	/* rule 1b replaces the start-SoC rules: any cap at any SoC of the window; stage 3 still refuses */
+	for (cap = 1; cap <= 73; cap++)
+		for (soc = 0; soc <= 80; soc++) {
+			g.cap = cap;
+			g.soc = soc;
+			g.stage4 = 1;
+			CHECK(vl3_gate(&g) == 0, "stage 4 cap %d SoC %d: %s", cap, soc, vl3_gate(&g) ?: "");
+			g.stage4 = 0;
+			CHECK((vl3_gate(&g) == 0) == (cap > 40 ? soc < 35 : cap > 25 ? soc < 55 : 1), "stage 3 cap %d SoC %d", cap, soc);
+		}
+}
+
+static void params(void)
+{
+	unsigned int cap, hold, conn, st, pumps;
+
+	for (cap = 0; cap < 80; cap++)
+		for (hold = 0; hold < 4600; hold += 1 + (hold > 4490 || hold < 5 ? 0 : 13))
+			for (conn = 0; conn < 100; conn += 9)
+				CHECK((vl4_params(cap, hold, conn) == 0) == (cap >= 1 && cap <= 73 && hold >= 1 && hold <= 4500 && conn >= 1 && conn <= 80), "stage 4 params %u %u %u", cap, hold, conn);
+	CHECK(vl4_params(73, 4500, 80) == 0 && vl4_params(74, 4500, 80) && vl4_params(73, 4501, 80) && vl4_params(73, 4500, 81) && vl4_params(0, 1, 1) && vl4_params(1, 0, 1) &&
+	      vl4_params(1, 1, 0), "param edges");
+	/* the stage 3 / 3b limits and the refusal of stage 4 by vl3_params2 are unchanged */
+	for (st = 0; st < 6; st++)
+		for (pumps = 0; pumps < 4; pumps++)
+			for (cap = 0; cap < 80; cap += 3)
+				for (hold = 0; hold < 700; hold += 11) {
+					int ok = (st == 2 && pumps == 1) ||
+						 (st == 3 && pumps == 1 && cap >= 1 && cap <= 13 && hold >= 1 && hold <= 300) ||
+						 (st == 3 && pumps == 2 && cap >= 1 && cap <= 73 && hold >= 1 && hold <= 600);
+
+					CHECK((vl3_params2(st, pumps, cap, hold, 60) == 0) == ok, "stage 3 params %u %u %u %u", st, pumps, cap, hold);
+				}
+	CHECK(vl4_auto_params(4, 1) == 0 && vl4_auto_params(3, 1) && vl4_auto_params(2, 1) && vl4_auto_params(5, 1) && !vl4_auto_params(4, 0) && !vl4_auto_params(3, 0) &&
+	      !vl4_auto_params(2, 0), "auto needs stage 4");
+}
+
+static void defaults(void)
+{
+	CHECK(vl4_default(4, 0) == 73 && vl4_default(4, 1) == 4500 && vl4_default(4, 2) == 0 && vl4_default(4, 3) == 80 && vl4_default(4, 4) == 210 && vl4_default(4, 5) == 350,
+	      "stage 4 defaults");
+	CHECK(vl4_default(3, 0) == 13 && vl4_default(3, 1) == 120 && vl4_default(3, 2) == 30 && vl4_default(3, 3) == 60 && vl4_default(3, 4) == 200 && vl4_default(3, 5) == 350,
+	      "stage 3 defaults are the old ones");
+	CHECK(vl4_default(2, 0) == 13 && vl4_default(2, 1) == 120 && vl4_default(2, 2) == 30 && vl4_default(2, 3) == 60 && vl4_default(2, 4) == 200 && vl4_default(2, 5) == 350,
+	      "stage 2 defaults are the old ones");
+	CHECK(vl4_params(vl4_default(4, 0), vl4_default(4, 1), 60) == 0 && vl3_params2(3, 1, vl4_default(3, 0), vl4_default(3, 1), 60) == 0, "the defaults are accepted");
+}
+
+static void rearm(void)
+{
+	CHECK(vl4_rearm(0, 29999) == 0 && vl4_rearm(0, 30000) == 1 && vl4_rearm(0, 30001) == 1 && vl4_rearm(0, 0) == 0 && vl4_rearm(0, 0x7fffffff) == 1, "offline needs 30 s after the end");
+	CHECK(vl4_next(0, 0) == 1 && vl4_next(1, 0) == 2 && vl4_next(0, 1) == 2 && vl4_next(1, 1) == 2, "refused before any write: recheck; anything written: wait for the unplug");
+	CHECK(vl4_recheck_due(0) == 0 && vl4_recheck_due(59999) == 0 && vl4_recheck_due(60000) == 1 && vl4_recheck_due(60001) == 1 && vl4_recheck_due(0x7fffffff) == 1, "recheck every 60 s");
+	CHECK(vl4_new_refusal("", "gate: SoC outside the start window") == 1 && vl4_new_refusal("", "") == 1, "the first refusal of a plug-in is logged");
+	CHECK(vl4_new_refusal("gate: SoC outside the start window", "gate: SoC outside the start window") == 0, "the same reason is not logged again");
+	CHECK(vl4_new_refusal("gate: battery 3400 mV below 3450", "gate: battery 3412 mV below 3450") == 0 && vl4_new_refusal("gate: battery 3400 mV below 3450", "gate: battery 3449 mV below 3450") == 0,
+	      "a moving value is not a new reason");
+	CHECK(vl4_new_refusal("gate: battery 20.5 C outside 210..350 (0.1 C)", "gate: battery 21.0 C outside 210..350 (0.1 C)") == 0 && vl4_new_refusal("gate: battery -1.5 C outside 210..350 (0.1 C)", "gate: battery 21.0 C outside 210..350 (0.1 C)") == 0,
+	      "temperatures");
+	CHECK(vl4_new_refusal("gate: battery 3400 mV below 3450", "gate: SoC outside the start window") == 1 && vl4_new_refusal("gate: SoC outside the start window", "gate: battery 3400 mV below 3450") == 1 &&
+	      vl4_new_refusal("gate: usb not online", "gate: usb not onlin") == 1 && vl4_new_refusal("gate: usb not onlin", "gate: usb not online") == 1 &&
+	      vl4_new_refusal("gate: battery 3400 mV below 3450", "gate: battery 3400 mV above 3450") == 1, "a different reason is logged");
+	CHECK(vl4_rearm(1, 29999) == 0 && vl4_rearm(1, 30000) == 0 && vl4_rearm(1, 0x7fffffff) == 0 && vl4_rearm(2, 0x7fffffff) == 0, "still plugged: no second attempt");
+}
+
+int main(void)
+{
+	start_env();
+	init();
+	envelope();
+	thermal();
+	taper();
+	settle();
+	ends();
+	replay();
+	replies();
+	change_code();
+	limits();
+	clock4();
+	gate4();
+	params();
+	defaults();
+	rearm();
+	if (fails) {
+		printf("FAIL: %d of %d checks failed\n", fails, checks);
+		return 1;
+	}
+	printf("PASS: %d checks, 0 failed\n", checks);
+	return 0;
+}
diff --git a/drivers/power/supply/iceland-supervooc/vooc_logic.h b/drivers/power/supply/iceland-supervooc/vooc_logic.h
new file mode 100644
index 0000000000000..67a50527d39b7
--- /dev/null
+++ b/drivers/power/supply/iceland-supervooc/vooc_logic.h
@@ -0,0 +1,1721 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * SUPERVOOC frame logic, pump write whitelists and limits of iceland_supervooc.c. No kernel includes besides types: the host tests
+ * (test_logic.c, test_stage3.c, test_stage3b.c, test_stage4.c) compile this file as it is.
+ *
+ * The frame logic mirrors OnePlus's GPL charger v2 for SVOOC adapters. What the comments refer to:
+ *   V.c       vendor/oplus/kernel/charger/v2/voocphy/oplus_ap_voocphy.c
+ *   D.c       vendor/oplus/kernel/charger/v2/ufcs_ic/oplus_hal_sc8547d.c
+ *             both in OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8850, line numbers as of 07ca84e
+ *   live.dts  the device tree of the stock firmware (11.A.38), decompiled
+ *   stock     that firmware, as seen in an i2c and kernel-log trace of a full 80 W session on a Pad 4
+ *
+ * Round 1 (vl_irq) follows V.c's handlers 2032-2473, dispatcher 3670-3751, tx encoding 3753-3774 and counters 3921-3938. Its
+ * 0x04 reply never carries the allow bit: there is no code path that sets it. Round 2 (vl3_irq) starts with the allow reply
+ * to the second 0x04.
+ */
+#ifndef VOOC_LOGIC_H
+#define VOOC_LOGIC_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+#endif
+
+#define VF_RXDONE	0x02
+#define VF_ABORT	0xd8	/* 0x80 pulse filtered, 0x40 ninth clock, 0x10 transfer error, 0x08 TX write fail */
+#define VL_FIRST	0xa8
+#define VL_MAX_IGNORE	6
+
+enum { VL_WAIT, VL_LIVE, VL_DONE, VL_STOP };
+
+enum {
+	VL_NONE = 0,		/* nothing to send */
+	VL_TX = 1,		/* write *tx */
+	VL_LAST = 2,		/* write *tx; the dialogue is complete (state VL_DONE) */
+	VL_E_FLAG = -1,
+	VL_E_START = -2,
+	VL_E_HEAD = -3,
+	VL_E_CMD = -4,
+	VL_E_ECHO = -5,
+	VL_E_ID = -6,
+	VL_E_PROT = -7,		/* stage 3: protection read-back mismatch, enable refused */
+	VL_E_VBUS = -8,		/* stage 3: VBUS window unusable (no ADC, or VBUS / VBAT below 2000 mV three times) */
+};
+
+enum { VC_ASK = 4, VC_IDENT = 0x0c, VC_MODEL = 0x05, VC_BATT = 0x0d };	/* adapter commands */
+enum { VP_IDENT = 0xf1, VP_MODEL = 0xf2, VP_BATT = 0xf3 };		/* pending follow-ups */
+
+struct vl {
+	u8 rl, rh;		/* the tablet's identification code, 7 bits each, drawn by the caller */
+	u8 state;
+	u8 ignored;		/* RXDATA_DONE frames before the first frame */
+	u8 pend;		/* pending follow-up (stock fastchg_adapter_ask_cmd), 0 = none */
+	u8 now;			/* command answered by the last call (for the tests) */
+	u8 seen;		/* commands already served, bit per VC_* index below */
+	u8 n_id, n_model, n_batt;	/* adapter_check_cmmu_count, adapter_model_count, ask_batt_sys */
+	u8 nx_l, nx_h;		/* identification bits for the next reply */
+	u8 model;
+	u16 far, local;
+};
+
+/* svooc_batt_sys_curve, live.dts:26345, index = row; the row sent last is row 0 */
+static const u8 vl_batt_row[6] = { 0x49, 0x40, 0x2c, 0x3f, 0x68, 0x3f };
+static const u8 vl_batt_echo[6] = { 1, 1, 2, 2, 3, 3 };		/* real_bat_sys_msg, V.c:159 */
+
+/*
+ * the pump is idle while CHG_EN (07.7) and the switching status (06.2) are clear. the low bits of 0x07 are not part of
+ * it: they read 0x07 after the soft reset, on stock too (its block read at 0x06 after the init: 22 07 e0 10)
+ */
+static inline int vl_pump_idle(u8 r06, u8 r07)
+{
+	return !(r07 & 0x80) && !(r06 & 0x04);
+}
+
+static inline int vl_id_ok(u8 id)
+{
+	return (id >= 0x4b && id <= 0x4e) || id == 0x65;
+}
+
+static inline void vl_init(struct vl *s, u8 rl, u8 rh)
+{
+	u8 *p = (u8 *)s;
+	unsigned int i;
+
+	for (i = 0; i < sizeof(*s); i++)
+		p[i] = 0;
+	s->rl = rl & 0x7f;
+	s->rh = rh & 0x7f;
+	s->state = VL_WAIT;
+	s->local = (s->rh << 9) | (s->rl << 1);
+}
+
+/* tx0 bits 2:0 = head (0x01), 7:3 = data; tx1 bits 1:0 = data; then the 10 bits are mirrored (V.c:3753-3774) */
+static inline u16 vl_word(u8 tx0, u8 tx1)
+{
+	unsigned int src = ((tx1 & 3) << 8) | tx0, des = 0, i;
+
+	for (i = 0; i < 10; i++)
+		if (src & (1u << i))
+			des |= 1u << (9 - i);
+	return ((des & 0xff) << 8) | ((des >> 8) & 3);
+}
+
+static inline const char *vl_why(int r)
+{
+	switch (r) {
+	case VL_E_FLAG:	return "PHY flag 0x80/0x40/0x10/0x08";
+	case VL_E_START:return "6 frames without a 0xa8 first frame";
+	case VL_E_HEAD:	return "frame head is not SVOOC";
+	case VL_E_CMD:	return "adapter command out of order";
+	case VL_E_ECHO:	return "adapter echo does not match";
+	case VL_E_ID:	return "adapter id not in {4b 4c 4d 4e 65}";
+	case VL_E_PROT:	return "protection register differs from the expected image: enable refused";
+	case VL_E_VBUS:	return "VBUS window unusable";
+	}
+	return "?";
+}
+
+static inline void vl_ident_code(struct vl *s, u8 *l, u8 *h)
+{
+	u8 rl = s->rl, rh = s->rh;
+
+	*l = ((rl >> 6) & 1) | (((rl >> 4) & 1) << 1) | (((rh >> 6) & 1) << 2) | ((rl & 1) << 3) | ((rh & 1) << 4);
+	*h = ((rh >> 4) & 1) | (((rl >> 2) & 1) << 1);
+	s->nx_l = ((rl >> 3) & 1) | (((rh >> 5) & 1) << 1) | (((rl >> 5) & 1) << 2) | (((rh >> 1) & 1) << 3) |
+		  (((rh >> 2) & 1) << 4);
+	s->nx_h = ((rl >> 1) & 1) | (((rh >> 3) & 1) << 1);
+}
+
+/*
+ * One PHY interrupt: rx byte and flags are the two bytes of the word read at 0x2e.
+ * Returns VL_NONE / VL_TX / VL_LAST, or a negative VL_E_* that ends the session.
+ */
+static inline int vl_irq(struct vl *s, u8 rx, u8 flags, u16 *tx)
+{
+	u8 mesg = (rx & 0x1e) >> 1, tx0 = 1, tx1 = 0, cmd;
+
+	s->now = 0;
+	if (flags & VF_ABORT)
+		return VL_E_FLAG;
+	if (!(flags & VF_RXDONE) || s->state >= VL_DONE)
+		return VL_NONE;
+
+	if (s->state == VL_WAIT) {
+		if (rx != VL_FIRST)
+			return ++s->ignored >= VL_MAX_IGNORE ? VL_E_START : VL_NONE;
+		s->state = VL_LIVE;
+	} else if ((rx & 0xe0) != 0x80) {
+		return VL_E_HEAD;
+	}
+
+	cmd = s->pend ? s->pend : mesg;
+	s->now = cmd;
+	switch (cmd) {
+	case VC_ASK:
+		if (s->seen & 1) {		/* the second 0x04 is never answered */
+			s->state = VL_STOP;
+			return VL_NONE;
+		}
+		s->seen |= 1;
+		tx0 |= 0x06 << 3;		/* R bits 0x06, allow bit clear */
+		break;
+	case VC_IDENT:
+		if (!(s->seen & 1) || (s->seen & 2))
+			return VL_E_CMD;
+		s->seen |= 2;
+		s->pend = VP_IDENT;
+		s->n_id = 6;
+		vl_ident_code(s, &tx0, &tx1);
+		tx0 = (tx0 << 3) | 1;
+		break;
+	case VP_IDENT:
+		switch (s->n_id) {
+		case 5:
+			tx0 |= s->nx_l << 3;
+			tx1 = s->nx_h;
+			break;
+		case 4:
+			s->far = (u16)mesg << 12;
+			tx0 |= 0x20;
+			break;
+		case 3:
+			s->far |= (u16)mesg << 8;
+			tx0 |= 0x20;
+			break;
+		case 2:
+			s->far |= (u16)mesg << 4;
+			tx0 |= 0x20;
+			break;
+		default:
+			s->far = (s->far | mesg) & 0xfefe;
+			if (s->far != s->local)
+				return VL_E_ECHO;
+			tx0 |= 0x20;
+			s->pend = 0;
+			s->seen |= 4;
+		}
+		break;
+	case VC_MODEL:
+		if (!(s->seen & 4) || (s->seen & 8))
+			return VL_E_CMD;
+		s->seen |= 8;
+		s->pend = VP_MODEL;
+		s->n_model = 3;
+		tx0 |= 0x10 | 0x40;
+		break;
+	case VP_MODEL:
+		tx0 |= 0x20;
+		if (s->n_model == 2) {
+			s->model = mesg << 4;
+		} else {
+			s->model = (s->model | mesg) & 0x7f;
+			if (!vl_id_ok(s->model))
+				return VL_E_ID;
+			s->pend = 0;
+			s->seen |= 16;
+		}
+		break;
+	case VC_BATT:
+		if (!(s->seen & 16) || (s->seen & 32))
+			return VL_E_CMD;
+		s->seen |= 32;
+		s->pend = VP_BATT;
+		s->n_batt = 7;
+		tx0 |= 0x0c << 3;
+		break;
+	case VP_BATT:
+		if (mesg != vl_batt_echo[6 - s->n_batt])
+			return VL_E_ECHO;
+		tx0 |= (vl_batt_row[s->n_batt - 1] & 0x1f) << 3;
+		tx1 = (vl_batt_row[s->n_batt - 1] >> 5) & 3;
+		break;
+	default:
+		return VL_E_CMD;
+	}
+
+	*tx = vl_word(tx0, tx1);
+	if (s->n_id)
+		s->n_id--;
+	else if (s->n_model)
+		s->n_model--;
+	else if (s->n_batt)
+		s->n_batt--;
+	if (cmd == VP_BATT && s->n_batt == 0) {
+		s->pend = 0;
+		s->state = VL_DONE;
+		return VL_LAST;
+	}
+	return VL_TX;
+}
+
+/*
+ * Pump write whitelist of the handshake: the init rows 1..19, the in-session rows and the exit rows.
+ * Every pump write goes through vl_write_ok(); nothing outside this table can be written.
+ * w = 1: byte write; w = 2: SMBus word write (low byte to reg, high byte to reg + 1).
+ */
+#define VW_INIT	1
+#define VW_SESS	2
+#define VW_EXIT	4
+
+/* what a row is for: the host tests print it, the module does not carry it */
+#ifdef __KERNEL__
+#define VL_DOC(s)
+#else
+#define VL_DOC(s) s
+#endif
+
+struct vl_w {
+	u8 reg, w, phase;
+	u16 mask, val;
+#ifndef __KERNEL__
+	const char *what;
+#endif
+};
+
+static const struct vl_w vl_wl[] = {
+	{ 0x07, 1, VW_INIT,		0xff,   0x40,   VL_DOC("row 1: soft reset (CHG_EN is 0)") },
+	{ 0x07, 1, VW_EXIT,		0xff,   0x00,   VL_DOC("exit: CHG_EN off") },
+	{ 0x11, 1, VW_INIT | VW_EXIT,	0xff,   0x00,   VL_DOC("row 2: ADC off") },
+	{ 0x02, 1, VW_INIT | VW_EXIT,	0xff,   0x01,   VL_DOC("row 3: VAC OVP") },
+	{ 0x04, 1, VW_INIT | VW_EXIT,	0xff,   0x5a,   VL_DOC("row 4: VBUS OVP 10500 mV") },
+	{ 0x00, 1, VW_INIT | VW_EXIT,	0xff,   0x36,   VL_DOC("row 5: VBAT OVP 4850 mV") },
+	{ 0x05, 1, VW_INIT | VW_EXIT,	0xff,   0x2f,   VL_DOC("row 6: IBUS OCP 5700 mA, UCP on") },
+	{ 0x01, 1, VW_INIT,		0xff,   0xbf,   VL_DOC("row 7: IBAT OCP") },
+	{ 0x2b, 1, VW_INIT | VW_EXIT,	0xff,   0x00,   VL_DOC("row 8: VOOC PHY off") },
+	{ 0x34, 1, VW_INIT,		0xff,   0x60,   VL_DOC("rows 9, 13: hold time") },
+	{ 0x09, 1, VW_INIT | VW_EXIT,	0xff,   0x10,   VL_DOC("row 10: 2:1, UCP-rise masked, watchdog off") },
+	{ 0x10, 1, VW_INIT | VW_EXIT,	0xff,   0x02,   VL_DOC("row 11: mask ADAPTER_INSERT") },
+	{ 0x3b, 1, VW_INIT,		0xff,   0x04,   VL_DOC("OTG_EN back on after the reset, as stock (always_otg_en)") },
+	{ 0x31, 2, VW_INIT | VW_EXIT,	0xffff, 0x0000, VL_DOC("row 12: predata 0 (0x31/0x32)") },
+	{ 0x21, 1, VW_INIT,		0xff,   0x21,   VL_DOC("row 14: DM 20k pull-down, DPDM_EN") },
+	{ 0x22, 1, VW_INIT,		0xff,   0x00,   VL_DOC("row 15: D+/D- buffers off") },
+	{ 0x33, 1, VW_INIT,		0xff,   0xd1,   VL_DOC("row 16: VOOC timing") },
+	{ 0x30, 1, VW_INIT,		0xff,   0x05,   VL_DOC("row 17: PHY interrupt mask") },
+	{ 0x11, 1, VW_INIT | VW_SESS,	0xff,   0x80,   VL_DOC("row 18 / session: ADC on, continuous / unfreeze") },
+	{ 0x2b, 1, VW_INIT,		0xff,   0x81,   VL_DOC("row 19: VOOC_EN + SEND_SEQ, the handshake") },
+	{ 0x11, 1, VW_SESS,		0xff,   0xa0,   VL_DOC("session: ADC freeze") },
+	{ 0x2c, 2, VW_SESS,		0x00ff, 0x0002, VL_DOC("session: TX word, 0x2c = 0x02, 0x2d = reply byte") },
+	{ 0x2c, 2, VW_EXIT,		0xffff, 0x0000, VL_DOC("exit: clear TX (0x2c/0x2d)") },
+	{ 0x21, 1, VW_EXIT,		0xff,   0xc0,   VL_DOC("exit: D+/D- pull-downs") },
+	{ 0x30, 1, VW_EXIT,		0xff,   0x7f,   VL_DOC("exit: mask all PHY interrupts") },
+};
+#define VL_NW (sizeof(vl_wl) / sizeof(vl_wl[0]))
+
+/* phases in which the write is allowed, 0 = refused */
+static inline int vl_write_phase(u8 reg, u8 w, u16 val)
+{
+	unsigned int i;
+	int ph = 0;
+
+	if (w == 1 && val > 0xff)
+		return 0;
+	for (i = 0; i < VL_NW; i++)
+		if (vl_wl[i].reg == reg && vl_wl[i].w == w && (val & vl_wl[i].mask) == vl_wl[i].val)
+			ph |= vl_wl[i].phase;
+	return ph;
+}
+
+static inline int vl_write_ok(u8 reg, u8 w, u16 val)
+{
+	return vl_write_phase(reg, w, val) != 0;
+}
+
+struct vl_row {
+	u8 reg, w;
+	u16 val;
+};
+
+/*
+ * stock's init in stock's order, primary only. 0x3b = 0x04 (OTG_EN): the reset clears it, stock sets it on every init
+ * (D.c:1165, always_otg_en) and before usb host mode (D.c:3781), and the tablet has never run with it clear
+ */
+static const struct vl_row vl_init_rows[] = {
+	{ 0x07, 1, 0x40 }, { 0x11, 1, 0x00 }, { 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x00, 1, 0x36 },
+	{ 0x05, 1, 0x2f }, { 0x01, 1, 0xbf }, { 0x2b, 1, 0x00 }, { 0x34, 1, 0x60 }, { 0x09, 1, 0x10 },
+	{ 0x10, 1, 0x02 }, { 0x3b, 1, 0x04 }, { 0x31, 2, 0x0000 }, { 0x34, 1, 0x60 }, { 0x21, 1, 0x21 },
+	{ 0x22, 1, 0x00 },
+	{ 0x33, 1, 0xd1 }, { 0x30, 1, 0x05 }, { 0x11, 1, 0x80 },
+};
+/* row 19, the handshake, comes after the interrupt is armed */
+static const struct vl_row vl_handshake = { 0x2b, 1, 0x81 };
+
+/* the exit rows: stock's, with its 0x10 write moved to the end */
+static const struct vl_row vl_exit_rows[] = {
+	{ 0x07, 1, 0x00 }, { 0x09, 1, 0x10 }, { 0x00, 1, 0x36 }, { 0x02, 1, 0x01 }, { 0x04, 1, 0x5a },
+	{ 0x05, 1, 0x2f }, { 0x11, 1, 0x00 }, { 0x2c, 2, 0x0000 }, { 0x30, 1, 0x7f }, { 0x21, 1, 0xc0 },
+	{ 0x2b, 1, 0x00 }, { 0x31, 2, 0x0000 }, { 0x10, 1, 0x02 },
+};
+
+/* ====================================================================================================================
+ * Round 2: the powered session (stage 3 and 4). Everything below is added to the handshake above, which is unchanged.
+ * ==================================================================================================================== */
+
+#define V3_CAP_MAX	13		/* 100 mA units: the maximum with pumps = 1 */
+#define V3_HOLD_MAX_S	300
+#define V3B_CAP_MAX	73		/* pumps = 2: stock's highest ask, 7.3 A total (live.dts svooc_charge_strategy 0x49) */
+#define V3B_HOLD_MAX_S	600
+#define V3_STOCK_ASK	73		/* stock's first ask-current reply: 7.3 A (voocphy_current_default, tx 0x4902) */
+#define V3_CHG_CODE	0x7f		/* battery-voltage reply that asks the adapter for a new 0x03 (V.c:3381-3390, ap_need_change_current) */
+#define V3_CHG_TRIES	5		/* stock sets ap_need_change_current = 5 and sends the code that many times at most */
+
+enum { VB_LOW = 1, VB_HIGH, VB_NORMAL };		/* oplus_ap_voocphy.c vooc_vbus_status: LOW 1, HIGH 2, NORMAL 3 */
+enum { V3_ASK, V3_PRE, V3_RUN };			/* second 0x04 pending / allowed, VBUS window / pump enabled */
+#define V3A_ENABLE	1			/* write 0x07 = 0x80 before the TX word, as stock */
+#define V3A_PREDATA	2			/* write the predata word r->predata after the TX word */
+#define V3A_HW		4			/* hw_setting(SVOOC) rows, after the predata */
+
+enum { VC3_BVOL = 1, VC3_VBUS = 2, VC3_CURR = 3, VC3_APST = 0x0a };	/* adapter commands after the allow reply */
+
+/* module configuration bits for the write tables: the handshake's rows are always allowed */
+#define VM_S2		1
+#define VM_S3		2
+#define VM_S3S		4			/* stock_start = 1 */
+#define VM_S3B		8			/* pumps = 2: the secondary's table */
+
+/* pump ADC block 0x13..0x20 (stock reads only 0x13..0x1c; TDIE comes from the 0x1f/0x20 pair as the reference driver reads it) */
+struct vl_adc {
+	u8 raw[14];
+	int ibus, vbus, vac, vout, vbat, tdie;		/* mA, mV, mV, mV, mV, 0.1 C; integer math as stock */
+};
+
+static inline void vl_adc_decode(struct vl_adc *a, const u8 *b)
+{
+	unsigned int i;
+
+	for (i = 0; i < 14; i++)
+		a->raw[i] = b[i];
+	a->ibus = (((b[0] & 0x0f) << 8) | b[1]) * 1875 / 1000;
+	a->vbus = (((b[2] & 0x0f) << 8) | b[3]) * 375 / 100;
+	a->vac = (((b[4] & 0x0f) << 8) | b[5]) * 5;
+	a->vout = (((b[6] & 0x0f) << 8) | b[7]) * 125 / 100;
+	a->vbat = (((b[8] & 0x0f) << 8) | b[9]) * 125 / 100;
+	a->tdie = (((b[12] & 0x01) << 8) | b[13]) * 5;
+}
+
+/* the secondary pump's state, see the block at the end of this file */
+struct vl3s {
+	struct vl_adc adc;
+	u8 adc_ok, prot_ok, hw_done, enabled, done, sw_seen, sw_now, checked, tick_init, tick_now, fresh;
+	u8 n_lost, n_same, n_tot, n_low;
+	u8 blk[17], fl_or[4];
+	int t_en, next_tick;
+	int ibus_max, tdie_max, tot_max, nrun;
+};
+
+struct vl3 {
+	/* configuration */
+	u8 cap, stock_ask, stock_start, pumps;
+	u8 stage4, ask4;			/* stage 4: the ask the monitor currently allows (100 mA units); vl4_setup() */
+	u8 lim4;				/* stage 4: the ask the total-current limit uses (vl4.lim: the adapter has had time to take it) */
+	u16 vbat_hi;				/* stage 4: the pump's VBAT limit, 0 = V3_LIM_VBAT_MV */
+	/* inputs the caller sets before vl3_irq() / vl3_post() */
+	u8 suspend_ok;			/* the buck input suspend was confirmed */
+	u8 prot_ok;			/* the last register image read matched (vl3_post sets it) */
+	struct vl_adc adc;		/* the block read after the previous frame, as stock's cp_vbus / cp_vbat / cp_vsys / cp_ichg */
+	u8 adc_ok;
+	/* state */
+	u8 ph, vbus_st, vb_err;
+	u8 enabled, restored, sw_seen, i600;
+	u8 n_ibus, n_vdiff, n_same, n_lost;
+	u8 sent, want, chg;		/* the last ask-current reply (0 = none yet), the last ask seen, change codes left for it */
+	/* outputs of the last vl3_irq() */
+	u8 act;
+	u16 predata;
+	/* statistics for the summary */
+	int vdiff_min, vdiff_max, ibus_max, tdie_max, nrun;
+	struct vl3s s;
+};
+
+static inline void vl3_init(struct vl3 *r, u8 cap, u8 stock_start)
+{
+	u8 *p = (u8 *)r;
+	unsigned int i;
+
+	for (i = 0; i < sizeof(*r); i++)
+		p[i] = 0;
+	r->cap = cap;
+	r->stock_ask = V3_STOCK_ASK;
+	r->stock_start = stock_start;
+	r->pumps = 1;
+	r->ph = V3_ASK;
+}
+
+/* oplus_vooc_vbus_vbatt_detect(), SVOOC: diff = vbus - 2 x vbat (vbat = gauge_vbatt = cp_vbat), thresholds 100 / 200 mV */
+static inline int vl_window(int vbus, int vbat)
+{
+	int d = vbus - 2 * vbat;
+
+	return d < 100 ? VB_LOW : d > 200 ? VB_HIGH : VB_NORMAL;
+}
+
+/* the 7-bit data field of an SVOOC reply (ask-current and battery voltage use the same bit order, V.c:3328-3341, :3548-3556) */
+static inline u16 vl3_data_word(u8 v)
+{
+	u8 l = ((v >> 6) & 1) | (((v >> 5) & 1) << 1) | (((v >> 4) & 1) << 2) | (((v >> 3) & 1) << 3) | (((v >> 2) & 1) << 4);
+	u8 h = ((v >> 1) & 1) | ((v & 1) << 1);
+
+	return vl_word((l << 3) | 1, h);
+}
+
+/* stock's battery-voltage reply for this tablet (non-bidirectional cp, no parallel switch): V.c:3498-3500, 3548-3552 */
+static inline int vl_batt_code2(const struct vl_adc *a, int ibus)
+{
+	int v1 = a->vbus / 2 - (a->vout - a->vbat) / 4 - ibus * 75 / 1000;
+
+	if (v1 < 3404)
+		return 0;
+	if (v1 > 4654)
+		return 125;
+	return (v1 - 3404) / 10;
+}
+
+static inline int vl_batt_code(const struct vl_adc *a)
+{
+	return vl_batt_code2(a, a->ibus);
+}
+
+/* the ask-current reply: the cap and stock's 7.3 A, in stage 4 also the monitor's current ask (fails low: 0 until it is set) */
+static inline u8 vl3_ask(const struct vl3 *r)
+{
+	u8 a = r->cap < r->stock_ask ? r->cap : r->stock_ask;
+
+	return r->stage4 && r->ask4 < a ? r->ask4 : a;
+}
+
+/* the total IBUS limit of both pumps: cap + 300 mA, in stage 4 the ask in force (lim4) + 300 mA when that is lower */
+static inline int vl3_tot_lim(const struct vl3 *r)
+{
+	u8 c = r->stage4 && r->lim4 < r->cap ? r->lim4 : r->cap;
+
+	return c * 100 + 300;
+}
+
+/*
+ * One PHY interrupt of a powered session. Round 1 is vl_irq() unchanged. After the last battery-model row (state VL_DONE) the second 0x04
+ * gets the allow reply only if the caller says the input suspend is confirmed (r->suspend_ok); otherwise it is not answered
+ * (state VL_STOP, where a handshake-only session ends). Then: 0x0a, VBUS window answers (the first NORMAL asks for the enable), ask-current, battery voltage.
+ */
+static inline int vl3_irq(struct vl *s, struct vl3 *r, u8 rx, u8 flags, u16 *tx)
+{
+	u8 mesg = (rx & 0x1e) >> 1;
+	int st;
+
+	r->act = 0;
+	if (s->state < VL_DONE)
+		return vl_irq(s, rx, flags, tx);
+	s->now = 0;
+	if (flags & VF_ABORT)
+		return VL_E_FLAG;
+	if (!(flags & VF_RXDONE) || s->state != VL_DONE)
+		return VL_NONE;
+	if ((rx & 0xe0) != 0x80)
+		return VL_E_HEAD;
+	s->now = mesg;
+
+	switch (mesg) {
+	case VC_ASK:
+		if (r->ph != V3_ASK)
+			return VL_E_CMD;
+		if (!r->suspend_ok) {
+			s->state = VL_STOP;
+			return VL_NONE;
+		}
+		r->ph = V3_PRE;
+		r->predata = 0x2002;
+		r->act = V3A_PREDATA | V3A_HW;
+		*tx = vl_word(1 | (0x07 << 3), 0);
+		return VL_TX;
+	case VC3_APST:
+		if (r->ph == V3_ASK)
+			return VL_E_CMD;
+		*tx = vl_word(1, 0);
+		return VL_TX;
+	case VC3_VBUS:
+		if (r->ph == V3_ASK)
+			return VL_E_CMD;
+		if (!r->adc_ok)
+			return VL_E_VBUS;
+		st = vl_window(r->adc.vbus, r->adc.vbat);
+		if (st == VB_NORMAL && (r->adc.vbus < 2000 || r->adc.vbat < 2000)) {	/* NORMAL_VBUS_MIN / NORMAL_VBAT_MIN, 3 times */
+			if (r->vb_err >= 3)
+				return VL_E_VBUS;
+			r->vb_err++;
+			st = VB_HIGH;
+		} else {
+			r->vb_err = 0;
+		}
+		r->vbus_st = st;
+		if (st == VB_NORMAL && r->ph == V3_PRE) {
+			if (!r->prot_ok)
+				return VL_E_PROT;
+			r->ph = V3_RUN;
+			r->enabled = 1;
+			r->act = V3A_ENABLE;
+		}
+		*tx = vl_word(1 | (st == VB_HIGH ? 0x10 : st == VB_LOW ? 0x20 : 0x30), 0);
+		return VL_TX;
+	case VC3_CURR:
+		if (r->ph != V3_RUN)
+			return VL_E_CMD;
+		r->sent = vl3_ask(r);
+		*tx = vl3_data_word(r->sent);
+		return VL_TX;
+	case VC3_BVOL:
+		if (r->ph == V3_ASK || !r->adc_ok)
+			return VL_E_CMD;
+		/* stock's cp_ichg is the sum of both pumps once the secondary is on (V.c:3409, 1801; a secondary that is off counts 0): the reply, 7 codes lower, follows it */
+		/* the adapter asks for current only when told to: a lower ask goes out as the change code, then its 0x03 (stock's V.c:3381) */
+		if (vl3_ask(r) != r->want) {
+			r->want = vl3_ask(r);
+			r->chg = V3_CHG_TRIES;
+		}
+		if (r->sent && r->want != r->sent && r->chg) {
+			r->chg--;
+			*tx = vl3_data_word(V3_CHG_CODE);
+		} else {
+			*tx = vl3_data_word(vl_batt_code2(&r->adc, r->adc.ibus + (r->pumps == 2 && r->s.enabled ? r->s.adc.ibus : 0)));
+		}
+		r->predata = *tx;
+		r->act = V3A_PREDATA;
+		return VL_TX;
+	}
+	return VL_E_CMD;
+}
+
+/* ---- write tables of the powered session: the handshake's table (vl_wl) stays valid, these are added ---- */
+
+#define VW_HW		8
+#define VW_RUN		16
+#define VW_ENAB		32
+#define VW_START	64
+#define VW_LAD		128
+
+/* the primary pump */
+static const struct vl_w vl3_wl[] = {
+	{ 0x31, 2, VW_HW | VW_RUN, 0x00ff, 0x0002, VL_DOC("predata word: 0x2002 at the allow frame, the reply word after battery-voltage replies") },
+	{ 0x02, 1, VW_HW, 0xff, 0x01, VL_DOC("hw_setting: VAC OVP") },
+	{ 0x04, 1, VW_HW, 0xff, 0x5a, VL_DOC("hw_setting: VBUS OVP 10500 mV") },
+	{ 0x05, 1, VW_HW, 0xff, 0x2f, VL_DOC("hw_setting: IBUS OCP 5700 mA, UCP on") },
+	{ 0x09, 1, VW_HW, 0xff, 0x13, VL_DOC("hw_setting: 2:1, UCP-rise masked, watchdog 1 s") },
+	{ 0x11, 1, VW_HW, 0xff, 0x80, VL_DOC("hw_setting: ADC on") },
+	{ 0x0d, 1, VW_HW, 0xff, 0x70, VL_DOC("hw_setting: PMID2OUT UVP 100 mV, OVP 500 mV") },
+	{ 0x33, 1, VW_HW, 0xff, 0xd1, VL_DOC("hw_setting: VOOC timing") },
+	{ 0x34, 1, VW_HW, 0xff, 0x60, VL_DOC("hw_setting: hold time") },
+	{ 0x07, 1, VW_ENAB, 0xff, 0x80, VL_DOC("pump enable (only vl3_enable_ok(), from the one enable function)") },
+};
+#define VL3_NW (sizeof(vl3_wl) / sizeof(vl3_wl[0]))
+
+/* stock_start = 1: stock's start pattern and its end */
+static const struct vl_w vl3s_wl[] = {
+	{ 0x05, 1, VW_START, 0xff, 0xaf, VL_DOC("start: UCP off (stock hw_setting step 9)") },
+	{ 0x08, 1, VW_START, 0xff, 0x00, VL_DOC("start: soft-start timeout off") },
+	{ 0x05, 1, VW_RUN, 0xff, 0x2f, VL_DOC("UCP back on when IBUS > 600 mA") },
+	{ 0x08, 1, VW_RUN | VW_LAD, 0xff, 0xe0, VL_DOC("soft-start timeout 81.92 s back (also in the exit ladder if the start pattern was not undone)") },
+};
+#define VL3S_NW (sizeof(vl3s_wl) / sizeof(vl3s_wl[0]))
+
+static inline int vl3_tab_phase(const struct vl_w *t, unsigned int n, u8 reg, u8 w, u16 val)
+{
+	unsigned int i;
+	int ph = 0;
+
+	if (w == 1 && val > 0xff)
+		return 0;
+	for (i = 0; i < n; i++)
+		if (t[i].reg == reg && t[i].w == w && (val & t[i].mask) == t[i].val)
+			ph |= t[i].phase;
+	return ph;
+}
+
+/* phases in which a write is allowed in the given mode (VM_*), 0 = refused; 0x07 = 0x80 is not part of it (VW_ENAB) */
+static inline int vl_write_phase_m(u8 reg, u8 w, u16 val, u8 mode)
+{
+	int ph = vl_write_phase(reg, w, val);
+
+	if (mode & VM_S3)
+		ph |= vl3_tab_phase(vl3_wl, VL3_NW, reg, w, val) & ~VW_ENAB;
+	if ((mode & (VM_S3 | VM_S3S)) == (VM_S3 | VM_S3S))
+		ph |= vl3_tab_phase(vl3s_wl, VL3S_NW, reg, w, val);
+	return ph;
+}
+
+static inline int vl_write_ok_m(u8 reg, u8 w, u16 val, u8 mode)
+{
+	return vl_write_phase_m(reg, w, val, mode) != 0;
+}
+
+/* the enable: the powered stages only, the one row, from the one enable function */
+static inline int vl3_enable_ok(u8 reg, u8 w, u16 val, u8 mode)
+{
+	return (mode & VM_S3) && reg == 0x07 && w == 1 && val == 0x80;
+}
+
+/* hw_setting(SVOOC) for the primary in stock's order, then stock's start pattern; the RMW reads are left out */
+static const struct vl_row vl3_hw_rows[] = {
+	{ 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x05, 1, 0x2f }, { 0x09, 1, 0x13 }, { 0x11, 1, 0x80 }, { 0x0d, 1, 0x70 },
+	{ 0x33, 1, 0xd1 }, { 0x34, 1, 0x60 },
+};
+static const struct vl_row vl3_start_rows[] = { { 0x05, 1, 0xaf }, { 0x08, 1, 0x00 } };
+static const struct vl_row vl3_restore_rows[] = { { 0x05, 1, 0x2f }, { 0x08, 1, 0xe0 } };
+#define VL3_NHW		(sizeof(vl3_hw_rows) / sizeof(vl3_hw_rows[0]))
+#define VL3_NSTART	2
+#define VL3_NEXIT	(sizeof(vl_exit_rows) / sizeof(vl_exit_rows[0]))
+
+/* total IBUS above 600 mA with the window NORMAL: stock turns UCP and the soft-start timeout back on (V.c:1805-1808) */
+static inline int vl3_restore_due(const struct vl3 *r)
+{
+	return r->stock_start && r->enabled && !r->restored && r->vbus_st == VB_NORMAL && r->adc_ok && r->adc.ibus > 600;
+}
+
+/* ---- the register image read back before the enable and in every frame ---- */
+
+/*
+ * blk[reg] = the registers 0x00..0x10 read in one block (stock reads 0x06..0x0f every frame). 0 = as expected, else the register + 1.
+ * Values: read back on this tablet after the init rows (0x00 0x36, 0x01 0xbf, 0x02 0x01, 0x04 0x5a, 0x05 0x2f, 0x08 0xe0,
+ * 0x10 0x02); 0x09 0x13 and 0x0d 0x70 after hw_setting, 0x05 0xaf and 0x08 0x00 inside stock's start pattern.
+ * Flag bits that stock's own blocks show set (0x09.5 UCP-rise at the start of the current, 0x02.4) are masked here and judged in vl3_post().
+ */
+static inline int vl3_image(const u8 *blk, int stock_start, int restored)
+{
+	int ucp_off = stock_start && !restored;
+
+	if (blk[0x00] != 0x36)
+		return 0x00 + 1;
+	if (blk[0x01] != 0xbf)
+		return 0x01 + 1;
+	if ((blk[0x02] & 0xef) != 0x01)
+		return 0x02 + 1;
+	if (blk[0x04] != 0x5a)
+		return 0x04 + 1;
+	if (blk[0x05] != (ucp_off ? 0xaf : 0x2f))
+		return 0x05 + 1;
+	if (blk[0x08] != (ucp_off ? 0x00 : 0xe0))
+		return 0x08 + 1;
+	if ((blk[0x09] & 0x97) != 0x13)
+		return 0x09 + 1;
+	if ((blk[0x0d] & 0xf0) != 0x70)
+		return 0x0d + 1;
+	if (blk[0x10] != 0x02)
+		return 0x10 + 1;
+	return 0;
+}
+
+enum {
+	V3E_NONE, V3E_FLAGS, V3E_IMAGE, V3E_IDLE, V3E_CHGEN, V3E_VERR, V3E_LOST, V3E_VBUS, V3E_IBUS_MAX, V3E_IBUS_CAP,
+	V3E_VDIFF, V3E_TDIE, V3E_VBAT, V3E_STALE,
+	V3E_SFLAGS, V3E_SIMAGE, V3E_SIDLE, V3E_SCHGEN, V3E_SVERR, V3E_SLOST, V3E_SIBUS_MAX, V3E_SCURR, V3E_STDIE, V3E_SSTALE,
+	V3E_TOTAL, V3E_STROUBLE, V3E_SLOW,
+};
+#define V3_ENABLE_GRACE_MS	100	/* stock: 0x07 reads 0x00 half a millisecond after the enable and 0x80 45 ms later */
+#define V3_LIM_VBUS_MV		10000	/* after the allow bit; stock's pump OVP is 10500 */
+#define V3_LIM_VBUS_PRE_MV	6000	/* until then */
+#define V3_LIM_VDIFF_MV		500
+/*
+ * stock's VBUS - 2 x VBAT grows with the pump's current (in its trace, by primary IBUS: max 492 mV at 1.5..2 A, 747 at
+ * 2.5..3 A, 970 at 3.5..4 A): 500 mV up to 1 A, then 0.30 mV per mA. The closest stock came to the limit is 251 mV under it
+ */
+static inline int vl3_vdiff_max(int ibus)
+{
+	return V3_LIM_VDIFF_MV + (ibus > 1000 ? (ibus - 1000) * 3 / 10 : 0);
+}
+#define V3_LIM_TDIE_DC		700
+#define V3_LIM_VBAT_MV		4450
+#define V3_LIM_IBUS_MAX_MA	5300	/* stock's voocphy_cp_max_ibus, per pump */
+#define V3_STALE_N		6	/* stock's longest run of identical ADC blocks is 2 (91483 blocks) */
+
+static inline const char *vl3_why(int c)
+{
+	switch (c) {
+	case V3E_FLAGS:		return "pump fault flag (0x06 0xc9 / 0x09.3 / 0x0d 0x0c / 0x0e 0xf8 / 0x0f 0xfc)";
+	case V3E_IMAGE:		return "protection register differs from the expected image";
+	case V3E_IDLE:		return "pump not idle before the enable";
+	case V3E_CHGEN:		return "CHG_EN (0x07.7) clear while enabled";
+	case V3E_VERR:		return "VBUS error status (0x06 0x30) while enabled";
+	case V3E_LOST:		return "pump stopped switching (0x06.2 clear on 3 reads)";
+	case V3E_VBUS:		return "VBUS ADC above its limit";
+	case V3E_IBUS_MAX:	return "IBUS above 5300 mA";
+	case V3E_IBUS_CAP:	return "IBUS above cap + 300 mA on 3 reads";
+	case V3E_VDIFF:		return "VBUS - 2 x VBAT above 500 mV + 0.30 mV per mA of IBUS over 1 A, on 3 reads";
+	case V3E_TDIE:		return "pump die temperature above 70.0 C";
+	case V3E_VBAT:		return "pump VBAT above 4450 mV";
+	case V3E_STALE:		return "ADC block identical on 6 reads";
+	case V3E_SFLAGS:	return "secondary pump fault flag (0x06 0xc9 / 0x09.3 / 0x0d 0x0c / 0x0e 0xf8 / 0x0f 0xfc)";
+	case V3E_SIMAGE:	return "secondary protection register differs from the expected image";
+	case V3E_SIDLE:		return "secondary pump not idle before its enable";
+	case V3E_SCHGEN:	return "secondary CHG_EN (0x07.7) clear while enabled";
+	case V3E_SVERR:		return "secondary VBUS error status (0x06 0x30) while enabled";
+	case V3E_SLOST:		return "secondary pump stopped switching (0x06.2 clear on 3 reads)";
+	case V3E_SIBUS_MAX:	return "secondary IBUS above 5300 mA";
+	case V3E_SCURR:		return "secondary IBUS above 600 mA while it is not enabled";
+	case V3E_STDIE:		return "secondary die temperature above 70.0 C";
+	case V3E_SSTALE:	return "secondary ADC block identical on 6 reads";
+	case V3E_TOTAL:		return "total IBUS (both pumps) above cap + 300 mA on 3 reads";
+	case V3E_STROUBLE:	return "secondary pump in trouble after its enable (stock's slave check)";
+	case V3E_SLOW:		return "total IBUS below 1100 mA on 4 ticks with the secondary on (stock would stop only the secondary)";
+	}
+	return "?";
+}
+
+/* the fault flags of one pump's block blk[0x06..0x0f]; the same masks for both pumps */
+static inline int vl3_flags(const u8 *blk)
+{
+	return (blk[0x06] & 0xc9) || (blk[0x09] & 0x08) || (blk[0x0d] & 0x0c) || (blk[0x0e] & 0xf8) || (blk[0x0f] & 0xfc);
+}
+
+/*
+ * After every frame (IRQ thread, after the reply): the flag/protection block blk[0x00..0x10] and the ADC block a, ms_on = ms since the
+ * enable write. Returns 0 or a V3E_*; counters live in r.
+ */
+static inline int vl3_post(struct vl3 *r, const u8 *blk, const struct vl_adc *a, int ms_on)
+{
+	unsigned int i;
+	int img, same = 1, vdiff;
+
+	r->prot_ok = 0;
+	if (vl3_flags(blk))
+		return V3E_FLAGS;
+	img = vl3_image(blk, r->stock_start, r->restored);
+	r->prot_ok = img == 0;
+	if (img)
+		return V3E_IMAGE;
+	if (!r->enabled) {
+		if (!vl_pump_idle(blk[0x06], blk[0x07]))
+			return V3E_IDLE;
+	} else if (ms_on >= V3_ENABLE_GRACE_MS) {
+		if (!(blk[0x07] & 0x80))
+			return V3E_CHGEN;
+		if (blk[0x06] & 0x30)
+			return V3E_VERR;
+	}
+	if (r->enabled) {
+		if (blk[0x06] & 0x04) {
+			r->sw_seen = 1;
+			r->n_lost = 0;
+		} else if (r->sw_seen && ++r->n_lost >= 3) {
+			return V3E_LOST;
+		}
+	}
+	if (a->vbus > (r->ph == V3_ASK ? V3_LIM_VBUS_PRE_MV : V3_LIM_VBUS_MV))
+		return V3E_VBUS;
+	if (a->tdie > V3_LIM_TDIE_DC)
+		return V3E_TDIE;
+	if (a->vbat > (r->vbat_hi ? r->vbat_hi : V3_LIM_VBAT_MV))
+		return V3E_VBAT;
+	if (a->ibus > V3_LIM_IBUS_MAX_MA)
+		return V3E_IBUS_MAX;
+	if (!r->enabled)
+		return 0;
+
+	vdiff = a->vbus - 2 * a->vbat;
+	if (!r->nrun || vdiff < r->vdiff_min)
+		r->vdiff_min = vdiff;
+	if (!r->nrun || vdiff > r->vdiff_max)
+		r->vdiff_max = vdiff;
+	if (a->ibus > r->ibus_max)
+		r->ibus_max = a->ibus;
+	if (a->tdie > r->tdie_max)
+		r->tdie_max = a->tdie;
+	r->nrun++;
+	if (a->ibus > 600)
+		r->i600 = 1;
+
+	if (a->ibus > r->cap * 100 + 300) {
+		if (++r->n_ibus >= 3)
+			return V3E_IBUS_CAP;
+	} else {
+		r->n_ibus = 0;
+	}
+	if (vdiff > vl3_vdiff_max(a->ibus)) {
+		if (++r->n_vdiff >= 3)
+			return V3E_VDIFF;
+	} else {
+		r->n_vdiff = 0;
+	}
+	for (i = 0; i < 14; i++)
+		if (a->raw[i] != r->adc.raw[i])
+			same = 0;
+	if (r->adc_ok && same) {
+		if (++r->n_same >= V3_STALE_N - 1)
+			return V3E_STALE;
+	} else {
+		r->n_same = 0;
+	}
+	return 0;
+}
+
+/* ---- the clock checks of the session thread (10 ms tick); times in ms, c->t_en < 0 = pump not enabled ---- */
+
+struct vl3_clk {
+	int now, t0, t_hs, t_last, t_en;
+	int frames, i600, hold_ms;
+	u8 long_hold;				/* pumps = 2: the pump-on limit is 600 s, not 300 s */
+	u8 stage4;				/* stage 4: 4500 s */
+};
+enum { V3T_NONE, V3T_FIRST, V3T_NOFRAME, V3T_PRE, V3T_START, V3T_HOLD, V3T_A1 };
+#define V3_LIM_FIRST_MS		2000	/* handshake to the first frame */
+#define V3_LIM_NOFRAME_MS	200	/* between two frames */
+#define V3_LIM_PRE_MS		5000	/* start of the session to the enable; stock needs 1.53 s */
+#define V3_LIM_START_MS		1000	/* enable to IBUS > 600 mA; stock needs 183 ms */
+#define V3_LIM_A1_MS		300000	/* pump on for at most 5 minutes; hold_s <= 300 ends first */
+#define V3B_LIM_A1_MS		600000	/* pumps = 2: hold_s <= 600 ends first */
+#define V4_LIM_A1_MS		4500000	/* stage 4: hold_s <= 4500 ends first */
+
+static inline int vl3_time(const struct vl3_clk *c)
+{
+	if (!c->frames && c->now - c->t_hs > V3_LIM_FIRST_MS)
+		return V3T_FIRST;
+	if (c->frames && c->now - c->t_last > V3_LIM_NOFRAME_MS)
+		return V3T_NOFRAME;
+	if (c->t_en < 0 && c->now - c->t0 > V3_LIM_PRE_MS)
+		return V3T_PRE;
+	if (c->t_en >= 0 && !c->i600 && c->now - c->t_en > V3_LIM_START_MS)
+		return V3T_START;
+	if (c->t_en >= 0 && c->now - c->t_en >= c->hold_ms)
+		return V3T_HOLD;
+	if (c->t_en >= 0 && c->now - c->t_en > (c->stage4 ? V4_LIM_A1_MS : (c->long_hold ? V3B_LIM_A1_MS : V3_LIM_A1_MS)))
+		return V3T_A1;
+	return V3T_NONE;
+}
+
+static inline const char *vl3_time_why(int c)
+{
+	switch (c) {
+	case V3T_FIRST:		return "no first frame within 2 s of the handshake";
+	case V3T_NOFRAME:	return "no frame for 200 ms";
+	case V3T_PRE:		return "pump not enabled within 5 s of the start";
+	case V3T_START:		return "IBUS not above 600 mA within 1.0 s of the enable";
+	case V3T_HOLD:		return "complete: hold time elapsed";
+	case V3T_A1:		return "pump on for more than 5 minutes";
+	}
+	return "?";
+}
+
+/* ---- the 1 s battery monitor (qcom-battmgr readings, taken in process context) ---- */
+
+struct vl3_bs {
+	u8 n_hi, n_lo, n_conn, n_none;
+	int vhigh_mv;				/* 0 = V3_LIM_VBAT_MV; stage 4: vl4_read() judges the gauge voltage instead */
+};
+enum { V3B_NONE, V3B_STALE, V3B_L2, V3B_L3, V3B_TEMP, V3B_VLOW, V3B_VHIGH, V3B_CONN, V3B_GUARD };
+#define V3_LIM_BAT_AGE_MS	3000
+#define V3_LIM_IBAT_HI_MA	16000
+#define V3_LIM_IBAT_LO_MA	(-3000)
+#define V3_LIM_IBAT_TICKS	7	/* "more than 7 ticks" */
+#define V3_LIM_BAT_T_MAX	440	/* 0.1 C: tighter than stock's 51.0 */
+#define V3_LIM_BAT_T_MIN	0
+#define V3_LIM_VLOW_MV		3450
+#define V3_CONN_STOCK_C		80	/* stock's BTB limit; conn_max_c may only be lower */
+#define V3_OUT_SUSPEND_MA	2000	/* stock: output suspend when the battery takes more than 2 A */
+
+/*
+ * ma = battery current into the battery (qcom-battmgr: positive = charging), t = 0.1 C, conn_c = highest connector temperature in whole
+ * C (V3_NO_CONN = no source readable), age_ms = age of the newest reading.
+ */
+#define V3_NO_CONN	(-1000)
+static inline int vl3_bat(struct vl3_bs *s, int age_ms, int t, int mv, int ma, int conn_c, int conn_max_c)
+{
+	if (age_ms > V3_LIM_BAT_AGE_MS)
+		return V3B_STALE;
+	if (ma > V3_LIM_IBAT_HI_MA) {
+		if (++s->n_hi > V3_LIM_IBAT_TICKS)
+			return V3B_L2;
+	} else {
+		s->n_hi = 0;
+	}
+	if (ma < V3_LIM_IBAT_LO_MA) {
+		if (++s->n_lo > V3_LIM_IBAT_TICKS)
+			return V3B_L3;
+	} else {
+		s->n_lo = 0;
+	}
+	if (t > V3_LIM_BAT_T_MAX || t < V3_LIM_BAT_T_MIN)
+		return V3B_TEMP;
+	if (mv < V3_LIM_VLOW_MV)
+		return V3B_VLOW;
+	if (mv > (s->vhigh_mv ? s->vhigh_mv : V3_LIM_VBAT_MV))
+		return V3B_VHIGH;
+	if (conn_c == V3_NO_CONN) {		/* every source unreadable for 3 ticks: the limit cannot be judged */
+		if (++s->n_none >= 3)
+			return V3B_CONN;
+		return 0;
+	}
+	s->n_none = 0;
+	if (conn_c >= conn_max_c) {
+		if (++s->n_conn >= 3)
+			return V3B_CONN;
+	} else {
+		s->n_conn = 0;
+	}
+	return 0;
+}
+
+static inline const char *vl3_bat_why(int c)
+{
+	switch (c) {
+	case V3B_STALE:	return "battery readings older than 3 s";
+	case V3B_L2:	return "battery current above 16 A for more than 7 ticks";
+	case V3B_L3:	return "battery current below -3 A for more than 7 ticks";
+	case V3B_TEMP:	return "battery temperature outside 0.0 .. 44.0 C";
+	case V3B_VLOW:	return "battery below 3450 mV";
+	case V3B_VHIGH:	return "battery above 4450 mV";
+	case V3B_CONN:	return "connector temperature at the limit on 3 reads, or no connector reading for 3 s";
+	case V3B_GUARD:	return "charging inhibited by the host (charge_behaviour is not auto, or not readable)";
+	}
+	return "?";
+}
+
+static inline int vl3_out_due(int ma, int enabled, int done)
+{
+	return enabled && !done && ma > V3_OUT_SUSPEND_MA;
+}
+
+/* the host's own charge_behaviour (user space's battery guard owns it): anything but auto, or unreadable, ends the session */
+#define V3_BEH_AUTO	0		/* POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO; the C file asserts it */
+static inline int vl3_guard(int rc, int beh)
+{
+	return rc || beh != V3_BEH_AUTO ? V3B_GUARD : 0;
+}
+
+/* battery authentication: 1 = authentic, 0 = not, < 0 = the request failed; auth_gate = 0 only reports */
+static inline int vl3_auth_ok(int auth, int gate)
+{
+	return !gate || auth == 1;
+}
+
+/* ---- start gates of the powered stages (on top of the handshake's): start window, voltage, connector ---- */
+
+struct vl3_g {
+	int soc, t, mv, conn_c;
+	int soc_min, soc_max, t_min, t_max, conn_max_c;
+	int cap;
+	int stage4;					/* stage 4: the envelope (vl4_env_ask) replaces the two start-SoC rules for the cap */
+};
+/* 0 = go, else the reason text */
+static inline const char *vl3_gate(const struct vl3_g *g)
+{
+	if (g->soc < g->soc_min || g->soc > g->soc_max)
+		return "SoC outside the start window";
+	/* stock picks its curve by the SoC at the start (live.dts svooc_charge_strategy, soc_range 20 / 35 / 55): 7.3 A at every temperature
+	 * of the start window only below 35 %, at 35..55 % 4.0 A unless the battery is above 35 C, from 55 % 2.5..3.5 A */
+	if (!g->stage4 && g->cap > 40 && g->soc >= 35)
+		return "SoC 35 % or more for an ask above 4.0 A (stock's curve)";
+	if (!g->stage4 && g->cap > 25 && g->soc >= 55)
+		return "SoC 55 % or more for an ask above 2.5 A (stock's curve)";
+	if (g->t < g->t_min || g->t > g->t_max)
+		return "battery temperature outside the start window";
+	if (g->mv < V3_LIM_VLOW_MV || g->mv > V3_LIM_VBAT_MV)
+		return "battery voltage outside 3450 .. 4450 mV";
+	if (g->conn_c == V3_NO_CONN)
+		return "no connector temperature source readable";
+	if (g->conn_c >= g->conn_max_c)
+		return "connector temperature at the limit";
+	return 0;
+}
+
+/* module parameters that make the module refuse to load */
+static inline const char *vl3_params2(unsigned int stage, unsigned int pumps, unsigned int cap, unsigned int hold_s, unsigned int conn_max_c)
+{
+	if (stage != 2 && stage != 3)
+		return "stage must be 2 or 3";
+	if (pumps != 1 && pumps != 2)
+		return "pumps must be 1 or 2";
+	if (stage == 2 && pumps != 1)
+		return "pumps=2 needs stage=3";
+	if (stage == 3 && pumps == 1 && (cap < 1 || cap > V3_CAP_MAX))
+		return "cap_100ma must be 1 .. 13 with pumps=1";
+	if (stage == 3 && pumps == 2 && (cap < 1 || cap > V3B_CAP_MAX))
+		return "cap_100ma must be 1 .. 73 with pumps=2";
+	if (stage == 3 && pumps == 1 && (hold_s < 1 || hold_s > V3_HOLD_MAX_S))
+		return "hold_s must be 1 .. 300 with pumps=1";
+	if (stage == 3 && pumps == 2 && (hold_s < 1 || hold_s > V3B_HOLD_MAX_S))
+		return "hold_s must be 1 .. 600 with pumps=2";
+	if (stage == 3 && (conn_max_c < 1 || conn_max_c > V3_CONN_STOCK_C))
+		return "conn_max_c must be 1 .. 80 (stock's limit)";
+	return 0;
+}
+
+static inline const char *vl3_params(unsigned int stage, unsigned int cap, unsigned int hold_s, unsigned int conn_max_c)
+{
+	return vl3_params2(stage, 1, cap, hold_s, conn_max_c);
+}
+
+/* the session limit of the thread's clock: 5 s to the enable + the hold + margin */
+static inline int vl3_session_ms(unsigned int pumps)
+{
+	return pumps == 2 ? 630000 : 330000;
+}
+
+/* ---- firmware writes: one table (power-supply properties of qcom-battmgr), the powered stages only ---- */
+
+enum { FW_ICL = 1, FW_HOLD };			/* usb input_current_limit, the battery supply's charger hold (qcom_battmgr_oplus_pump_hold) */
+#define FWP_SUSPEND	1			/* from the first frame to the second 0x04 */
+#define FWP_RUN		2
+#define FWP_EXIT	4
+#define FW_HOLD_ON	1
+#define FW_HOLD_OFF	0
+#define FW_ICL_SUSPEND	0
+#define FW_ICL_UNSUSPEND 2000000		/* any non-zero value ends the suspend; stock's ICL after its exit is 2000 mA */
+
+struct vl3_fw {
+	u8 prop, phase;
+	int val;
+#ifndef __KERNEL__
+	const char *what;
+#endif
+};
+static const struct vl3_fw vl3_fwl[] = {
+	{ FW_ICL, FWP_SUSPEND, FW_ICL_SUSPEND, VL_DOC("input suspend: OPLUS prop 5 = 0 (stock: at the allow frame; here from the first frame)") },
+	{ FW_HOLD, FWP_RUN, FW_HOLD_ON, VL_DOC("output hold: qcom_battmgr_oplus_pump_hold(true), when the battery takes more than 2 A (stock: output suspend)") },
+	{ FW_HOLD, FWP_EXIT, FW_HOLD_OFF, VL_DOC("output release: qcom_battmgr_oplus_pump_hold(false), on every way out once a hold was requested") },
+	{ FW_ICL, FWP_EXIT, FW_ICL_UNSUSPEND, VL_DOC("input unsuspend: OPLUS prop 5 = 0xffffffff, then the driver's own ICL steps") },
+};
+#define VL3_NFW (sizeof(vl3_fwl) / sizeof(vl3_fwl[0]))
+
+static inline int vl3_fw_ok(u8 prop, int val, u8 phase, u8 mode)
+{
+	unsigned int i;
+
+	if (!(mode & VM_S3))
+		return 0;
+	for (i = 0; i < VL3_NFW; i++)
+		if (vl3_fwl[i].prop == prop && vl3_fwl[i].val == val && (vl3_fwl[i].phase & phase))
+			return 1;
+	return 0;
+}
+
+/* ---- the pump side of every way out ---- */
+
+struct vl3_io {
+	void *c;
+	int (*wr)(void *c, u8 reg, u8 w, u16 val);	/* checked pump write, < 0 on error */
+	int (*rd)(void *c, u8 reg, u8 n, u8 *buf);	/* block read, returns n or < 0 */
+	void (*dly)(void *c, int ms);
+	int (*en)(void *c);				/* the secondary's enable (C glue: lock, end check, the one write); optional */
+	int (*stop)(void *c);				/* non-zero once an end reason is set; optional */
+};
+struct vl3_lad {
+	int off_rc, off_tries, rows_fail, rd_fail;
+	u8 off_ok, wdt_kept, r06, r07;
+};
+#define VL3_OFF_TRIES	10
+
+/* off (0x07 = 0x00; the secondary's 0x01), then read 0x06 / 0x07 until CHG_EN and the switching status are clear; again on a failed write or a pump still on */
+static inline void vl3_off_confirm(const struct vl3_io *io, struct vl3_lad *l, int written, u8 off)
+{
+	u8 b[2];
+	int i;
+
+	for (i = 0; i < VL3_OFF_TRIES; i++) {
+		if (i || !written) {
+			l->off_rc = io->wr(io->c, 0x07, 1, off);
+			l->off_tries++;
+		}
+		io->dly(io->c, 2);
+		if (io->rd(io->c, 0x06, 2, b) == 2) {
+			l->r06 = b[0];
+			l->r07 = b[1];
+			if (vl_pump_idle(b[0], b[1])) {
+				l->off_ok = 1;
+				return;
+			}
+		} else {
+			l->rd_fail++;
+		}
+	}
+}
+
+/*
+ * Off and confirmed first, then stock's exit rows (vl_exit_rows[1..], row 0 is the off). Failed steps do not stop the rest. If the pump
+ * is not confirmed off the watchdog row (0x09 = 0x10) is NOT written: the 1 s watchdog stays armed and stops the pump when our reads stop.
+ * With stock_start and no UCP-back yet, the soft-start timeout goes back right after 0x05 = 0x2f.
+ */
+static inline void vl3_ladder_rows(const struct vl3_io *io, struct vl3_lad *l, int stock_start, int restored)
+{
+	unsigned int i;
+
+	for (i = 1; i < VL3_NEXIT; i++) {
+		const struct vl_row *r = &vl_exit_rows[i];
+
+		if (r->reg == 0x09 && !l->off_ok) {
+			l->wdt_kept = 1;
+			continue;
+		}
+		if (io->wr(io->c, r->reg, r->w, r->val) < 0)
+			l->rows_fail++;
+		if (r->reg == 0x05 && stock_start && !restored && io->wr(io->c, 0x08, 1, 0xe0) < 0)
+			l->rows_fail++;
+	}
+}
+
+static inline void vl3_ladder_pump(const struct vl3_io *io, struct vl3_lad *l, int written, int stock_start, int restored)
+{
+	vl3_off_confirm(io, l, written, 0x00);
+	vl3_ladder_rows(io, l, stock_start, restored);
+}
+
+/* ====================================================================================================================
+ * Stage 4: automatic SUPERVOOC (stage=4, both pumps, the ask follows stock's current envelope). Nothing here writes a register: the write
+ * tables, hw rows and exit rows are the two-pump session's; what changes is the value of the ask-current reply, the end rules, the session
+ * length and the start. The envelope follows stock's own battery current by state of charge (12.1 A at 31..40 %, 9.95 A at 40..55 %,
+ * 7.54 A above; stock first reaches 4450 mV at 82 %) and live.dts svooc_charge_strategy.
+ * ==================================================================================================================== */
+
+#define V4_HOLD_MAX_S		4500		/* 75 min, the backstop */
+#define V4_SESSION_MS		4530000		/* 5 s to the enable + the hold + the margin used with pumps = 2 (630 s for 600 s) */
+
+#define V4_ENV_SOC1		40		/* live envelope by the gauge SoC: below SOC1 A0, below SOC2 A1, else A2 */
+#define V4_ENV_SOC2		55
+#define V4_ENV_A0		73
+#define V4_ENV_A1		50
+#define V4_ENV_A2		38
+#define V4_HOT_DC		660		/* 0.1 C, either pump's TDIE: the ask is at most V4_HOT_ASK from then on */
+#define V4_HOT_ASK		60
+#define V4_TAPER_MV		4450		/* gauge VBAT at or above it on V4_TAPER_READS consecutive reads: one step down the ladder */
+#define V4_TAPER_READS		3
+#define V4_SETTLE_READS		30		/* reads after an ask change: the adapter takes a new ask only through the change code and then ramps, so the
+						 * taper does not count and the total limit keeps the old ask until then */
+#define V4_END_MV		4480		/* a single gauge read above it ends the session (stock's first step-down voltage) */
+#define V4_END_SOC		90
+#define V4_REARM_MS		30000		/* offline is believed this long after a session's end (the firmware's own unsuspend dips VBUS) */
+#define V4_RECHECK_MS		60000		/* a start refused before any write: the gates are read again this long after the refusal */
+#define V4_NO_LIMIT		0x7fffffff
+
+enum { V4N_RECHECK = 1, V4N_UNPLUG };		/* what an auto start that ended does to the plug-in: not used up / used up */
+
+enum { V4R_NONE, V4R_ENV, V4R_HOT, V4R_TAPER };	/* why the ask changed */
+enum { V4E_NONE, V4E_VOLT, V4E_SOC, V4E_FLOOR };	/* ends decided by vl4_read() */
+
+struct vl4 {
+	u8 ask;					/* the running minimum, 100 mA units; only the monitor changes it */
+	u8 n_hi;
+	u8 lim;					/* the ask the total-current limit uses: the ask once V4_SETTLE_READS reads passed without a change */
+	u8 since;				/* reads since the last ask change, 255 = none yet */
+	u8 nchg;				/* changes made by the last vl4_read(): new ask and reason per change */
+	u8 new_ask[3], why[3];
+};
+
+static inline u8 vl4_env_ask(int soc)
+{
+	return soc < V4_ENV_SOC1 ? V4_ENV_A0 : soc < V4_ENV_SOC2 ? V4_ENV_A1 : V4_ENV_A2;
+}
+
+static const u8 vl4_ladder[7] = { 73, 60, 50, 38, 30, 25, 20 };
+
+/* the highest ladder level below the ask, 0 = none (the ask is at the floor) */
+static inline u8 vl4_below(u8 ask)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(vl4_ladder); i++)
+		if (vl4_ladder[i] < ask)
+			return vl4_ladder[i];
+	return 0;
+}
+
+static inline void vl4_init(struct vl4 *s, u8 cap, int soc)
+{
+	u8 e = vl4_env_ask(soc);
+
+	*s = (struct vl4){ 0 };
+	s->ask = cap < e ? cap : e;
+	s->lim = s->ask;
+	s->since = 0xff;
+}
+
+static inline void vl4_set(struct vl4 *s, u8 ask, u8 why)
+{
+	s->ask = ask;
+	s->since = 0;
+	s->new_ask[s->nchg] = ask;
+	s->why[s->nchg++] = why;
+}
+
+/*
+ * One gauge battery read (the monitor, once a second): soc %, mv, tdie = the higher of the two pumps' TDIE maxima in 0.1 C. Returns 0 or a
+ * V4E_*. The ask only goes down: the envelope, the thermal cap and the taper each lower it, none raises it. After any change the taper
+ * waits V4_SETTLE_READS reads (the adapter has not taken the new ask yet, so the voltage still shows the old one: without the wait one
+ * stretch above 4450 mV would walk the ladder to the floor in 18 reads), and lim, the total-current limit's ask, follows only then.
+ */
+static inline int vl4_read(struct vl4 *s, int soc, int mv, int tdie)
+{
+	u8 a;
+
+	s->nchg = 0;
+	if (mv > V4_END_MV)
+		return V4E_VOLT;
+	if (soc >= V4_END_SOC)
+		return V4E_SOC;
+	if (s->since < 0xff)
+		s->since++;
+	a = vl4_env_ask(soc);
+	if (a < s->ask)
+		vl4_set(s, a, V4R_ENV);
+	if (tdie >= V4_HOT_DC && V4_HOT_ASK < s->ask)
+		vl4_set(s, V4_HOT_ASK, V4R_HOT);
+	if (s->since < V4_SETTLE_READS) {
+		s->n_hi = 0;
+		return 0;
+	}
+	s->lim = s->ask;
+	if (mv >= V4_TAPER_MV) {
+		if (++s->n_hi >= V4_TAPER_READS) {
+			s->n_hi = 0;
+			a = vl4_below(s->ask);
+			if (!a)
+				return V4E_FLOOR;
+			vl4_set(s, a, V4R_TAPER);
+		}
+	} else {
+		s->n_hi = 0;
+	}
+	return 0;
+}
+
+static inline const char *vl4_why(int c)
+{
+	switch (c) {
+	case V4E_VOLT:	return "battery voltage above 4480 mV";
+	case V4E_SOC:	return "complete: 90 %";
+	case V4E_FLOOR:	return "complete: taper reached 2.0 A";
+	}
+	return "?";
+}
+
+static inline const char *vl4_ask_why(int r)
+{
+	return r == V4R_ENV ? "envelope" : r == V4R_HOT ? "thermal" : r == V4R_TAPER ? "taper" : "?";
+}
+
+/* stage 4 on top of vl3_init() / vl3_bs: the reply follows the monitor's ask, the pump's own VBAT limit is the 4480 mV end, the gauge is judged by vl4_read() */
+static inline void vl4_setup(struct vl3 *r, u8 ask)
+{
+	r->pumps = 2;
+	r->stage4 = 1;
+	r->ask4 = ask;
+	r->lim4 = ask;
+	r->vbat_hi = V4_END_MV;
+}
+
+static inline void vl4_bs_setup(struct vl3_bs *s)
+{
+	s->vhigh_mv = V4_NO_LIMIT;
+}
+
+/* module parameters of stage 4 (vl3_params2() keeps refusing stage 4); pumps is ignored */
+static inline const char *vl4_params(unsigned int cap, unsigned int hold_s, unsigned int conn_max_c)
+{
+	if (cap < 1 || cap > V3B_CAP_MAX)
+		return "cap_100ma must be 1 .. 73 with stage=4";
+	if (hold_s < 1 || hold_s > V4_HOLD_MAX_S)
+		return "hold_s must be 1 .. 4500 with stage=4";
+	if (conn_max_c < 1 || V3_CONN_STOCK_C < conn_max_c)
+		return "conn_max_c must be 1 .. 80 (stock's limit)";
+	return 0;
+}
+
+static inline const char *vl4_auto_params(unsigned int stage, unsigned int auto_start)
+{
+	return auto_start && stage != 4 ? "autostart=1 needs stage=4" : 0;
+}
+
+/* the parameters left unset take the stage's default */
+enum { V4D_CAP, V4D_HOLD, V4D_SOC_MIN, V4D_SOC_MAX, V4D_T_MIN, V4D_T_MAX };
+static inline int vl4_default(unsigned int stage, int which)
+{
+	static const int s3[] = { V3_CAP_MAX, 120, 30, 60, 200, 350 };
+	static const int s4[] = { 73, V4_HOLD_MAX_S, 0, 80, 210, 350 };
+
+	return stage == 4 ? s4[which] : s3[which];
+}
+
+static inline int vl4_session_ms(void)
+{
+	return V4_SESSION_MS;
+}
+
+/* after a session's end: the usb supply read offline counts as an unplug only this long after the end (still plugged = no second attempt) */
+static inline int vl4_rearm(int online, int ms_since_end)
+{
+	return !online && ms_since_end >= V4_REARM_MS;
+}
+
+/*
+ * The plug-in's only attempt is a session that wrote to a pump or switched D+/D- (whatever ended it: wait for the unplug). A start that
+ * a gate refused before any write leaves the plug-in unused: the gates are read again V4_RECHECK_MS later.
+ */
+static inline int vl4_next(int pump_written, int mux_switched)
+{
+	return !pump_written && !mux_switched ? V4N_RECHECK : V4N_UNPLUG;
+}
+
+static inline int vl4_recheck_due(int ms_since_refusal)
+{
+	return ms_since_refusal >= V4_RECHECK_MS;
+}
+
+/* 1 = a refusal to log: the first of the plug-in (last empty) or a different reason; digits, '.' and '-' are values that move (3400 mV, 21.0 C), not the reason */
+static inline int vl4_new_refusal(const char *last, const char *now)
+{
+	if (!*last)
+		return 1;
+	for (;;) {
+		while (*last && ((*last >= '0' && *last <= '9') || *last == '.' || *last == '-'))
+			last++;
+		while (*now && ((*now >= '0' && *now <= '9') || *now == '.' || *now == '-'))
+			now++;
+		if (*last != *now)
+			return 1;
+		if (!*last)
+			return 0;
+		last++;
+		now++;
+	}
+}
+
+
+/* ====================================================================================================================
+ * Both pumps (pumps = 2). The secondary pump (stock's "slave", i2c@890000) is driven only from here: its own write table, its own
+ * rows, its own per-frame sequence. Stock's slave functions are D.c:2136-2434.
+ * ==================================================================================================================== */
+
+/* stock's secondary logic, all of it from the curr event handler (V.c:5382-5500), a 1 s monitor event (VOOC_CURR_EVENT_TIME, 1000):
+ * the first run is at the monitor start = the primary's enable, then 1 s after the previous run ended */
+#define V3B_TICK_MS		1000
+#define V3B_ENABLE_MA		1400	/* oplus_spec,slave_cp_enable_thr = 0x578 (live.dts:26314), compared with cp_ichg = primary + secondary ADC (V.c:1801) */
+#define V3B_LOW_MA		1100	/* oplus_spec,slave_cp_disable_thr_high = 0x44c (live.dts:26315): below it on 4 ticks stock disables the secondary */
+#define V3B_LOW_TICKS		4	/* disable_sub_cp_count 0, 1, 2, 3, then the disable (V.c:5480-5496) */
+#define V3B_MIN_MA		500	/* oplus,slave_cp_enable_thr_low, not in live.dts: default 500 (V.c:6804): slave IBUS below it = trouble */
+#define V3B_DEV_MA		1000	/* oplus,cp_ibus_devation, not in live.dts: DEFAULT_CP_IBUS_DEVATION 1000: |primary - secondary| above it = trouble */
+#define V3B_STATUS_DELAY_MS	300	/* OPLUS_VOOCPHY_SLAVE_CHECK_DELAY_MS (V.c:2816) */
+#define V3B_STATUS_MS		3000	/* 60 x OPLUS_VOOCPHY_SLAVE_STATUS_CHECK_DELAY_MS (50 ms), V.c:2817-2818 */
+#define V3B_PUMP_MAX_MA		5300	/* oplus_spec,voocphy_cp_max_ibus = 0x14b4 (live.dts:26337), per pump (V.c:6398) */
+#define V3B_IDLE_MA		600	/* a pump that is not enabled carries less (stock: at most 2 mA before the secondary's enable) */
+
+enum { V3S_RD = 1, V3S_WR, V3S_EN };		/* negative returns of the secondary's functions: read failed, write failed / refused, enable not written */
+
+/* the secondary's write table (stock's whole session: no word write, no other register). Byte rows only; phases as the primary's */
+static const struct vl_w vl3b_wl[] = {
+	{ 0x07, 1, VW_INIT,			0xff, 0x41, VL_DOC("init: soft reset, bit 0 as stock's slave") },
+	{ 0x07, 1, VW_EXIT,			0xff, 0x01, VL_DOC("exit: CHG_EN off, bit 0 kept (D.c:2228-2266)") },
+	{ 0x07, 1, VW_ENAB,			0xff, 0x81, VL_DOC("secondary enable (only vl3b_enable_ok(), from the one enable function)") },
+	{ 0x11, 1, VW_INIT | VW_EXIT | VW_SESS,	0xff, 0x00, VL_DOC("ADC off; round 1: unfreeze with the ADC off") },
+	{ 0x11, 1, VW_SESS,			0xff, 0x20, VL_DOC("round 1: ADC freeze with the ADC off") },
+	{ 0x11, 1, VW_HW | VW_RUN,		0xff, 0x80, VL_DOC("hw_setting: ADC on / unfreeze") },
+	{ 0x11, 1, VW_RUN,			0xff, 0xa0, VL_DOC("ADC freeze for the block read") },
+	{ 0x02, 1, VW_INIT | VW_HW | VW_EXIT,	0xff, 0x01, VL_DOC("VAC OVP") },
+	{ 0x04, 1, VW_INIT | VW_HW | VW_EXIT,	0xff, 0x5a, VL_DOC("VBUS OVP 10500 mV") },
+	{ 0x00, 1, VW_INIT | VW_EXIT,		0xff, 0x36, VL_DOC("VBAT OVP 4850 mV") },
+	{ 0x05, 1, VW_INIT | VW_HW | VW_EXIT,	0xff, 0x2e, VL_DOC("IBUS OCP 5400 mA, UCP on (stock's secondary, DT ocp_reg 0xe)") },
+	{ 0x01, 1, VW_INIT | VW_EXIT,		0xff, 0xbf, VL_DOC("IBAT OCP") },
+	{ 0x2b, 1, VW_INIT | VW_EXIT,		0xff, 0x00, VL_DOC("VOOC PHY off") },
+	{ 0x34, 1, VW_INIT | VW_HW | VW_EXIT,	0xff, 0x60, VL_DOC("hold time") },
+	{ 0x09, 1, VW_INIT | VW_EXIT,		0xff, 0x10, VL_DOC("2:1, UCP-rise masked, watchdog off") },
+	{ 0x09, 1, VW_HW,			0xff, 0x13, VL_DOC("hw_setting: watchdog 1 s armed") },
+	{ 0x10, 1, VW_INIT | VW_EXIT,		0xff, 0x02, VL_DOC("mask ADAPTER_INSERT") },
+	{ 0x0d, 1, VW_HW,			0xff, 0x70, VL_DOC("hw_setting: PMID2OUT UVP 100 mV, OVP 500 mV") },
+	{ 0x33, 1, VW_HW,			0xff, 0xd1, VL_DOC("hw_setting: VOOC timing") },
+};
+#define VL3B_NW (sizeof(vl3b_wl) / sizeof(vl3b_wl[0]))
+
+/* the secondary's write check: its own table, only with pumps=2. Nothing of the primary's tables is consulted */
+static inline int vl3b_write_phase(u8 reg, u8 w, u16 val, u8 mode)
+{
+	if (!(mode & VM_S3B))
+		return 0;
+	return vl3_tab_phase(vl3b_wl, VL3B_NW, reg, w, val) & ~VW_ENAB;
+}
+
+static inline int vl3b_write_ok(u8 reg, u8 w, u16 val, u8 mode)
+{
+	return vl3b_write_phase(reg, w, val, mode) != 0;
+}
+
+static inline int vl3b_enable_ok(u8 reg, u8 w, u16 val, u8 mode)
+{
+	return (mode & VM_S3B) && reg == 0x07 && w == 1 && val == 0x81;
+}
+
+/* stock's secondary sequence in stock's order, RMW reads left out */
+static const struct vl_row vl3b_init_rows[] = {		/* after the primary's init, before the handshake */
+	{ 0x07, 1, 0x41 }, { 0x11, 1, 0x00 }, { 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x00, 1, 0x36 }, { 0x05, 1, 0x2e },
+	{ 0x01, 1, 0xbf }, { 0x2b, 1, 0x00 }, { 0x34, 1, 0x60 }, { 0x09, 1, 0x10 }, { 0x10, 1, 0x02 },
+};
+static const struct vl_row vl3b_hw_rows[] = {		/* after the primary's hw rows and start pattern */
+	{ 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x05, 1, 0x2e }, { 0x09, 1, 0x13 }, { 0x11, 1, 0x80 }, { 0x0d, 1, 0x70 },
+	{ 0x33, 1, 0xd1 }, { 0x34, 1, 0x60 },
+};
+static const struct vl_row vl3b_adc1_rows[] = { { 0x11, 1, 0x20 }, { 0x11, 1, 0x00 } };	/* round 1, around the 0x13 read */
+static const struct vl_row vl3b_adc_rows[] = { { 0x11, 1, 0xa0 }, { 0x11, 1, 0x80 } };	/* from the allow frame on */
+/*
+ * stock's exit: 07=01, 09 read-modify-write (0x33 -> 0x30: bit 5 is the UCP-rise flag), then stock's reset rows. This
+ * table writes 0x10 for that row (same effect, a value stock writes on this chip). Stock repeats the whole set once more 120 ms later;
+ * not repeated here.
+ */
+static const struct vl_row vl3b_exit_rows[] = {
+	{ 0x07, 1, 0x01 }, { 0x09, 1, 0x10 }, { 0x11, 1, 0x00 }, { 0x02, 1, 0x01 }, { 0x04, 1, 0x5a }, { 0x00, 1, 0x36 },
+	{ 0x05, 1, 0x2e }, { 0x01, 1, 0xbf }, { 0x2b, 1, 0x00 }, { 0x34, 1, 0x60 }, { 0x09, 1, 0x10 }, { 0x10, 1, 0x02 },
+};
+#define VL3B_NINIT	(sizeof(vl3b_init_rows) / sizeof(vl3b_init_rows[0]))
+#define VL3B_NHW	(sizeof(vl3b_hw_rows) / sizeof(vl3b_hw_rows[0]))
+#define VL3B_NEXIT	(sizeof(vl3b_exit_rows) / sizeof(vl3b_exit_rows[0]))
+
+/* writes the rows in order through the bus's own checked write; stops at the first failure (-1) or when an end reason is set (-2) */
+static inline int vl3_rows(const struct vl3_io *io, const struct vl_row *rw, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (io->stop && io->stop(io->c))
+			return -2;
+		if (io->wr(io->c, rw[i].reg, rw[i].w, rw[i].val) < 0)
+			return -1;
+	}
+	return 0;
+}
+
+static inline int vl3b_init(const struct vl3_io *io)
+{
+	return vl3_rows(io, vl3b_init_rows, VL3B_NINIT);
+}
+
+static inline int vl3b_hw(const struct vl3_io *io, struct vl3 *r)
+{
+	int rc = vl3_rows(io, vl3b_hw_rows, VL3B_NHW);
+
+	if (!rc)
+		r->s.hw_done = 1;
+	return rc;
+}
+
+/* the secondary's register image, read back right before its enable and in every frame after the allow frame (0x08 is never written or read by stock: not judged) */
+static inline int vl3b_image(const u8 *blk)
+{
+	if (blk[0x00] != 0x36)
+		return 0x00 + 1;
+	if (blk[0x01] != 0xbf)
+		return 0x01 + 1;
+	if ((blk[0x02] & 0xef) != 0x01)
+		return 0x02 + 1;
+	if (blk[0x04] != 0x5a)
+		return 0x04 + 1;
+	if (blk[0x05] != 0x2e)
+		return 0x05 + 1;
+	if ((blk[0x09] & 0x97) != 0x13)
+		return 0x09 + 1;
+	if ((blk[0x0d] & 0xf0) != 0x70)
+		return 0x0d + 1;
+	if (blk[0x10] != 0x02)
+		return 0x10 + 1;
+	return 0;
+}
+
+/* the secondary's flags, image (after the allow frame), idle / CHG_EN / switching. blk = registers 0x00..0x10 as the primary's */
+static inline int vl3b_pre(struct vl3 *r, const u8 *blk, int now)
+{
+	struct vl3s *s = &r->s;
+	int img;
+
+	s->prot_ok = 0;
+	s->fl_or[0] |= blk[0x06];
+	s->fl_or[1] |= blk[0x09];
+	s->fl_or[2] |= blk[0x0d] | blk[0x0e];
+	s->fl_or[3] |= blk[0x0f];
+	if (vl3_flags(blk))
+		return V3E_SFLAGS;
+	if (r->ph != V3_ASK) {
+		img = vl3b_image(blk);
+		s->prot_ok = img == 0;
+		if (img)
+			return V3E_SIMAGE;
+	}
+	s->sw_now = (blk[0x06] & 0x04) && (blk[0x07] & 0x80);		/* stock's slave get_cp_status (D.c:2356) */
+	if (!s->enabled)
+		return vl_pump_idle(blk[0x06], blk[0x07]) ? 0 : V3E_SIDLE;
+	if (now - s->t_en >= V3_ENABLE_GRACE_MS) {
+		if (!(blk[0x07] & 0x80))
+			return V3E_SCHGEN;
+		if (blk[0x06] & 0x30)
+			return V3E_SVERR;
+	}
+	if (blk[0x06] & 0x04) {
+		s->sw_seen = 1;
+		s->n_lost = 0;
+	} else if (s->sw_seen && ++s->n_lost >= 3) {
+		return V3E_SLOST;
+	}
+	return 0;
+}
+
+/* the 1 s tick of stock's curr event, from the primary's enable on; 1 = this frame is a tick */
+static inline int vl3b_tick(struct vl3 *r, int now)
+{
+	struct vl3s *s = &r->s;
+
+	s->tick_now = 0;
+	if (!r->enabled)
+		return 0;
+	if (!s->tick_init) {
+		s->tick_init = 1;
+		s->next_tick = now;
+	}
+	if (now < s->next_tick)
+		return 0;
+	s->next_tick = now + V3B_TICK_MS;
+	s->tick_now = 1;
+	return 1;
+}
+
+/*
+ * The secondary's enable, stock's condition (V.c:5430-5435) with this module's added ones: at a tick, the window NORMAL, total IBUS above
+ * 1400 mA (stock's get_ichg of a pump that is not enabled is 0: the primary alone), the secondary not enabled, and never twice (stock's
+ * slave_trouble_count <= 1 retry is not taken: one enable per session); plus pumps=2, the primary enabled, switching, its image ok, the
+ * input suspend confirmed, the secondary's hw rows written and its own image read back in this frame. "No end reason set" is the C glue's.
+ */
+static inline int vl3b_due(struct vl3 *r, int now)
+{
+	struct vl3s *s = &r->s;
+
+	vl3b_tick(r, now);
+	if (!s->tick_now || r->pumps != 2 || s->enabled || s->done)
+		return 0;
+	return r->sw_seen && !r->n_lost && r->prot_ok && s->prot_ok && s->hw_done && r->suspend_ok && r->vbus_st == VB_NORMAL && r->adc_ok &&
+	       r->adc.ibus > V3B_ENABLE_MA;
+}
+
+/* the secondary's ADC block (14 bytes as the primary's; its VBAT pin is not wired, so VBAT / VOUT / VBUS are not judged); r->adc is this frame's primary block */
+static inline int vl3b_adc(struct vl3 *r, const struct vl_adc *a, int now)
+{
+	struct vl3s *s = &r->s;
+	unsigned int i;
+	int tot, same = 1, d;
+
+	if (a->tdie > V3_LIM_TDIE_DC)
+		return V3E_STDIE;
+	if (a->ibus > V3B_PUMP_MAX_MA)
+		return V3E_SIBUS_MAX;
+	if (!s->enabled)
+		return a->ibus > V3B_IDLE_MA ? V3E_SCURR : 0;
+
+	tot = r->adc.ibus + a->ibus;
+	if (a->ibus > s->ibus_max)
+		s->ibus_max = a->ibus;
+	if (a->tdie > s->tdie_max)
+		s->tdie_max = a->tdie;
+	if (tot > s->tot_max)
+		s->tot_max = tot;
+	s->nrun++;
+	if (tot > vl3_tot_lim(r)) {
+		if (++s->n_tot >= 3)
+			return V3E_TOTAL;
+	} else {
+		s->n_tot = 0;
+	}
+	if (!s->checked && now - s->t_en >= V3B_STATUS_DELAY_MS) {
+		d = r->adc.ibus > a->ibus ? r->adc.ibus - a->ibus : a->ibus - r->adc.ibus;
+		if (a->ibus >= V3B_MIN_MA && s->sw_now && d <= V3B_DEV_MA)
+			s->checked = 1;
+		else if (now - s->t_en >= V3B_STATUS_DELAY_MS + V3B_STATUS_MS)
+			return V3E_STROUBLE;
+	}
+	if (s->checked && s->tick_now) {
+		if (tot < V3B_LOW_MA) {
+			if (++s->n_low >= V3B_LOW_TICKS)
+				return V3E_SLOW;
+		} else {
+			s->n_low = 0;
+		}
+	}
+	for (i = 0; i < 14; i++)
+		if (a->raw[i] != s->adc.raw[i])
+			same = 0;
+	if (s->adc_ok && same) {
+		if (++s->n_same >= V3_STALE_N - 1)
+			return V3E_SSTALE;
+	} else {
+		s->n_same = 0;
+	}
+	return 0;
+}
+
+/*
+ * What the IRQ thread does for the secondary after each frame's reply, after the primary's own post. Returns 0, a V3E_* limit, or a
+ * negative -V3S_*. Round 1 (before the allow reply): stock's freeze rows with the ADC off, flags and idle. After it: the register
+ * image, the enable decision (before this frame's ADC read, as stock's tick acts between frames), stock's freeze rows, the ADC block.
+ */
+static inline int vl3b_run(const struct vl3_io *io, struct vl3 *r, int now)
+{
+	struct vl3s *s = &r->s;
+	u8 blk[17], b[14];
+	struct vl_adc a;
+	int rc, n, i;
+
+	for (i = 0; i < 17; i++)
+		blk[i] = 0;
+	if (r->ph == V3_ASK) {
+		if (io->rd(io->c, 0x06, 10, blk + 6) != 10)
+			return -V3S_RD;
+		rc = vl3b_pre(r, blk, now);
+		if (vl3_rows(io, vl3b_adc1_rows, 1) < 0)
+			return -V3S_WR;
+		n = io->rd(io->c, 0x13, 2, b);
+		if (vl3_rows(io, vl3b_adc1_rows + 1, 1) < 0)
+			return -V3S_WR;
+		if (n != 2)
+			return -V3S_RD;
+		/* the ADC is off in round 1 (stock's 11=00 / 11=20): 0x13 holds the last conversion from whenever it last ran (seen here: android's
+		 * last fast charge, 901 mA at 9.3 V). stock reads it and ignores it; idle is judged from 0x06 / 0x07 */
+		return rc;
+	}
+	if (io->rd(io->c, 0x06, 10, blk + 6) != 10 || io->rd(io->c, 0x04, 2, blk + 4) != 2 || io->rd(io->c, 0x00, 3, blk) != 3 ||
+	    io->rd(io->c, 0x10, 1, blk + 16) != 1)
+		return -V3S_RD;
+	for (i = 0; i < 17; i++)
+		s->blk[i] = blk[i];
+	rc = vl3b_pre(r, blk, now);
+	if (rc)
+		return rc;
+	if (vl3b_due(r, now)) {
+		s->done = 1;
+		if (!io->en || io->en(io->c) < 0)
+			return -V3S_EN;
+		s->enabled = 1;
+		s->t_en = now;
+	}
+	if (vl3_rows(io, vl3b_adc_rows, 1) < 0)
+		return -V3S_WR;
+	n = io->rd(io->c, 0x13, 14, b);
+	if (vl3_rows(io, vl3b_adc_rows + 1, 1) < 0)
+		return -V3S_WR;
+	if (n != 14)
+		return -V3S_RD;
+	vl_adc_decode(&a, b);
+	/* the allow frame's read comes ~2 ms after the hw rows switched the ADC on; the chip needs ~10 ms to replace the old conversion */
+	rc = s->fresh ? vl3b_adc(r, &a, now) : 0;
+	s->fresh = 1;
+	s->adc = a;
+	s->adc_ok = 1;
+	return rc;
+}
+
+/* the secondary's way out in stock's order (its off and rows, then the primary's off); the watchdog row stays out while the pump is not confirmed off */
+static inline void vl3b_ladder_rows(const struct vl3_io *io, struct vl3_lad *l)
+{
+	unsigned int i;
+
+	for (i = 1; i < VL3B_NEXIT; i++) {
+		const struct vl_row *r = &vl3b_exit_rows[i];
+
+		if (r->reg == 0x09 && !l->off_ok) {
+			l->wdt_kept = 1;
+			continue;
+		}
+		if (io->wr(io->c, r->reg, r->w, r->val) < 0)
+			l->rows_fail++;
+	}
+}
+
+#endif
