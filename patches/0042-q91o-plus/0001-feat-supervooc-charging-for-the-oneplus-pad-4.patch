+static int psv(struct power_supply *p, enum power_supply_property prop, int *out)
+{
+	union power_supply_propval v;
+	int ret = power_supply_get_property(p, prop, &v);
+
+	if (!ret)
+		*out = v.intval;
+	return ret;
+}
