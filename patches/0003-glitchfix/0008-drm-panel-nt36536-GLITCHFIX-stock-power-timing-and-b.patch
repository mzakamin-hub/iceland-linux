From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 20 Oct 2026 21:33:00 +0300
Subject: [PATCH 8/8] drm/panel: nt36536: GLITCHFIX stock power timing and
 backlight switches

Test kernel q89z (OnePlus Pad 4 display glitch bundle), not for upstream.

The OnePlus Pad 4 (XN251) init sequence matches stock command for
command, but the power edges do not:

  stock                                   this driver
  vddio, 2 ms, reset                      vddio, reset at once
  display off, 10 ms, sleep in, 65 ms     display off, sleep in, no wait
  reset, 5 ms, vddio off                  reset, vddio off at once
  backlight after the first frame         backlight at prepare (before
  (delay_until_first_frame)               video starts)

panel_novatek_nt36536.stock_power_timing adds stock's waits;
panel_novatek_nt36536.bl_after_video moves the backlight enable to the
panel's enable, after the DSI hosts started video. Both default off
(current behaviour) and are read at every prepare / enable / unprepare.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-novatek-nt36536.c | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
index 5fb58b1fbeb1..30eeb21343e1 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -34,6 +34,8 @@ struct novatek {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	struct backlight_device *backlight;
+	/* bl_after_video: the backlight waits for novatek_enable() */
+	bool bl_deferred;
 };
 
 struct panel_desc {
@@ -64,6 +66,28 @@ static const struct regulator_bulk_data novatek_supplies[] = {
 	{ .supply = "vsn" },
 };
 
+/*
+ * Stock (XN251 / A0024) power timing: 2 ms after vddio before the reset,
+ * 10 ms after display off, 65 ms after sleep in, 5 ms before vddio off
+ * (oplus,panel-power-on/off-sequence, qcom,mdss-dsi-off-command). Off:
+ * no waits (default). Read at every prepare / unprepare.
+ */
+static bool stock_power_timing;
+module_param(stock_power_timing, bool, 0644);
+MODULE_PARM_DESC(stock_power_timing,
+		 "Use stock's waits around vddio, display off and sleep in (default: off)");
+
+/*
+ * Stock turns the backlight on only after the first video frame
+ * (qcom,bl-update-flag = "delay_until_first_frame"): from the panel's enable,
+ * which runs after the DSI hosts started video. Off: from prepare, before
+ * video (default). Read at every prepare / enable.
+ */
+static bool bl_after_video;
+module_param(bl_after_video, bool, 0644);
+MODULE_PARM_DESC(bl_after_video,
+		 "Turn the backlight on at the panel enable, after video started (default: at prepare)");
+
 static inline struct novatek *to_novatek(struct drm_panel *panel)
 {
 	return container_of(panel, struct novatek, panel);
@@ -113,6 +137,9 @@ static int novatek_prepare(struct drm_panel *panel)
 	if (ret < 0)
 		return ret;
 
+	if (READ_ONCE(stock_power_timing))
+		usleep_range(2000, 3000);
+
 	novatek_reset(ctx);
 
 	ret = ctx->desc->init_sequence(&dsi_ctx, &ctx->dsc);
@@ -131,13 +158,34 @@ static int novatek_prepare(struct drm_panel *panel)
 	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
 	mipi_dsi_msleep(&dsi_ctx, 28);
 
+	ctx->bl_deferred = READ_ONCE(bl_after_video);
+	if (ctx->bl_deferred)
+		return 0;
+
+	return backlight_enable(ctx->backlight);
+}
+
+static int novatek_enable(struct drm_panel *panel)
+{
+	struct novatek *ctx = to_novatek(panel);
+
+	if (!ctx->bl_deferred)
+		return 0;
+
+	ctx->bl_deferred = false;
 	return backlight_enable(ctx->backlight);
 }
 
 static int novatek_off(struct mipi_dsi_multi_context *dsi_ctx)
 {
+	bool waits = READ_ONCE(stock_power_timing);
+
 	mipi_dsi_dcs_set_display_off_multi(dsi_ctx);
+	if (waits)
+		mipi_dsi_msleep(dsi_ctx, 10);
 	mipi_dsi_dcs_enter_sleep_mode_multi(dsi_ctx);
+	if (waits)
+		mipi_dsi_msleep(dsi_ctx, 65);
 
 	return dsi_ctx->accum_err;
 }
@@ -157,6 +205,8 @@ static int novatek_unprepare(struct drm_panel *panel)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (READ_ONCE(stock_power_timing))
+		usleep_range(5000, 6000);
 	regulator_bulk_disable(ARRAY_SIZE(novatek_supplies), ctx->supplies);
 
 	return 0;
@@ -197,6 +247,7 @@ static int novatek_get_modes(struct drm_panel *panel,
 
 static const struct drm_panel_funcs novatek_panel_funcs = {
 	.prepare = novatek_prepare,
+	.enable = novatek_enable,
 	.unprepare = novatek_unprepare,
 	.get_modes = novatek_get_modes,
 };
