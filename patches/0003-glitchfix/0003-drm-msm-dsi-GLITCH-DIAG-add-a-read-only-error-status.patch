From 0226ebab9d7c44e622d6b36fd858e96df866bfa7 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 20 Oct 2026 07:49:00 +0300
Subject: [PATCH 1/2] drm/msm/dsi: GLITCH-DIAG add a read-only error status
 file per host

Diagnostic for the OnePlus Pad 4 display glitch, not for upstream.

The per-frame DPU CRCs stay clean while the panel shows flicker, so the
next place to look is the DSI link. In video mode the host enables only
the ACK error status as an interrupt source (ERR_INT_MASK0 = 0x13ff3fe0),
so lane FIFO under/overflows, LP contention, timeouts and an unlocked PLL
are latched in their status registers but never raise an interrupt or a
log line; "no DSI errors in the log" says nothing about them.

Add a debugfs file per host, iceland_dsi<N>_err, that reads the six
error status registers (ACK_ERR_STATUS, TIMEOUT_STATUS, DLN0_PHY_ERR,
FIFO_STATUS, STATUS0, CLK_STATUS) with dev_mutex held while the host is
powered, masks the error bits, and counts the error interrupts taken.
Nothing is written or cleared; a powered-off host reports power=0.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 77 ++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index b233ad4..628eb16 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
@@ -16,6 +17,7 @@
 #include <linux/pm_opp.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
+#include <linux/seq_file.h>
 #include <linux/spinlock.h>
 
 #include <video/mipi_display.h>
@@ -189,6 +191,10 @@ struct msm_dsi_host {
 	/* msm_dsi_host_set_vtotal() switched the timing double buffer on */
 	bool timing_db_used;
 	int irq;
+
+	/* GLITCH-DIAG: error interrupts taken, the debugfs status file */
+	u32 diag_err_irqs;
+	struct dentry *diag_dentry;
 };
 
 static inline u32 dsi_read(struct msm_dsi_host *msm_host, u32 reg)
@@ -1681,6 +1687,8 @@ static void dsi_error(struct msm_dsi_host *msm_host)
 	/* disable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 0);
 
+	WRITE_ONCE(msm_host->diag_err_irqs, msm_host->diag_err_irqs + 1);
+
 	dsi_clk_status(msm_host);
 	dsi_fifo_status(msm_host);
 	dsi_ack_err_status(msm_host);
@@ -1691,6 +1699,65 @@ static void dsi_error(struct msm_dsi_host *msm_host)
 	queue_work(msm_host->workqueue, &msm_host->err_work);
 }
 
+/*
+ * GLITCH-DIAG (OnePlus Pad 4 display glitch, not for upstream): the error
+ * status registers of this host, read once per call while the host is
+ * powered (dev_mutex held, so the link clocks and the runtime PM vote are
+ * on). In video mode only the ACK error status raises the error interrupt
+ * (ERR_INT_MASK0 = 0x13ff3fe0), so FIFO / PHY / timeout errors stay latched
+ * in their registers without a log line: this file shows them. Read only;
+ * nothing is cleared.
+ */
+#define DSI_DIAG_FIFO_ERR (DSI_FIFO_STATUS_VIDEO_MDP_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_VIDEO_MDP_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_CMD_MDP_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_CMD_DMA_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_DLN0_LP_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_DLN0_HS_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_DLN0_HS_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_DLN1_HS_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_DLN1_HS_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_DLN2_HS_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_DLN2_HS_FIFO_UNDERFLOW | \
+			   DSI_FIFO_STATUS_DLN3_HS_FIFO_OVERFLOW | \
+			   DSI_FIFO_STATUS_DLN3_HS_FIFO_UNDERFLOW)
+#define DSI_DIAG_DLN0_ERR (DSI_DLN0_PHY_ERR_DLN0_ERR_ESC | \
+			   DSI_DLN0_PHY_ERR_DLN0_ERR_SYNC_ESC | \
+			   DSI_DLN0_PHY_ERR_DLN0_ERR_CONTROL | \
+			   DSI_DLN0_PHY_ERR_DLN0_ERR_CONTENTION_LP0 | \
+			   DSI_DLN0_PHY_ERR_DLN0_ERR_CONTENTION_LP1)
+
+static int dsi_diag_show(struct seq_file *m, void *unused)
+{
+	struct msm_dsi_host *msm_host = m->private;
+	u32 ack, timeout, dln0, fifo, status0, clk;
+
+	mutex_lock(&msm_host->dev_mutex);
+	if (!msm_host->power_on) {
+		mutex_unlock(&msm_host->dev_mutex);
+		seq_printf(m, "power=0 err_irqs=%u\n",
+			   READ_ONCE(msm_host->diag_err_irqs));
+		return 0;
+	}
+
+	ack = dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS);
+	timeout = dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS);
+	dln0 = dsi_read(msm_host, REG_DSI_DLN0_PHY_ERR);
+	fifo = dsi_read(msm_host, REG_DSI_FIFO_STATUS);
+	status0 = dsi_read(msm_host, REG_DSI_STATUS0);
+	clk = dsi_read(msm_host, REG_DSI_CLK_STATUS);
+	mutex_unlock(&msm_host->dev_mutex);
+
+	seq_printf(m,
+		   "power=1 err_irqs=%u ack_err=0x%08x timeout_err=0x%08x dln0_err=0x%08x fifo_err=0x%08x contention_err=0x%x pll_unlock_err=0x%x fifo=0x%08x status0=0x%08x clk_status=0x%08x\n",
+		   READ_ONCE(msm_host->diag_err_irqs), ack, timeout,
+		   dln0 & DSI_DIAG_DLN0_ERR, fifo & DSI_DIAG_FIFO_ERR,
+		   status0 & DSI_STATUS0_INTERLEAVE_OP_CONTENTION,
+		   clk & DSI_CLK_STATUS_PLL_UNLOCKED, fifo, status0, clk);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(dsi_diag);
+
 static irqreturn_t dsi_host_irq(int irq, void *ptr)
 {
 	struct msm_dsi_host *msm_host = ptr;
@@ -2107,6 +2174,15 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 
 	msm_dsi->id = msm_host->id;
 
+	{
+		char name[32];
+
+		snprintf(name, sizeof(name), "iceland_dsi%d_err", msm_host->id);
+		msm_host->diag_dentry = debugfs_create_file(name, 0400, NULL,
+							    msm_host,
+							    &dsi_diag_fops);
+	}
+
 	DBG("Dsi Host %d initialized", msm_host->id);
 	return 0;
 }
@@ -2116,6 +2192,7 @@ void msm_dsi_host_destroy(struct mipi_dsi_host *host)
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 
 	DBG("");
+	debugfs_remove(msm_host->diag_dentry);
 	if (msm_host->workqueue) {
 		destroy_workqueue(msm_host->workqueue);
 		msm_host->workqueue = NULL;
-- 
2.43.0

