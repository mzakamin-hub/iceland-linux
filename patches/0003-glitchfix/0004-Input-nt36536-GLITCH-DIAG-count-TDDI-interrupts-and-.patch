From 0ce259f886908202c0eeb66af4651932431c5b56 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Tue, 20 Oct 2026 07:49:00 +0300
Subject: [PATCH 2/2] Input: nt36536: GLITCH-DIAG count TDDI interrupts and
 firmware states

Diagnostic for the OnePlus Pad 4 display glitch, not for upstream.

The NT36536 is a TDDI: touch and display in one chip. If the display
glitch comes from the chip, its touch firmware may show it as well:
interrupts without a finger, watchdog (FD / FE) or handshake (77) state
bytes, firmware reloads, failed event reads.

Count these in the interrupt handler (atomics, no extra SPI traffic)
and show them with the last six firmware state bytes in a debugfs file,
iceland_nvt_stat, for a per-second log next to the frame CRCs.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/nt36536/nt36xxx.c | 56 +++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/drivers/input/touchscreen/nt36536/nt36xxx.c b/drivers/input/touchscreen/nt36536/nt36xxx.c
index c5d5406..0b59c81 100644
--- a/drivers/input/touchscreen/nt36536/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36536/nt36xxx.c
@@ -15,6 +15,7 @@
  * more details.
  *
  */
+#include <linux/debugfs.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/interrupt.h>
@@ -23,6 +24,7 @@
 #include <linux/proc_fs.h>
 #include <linux/input/mt.h>
 #include <linux/of_irq.h>
+#include <linux/seq_file.h>
 #include <uapi/linux/sched/types.h>
 #include "nt36xxx.h"
 
@@ -878,6 +880,44 @@ Description:
 return:
 	n.a.
 *******************************************************/
+/*
+ * GLITCH-DIAG (OnePlus Pad 4 display glitch, not for upstream): what the
+ * touch half of the TDDI reports, as counters only - no extra SPI traffic.
+ * irq: interrupts handled; wdt_pat / hs_pat: reads whose firmware state bytes
+ * show the watchdog (FD / FE) or handshake (77) pattern; wdt: firmware
+ * reloads by the WDT recovery; spi_err: failed event reads; last: the six
+ * firmware state bytes of the last interrupt.
+ */
+static struct {
+	atomic_t irq, wdt_pat, hs_pat, wdt, spi_err;
+	u8 last[6];
+	ktime_t last_irq;
+} nvt_diag;
+static struct dentry *nvt_diag_dentry;
+
+static bool nvt_diag_pattern(const u8 *st, u8 a, u8 b)
+{
+	int i;
+
+	for (i = 1; i < 7; i++)
+		if (st[i] != a && st[i] != b)
+			return false;
+	return true;
+}
+
+static int nvt_diag_show(struct seq_file *m, void *unused)
+{
+	ktime_t last = READ_ONCE(nvt_diag.last_irq);
+
+	seq_printf(m, "irq=%d wdt_pat=%d hs_pat=%d wdt=%d spi_err=%d last=%6phN last_irq_ms_ago=%lld\n",
+		   atomic_read(&nvt_diag.irq), atomic_read(&nvt_diag.wdt_pat),
+		   atomic_read(&nvt_diag.hs_pat), atomic_read(&nvt_diag.wdt),
+		   atomic_read(&nvt_diag.spi_err), nvt_diag.last,
+		   last ? ktime_ms_delta(ktime_get(), last) : -1LL);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nvt_diag);
+
 static irqreturn_t nvt_ts_work_func(int irq, void *data)
 {
 	int32_t ret = -1;
@@ -905,6 +945,9 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 
 	mutex_lock(&ts->lock);
 
+	atomic_inc(&nvt_diag.irq);
+	WRITE_ONCE(nvt_diag.last_irq, ktime_get());
+
 	if (ts->dev_pm_suspend) {
 		ret = wait_for_completion_timeout(&ts->dev_pm_suspend_completion, msecs_to_jiffies(500));
 		if (!ret) {
@@ -916,6 +959,7 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 	point_data[0] = 0x00;
 	ret = CTP_SPI_READ(ts->client, point_data, POINT_DATA_LEN + 1);
 	if (ret < 0) {
+		atomic_inc(&nvt_diag.spi_err);
 		NVT_ERR("CTP_SPI_READ failed.(%d)\n", ret);
 		goto XFER_ERROR;
 	}
@@ -923,12 +967,19 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 	fw_state[0] = 0x00;
 	ret = CTP_SPI_READ(ts->client, fw_state, 7);
 	if (ret < 0) {
+		atomic_inc(&nvt_diag.spi_err);
 		NVT_ERR("CTP_SPI_READ failed.(%d)\n", ret);
 		goto XFER_ERROR;
 	}
+	memcpy(nvt_diag.last, &fw_state[1], sizeof(nvt_diag.last));
+	if (nvt_diag_pattern(fw_state, 0xFD, 0xFE))
+		atomic_inc(&nvt_diag.wdt_pat);
+	if (nvt_diag_pattern(fw_state, 0x77, 0x77))
+		atomic_inc(&nvt_diag.hs_pat);
 #if NVT_TOUCH_WDT_RECOVERY
 	/* ESD protect by WDT */
 	if (nvt_wdt_fw_recovery(fw_state)) {
+		atomic_inc(&nvt_diag.wdt);
 		NVT_ERR("Recover for fw reset, %02X\n", fw_state[1]);
 		if (fw_state[1] == 0xFE) {
 			nvt_sw_reset_idle();
@@ -1451,6 +1502,9 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 	bTouchIsAwake = 1;
 	NVT_LOG("end\n");
 
+	nvt_diag_dentry = debugfs_create_file("iceland_nvt_stat", 0400, NULL,
+					      NULL, &nvt_diag_fops);
+
 	nvt_irq_enable(true);
 
 	return 0;
@@ -1519,6 +1573,8 @@ return:
 *******************************************************/
 static void nvt_ts_remove(struct spi_device *client)
 {
+	debugfs_remove(nvt_diag_dentry);
+	nvt_diag_dentry = NULL;
 	NVT_LOG("Removing driver...\n");
 
 	bTouchIsAwake = 0;
-- 
2.43.0

