From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abel Vesa <abel.vesa@oss.qualcomm.com>
Date: Mon, 2 Nov 2026 13:41:17 +0200
Subject: [PATCH] power: supply: qcom_battmgr: Fix pmic_glink client
 use-after-free on unbind

Since commit 4e40befedfc8 ("power: supply: qcom_battmgr: fix
use-after-free"), enable_work is cancelled by a devres action registered
before the pmic_glink client, so that on unbind the client is released
first and can no longer requeue it. But a worker that is pending or
running at that point still goes on to use the released client in
pmic_glink_send().

The power supplies have the same problem: they are registered before
the client too, so they are unregistered only after it is released,
and a property access in between sends a request through the freed
client.

Fix both with a devres action registered right after the client is
allocated, which runs first on unbind. It disables enable_work using
disable_work_sync(), which waits for a running worker and turns any
later queueing from the client callbacks into a no-op, and then marks
the client as gone under the lock that serializes the requests, so the
power supplies fail any later request with -ENODEV instead of using it.

Fixes: 4e40befedfc8 ("power: supply: qcom_battmgr: fix use-after-free")
Fixes: 29e8142b5623 ("power: supply: Introduce Qualcomm PMIC GLINK power supply")
Cc: stable@vger.kernel.org # 6.10
Signed-off-by: Abel Vesa <abel.vesa@oss.qualcomm.com>
Link: https://patch.msgid.link/20261102-battmgr-client-teardown-uaf-v1-1-972fc5a5e0c9@oss.qualcomm.com
Signed-off-by: Sebastian Reichel <sebastian.reichel@collabora.com>
(backported from commit 4f9bf356cbfb8aa6e73b1d05e182445723a4bb49)

[mzak: ported by hand for q92b from the power-supply for-next tree (in
next-20261120); it does not apply to this tree's driver, which carries
the OPLUS charger firmware support. The OPLUS support adds two more works
that the client callbacks queue and that send requests: cid_work (the
attach poll, a delayed work that requeues itself) and plug_work (the
plug check). They had the same devres order as enable_work, so the
action disables all three, enable_work first as its worker modifies
cid_work, and all three are initialised early in probe instead of with
devm_work_autocancel() / devm_delayed_work_autocancel(), which leaves
devm-helpers.h unused here as upstream. The action is registered before
the charge current cooling device, so devres still removes that first.
The request check sits before the in-flight request is armed under
rx_lock.]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 drivers/power/supply/qcom_battmgr.c | 53 ++++++++++++++++++++---------
 1 file changed, 37 insertions(+), 16 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index ad50fd1414967..8ed8917fb0af2 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -6,7 +6,6 @@
  */
 #include <linux/auxiliary_bus.h>
 #include <linux/delay.h>
-#include <linux/devm-helpers.h>
 #include <linux/jiffies.h>
 #include <linux/ktime.h>
 #include <linux/math64.h>
@@ -511,6 +510,9 @@ struct qcom_battmgr {
 	 * firmware, as it then stops responding.
 	 */
 	struct mutex lock;
+
+	/* Set under @lock once @client is about to be released */
+	bool client_gone;
 };
 
 /* the standard property reads echo the property in their reply (the callbacks dispatch on it) */
@@ -534,6 +536,13 @@ static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t
 	unsigned long flags, left;
 	int ret;
 
+	/*
+	 * The power supplies request under @lock; the works, which also
+	 * request, are disabled before client_gone is set.
+	 */
+	if (battmgr->client_gone)
+		return -ENODEV;
+
 	spin_lock_irqsave(&battmgr->rx_lock, flags);
 	reinit_completion(&battmgr->ack);
 	battmgr->error = 0;
@@ -3827,6 +3836,19 @@ static void qcom_battmgr_enable_worker(struct work_struct *work)
 	}
 }
 
+static void qcom_battmgr_release_client(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	disable_work_sync(&battmgr->enable_work);
+	disable_delayed_work_sync(&battmgr->cid_work);
+	disable_work_sync(&battmgr->plug_work);
+
+	mutex_lock(&battmgr->lock);
+	battmgr->client_gone = true;
+	mutex_unlock(&battmgr->lock);
+}
+
 static void qcom_battmgr_pdr_notify(void *priv, int state)
 {
 	struct qcom_battmgr *battmgr = priv;
@@ -3933,6 +3955,9 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	psy_cfg_supply.supplied_to = qcom_battmgr_battery;
 	psy_cfg_supply.num_supplicants = 1;
 
+	INIT_WORK(&battmgr->enable_work, qcom_battmgr_enable_worker);
+	INIT_DELAYED_WORK(&battmgr->cid_work, qcom_battmgr_oplus_cid_work);
+	INIT_WORK(&battmgr->plug_work, qcom_battmgr_oplus_plug_work);
 	mutex_init(&battmgr->lock);
 	spin_lock_init(&battmgr->rx_lock);
 	init_completion(&battmgr->ack);
@@ -4015,21 +4040,6 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		}
 	}
 
-	ret = devm_work_autocancel(dev, &battmgr->enable_work,
-				   qcom_battmgr_enable_worker);
-	if (ret)
-		return ret;
-
-	ret = devm_delayed_work_autocancel(dev, &battmgr->cid_work,
-					   qcom_battmgr_oplus_cid_work);
-	if (ret)
-		return ret;
-
-	ret = devm_work_autocancel(dev, &battmgr->plug_work,
-				   qcom_battmgr_oplus_plug_work);
-	if (ret)
-		return ret;
-
 	if (battmgr->variant == QCOM_BATTMGR_OPLUS) {
 		/* a plug or an unplug wakes the system; user space can turn that off in power/wakeup */
 		ret = devm_device_init_wakeup(dev);
@@ -4044,6 +4054,17 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	if (IS_ERR(battmgr->client))
 		return PTR_ERR(battmgr->client);
 
+	/*
+	 * Registered after the client, so that on unbind it runs before the
+	 * client is released. The client callbacks may fire until then, so
+	 * disable rather than cancel the works to keep them from being
+	 * requeued, and stop the power supplies, which are unregistered only
+	 * after the client is gone, from using it.
+	 */
+	ret = devm_add_action_or_reset(dev, qcom_battmgr_release_client, battmgr);
+	if (ret)
+		return ret;
+
 	/* after the client: devres removes the cooling device first */
 	ret = qcom_battmgr_cool_init(battmgr);
 	if (ret)
-- 
2.43.0

