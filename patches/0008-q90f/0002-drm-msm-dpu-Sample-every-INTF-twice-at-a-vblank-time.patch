From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Thu, 22 Oct 2026 11:38:22 +0300
Subject: [PATCH 2/3] drm/msm/dpu: Sample every INTF twice at a vblank timeout

A vblank / irq timeout on a bonded DSI video mode panel logs one sample
of the timed-out encoder's own INTF. That cannot tell a stuck CTL flush
(the timing engines keep running) from a stopped INTF or DSI host, nor
which half of the panel stalled.

At such a timeout, read the frame and line counters of every INTF of
the virtual encoder, wait about two lines (from the cached mode, 4 to
100 us) and read them again; log per INTF its role (master / slave /
solo), both samples and running / STOPPED / timing engine off.

msm.dpu_intf_diag (0644): 0 = off, 1 = at vblank / irq timeouts
(default), 2 = also at underruns (they are expected at every enable, so
not by default). Error paths only, rate-limited to 4 events per 10 s,
MMIO reads of INTFs whose encoder is enabled plus a short udelay, so it
may run from the underrun interrupt.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c   | 83 +++++++++++++++++++
 .../gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h  |  3 +
 .../drm/msm/disp/dpu1/dpu_encoder_phys_vid.c  |  1 +
 3 files changed, 87 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index fdcd6d48bb97..1a8267f4e72f 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -1537,6 +1537,85 @@ static char *dpu_encoder_helper_get_intf_type(enum dpu_intf_mode intf_mode)
 	}
 }
 
+/*
+ * At a vblank / irq timeout (and, with 2, an underrun) sample the frame and
+ * line counters of every INTF of the encoder twice, about two lines apart.
+ * Counters that move: that timing engine runs (a stuck CTL flush or a late
+ * frame). Counters that stand still: that INTF, or its DSI host, stopped.
+ * With a bonded DSI panel this tells which half stalled. Error paths only,
+ * rate-limited; 0 = off. Read at every event.
+ */
+static unsigned int dpu_intf_diag = 1;
+module_param(dpu_intf_diag, uint, 0644);
+MODULE_PARM_DESC(dpu_intf_diag,
+		 "Two INTF frame / line counter samples per INTF of the encoder: 0 = off, 1 = at vblank / irq timeouts (default), 2 = also at underruns");
+
+/**
+ * dpu_encoder_helper_intf_diag - log two counter samples of each INTF
+ * @phys_enc: the physical encoder that saw the event
+ * @why: the event ("vblank timeout", "irq timeout", "underrun")
+ * @level: the lowest msm.dpu_intf_diag value that logs this event
+ * Callable from the interrupt handler (MMIO reads and a short udelay only).
+ */
+void dpu_encoder_helper_intf_diag(struct dpu_encoder_phys *phys_enc,
+				  const char *why, unsigned int level)
+{
+	static DEFINE_RATELIMIT_STATE(rs, 10 * HZ, 4);
+	struct dpu_hw_intf_status s0[MAX_PHYS_ENCODERS_PER_VIRTUAL] = {};
+	struct dpu_hw_intf_status s1[MAX_PHYS_ENCODERS_PER_VIRTUAL] = {};
+	const struct drm_display_mode *mode;
+	struct dpu_encoder_virt *dpu_enc;
+	unsigned int i, us = 20;
+
+	if (!phys_enc || !phys_enc->parent || READ_ONCE(dpu_intf_diag) < level)
+		return;
+	if (!__ratelimit(&rs))
+		return;
+
+	dpu_enc = to_dpu_encoder_virt(phys_enc->parent);
+	mode = &phys_enc->cached_mode;
+	if (mode->clock > 0 && mode->htotal > 0)
+		us = clamp_t(unsigned int,
+			     DIV_ROUND_UP(2000U * mode->htotal, (unsigned int)mode->clock),
+			     4, 100);
+
+	for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+		struct dpu_hw_intf *intf = dpu_enc->phys_encs[i]->hw_intf;
+
+		if (intf && intf->ops.get_status)
+			intf->ops.get_status(intf, &s0[i]);
+	}
+	udelay(us);
+	for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+		struct dpu_hw_intf *intf = dpu_enc->phys_encs[i]->hw_intf;
+
+		if (intf && intf->ops.get_status)
+			intf->ops.get_status(intf, &s1[i]);
+	}
+
+	for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = dpu_enc->phys_encs[i];
+		struct dpu_hw_intf *intf = phys->hw_intf;
+		const char *state;
+
+		if (!intf || !intf->ops.get_status)
+			continue;
+		if (!s1[i].is_en)
+			state = "timing engine off";
+		else if (s0[i].frame_count != s1[i].frame_count ||
+			 s0[i].line_count != s1[i].line_count)
+			state = "running";
+		else
+			state = "STOPPED";
+		DPU_ERROR("intf diag (%s): intf %d %s: frame %u -> %u, line %u -> %u (%u us): %s\n",
+			  why, intf->idx - INTF_0,
+			  phys->split_role == ENC_ROLE_MASTER ? "master" :
+			  phys->split_role == ENC_ROLE_SLAVE ? "slave" : "solo",
+			  s0[i].frame_count, s1[i].frame_count,
+			  s0[i].line_count, s1[i].line_count, us, state);
+	}
+}
+
 /**
  * dpu_encoder_helper_report_irq_timeout - utility to report error that irq has
  *	timed out, including reporting frame error event to crtc and debug dump
@@ -1553,6 +1632,8 @@ void dpu_encoder_helper_report_irq_timeout(struct dpu_encoder_phys *phys_enc,
 			phys_enc->hw_wb ? phys_enc->hw_wb->idx - WB_0 : -1,
 			phys_enc->hw_pp->idx - PINGPONG_0, intr_idx);
 
+	dpu_encoder_helper_intf_diag(phys_enc, "irq timeout", 1);
+
 	dpu_encoder_frame_done_callback(phys_enc->parent, phys_enc,
 				DPU_ENCODER_FRAME_EVENT_ERROR);
 }
@@ -2631,6 +2712,8 @@ void dpu_encoder_underrun_callback(struct drm_encoder *drm_enc,
 	DPU_ATRACE_BEGIN("encoder_underrun_callback");
 	atomic_inc(&phy_enc->underrun_cnt);
 
+	dpu_encoder_helper_intf_diag(phy_enc, "underrun", 2);
+
 	/* trigger dump only on the first underrun */
 	if (atomic_read(&phy_enc->underrun_cnt) == 1)
 		msm_disp_snapshot_state(drm_enc->dev);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
index 01b026be572b..d19d3f1f77b8 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
@@ -333,6 +333,9 @@ void dpu_encoder_helper_split_config(
 		struct dpu_encoder_phys *phys_enc,
 		enum dpu_intf interface);
 
+void dpu_encoder_helper_intf_diag(struct dpu_encoder_phys *phys_enc,
+				  const char *why, unsigned int level);
+
 void dpu_encoder_helper_report_irq_timeout(struct dpu_encoder_phys *phys_enc,
 		enum dpu_intr_idx intr_idx);
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index 4255b8addd60..961672cde6e8 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -599,6 +599,7 @@ static int dpu_encoder_phys_vid_wait_for_commit_done(
 			  phys_enc->hw_intf ? phys_enc->hw_intf->idx - INTF_0 : -1,
 			  s.is_en, s.frame_count, s.line_count,
 			  READ_ONCE(phys_enc->vblank_refcount));
+		dpu_encoder_helper_intf_diag(phys_enc, "vblank timeout", 1);
 		return -ETIMEDOUT;
 	}
 
