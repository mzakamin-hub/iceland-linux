From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Thu, 22 Oct 2026 11:38:23 +0300
Subject: [PATCH 3/3] drm/msm/a8xx: Do not replay submits on a GPU that was not
 reset

a8xx_recover() resets the GPU by collapsing the CX GDSC; the GX soft
reset is a no-op on A8xx. If the collapse does not happen within 1 s,
it only logs "cx gdsc didn't collapse", runs hw_init and the recover
worker replays every queued submit on a GPU that was never reset. Since
a8xx_progress() always reports progress, each replayed submit that gets
stuck costs another full hangcheck period and another recovery.

When the collapse did not happen, complete the queued submits without
running them: advance each ring's fence to its last assigned fence so
that the recover worker retires them instead of replaying them, and
count a fault on their submit queues so that robust clients (Vulkan
device lost, GL robustness) see a GPU reset. The faulting submit is
already skipped by the recover worker. A recovery with a collapsed CX
GDSC is unchanged.

msm.a8xx_safe_recover (0644, default on); 0 replays as before.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/adreno/a8xx_gpu.c      | 45 +++++++++++++++++++++-
 drivers/gpu/drm/msm/adreno/adreno_device.c |  5 +++
 drivers/gpu/drm/msm/adreno/adreno_gpu.h    |  1 +
 3 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/adreno/a8xx_gpu.c b/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
index 896d55d5cf5c..184836062246 100644
--- a/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a8xx_gpu.c
@@ -898,12 +898,50 @@ static void a8xx_dump(struct msm_gpu *gpu)
 	adreno_dump(gpu);
 }
 
+/*
+ * a8xx_recover() relies on the CX GDSC collapse to reset the GPU: the GX
+ * soft reset is a no-op on A8xx (a6xx_gpu_sw_reset()). When the collapse
+ * did not happen, the GPU was not reset, and replaying the queued submits
+ * feeds them to a GPU in an unknown state; a8xx_progress() cannot tell a
+ * stuck replay from a slow one, so each would cost another full hangcheck.
+ * Complete them without running them and count a fault on their queues,
+ * so robust clients see a GPU reset. Called with gpu->lock held.
+ */
+static void a8xx_drop_queued_submits(struct msm_gpu *gpu)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < gpu->nr_rings; i++) {
+		struct msm_ringbuffer *ring = gpu->rb[i];
+		u32 fence = ring->fctx->last_fence;
+		struct msm_gem_submit *submit;
+		unsigned long flags;
+
+		spin_lock_irqsave(&ring->submit_lock, flags);
+		list_for_each_entry(submit, &ring->submits, node) {
+			if (fence_after(submit->seqno, ring->memptrs->fence)) {
+				submit->queue->faults++;
+				n++;
+			}
+		}
+		spin_unlock_irqrestore(&ring->submit_lock, flags);
+
+		ring->memptrs->fence = fence;
+		msm_update_fence(ring->fctx, fence);
+	}
+
+	DRM_DEV_ERROR(&gpu->pdev->dev,
+		      "GPU not reset (cx gdsc still on): %u queued submit(s) completed as faulted, not replayed\n",
+		      n);
+}
+
 void a8xx_recover(struct msm_gpu *gpu)
 {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
 	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
 	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
 	int active_submits;
+	bool collapsed;
 
 	adreno_dump_info(gpu);
 
@@ -947,7 +985,9 @@ void a8xx_recover(struct msm_gpu *gpu)
 	/* And the final one from recover worker */
 	pm_runtime_put_sync(&gpu->pdev->dev);
 
-	if (!wait_for_completion_timeout(&gmu->pd_gate, msecs_to_jiffies(1000)))
+	collapsed = wait_for_completion_timeout(&gmu->pd_gate,
+						msecs_to_jiffies(1000));
+	if (!collapsed)
 		DRM_DEV_ERROR(&gpu->pdev->dev, "cx gdsc didn't collapse\n");
 
 	dev_pm_genpd_remove_notifier(gmu->cxpd);
@@ -962,6 +1002,9 @@ void a8xx_recover(struct msm_gpu *gpu)
 	gpu->active_submits = active_submits;
 	mutex_unlock(&gpu->active_lock);
 
+	if (!collapsed && READ_ONCE(a8xx_safe_recover))
+		a8xx_drop_queued_submits(gpu);
+
 	msm_gpu_hw_init(gpu);
 	a6xx_gpu->hung = false;
 }
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index 3c3773d5758c..1059bc489e40 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -38,6 +38,11 @@ MODULE_PARM_DESC(a8xx_legacy_protect,
 		 "A840: program the CP protect table used before the SoC's own one (0=SoC table (default), 1=legacy)");
 module_param(a8xx_legacy_protect, bool, 0444);
 
+bool a8xx_safe_recover = true;
+MODULE_PARM_DESC(a8xx_safe_recover,
+		 "A8xx: when the CX GDSC did not collapse at a GPU recovery (no reset), complete the queued submits as faulted instead of replaying them (1=on (default), 0=replay)");
+module_param(a8xx_safe_recover, bool, 0644);
+
 bool enable_clx;
 MODULE_PARM_DESC(enable_clx, "Enable the GPU current limiter (CLX) on GPUs with a CLX table (0=off (default), 1=on)");
 module_param(enable_clx, bool, 0400);
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index 48bc55048a3d..ae4894beea9a 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -22,6 +22,7 @@
 extern bool snapshot_debugbus;
 extern bool enable_clx;
 extern bool a8xx_crashstate;
+extern bool a8xx_safe_recover;
 extern bool a8xx_legacy_protect;
 
 enum {
