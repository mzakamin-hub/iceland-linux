From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 30 Oct 2026 08:19:24 +0200
Subject: [PATCH 06/11] Revert "net: qrtr: announce local services again once
 our HELLO is sent"

This reverts commit 73d520a4bd36 (series 0019-q90r, patch 0007), the
first posting of the patch. Its v3 follows.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 net/qrtr/af_qrtr.c | 22 +---------------------
 1 file changed, 1 insertion(+), 21 deletions(-)

diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
index 600da584a42f..d79bc99ded17 100644
--- a/net/qrtr/af_qrtr.c
+++ b/net/qrtr/af_qrtr.c
@@ -122,7 +122,6 @@ static DEFINE_XARRAY_ALLOC(qrtr_ports);
  * @qrtr_tx_flow: xarray of qrtr_tx_flow, keyed by node << 32 | port
  * @qrtr_tx_lock: lock for qrtr_tx_flow inserts
  * @hello_sent: hello packet send successful
- * @hello_rcvd: remote has sent a hello packet
  * @rx_queue: receive queue
  * @item: list item for broadcast list
  * @say_hello: delayed work for sending hello packet
@@ -137,7 +136,6 @@ struct qrtr_node {
 	struct mutex qrtr_tx_lock; /* for qrtr_tx_flow */
 
 	bool hello_sent;
-	bool hello_rcvd;
 
 	struct sk_buff_head rx_queue;
 	struct list_head item;
@@ -554,11 +552,6 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
 		qrtr_node_assign(node, le32_to_cpu(pkt->server.node));
 	}
 
-	if (cb->type == QRTR_TYPE_HELLO) {
-		/* Pairs with smp_load_acquire() in qrtr_hello_work() */
-		smp_store_release(&node->hello_rcvd, true);
-	}
-
 	if (cb->type == QRTR_TYPE_RESUME_TX) {
 		qrtr_tx_resume(node, skb);
 	} else {
@@ -637,20 +630,7 @@ static void qrtr_hello_work(struct work_struct *work)
 	pkt->cmd = cpu_to_le32(QRTR_TYPE_HELLO);
 	from.sq_node = qrtr_local_nid;
 	to.sq_node = node->nid;
-	if (qrtr_node_enqueue(node, skb, QRTR_TYPE_HELLO, &from, &to))
-		goto out;
-
-	/* Pairs with smp_store_release() in qrtr_endpoint_post() */
-	if (!smp_load_acquire(&node->hello_rcvd))
-		goto out;
-
-	skb = qrtr_alloc_ctrl_packet(&pkt, GFP_KERNEL);
-	if (skb) {
-		pkt->cmd = cpu_to_le32(QRTR_TYPE_HELLO);
-		to.sq_node = READ_ONCE(node->nid);
-		qrtr_local_enqueue(NULL, skb, QRTR_TYPE_HELLO, &to, &from);
-	}
-out:
+	qrtr_node_enqueue(node, skb, QRTR_TYPE_HELLO, &from, &to);
 	qrtr_port_put(ctrl);
 }
 
