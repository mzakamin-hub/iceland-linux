From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 2 Nov 2026 09:19:09 +0200
Subject: [PATCH 23/32] ASoC: qcom: sc8280xp: run the Kaanapali RX codec DMA at
 24 bit

On Kaanapali the back-end fixup forces every codec DMA interface to
16-bit samples. The RX macro then receives nothing from RX_CODEC_DMA_RX_0
and headphone playback through the WCD9395 stays silent. Stock runs this
back end with 24-bit samples (its CODEC_DMA-LPAIF_RXTX-RX-0 device is
24 bit).

Add a per-card flag and let the fixup select S24_LE (24 bits in a 32-bit
word) for RX_CODEC_DMA_RX_0 on the Kaanapali cards. Other boards keep
their 16-bit back end.

The silent 16-bit RX DMA was found and measured by Reixo on another
Kaanapali device (RedMagic 11 Pro); this is a separate implementation of
that finding.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 sound/soc/qcom/sc8280xp.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index a2e5b6ae7e01..a4f2a8a973b6 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -94,6 +94,7 @@ struct qcom_snd_soc_common {
 	bool mi2s_mclk_enable;
 	bool mi2s_bclk_enable;
 	bool wcd_jack;
+	bool rx_codec_dma_s24;
 	const struct sc8280xp_dai_data *dai_data;
 	size_t num_dai_data;
 	int (*snd_init)(struct snd_soc_pcm_runtime *rtd);
@@ -298,6 +299,7 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	struct snd_interval *channels = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 
 	rate->min = rate->max = 48000;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
@@ -310,6 +312,17 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	case TX_CODEC_DMA_TX_3:
 		channels->min = 1;
 		break;
+	case RX_CODEC_DMA_RX_0:
+		/*
+		 * On Kaanapali the RX macro gets no samples from a 16-bit RX
+		 * codec DMA interface: headphone playback stays silent. The
+		 * interface runs 24-bit samples in 32-bit words, as stock does.
+		 */
+		if (data->priv->rx_codec_dma_s24) {
+			snd_mask_none(fmt);
+			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+		}
+		break;
 	case PRIMARY_MI2S_RX:
 		if (!(codec_dai->driver->playback.formats & SNDRV_PCM_FMTBIT_S16_LE)) {
 			snd_mask_none(fmt);
@@ -617,6 +630,7 @@ static struct qcom_snd_soc_common oneplus_iceland_priv_data = {
 	.mi2s_bclk_enable = true,
 	.snd_prepare = oneplus_iceland_snd_prepare,
 	.wcd_jack = true,
+	.rx_codec_dma_s24 = true,
 };
 
 static const struct qcom_snd_soc_common eliza_priv_data = {
@@ -641,6 +655,7 @@ static const struct qcom_snd_soc_common kaanapali_priv_data = {
 	.num_dapm_widgets = ARRAY_SIZE(sc8280xp_dapm_widgets),
 	.mi2s_bclk_enable = true,
 	.wcd_jack = true,
+	.rx_codec_dma_s24 = true,
 };
 
 static const struct qcom_snd_soc_common maili_priv_data = {
