From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 6 Nov 2026 23:30:07 +0200
Subject: [PATCH 21/27] Revert "PM: EM: Rank boost and non-boost frequencies
 separately"

This reverts commit 5d20ada0de13, our carry of v1 of the change. The
reviewed v2 (pw 1200255, "PM: EM: Exclude boost frequencies from
inefficiency ranking", Reviewed-by: Lukasz Luba) replaces it in the next
commit.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/linux/cpufreq.h     | 24 ------------------------
 kernel/power/energy_model.c | 15 ---------------
 2 files changed, 39 deletions(-)

diff --git a/include/linux/cpufreq.h b/include/linux/cpufreq.h
index 5a7590a5f..2b34a9ff7 100644
--- a/include/linux/cpufreq.h
+++ b/include/linux/cpufreq.h
@@ -1157,24 +1157,6 @@ cpufreq_table_set_inefficient(struct cpufreq_policy *policy,
 	return -EINVAL;
 }
 
-static inline unsigned int
-cpufreq_table_max_nonboost_freq(struct cpufreq_policy *policy)
-{
-	struct cpufreq_frequency_table *pos;
-	unsigned int max = 0;
-
-	if (!policy->freq_table)
-		return 0;
-
-	/* The table may be unsorted, scan all of it for the highest one. */
-	cpufreq_for_each_valid_entry(pos, policy->freq_table) {
-		if (!(pos->flags & CPUFREQ_BOOST_FREQ) && pos->frequency > max)
-			max = pos->frequency;
-	}
-
-	return max;
-}
-
 static inline int parse_perf_domain(int cpu, const char *list_name,
 				    const char *cell_name,
 				    struct of_phandle_args *args)
@@ -1239,12 +1221,6 @@ cpufreq_table_set_inefficient(struct cpufreq_policy *policy,
 	return -EINVAL;
 }
 
-static inline unsigned int
-cpufreq_table_max_nonboost_freq(struct cpufreq_policy *policy)
-{
-	return 0;
-}
-
 static inline int of_perf_domain_get_sharing_cpumask(int pcpu, const char *list_name,
 						     const char *cell_name, struct cpumask *cpumask,
 						     struct of_phandle_args *pargs)
diff --git a/kernel/power/energy_model.c b/kernel/power/energy_model.c
index 253c53ca6..d19a65461 100644
--- a/kernel/power/energy_model.c
+++ b/kernel/power/energy_model.c
@@ -255,30 +255,15 @@ static int em_compute_costs(struct device *dev, struct em_perf_state *table,
 			    unsigned long flags)
 {
 	unsigned long prev_cost = ULONG_MAX;
-	struct cpufreq_policy *policy;
-	unsigned int max_nonboost = 0;
-	bool prev_boost = false;
 	int i, ret;
 
 	/* This is needed only for CPUs and EAS skip other devices */
 	if (!_is_cpu_device(dev))
 		return 0;
 
-	policy = cpufreq_cpu_get(dev->id);
-	if (policy) {
-		max_nonboost = cpufreq_table_max_nonboost_freq(policy);
-		cpufreq_cpu_put(policy);
-	}
-
 	/* Compute the cost of each performance state. */
 	for (i = nr_states - 1; i >= 0; i--) {
 		unsigned long power_res, cost;
-		bool boost = table[i].frequency > max_nonboost;
-
-		if (boost != prev_boost) {
-			prev_boost = boost;
-			prev_cost = ULONG_MAX;
-		}
 
 		if ((flags & EM_PERF_DOMAIN_ARTIFICIAL) && cb->get_cost) {
 			ret = cb->get_cost(dev, table[i].frequency, &cost);
-- 
2.43.0

