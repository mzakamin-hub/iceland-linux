+				show_priv->state = gpu->funcs->gpu_state_get(gpu);
+			pm_runtime_put_sync(&gpu->pdev->dev);
+		}
+	}
 
 	mutex_unlock(&gpu->lock);
 
+	if (ret < 0)
+		goto free_priv;
+
 	if (IS_ERR(show_priv->state)) {
 		ret = PTR_ERR(show_priv->state);
 		goto free_priv;
diff --git a/drivers/gpu/drm/msm/msm_gem.c b/drivers/gpu/drm/msm/msm_gem.c
index 130ae27ee00be..68599dbbe4fe4 100644
--- a/drivers/gpu/drm/msm/msm_gem.c
+++ b/drivers/gpu/drm/msm/msm_gem.c
@@ -54,8 +54,10 @@ static void put_iova_spaces(struct drm_gem_object *obj, struct drm_gpuvm *vm,
 
 static void msm_gem_close(struct drm_gem_object *obj, struct drm_file *file)
 {
+	struct msm_drm_private *priv = obj->dev->dev_private;
 	struct msm_context *ctx = file->driver_priv;
 	struct drm_exec exec;
+	long ret;
 
 	update_ctx_mem(file, -obj->size);
 	msm_gem_vma_put(obj);
@@ -76,12 +78,33 @@ static void msm_gem_close(struct drm_gem_object *obj, struct drm_file *file)
 	if (msm_context_is_vmbind(ctx))
 		return;
 
-	/*
-	 * TODO we might need to kick this to a queue to avoid blocking
-	 * in CLOSE ioctl
-	 */
-	dma_resv_wait_timeout(obj->resv, DMA_RESV_USAGE_BOOKKEEP, false,
-			      MAX_SCHEDULE_TIMEOUT);
+	if (!msm_wedge_failed_recovery) {
+		/*
+		 * TODO we might need to kick this to a queue to avoid blocking
+		 * in CLOSE ioctl
+		 */
+		dma_resv_wait_timeout(obj->resv, DMA_RESV_USAGE_BOOKKEEP, false,
+				      MAX_SCHEDULE_TIMEOUT);
+	} else {
+		/*
+		 * A failed recovery may be unable to stop DMA: it keeps the
+		 * pending fences and BO references, but close must still let
+		 * the process exit. Leave the mappings to
+		 * msm_gem_free_object() rather than unmapping memory the GPU
+		 * might still access; the same holds when a signal interrupts
+		 * the wait (submits hold the BO and VM). The terminal state is
+		 * rechecked once a second; that is not a deadline.
+		 */
+		while (!dma_resv_test_signaled(obj->resv, DMA_RESV_USAGE_BOOKKEEP)) {
+			if (READ_ONCE(priv->gpu->wedged))
+				return;
+			ret = dma_resv_wait_timeout(obj->resv,
+						    DMA_RESV_USAGE_BOOKKEEP,
+						    true, HZ);
+			if (ret < 0)
+				return;
+		}
+	}
 
 	msm_gem_lock_vm_and_obj(&exec, obj, ctx->vm);
 	put_iova_spaces(obj, ctx->vm, true, "close");
diff --git a/drivers/gpu/drm/msm/msm_gem_submit.c b/drivers/gpu/drm/msm/msm_gem_submit.c
