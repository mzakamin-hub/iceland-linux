@@ -84,13 +84,26 @@ static int msm_gpu_open(struct inode *inode, struct file *file)
 	if (ret)
 		goto free_priv;
 
-	pm_runtime_get_sync(&gpu->pdev->dev);
-	msm_gpu_hw_init(gpu);
