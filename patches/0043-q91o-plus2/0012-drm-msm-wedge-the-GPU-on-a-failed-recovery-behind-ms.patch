diff --git a/drivers/gpu/drm/msm/msm_gpu.c b/drivers/gpu/drm/msm/msm_gpu.c
index 34ef145fb8e30..ed0a45168062d 100644
--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -166,12 +166,28 @@ void msm_gpu_show_fdinfo(struct msm_gpu *gpu, struct msm_context *ctx,
 	drm_printf(p, "drm-maxfreq-gpu:\t%u Hz\n", gpu->fast_rate);
 }
 
+/*
+ * A GPU whose recovery fails is wedged for good: new submits are refused, the
+ * hangcheck stops, queued jobs end with -EIO without touching the hardware,
+ * and the pending hardware fences are completed only after a confirmed CX
+ * collapse (otherwise they and their buffers are kept, as DMA may still run).
+ * Off (default): the queued submits are completed as faulted when the
+ * hardware init after ->recover() fails, as before.
+ */
+bool msm_wedge_failed_recovery;
+module_param_named(wedge_failed_recovery, msm_wedge_failed_recovery, bool, 0400);
+MODULE_PARM_DESC(wedge_failed_recovery,
+		 "Wedge the GPU when its recovery fails and keep unfinished fences until CX collapsed (default off)");
+
 int msm_gpu_hw_init(struct msm_gpu *gpu)
 {
 	int ret;
 
 	WARN_ON(!mutex_is_locked(&gpu->lock));
 
+	if (gpu->wedged)
+		return -EIO;
+
 	if (!gpu->needs_hw_init)
 		return 0;
 
@@ -460,6 +476,54 @@ find_submit(struct msm_ringbuffer *ring, uint32_t fence)
 
 static void retire_submits(struct msm_gpu *gpu);
 
+/* Only call after the GPU can no longer access the submitted buffers. */
+static void msm_gpu_fail_submits(struct msm_gpu *gpu)
+{
+	int i;
+
+	lockdep_assert_held(&gpu->lock);
+
+	for (i = 0; i < gpu->nr_rings; i++) {
+		struct msm_ringbuffer *ring = gpu->rb[i];
+		struct msm_gem_submit *submit;
+		unsigned long flags;
+
+		spin_lock_irqsave(&ring->submit_lock, flags);
+		list_for_each_entry(submit, &ring->submits, node) {
+			struct dma_fence *fence = submit->hw_fence;
+
+			spin_lock(dma_fence_spinlock(fence));
+			if (!dma_fence_is_signaled_locked(fence)) {
+				dma_fence_set_error(fence, -EIO);
+				dma_fence_signal_locked(fence);
+			}
+			spin_unlock(dma_fence_spinlock(fence));
+		}
+		spin_unlock_irqrestore(&ring->submit_lock, flags);
+
+		ring->memptrs->fence = ring->fctx->last_fence;
+		msm_update_fence(ring->fctx, ring->fctx->last_fence);
+	}
+}
+
+/* msm.wedge_failed_recovery only: the only place that sets gpu->wedged */
+void msm_gpu_recovery_failed(struct msm_gpu *gpu, int error, bool quiesced)
+{
+	int i;
+
+	lockdep_assert_held(&gpu->lock);
+
+	WRITE_ONCE(gpu->wedged, true);
+	for (i = 0; i < gpu->nr_rings; i++)
+		timer_delete_sync(&gpu->rb[i]->hangcheck_timer);
+	DRM_DEV_ERROR(&gpu->pdev->dev, "GPU recovery failed: %d; device wedged\n", error);
+	if (quiesced)
+		msm_gpu_fail_submits(gpu);
+	else
+		DRM_DEV_ERROR(&gpu->pdev->dev,
+			      "GPU not quiescent; retaining pending fences and buffers\n");
+}
+
 static void get_comm_cmdline(struct msm_gem_submit *submit, char **comm, char **cmd)
 {
 	struct msm_context *ctx = submit->queue->ctx;
@@ -534,11 +598,14 @@ static void recover_worker(struct kthread_work *work)
 	char *comm = NULL, *cmd = NULL;
 	unsigned int noreclaim_flag;
 	struct task_struct *task;
-	int i;
+	int i, ret = 0;
 
 	mutex_lock(&gpu->lock);
 	WRITE_ONCE(gpu->recovery_in_progress, true);
 
+	if (gpu->wedged)
+		goto out_unlock;
+
 	DRM_DEV_ERROR(dev->dev, "%s: hangcheck recover!\n", gpu->name);
 
 	submit = find_submit(cur_ring, cur_ring->memptrs->fence + 1);
@@ -590,14 +657,37 @@ static void recover_worker(struct kthread_work *work)
 	}
 
 	/* Record the crash state */
-	pm_runtime_get_sync(&gpu->pdev->dev);
-	msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
+	if (msm_wedge_failed_recovery) {
+		ret = pm_runtime_get_sync(&gpu->pdev->dev);
+		if (ret >= 0)
+			msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
+	} else {
+		pm_runtime_get_sync(&gpu->pdev->dev);
+		msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
+	}
 
 	memalloc_noreclaim_restore(noreclaim_flag);
 
 	kfree(cmd);
 	kfree(comm);
 
+	/*
+	 * msm.wedge_failed_recovery: recover first and advance the fences
+	 * only after recovery has stopped the old commands (fence waiters can
+	 * release BOs before retire_submits() runs); a failed recovery wedges
+	 * the GPU and replays nothing.
+	 */
+	if (msm_wedge_failed_recovery) {
+		if (ret < 0) {
+			msm_gpu_recovery_failed(gpu, ret, false);
+			goto out_pm;
+		}
+		priv->disable_err_irq = false;
+		gpu->funcs->recover(gpu);
+		if (gpu->wedged)
+			goto out_pm;
+	}
+
 	/*
 	 * Update all the rings with the latest and greatest fence.. this
 	 * needs to happen after msm_rd_dump_submit() to ensure that the
@@ -618,13 +708,15 @@ static void recover_worker(struct kthread_work *work)
 		msm_update_fence(ring->fctx, fence);
 	}
 
-	priv->disable_err_irq = false;
+	if (!msm_wedge_failed_recovery) {
+		priv->disable_err_irq = false;
 
-	gpu->funcs->recover(gpu);
+		gpu->funcs->recover(gpu);
 
-	/* ->recover() ends with a hardware init: did the GPU come back? */
-	if (gpu->needs_hw_init)
-		fail_queued_submits(gpu);
+		/* ->recover() ends with a hardware init: did the GPU come back? */
+		if (gpu->needs_hw_init)
+			fail_queued_submits(gpu);
+	}
 
 	/* retire completed submits, plus the one that hung: */
 	retire_submits(gpu);
@@ -650,6 +742,7 @@ static void recover_worker(struct kthread_work *work)
 		spin_unlock_irqrestore(&ring->submit_lock, flags);
 	}
 
+out_pm:
 	pm_runtime_put(&gpu->pdev->dev);
 
 out_unlock:
@@ -662,12 +755,17 @@ static void recover_worker(struct kthread_work *work)
 void msm_gpu_fault_crashstate_capture(struct msm_gpu *gpu, struct msm_gpu_fault_info *fault_info)
 {
 	struct msm_gem_submit *submit;
-	struct msm_ringbuffer *cur_ring = gpu->funcs->active_ring(gpu);
+	struct msm_ringbuffer *cur_ring;
 	char *comm = NULL, *cmd = NULL;
 	unsigned int noreclaim_flag;
 
 	mutex_lock(&gpu->lock);
 
+	if (gpu->wedged)
+		goto resume_smmu;
+
+	cur_ring = gpu->funcs->active_ring(gpu);
+
 	submit = find_submit(cur_ring, cur_ring->memptrs->fence + 1);
 	if (submit && submit->fault_dumped)
 		goto resume_smmu;
@@ -685,9 +783,14 @@ void msm_gpu_fault_crashstate_capture(struct msm_gpu *gpu, struct msm_gpu_fault_
 	}
 
 	/* Record the crash state */
-	pm_runtime_get_sync(&gpu->pdev->dev);
-	msm_gpu_crashstate_capture(gpu, submit, fault_info, comm, cmd);
-	pm_runtime_put_sync(&gpu->pdev->dev);
