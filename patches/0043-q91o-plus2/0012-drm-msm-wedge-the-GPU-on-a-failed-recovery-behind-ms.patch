+++ b/drivers/gpu/drm/msm/msm_gem_submit.c
@@ -632,6 +632,9 @@ int msm_ioctl_gem_submit(struct drm_device *dev, void *data,
 	if (!gpu)
 		return -ENXIO;
 
+	if (READ_ONCE(gpu->wedged))
