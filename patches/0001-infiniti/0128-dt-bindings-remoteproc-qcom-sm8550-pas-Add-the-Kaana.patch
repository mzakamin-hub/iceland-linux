From f6f34b9f28de893344c3bf86de1902a7f25e45fe Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Fri, 25 Sep 2026 02:45:00 -0700
Subject: [PATCH] dt-bindings: remoteproc: qcom,sm8550-pas: Add the Kaanapali
 modem

It is compatible with SM8750.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 .../bindings/remoteproc/qcom,sm8550-pas.yaml  | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
index c58e8a6c7f..87320d87ea 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
@@ -47,6 +47,9 @@ properties:
       - items:
           - const: qcom,sm8750-cdsp-pas
           - const: qcom,sm8650-cdsp-pas
+      - items:
+          - const: qcom,kaanapali-mpss-pas
+          - const: qcom,sm8750-mpss-pas
 
   reg:
     maxItems: 1
@@ -219,8 +222,9 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sm8750-mpss-pas
+          contains:
+            enum:
+              - qcom,sm8750-mpss-pas
     then:
       properties:
         interrupts:
@@ -253,11 +257,12 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - qcom,sdx75-mpss-pas
-            - qcom,sm8550-mpss-pas
-            - qcom,sm8650-mpss-pas
-            - qcom,sm8750-mpss-pas
+          contains:
+            enum:
+              - qcom,sdx75-mpss-pas
+              - qcom,sm8550-mpss-pas
+              - qcom,sm8650-mpss-pas
+              - qcom,sm8750-mpss-pas
     then:
       properties:
         power-domains:
-- 
2.43.0

