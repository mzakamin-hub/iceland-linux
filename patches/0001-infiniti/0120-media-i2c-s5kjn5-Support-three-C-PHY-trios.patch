+	.hts		= 5800,
+	.vts_min	= 5296,
+	.exposure_margin = 12,
+	.regs		= s5kjn5_4096x3072_regs,
+	.num_regs	= ARRAY_SIZE(s5kjn5_4096x3072_regs),
+};
+
+/* 2x2 binned 16:9, 60 fps */
+static const struct s5kjn5_mode s5kjn5_cphy_mode = {
+	.width		= 4096,
+	.height		= 2304,
+	.hts		= 7108,
+	.vts_min	= 3204,
