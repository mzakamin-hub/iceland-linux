From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Thu, 24 Sep 2026 13:06:07 -0700
Subject: [PATCH] media: i2c: s5kjn5: Support three C-PHY trios

As used by the OnePlus 15, with a 4096x2304 60 fps mode.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 drivers/media/i2c/s5kjn5.c | 1940 ++++++++++++++++++++++++++++++++----
 1 file changed, 1720 insertions(+), 220 deletions(-)

diff --git a/drivers/media/i2c/s5kjn5.c b/drivers/media/i2c/s5kjn5.c
index edf824228bb6..7a82013e0d63 100644
--- a/drivers/media/i2c/s5kjn5.c
+++ b/drivers/media/i2c/s5kjn5.c
@@ -52,24 +52,12 @@
 
 #define S5KJN5_XVCLK_RATE	19200000
 
-#define S5KJN5_DATA_LANES	4
 #define S5KJN5_RGB_DEPTH	10
 
 /* Full 50.3 Mpx active pixel array */
 #define S5KJN5_NATIVE_WIDTH	8192
 #define S5KJN5_NATIVE_HEIGHT	6144
 
-static const s64 s5kjn5_link_freqs[] = {
-	1248000000LL,
-};
-
-static u64 s5kjn5_to_pixel_rate(u32 f_index)
-{
-	u64 pixel_rate = s5kjn5_link_freqs[f_index] * 2 * S5KJN5_DATA_LANES;
-
-	return div_u64(pixel_rate, S5KJN5_RGB_DEPTH);
-}
-
 static const char * const s5kjn5_supply_names[] = {
 	"vddio",
 	"vddd",
@@ -2207,215 +2195,1726 @@ static const struct cci_reg_sequence s5kjn5_4096x3072_regs[] = {
 	{ CCI_REG16(0x0e00), 0x0003 },
 };
 
-static const struct s5kjn5_mode s5kjn5_modes[] = {
-	{
-		.width		= 4096,
-		.height		= 3072,
-		.hts		= 5800,
-		.vts_min	= 5296,
-		.exposure_margin = 12,
-		.regs		= s5kjn5_4096x3072_regs,
-		.num_regs	= ARRAY_SIZE(s5kjn5_4096x3072_regs),
-	},
+static const u8 s5kjn5_cphy_data_6200[] = {
+	0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
 };
 
-struct s5kjn5 {
-	struct v4l2_subdev	sd;
-	struct media_pad	pad;
-	struct regmap		*regmap;
-	struct clk		*inclk;
-	struct gpio_desc	*reset_gpio;
-	struct regulator_bulk_data supplies[ARRAY_SIZE(s5kjn5_supply_names)];
-	struct v4l2_ctrl_handler ctrl_handler;
-	struct v4l2_ctrl	*link_freq;
-	struct v4l2_ctrl	*hblank;
-	struct v4l2_ctrl	*exposure;
+static const u8 s5kjn5_cphy_data_0100[] = {
+	0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
 };
 
-static inline struct s5kjn5 *sd_to_s5kjn5(struct v4l2_subdev *sd)
-{
-	return container_of(sd, struct s5kjn5, sd);
-}
-
-static int s5kjn5_write_ops(struct s5kjn5 *s5kjn5,
-			    const struct s5kjn5_init_op *ops, size_t num_ops)
-{
-	const struct s5kjn5_init_op *op;
-	int ret = 0;
-
-	for (op = ops; op < ops + num_ops; op++) {
-		if (op->burst)
-			ret = regmap_bulk_write(s5kjn5->regmap, op->burst_addr,
-						op->burst, op->burst_len);
-		else if (op->reg)
-			ret = cci_write(s5kjn5->regmap, op->reg, op->val, NULL);
-		if (ret)
-			return ret;
-	}
-
-	return 0;
-}
-
-static int s5kjn5_write_init(struct s5kjn5 *s5kjn5)
-{
-	int ret;
-
-	ret = s5kjn5_write_ops(s5kjn5, s5kjn5_init_ops_1,
-			       ARRAY_SIZE(s5kjn5_init_ops_1));
-	if (ret)
-		return ret;
-
-	/* Settling delay mandated by the vendor initialisation sequence. */
-	fsleep(5000);
-
-	return s5kjn5_write_ops(s5kjn5, s5kjn5_init_ops_2,
-				ARRAY_SIZE(s5kjn5_init_ops_2));
-}
-
-static int s5kjn5_power_on(struct device *dev)
-{
-	struct v4l2_subdev *sd = dev_get_drvdata(dev);
-	struct s5kjn5 *s5kjn5 = sd_to_s5kjn5(sd);
-	int ret;
-
-	ret = regulator_bulk_enable(ARRAY_SIZE(s5kjn5_supply_names),
-				    s5kjn5->supplies);
-	if (ret) {
-		dev_err(dev, "failed to enable regulators: %d\n", ret);
-		return ret;
-	}
-
-	gpiod_set_value_cansleep(s5kjn5->reset_gpio, 0);
-	usleep_range(8000, 10000);
-
-	ret = clk_prepare_enable(s5kjn5->inclk);
-	if (ret) {
-		dev_err(dev, "failed to enable clock: %d\n", ret);
-		gpiod_set_value_cansleep(s5kjn5->reset_gpio, 1);
-		regulator_bulk_disable(ARRAY_SIZE(s5kjn5_supply_names),
-				       s5kjn5->supplies);
-		return ret;
-	}
-
-	usleep_range(10000, 12000);
-
-	return 0;
-}
-
-static int s5kjn5_power_off(struct device *dev)
-{
-	struct v4l2_subdev *sd = dev_get_drvdata(dev);
-	struct s5kjn5 *s5kjn5 = sd_to_s5kjn5(sd);
-
-	clk_disable_unprepare(s5kjn5->inclk);
-	gpiod_set_value_cansleep(s5kjn5->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(s5kjn5_supply_names),
-			       s5kjn5->supplies);
-
-	return 0;
-}
