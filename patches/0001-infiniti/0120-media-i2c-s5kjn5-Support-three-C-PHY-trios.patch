+	.num_regs	= ARRAY_SIZE(s5kjn5_cphy_4096x2304_regs),
+};
+
+/*
+ * The sensor setup depends on the CSI-2 link: the vendor settings for a
+ * four-lane D-PHY link come from the Qualcomm reference design, those for a
+ * three-trio C-PHY link from the OnePlus 15.
+ */
+struct s5kjn5_link {
+	enum v4l2_mbus_type bus_type;
+	unsigned int num_lanes;
+	s64 link_freq;
+	u32 code;
+	const struct s5kjn5_init_op *init_ops;
+	size_t num_init_ops;
+	const struct s5kjn5_mode *mode;
+};
+
+static const struct s5kjn5_link s5kjn5_links[] = {
+	{
+		.bus_type	= V4L2_MBUS_CSI2_DPHY,
+		.num_lanes	= 4,
+		.link_freq	= 1248000000,
+		.code		= MEDIA_BUS_FMT_SGBRG10_1X10,
+		.init_ops	= s5kjn5_init_ops_2,
+		.num_init_ops	= ARRAY_SIZE(s5kjn5_init_ops_2),
+		.mode		= &s5kjn5_dphy_mode,
+	}, {
+		.bus_type	= V4L2_MBUS_CSI2_CPHY,
+		.num_lanes	= 3,
+		.link_freq	= 998400000,
+		.code		= MEDIA_BUS_FMT_SBGGR10_1X10,
+		.init_ops	= s5kjn5_cphy_init_ops,
+		.num_init_ops	= ARRAY_SIZE(s5kjn5_cphy_init_ops),
+		.mode		= &s5kjn5_cphy_mode,
+	},
+};
+
+/*
+ * A D-PHY lane carries 2 bits per link clock cycle, a C-PHY trio 16 bits per
+ * 7 symbols at 2 symbols per link clock cycle.
+ */
+static u64 s5kjn5_pixel_rate(const struct s5kjn5_link *link)
+{
+	u64 rate = link->link_freq * 2 * link->num_lanes;
+
+	if (link->bus_type == V4L2_MBUS_CSI2_CPHY)
+		rate = div_u64(rate * 16, 7);
+
+	return div_u64(rate, S5KJN5_RGB_DEPTH);
+}
+
+struct s5kjn5 {
+	struct v4l2_subdev	sd;
+	struct media_pad	pad;
+	struct regmap		*regmap;
+	struct clk		*inclk;
+	struct gpio_desc	*reset_gpio;
+	const struct s5kjn5_link *link;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5kjn5_supply_names)];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl	*link_freq;
+	struct v4l2_ctrl	*hblank;
+	struct v4l2_ctrl	*exposure;
+};
+
+static inline struct s5kjn5 *sd_to_s5kjn5(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5kjn5, sd);
+}
+
+static int s5kjn5_write_ops(struct s5kjn5 *s5kjn5,
+			    const struct s5kjn5_init_op *ops, size_t num_ops)
+{
+	const struct s5kjn5_init_op *op;
+	int ret = 0;
+
+	for (op = ops; op < ops + num_ops; op++) {
+		if (op->burst)
+			ret = regmap_bulk_write(s5kjn5->regmap, op->burst_addr,
+						op->burst, op->burst_len);
+		else if (op->reg)
+			ret = cci_write(s5kjn5->regmap, op->reg, op->val, NULL);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int s5kjn5_write_init(struct s5kjn5 *s5kjn5)
+{
+	int ret;
+
+	ret = s5kjn5_write_ops(s5kjn5, s5kjn5_init_ops_1,
+			       ARRAY_SIZE(s5kjn5_init_ops_1));
+	if (ret)
+		return ret;
+
+	/* Settling delay mandated by the vendor initialisation sequence. */
+	fsleep(5000);
+
+	return s5kjn5_write_ops(s5kjn5, s5kjn5->link->init_ops,
+				s5kjn5->link->num_init_ops);
+}
+
+static int s5kjn5_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kjn5 *s5kjn5 = sd_to_s5kjn5(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5kjn5_supply_names),
+				    s5kjn5->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(s5kjn5->reset_gpio, 0);
+	usleep_range(8000, 10000);
+
+	ret = clk_prepare_enable(s5kjn5->inclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		gpiod_set_value_cansleep(s5kjn5->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s5kjn5_supply_names),
+				       s5kjn5->supplies);
+		return ret;
+	}
+
+	usleep_range(10000, 12000);
+
+	return 0;
+}
+
+static int s5kjn5_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5kjn5 *s5kjn5 = sd_to_s5kjn5(sd);
+
+	clk_disable_unprepare(s5kjn5->inclk);
+	gpiod_set_value_cansleep(s5kjn5->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s5kjn5_supply_names),
+			       s5kjn5->supplies);
+
+	return 0;
+}
+
+static int s5kjn5_check_id(struct s5kjn5 *s5kjn5)
+{
+	struct device *dev = s5kjn5->sd.dev;
+	u64 chip_id;
+	int ret;
+
+	ret = cci_read(s5kjn5->regmap, S5KJN5_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip ID\n");
+
+	if (chip_id != S5KJN5_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected chip ID 0x%04llx, expected 0x%04x\n",
+				     chip_id, S5KJN5_CHIP_ID);
+
+	return 0;
+}
+
+static int s5kjn5_check_hwcfg(struct s5kjn5 *s5kjn5, struct device *dev)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_UNKNOWN,
+	};
+	const struct s5kjn5_link *link = NULL;
+	unsigned long freq_bitmap;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return dev_err_probe(dev, -EINVAL, "no endpoint found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5kjn5_links); i++) {
+		if (s5kjn5_links[i].bus_type == bus_cfg.bus_type &&
+		    s5kjn5_links[i].num_lanes ==
+		    bus_cfg.bus.mipi_csi2.num_data_lanes)
+			link = &s5kjn5_links[i];
+	}
+
+	if (!link) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "unsupported bus type %u with %u lanes\n",
+				    bus_cfg.bus_type,
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       &link->link_freq, 1, &freq_bitmap);
+	if (!ret)
+		s5kjn5->link = link;
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5kjn5_init(struct s5kjn5 *s5kjn5,
+		       const struct s5kjn5_mode *mode)
+{
+	int ret;
+
+	ret = s5kjn5_write_init(s5kjn5);
+	if (ret)
+		return ret;
+
+	return cci_multi_reg_write(s5kjn5->regmap, mode->regs,
+				   mode->num_regs, NULL);
+}
