From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Thu, 24 Sep 2026 02:44:18 -0700
Subject: [PATCH] media: iris: Only allow hierarchical B-frames on kaanapali

The kaanapali firmware crashes when HFI_PROP_MAX_B_FRAMES is set without
hierarchical-B coding, so cap V4L2_CID_MPEG_VIDEO_B_FRAMES at 0.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 drivers/media/platform/qcom/iris/iris_ctrls.c           | 4 ++++
 drivers/media/platform/qcom/iris/iris_platform_common.h | 1 +
 drivers/media/platform/qcom/iris/iris_platform_vpu3x.c  | 1 +
 3 files changed, 6 insertions(+)

diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 4f2633bbb49f..d87fe8bab35b 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -477,6 +477,10 @@ void iris_session_init_caps(struct iris_core *core)
 		core->inst_fw_caps_enc[cap_id].flags = caps[i].flags;
 		core->inst_fw_caps_enc[cap_id].hfi_id = caps[i].hfi_id;
 		core->inst_fw_caps_enc[cap_id].set = caps[i].set;
+
+		if (cap_id == B_FRAME &&
+		    core->iris_platform_data->hier_b_frames_only)
+			core->inst_fw_caps_enc[cap_id].max = 0;
 	}
 }
 
diff --git a/drivers/media/platform/qcom/iris/iris_platform_common.h b/drivers/media/platform/qcom/iris/iris_platform_common.h
index d99ea180d79e..4751e47505e7 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -351,6 +351,7 @@ struct iris_platform_data {
 	bool no_rpmh;
 	u32 wd_intr_mask;
 	u32 icc_ib_multiplier;
+	bool hier_b_frames_only;
 	u32 max_session_count;
 	/* max number of macroblocks per frame supported */
 	u32 max_core_mbpf;
diff --git a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
index 016ce234d7ba..947b79ed4ae2 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
@@ -258,6 +258,7 @@ const struct iris_platform_data kaanapali_data = {
 	.tz_cp_config_data = tz_cp_config_kaanapali,
 	.tz_cp_config_data_size = ARRAY_SIZE(tz_cp_config_kaanapali),
 	.num_vpp_pipe = 2,
+	.hier_b_frames_only = true,
 	.max_session_count = 16,
 	.max_core_mbpf = NUM_MBS_8K * 2,
 	.max_core_mbps = ((8192 * 4352) / 256) * 60,
