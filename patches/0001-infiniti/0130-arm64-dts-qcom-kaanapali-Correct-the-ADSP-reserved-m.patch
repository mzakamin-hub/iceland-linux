From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Wed, 29 Jul 2026 17:57:13 -0700
Subject: [PATCH] arm64: dts: qcom: kaanapali: Correct the ADSP reserved memory
 size

The signed ADSP image spans 0x5000000 bytes.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 arch/arm64/boot/dts/qcom/kaanapali.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index fc897698e86a..4ff1f5ce3240 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -441,7 +441,7 @@ q6_adsp_dtb_mem: q6-adsp-dtb@a1380000 {
 		};
 
 		adspslpi_mem: adspslpi@a1400000 {
-			reg = <0x0 0xa1400000 0x0 0x4c00000>;
+			reg = <0x0 0xa1400000 0x0 0x5000000>;
 			no-map;
 		};
 
-- 
2.43.0

