From ad8fc6e2b34c464d2b18eb3e88da9f2ea11c7754 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Thu, 24 Sep 2026 15:51:24 -0700
Subject: [PATCH] dt-bindings: media: i2c: samsung,s5kjn5: Allow three C-PHY
 trios

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 .../bindings/media/i2c/samsung,s5kjn5.yaml           | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5kjn5.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5kjn5.yaml
index fedb274679..abfacfe9df 100644
--- a/Documentation/devicetree/bindings/media/i2c/samsung,s5kjn5.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5kjn5.yaml
@@ -9,8 +9,8 @@ title: Samsung S5KJN5 Image Sensor
 description:
   Samsung S5KJN5 is a 50MP 10-bit RAW MIPI CSI-2 image sensor.
   The sensor is controlled over I2C. The full resolution pixel array is
-  8192x6144, data output format is RAW10 transferred over 4-lane MIPI
-  D-PHY interface.
+  8192x6144, data output format is RAW10 transferred over a 4-lane MIPI
+  D-PHY or a 3-trio MIPI C-PHY interface.
 
 maintainers:
   - Wenmeng Liu <wenmeng.liu@oss.qualcomm.com>
@@ -65,7 +65,15 @@ properties:
         unevaluatedProperties: false
 
         properties:
+          bus-type:
+            enum:
+              - 1 # MIPI CSI-2 C-PHY
+              - 4 # MIPI CSI-2 D-PHY
+            default: 4
+
           data-lanes:
+            description: Four D-PHY data lanes, or three C-PHY trios.
+            minItems: 3
             items:
               - const: 1
               - const: 2
-- 
2.43.0

