From afecbcd078fe765dafa1fda52abad8fda51d56b6 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Sun, 27 Sep 2026 01:04:51 -0700
Subject: [PATCH 137/138] arm64: dts: qcom: pmk8850: Add the reboot mode

The bootloader reads the reboot mode from the same SDAM cell as on PMK8550.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 arch/arm64/boot/dts/qcom/pmk8850.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pmk8850.dtsi b/arch/arm64/boot/dts/qcom/pmk8850.dtsi
index 44d1d1957f8a..7fd14de84007 100644
--- a/arch/arm64/boot/dts/qcom/pmk8850.dtsi
+++ b/arch/arm64/boot/dts/qcom/pmk8850.dtsi
@@ -9,6 +9,16 @@
 #include <dt-bindings/spmi/spmi.h>
 #include "qcom-adc5-gen4.h"
 
+/ {
+	reboot-mode {
+		compatible = "nvmem-reboot-mode";
+		nvmem-cells = <&reboot_reason>;
+		nvmem-cell-names = "reboot-mode";
+		mode-recovery = <0x01>;
+		mode-bootloader = <0x02>;
+	};
+};
+
 &spmi_bus0 {
 	pmic@0 {
 		compatible = "qcom,pmk8850", "qcom,spmi-pmic";
