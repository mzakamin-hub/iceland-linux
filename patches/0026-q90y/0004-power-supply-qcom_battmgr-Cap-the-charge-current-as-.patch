From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Wed, 28 Oct 2026 12:48:54 +0300
Subject: [PATCH 4/6] power: supply: qcom_battmgr: Cap the charge current as a
 cooling device

When the pmic-glink node lists charge current steps in
qcom,charge-current-limits-microamp, register a thermal cooling device
"qcom-battmgr-charge" on that node, with one state per step. State 0
leaves the charge current alone; state N caps it at the Nth step.
Without the property nothing is registered and nothing changes.

With the Oplus charger firmware the cap is applied together with the
host's own cap (constant_charge_current_max): the smaller one is written
to BATT_CHG_CTRL_LIM, at once when a charger is set up and again at every
attach. It only lowers the charge current; the PD 5 V cool-down keeps
following the host's cap alone. With the other sm8350-style firmware the
cap is written to BATT_CHG_CTRL_LIM directly, state 0 restores the
firmware's maximum read from BATT_CHG_CTRL_LIM_MAX, and a restarted
firmware gets the state again. The SC8280XP / X1E firmware numbers its
battery properties differently and is left out.

The cooling device is registered on the pmic-glink node, which the
battery manager's auxiliary device shares, so that the board's cooling
maps can bind to it.

The idea, a cooling device on the charge current limit, comes from
Doctor Logix's Perpetua kernel (denialwm/linux-perpetua ac4fb177caca,
"power: supply: qcom_battmgr: limit the charge current as a cooling
device"); that commit carries no Signed-off-by, so this is our own
implementation for our driver.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/Kconfig        |   1 +
 drivers/power/supply/qcom_battmgr.c | 179 ++++++++++++++++++++++++++++
 2 files changed, 180 insertions(+)

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 4679a32e6f2f..541c55104d96 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -211,6 +211,7 @@ config BATTERY_PMU
 config BATTERY_QCOM_BATTMGR
 	tristate "Qualcomm PMIC GLINK battery manager support"
 	depends on QCOM_PMIC_GLINK
+	depends on THERMAL || !THERMAL
 	select AUXILIARY_BUS
 	help
 	  Say Y here to enable the Qualcomm PMIC GLINK power supply driver,
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index e8455a22c610..bc36d0496581 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -19,6 +19,7 @@
 #include <linux/soc/qcom/pdr.h>
 #include <linux/soc/qcom/pmic_glink.h>
 #include <linux/suspend.h>
+#include <linux/thermal.h>
 #include <linux/math.h>
 #include <linux/units.h>
 
@@ -448,6 +449,11 @@ struct qcom_battmgr {
 	bool no_wireless;
 	unsigned int chg_fcc_ua;	/* the charge current set at the last attach */
 	unsigned int chg_fcc_host_ua;	/* the host's cap (constant_charge_current_max), 0 = none */
+	/* the board's thermal charge current steps (cooling states 1..n), see qcom_battmgr_cool_init() */
+	u32 *cool_ua;
+	unsigned int cool_levels;
+	unsigned long cool_state;
+	unsigned int cool_max_ua;	/* not OPLUS: the firmware's own maximum, 0 = not read yet */
 	bool chg_inhibit;
 	/* the host's input suspend (input_current_limit 0), see qcom_battmgr_oplus_set_input_limit() */
 	bool input_suspend;
@@ -930,10 +936,22 @@ out_unlock:
 	return ret;
 }
 
+/* the charge current step of the cooling device's state, 0 = none */
+static unsigned int qcom_battmgr_cool_cap_ua(struct qcom_battmgr *battmgr)
+{
+	unsigned long state = READ_ONCE(battmgr->cool_state);
+
+	return state ? battmgr->cool_ua[state - 1] : 0;
+}
+
 static unsigned int qcom_battmgr_oplus_fcc_ua(struct qcom_battmgr *battmgr, unsigned int fcc_ua)
 {
+	unsigned int cool_ua = qcom_battmgr_cool_cap_ua(battmgr);
+
 	if (battmgr->chg_fcc_host_ua)
 		fcc_ua = min(fcc_ua, battmgr->chg_fcc_host_ua);
+	if (cool_ua)
+		fcc_ua = min(fcc_ua, cool_ua);
 
 	return fcc_ua;
 }
@@ -2274,6 +2292,9 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		case BATT_CHG_CTRL_END_THR:
 			battmgr->info.charge_ctrl_end = le32_to_cpu(resp->intval.value);
 			break;
+		case BATT_CHG_CTRL_LIM_MAX:
+			battmgr->cool_max_ua = le32_to_cpu(resp->intval.value);
+			break;
 		default:
 			dev_warn(battmgr->dev, "unknown property %#x\n", property);
 			break;
@@ -3191,6 +3212,150 @@ static void qcom_battmgr_oplus_enable(struct qcom_battmgr *battmgr)
 			 msecs_to_jiffies(OPLUS_CID_GRACE_MS));
 }
 
+/*
+ * Charge current cooling device. A board that lists charge current steps in
+ * "qcom,charge-current-limits-microamp" (descending) gets a cooling device on
+ * the pmic-glink node with one state per step: state 0 leaves the charge
+ * current alone, state N caps it at the Nth step. Without that property
+ * nothing is registered and nothing changes.
+ *
+ * OPLUS: the cap joins the host's own cap (constant_charge_current_max) in
+ * qcom_battmgr_oplus_fcc_ua(), so the attach setup applies it as well. It
+ * only lowers the charge current; the PD 5 V cool-down still follows the
+ * host's cap alone. Other firmware: the cap is written to BATT_CHG_CTRL_LIM,
+ * and state 0 writes back the firmware's own maximum (BATT_CHG_CTRL_LIM_MAX).
+ */
+static int qcom_battmgr_cool_apply(struct qcom_battmgr *battmgr)
+{
+	unsigned int cap_ua = qcom_battmgr_cool_cap_ua(battmgr);
+	unsigned int ua;
+	int ret;
+
+	lockdep_assert_held(&battmgr->lock);
+
+	/* the service start applies it once the firmware listens */
+	if (!battmgr->service_up)
+		return 0;
+
+	if (battmgr->variant == QCOM_BATTMGR_OPLUS) {
+		/* nothing set up since the last attach: the next setup applies it */
+		if (!battmgr->chg_fcc_ua)
+			return 0;
+		ua = qcom_battmgr_oplus_fcc_ua(battmgr, battmgr->chg_fcc_ua);
+	} else {
+		if (!battmgr->cool_max_ua) {
+			ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+							    BATT_CHG_CTRL_LIM_MAX, 0);
+			if (ret)
+				return ret;
+			if (!battmgr->cool_max_ua)
+				return -ENODATA;
+		}
+		ua = cap_ua ? min(cap_ua, battmgr->cool_max_ua) : battmgr->cool_max_ua;
+	}
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+					    BATT_CHG_CTRL_LIM, ua);
+	if (ret)
+		dev_err(battmgr->dev, "charge current cooling: %u uA not set: %d\n", ua, ret);
+
+	return ret;
+}
+
+static int qcom_battmgr_cool_get_max_state(struct thermal_cooling_device *cdev,
+					   unsigned long *state)
+{
+	struct qcom_battmgr *battmgr = cdev->devdata;
+
+	*state = battmgr->cool_levels;
+
+	return 0;
+}
+
+static int qcom_battmgr_cool_get_cur_state(struct thermal_cooling_device *cdev,
+					   unsigned long *state)
+{
+	struct qcom_battmgr *battmgr = cdev->devdata;
+
+	*state = READ_ONCE(battmgr->cool_state);
+
+	return 0;
+}
+
+static int qcom_battmgr_cool_set_cur_state(struct thermal_cooling_device *cdev,
+					   unsigned long state)
+{
+	struct qcom_battmgr *battmgr = cdev->devdata;
+	int ret = 0;
+
+	if (state > battmgr->cool_levels)
+		return -EINVAL;
+
+	mutex_lock(&battmgr->lock);
+	if (state != battmgr->cool_state) {
+		/* kept on failure: the next attach or service start applies it */
+		WRITE_ONCE(battmgr->cool_state, state);
+		ret = qcom_battmgr_cool_apply(battmgr);
+	}
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
+static const struct thermal_cooling_device_ops qcom_battmgr_cool_ops = {
+	.get_max_state = qcom_battmgr_cool_get_max_state,
+	.get_cur_state = qcom_battmgr_cool_get_cur_state,
+	.set_cur_state = qcom_battmgr_cool_set_cur_state,
+};
+
+static int qcom_battmgr_cool_init(struct qcom_battmgr *battmgr)
+{
+	static const char prop[] = "qcom,charge-current-limits-microamp";
+	struct thermal_cooling_device *cdev;
+	struct device *dev = battmgr->dev;
+	int n, i, ret;
+
+	if (!device_property_present(dev, prop))
+		return 0;
+
+	/* the SC8280XP / X1E firmware numbers its battery properties differently */
+	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
+	    battmgr->variant == QCOM_BATTMGR_X1E80100) {
+		dev_warn(dev, "%s is not supported with this firmware\n", prop);
+		return 0;
+	}
+
+	n = device_property_count_u32(dev, prop);
+	if (n <= 0)
+		return dev_err_probe(dev, n ?: -EINVAL, "invalid %s\n", prop);
+
+	battmgr->cool_ua = devm_kcalloc(dev, n, sizeof(*battmgr->cool_ua), GFP_KERNEL);
+	if (!battmgr->cool_ua)
+		return -ENOMEM;
+
+	ret = device_property_read_u32_array(dev, prop, battmgr->cool_ua, n);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read %s\n", prop);
+
+	for (i = 0; i < n; i++) {
+		if (!battmgr->cool_ua[i] ||
+		    (i && battmgr->cool_ua[i] >= battmgr->cool_ua[i - 1]))
+			return dev_err_probe(dev, -EINVAL,
+					     "%s: steps must be above 0 and descending\n", prop);
+	}
+
+	battmgr->cool_levels = n;
+
+	/* on the pmic-glink node (the auxiliary device shares it): the board's cooling maps can point at it */
+	cdev = devm_thermal_of_cooling_device_register(dev, 0, "qcom-battmgr-charge",
+						       battmgr, &qcom_battmgr_cool_ops);
+	if (IS_ERR(cdev))
+		return dev_err_probe(dev, PTR_ERR(cdev),
+				     "cannot register the charge current cooling device\n");
+
+	return 0;
+}
+
 static void qcom_battmgr_enable_worker(struct work_struct *work)
 {
 	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, enable_work);
@@ -3207,6 +3372,15 @@ static void qcom_battmgr_enable_worker(struct work_struct *work)
 
 	if (battmgr->variant == QCOM_BATTMGR_OPLUS)
 		qcom_battmgr_oplus_enable(battmgr);
+
+	/* a (re)started firmware holds its own limit again */
+	if (battmgr->cool_levels && battmgr->variant != QCOM_BATTMGR_OPLUS) {
+		mutex_lock(&battmgr->lock);
+		battmgr->cool_max_ua = 0;
+		if (battmgr->cool_state)
+			qcom_battmgr_cool_apply(battmgr);
+		mutex_unlock(&battmgr->lock);
+	}
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
@@ -3413,6 +3587,11 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	if (IS_ERR(battmgr->client))
 		return PTR_ERR(battmgr->client);
 
+	/* after the client: devres removes the cooling device first */
+	ret = qcom_battmgr_cool_init(battmgr);
+	if (ret)
+		return ret;
+
 	pmic_glink_client_register(battmgr->client);
 
 	return 0;
