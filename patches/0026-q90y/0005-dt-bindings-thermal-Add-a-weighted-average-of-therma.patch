From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Wed, 28 Oct 2026 12:48:55 +0300
Subject: [PATCH 5/6] dt-bindings: thermal: Add a weighted average of thermal
 zones

Vendor thermal policies of phones and tablets throttle on estimated
temperatures of surfaces that carry no thermistor, such as the back
cover, computed as a fixed weighting of other sensors.

Describe a virtual sensor for such an estimate: the zones it averages,
by zone name, and the weight of each.

The compatible and the two properties follow Doctor Logix's Perpetua
kernel (denialwm/linux-perpetua 80167ebc3b97); the text is our own.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../thermal/weighted-thermal-sensor.yaml      | 56 +++++++++++++++++++
 1 file changed, 56 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/thermal/weighted-thermal-sensor.yaml

diff --git a/Documentation/devicetree/bindings/thermal/weighted-thermal-sensor.yaml b/Documentation/devicetree/bindings/thermal/weighted-thermal-sensor.yaml
new file mode 100644
index 000000000000..2f4c01819459
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/weighted-thermal-sensor.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/weighted-thermal-sensor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Weighted average of thermal zones
+
+maintainers:
+  - mzak <mzak.amin@gmail.com>
+
+description:
+  A virtual thermal sensor whose temperature is a weighted average of other
+  thermal zones, named by their zone names. Handheld devices throttle on such
+  estimates for surfaces that carry no thermistor, for example the back cover.
+  A thermal zone uses the sensor through thermal-sensors like any other.
+
+allOf:
+  - $ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: weighted-thermal-sensor
+
+  '#thermal-sensor-cells':
+    const: 0
+
+  zone-names:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    description: The thermal zones to average, by zone name.
+    minItems: 1
+
+  weights:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      The weight of each entry of zone-names, in the same order. Only the
+      ratios count; the sum must not be 0.
+    minItems: 1
+
+required:
+  - compatible
+  - '#thermal-sensor-cells'
+  - zone-names
+  - weights
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    back-cover-estimate {
+        compatible = "weighted-thermal-sensor";
+        #thermal-sensor-cells = <0>;
+        zone-names = "battery-thermal", "skin-thermal", "cpu-0-0-0-thermal";
+        weights = <50 35 15>;
+    };
+...
