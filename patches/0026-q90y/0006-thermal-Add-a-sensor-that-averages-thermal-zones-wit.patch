From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Wed, 28 Oct 2026 12:48:55 +0300
Subject: [PATCH 6/6] thermal: Add a sensor that averages thermal zones with
 weights

Add a driver for weighted-thermal-sensor: a thermal sensor whose
temperature is the weighted average of the zones named in its zone-names
property. Its probe waits until every input zone exists. The inputs are
looked up by name on each read, so an input whose driver is reloaded is
followed, and a read fails while any input cannot be read, so a missing
input never lowers the estimate. A zone that names itself as an input
is refused at read time.

The design follows Doctor Logix's Perpetua kernel
(denialwm/linux-perpetua 36df23454a01, "thermal: add a sensor that
reports a weighted average of thermal zones"); that commit carries no
Signed-off-by, so this is our own implementation.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/thermal/Kconfig            |  12 +++
 drivers/thermal/Makefile           |   1 +
 drivers/thermal/thermal-weighted.c | 132 +++++++++++++++++++++++++++++
 3 files changed, 145 insertions(+)
 create mode 100644 drivers/thermal/thermal-weighted.c

diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index 810eeccedfba..e18ec741897d 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -477,6 +477,18 @@ source "drivers/thermal/spacemit/Kconfig"
 
 source "drivers/thermal/tegra/Kconfig"
 
+config THERMAL_WEIGHTED_SENSOR
+	tristate "Weighted average of thermal zones"
+	depends on THERMAL_OF
+	help
+	  A virtual thermal sensor that reports a weighted average of other
+	  thermal zones, as the device tree describes it. Handheld devices
+	  throttle on such an estimate for surfaces that carry no thermistor,
+	  such as the back cover.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called thermal-weighted.
+
 config GENERIC_ADC_THERMAL
 	tristate "Generic ADC based thermal sensor"
 	depends on IIO
diff --git a/drivers/thermal/Makefile b/drivers/thermal/Makefile
index 3b249195c088..a44b3baef93e 100644
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -63,6 +63,7 @@ obj-y				+= tegra/
 obj-$(CONFIG_HISI_THERMAL)     += hisi_thermal.o
 obj-y				+= mediatek/
 obj-$(CONFIG_GENERIC_ADC_THERMAL)	+= thermal-generic-adc.o
+obj-$(CONFIG_THERMAL_WEIGHTED_SENSOR)	+= thermal-weighted.o
 obj-$(CONFIG_UNIPHIER_THERMAL)	+= uniphier_thermal.o
 obj-$(CONFIG_AMLOGIC_THERMAL)     += amlogic_thermal.o
