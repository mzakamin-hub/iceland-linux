From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 24 Oct 2026 09:51:23 +0300
Subject: [PATCH 4/4] virt: gunyah: rsc_mgr: unregister the PM notifier on
 unload

gunyah_rm_init() registers a PM notifier (hibernation restore of the
address-space info area) when the info area is present, but neither
gunyah_rm_exit() nor the init error paths after the registration take
it off the chain again. Once gunyah_rsc_mgr is unloaded (modprobe -r of
the Gunyah stack) the next suspend calls into the freed module text:

  Unable to handle kernel execute from non-executable memory
  pm_notifier_call_chain_robust <- pm_suspend

Unregister the notifier in gunyah_rm_exit() and on the init error
paths (the struct is freed there by __free(kfree)).

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/virt/gunyah/rsc_mgr.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/virt/gunyah/rsc_mgr.c b/drivers/virt/gunyah/rsc_mgr.c
index e607c70ce8a7..9aacd013df20 100644
--- a/drivers/virt/gunyah/rsc_mgr.c
+++ b/drivers/virt/gunyah/rsc_mgr.c
@@ -1002,15 +1002,17 @@ static int __init gunyah_rm_init(void)
 		if (ret)
 			pr_err("Failed to register pm notifier\n");
 	}
-	if (ret)
+	if (ret) {
+		rm->pm_nb.notifier_call = NULL;
 		return ret;
+	}
 
 	enable_irq_wake(rm->tx_ghrsc.irq);
 	ret = request_threaded_irq(rm->tx_ghrsc.irq, NULL,
 					 gunyah_rm_tx, IRQF_ONESHOT,
 					 "gunyah_rm_tx", rm);
 	if (ret)
-		return ret;
+		goto unregister_pm;
 	/* assume RM is ready to receive messages from us */
 	complete(&rm->send_ready);
 
@@ -1062,6 +1064,9 @@ free_rx_irq:
 	free_irq(rm->rx_ghrsc.irq, rm);
 free_tx_irq:
 	free_irq(rm->tx_ghrsc.irq, rm);
+unregister_pm:
+	if (rm->pm_nb.notifier_call)
+		unregister_pm_notifier(&rm->pm_nb);
 	return ret;
 }
 module_init(gunyah_rm_init);
@@ -1075,6 +1080,9 @@ static void __exit gunyah_rm_exit(void)
 	if (!rm)
 		return;
 
+	/* the PM notifier lives in this module: never leave it on the chain */
+	if (rm->pm_nb.notifier_call)
+		unregister_pm_notifier(&rm->pm_nb);
 	gunyah_rm_sysfs_unregister();
 	gunyah_cma_mem_exit();
 	auxiliary_device_delete(&rm->adev);
