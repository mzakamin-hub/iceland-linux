# SPDX-License-Identifier: GPL-2.0-only
# Merged after defconfig + sm8850.config. Goal: one kernel for any rootfs (Fedora, Ubuntu/Debian, Arch, pmOS, Kali)
# booted via U-Boot EFI -> systemd-boot/GRUB. Boot-critical drivers built in so any initramfs (or none) reaches root.
CONFIG_LOCALVERSION="-iceland"

# EFI boot through U-Boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=n

# Storage path to the root filesystem: built in
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_ZRAM=m

# Early display: framebuffer handed over by the boot chain
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Probes that must happen after rootfs firmware is available (troikoss: built-in hci_qca never retries)
CONFIG_BT_HCIUART=m
CONFIG_ATH12K=m

# systemd / container / security features used by all target distros
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_BPF_SYSCALL=y
CONFIG_NF_TABLES=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Debug for bring-up
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# Modules: compressed, unsigned for now (persistent key decided before any release)
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_SIG=n

# PMIC ADC5 Gen4 (pmk8850 adc@9000, driver qcom-spmi-adc5-gen3) and its thermal monitor. They were not enabled,
# so the ADC stayed unbound (PC relay kit pc-004: both bind with these)
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m
CONFIG_QCOM_SPMI_BCL=y

# Both KTZ8869 backlight ICs share their HWEN line (TLMM 1). Since 7.3 gpiolib hands a shared GPIO to its
# consumers through the gpio-shared-proxy driver; as a module it is not there when the backlight probes, and the
# backlight (so the panel and the whole display) defers with no reason printed (PC relay kit pc-006)
CONFIG_GPIO_SHARED_PROXY=y

# DMABUF_DEBUG (default y with DEBUG_KERNEL) hands every dma-buf importer a copy of the exporter's sg table without
# its pages and CPU lengths. The GPU driver builds its own page tables from them (msm_gem_import, sg_phys), so every
# foreign buffer - Iris video frames, udmabuf/shm frames sent to the compositor - was mapped as nothing: GPU
# translation faults, thousands of io-pgtable unmap warnings, and hardware-decoded video shown solid green
# (PC relay runs area-video-2..5). It is a debug check, not a feature.
CONFIG_DMABUF_DEBUG=n

# The pen charger (Maxic MT5806 wireless transmitter on the magnet side, patches 0090-0093)
CONFIG_CHARGER_MT5806_PEN=m

# The pogo keyboard dock (private protocol on one data line at 921600 baud, patches 0094-0097); built in so
# that it is there before user space mounts the module tree
CONFIG_KEYBOARD_ONEPLUS_POGO=y

# The installed Fedora (install plan K1): SELinux is built in but only starts when it is in CONFIG_LSM; Fedora's
# targeted policy then enforces. Fedora ships its firmware xz-compressed (qcom-firmware), so the loader must read
# compressed files; it tries the plain name first, so the kits' uncompressed firmware is found as before. A RAM kit
# without a policy only logs "SELinux:  Initializing." and allows everything (area-combo-65).
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Quick wins (area-combo-78): boot votes released after the deferred-probe timeout (every RPMh provider reaches
# sync_state, the GPU's GMU node has no driver), the camera EEPROMs, the PDCharger log on the SoCCP channel, IMEM and
# the SCMI shared memory on the sram driver, LLCC ECC reports, the watchdog in sysfs.
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y
CONFIG_EEPROM_AT24=m
CONFIG_QCOM_PMIC_PDCHARGER_ULOG=m
CONFIG_SRAM=y
CONFIG_EDAC_QCOM=m
CONFIG_WATCHDOG_SYSFS=y

# USB Attached SCSI for fast USB drives (usb-storage is built in; loads by alias when a UAS drive appears), area-combo-83 / -89.
CONFIG_USB_UAS=m

# PMIC power telemetry (per-rail energy / power through hwmon; starts only when read), area-combo-92.
CONFIG_SENSORS_QCOM_SPMI_QPT=m

# The SmartSens SC1320CS / SC820CS cameras (queue 0175), R2-final 3 Oct.
CONFIG_VIDEO_SC1320CS=m

# Fedora's alsa-lib loads snd-seq after snd-pcm (dist-alsa.conf); without it the first audio module loads abort.
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_SEQ_MIDI=m
CONFIG_SND_SEQ_MIDI_EVENT=m

# firewalld's nftables rules (inet rpfilter fib, redirect, helpers); without them firewalld exits at start.
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_DUP_IPV6=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CONNTRACK_SIP=m
CONFIG_NF_CONNTRACK_IRC=m
CONFIG_NF_CONNTRACK_H323=m
CONFIG_NF_CONNTRACK_PPTP=m
CONFIG_NF_CONNTRACK_SANE=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_NAT_FTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_NF_NAT_SIP=m
CONFIG_NF_NAT_IRC=m
CONFIG_NF_NAT_PPTP=m
CONFIG_NF_NAT_H323=m
CONFIG_NF_NAT_AMANDA=m

# systemd and the install rehearsal set kernel.hung_task_panic / hung_task_timeout_secs.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120

# F02: CMA dma-heap too small for full-size soft-ISP buffers: stop exporting CMA as dma-heaps
# (CONFIG_DMABUF_HEAPS_CMA off), libcamera then uses the system heap (wf/camfix, kernel q84).
# CONFIG_DMABUF_HEAPS_CMA is not set

# F12 F20: irqbalance: thermal netlink missing (CONFIG_THERMAL_NETLINK unset); PCIe: 11 probe attempts (pwrctrl
# module waits) + vdda / vddpe-3v3 dummy lines (no such supply on this board) (wf/klog, kernel q84).
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_THERMAL_NETLINK=y

# Waydroid (queue 0309): no system-wide /dev/binder* nodes. Binder, binderfs and PSI come from sm8850.config; each
# container start mounts its own binderfs instance and allocates its devices there. Nothing on the host uses binder.
CONFIG_ANDROID_BINDER_DEVICES=""

# Power (powerperf candidate C1, 15 Oct 2026): idle-power options that Android's GKI builds (android16-6.12
# gki_defconfig: CPU_IDLE_GOV_TEO, RCU_EXPERT, RCU_NOCB_CPU, RCU_LAZY, RCU_LAZY_DEFAULT_OFF), each one OFF by default
# so that this kernel behaves as before until the owner's A/B switches it on:
# - TEO is built next to menu; menu keeps the higher rating (20 vs 19) and stays the boot governor. The A/B switches
#   at run time through /sys/devices/system/cpu/cpuidle/current_governor (tablet/powerperf/powerperf.sh --ab-gov).
# - lazy RCU batches call_rcu() callbacks on offloaded CPUs for seconds instead of a grace period per few jiffies;
#   nothing is offloaded without rcu_nocbs= and nothing is lazy without rcutree.enable_rcu_lazy=1 (kernel command
#   line, powerperf.sh --rcu-lazy on / off).
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y
CONFIG_RCU_LAZY_DEFAULT_OFF=y

# The SMP2P sleep-state notifier to the ADSP / sensor hub (queue 0352-0354, trial q89s): built in, so the AP-awake bit
# is set right after the ADSP's SMP2P edge probes (the new entry reads "asleep" until the driver sets it). Switches:
# smp2p_sleepstate.notify=0 / smp2p_sleepstate.wakeup=0 (command line, or /sys/module/smp2p_sleepstate/parameters).
CONFIG_QCOM_SMP2P_SLEEPSTATE=y

# Everyday devices (trial q89v, K-1): what Fedora's own aarch64 kernel builds for USB / Bluetooth input devices, phone
# tethering, foreign file systems and the network defaults systemd sets. Modules, or options inside one: nothing loads
# until a device, a mount or a sysctl asks for it.
# - HID: the vendor drivers instead of hid-generic (Fn keys, hi-res scrolling, battery levels, Logitech Unifying / Bolt
#   receivers, Wacom pens and tablets, PlayStation / Steam controllers with rumble). HID-BPF is built in but inert
#   until the kernel carries BTF (its struct_ops need vmlinux BTF; BTF, sched_ext and the BPF LSM wait for a round with
#   pahole on the build host and full DWARF, wf/qv-misc/NEXT.txt).
# - userfaultfd: the ART garbage collector of Android 14+ containers and CRIU; unprivileged use stays limited to user
#   faults (vm.unprivileged_userfaultfd 0).
# - USB tethering from Android phones (RNDIS) and iPhones (ipheth; pairing needs usbmuxd).
# - NTFS (ntfs3, with compressed files and ACLs) and ISO 9660 (Joliet names, zisofs) media.
# - fq_codel: systemd's sysctl.d sets net.core.default_qdisc = fq_codel; the write loads the module. The kernel default
#   stays pfifo_fast, as in Fedora. BBR, kernel TLS and MPTCP as modules / options for the programs that ask for them.
# - DP AUX character devices (/dev/drm_dp_auxN, root only): DPCD reads for the "DP link up, no picture" diagnosis.
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_WACOM=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HID_BPF=y
CONFIG_USERFAULTFD=y
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_TCP_CONG_BBR=m
CONFIG_TLS=m
CONFIG_MPTCP=y
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y

# DMA through the IOMMU (trial q89v, K-3): lazy TLB invalidation, as Fedora's aarch64 kernel. Unmapped IOVAs are
# flushed in batches (per-CPU flush queue, at the latest after 10 ms) instead of one TLB invalidate + sync per unmap
# for UFS, Wi-Fi (PCIe), USB, Iris, camera and FastRPC; the GPU and the display keep their own page tables. A device
# can still reach a buffer for up to that window after its unmap. Undo: iommu.strict=1 on the kernel command line;
# check: "iommu: DMA domain TLB invalidation policy: lazy mode" in dmesg, DMA-FQ in /sys/kernel/iommu_groups/*/type.
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y

# q89w: drivers for external USB-C devices (docks, hubs, dongles) missing from q89u / q89v. Modules only.
# Card readers in docks / hubs
CONFIG_USB_STORAGE_REALTEK=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_MEMSTICK=m
CONFIG_MEMSTICK_REALTEK_USB=m
# Serial adapters
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
# Mobile broadband dongles, extra USB Ethernet
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_AQC111=m
# USB Wi-Fi dongles (firmware from Fedora's firmware packages)
CONFIG_RTW88=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852BU=m
CONFIG_MT7921U=m
CONFIG_ATH9K_HTC=m
# Extras
CONFIG_USB_APPLEDISPLAY=m
CONFIG_USB_GSPCA=m
