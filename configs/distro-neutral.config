# SPDX-License-Identifier: GPL-2.0-only
# Merged after defconfig + sm8850.config. Goal: one kernel for any rootfs (Fedora, Ubuntu/Debian, Arch, pmOS, Kali)
# booted via U-Boot EFI -> systemd-boot/GRUB. Boot-critical drivers built in so any initramfs (or none) reaches root.
CONFIG_LOCALVERSION="-iceland"

# EFI boot through U-Boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=n

# Storage path to the root filesystem: built in
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_ZRAM=m

# Early display: framebuffer handed over by the boot chain
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Probes that must happen after rootfs firmware is available (troikoss: built-in hci_qca never retries)
CONFIG_BT_HCIUART=m
CONFIG_ATH12K=m

# systemd / container / security features used by all target distros
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_BPF_SYSCALL=y
CONFIG_NF_TABLES=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Debug for bring-up
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# Modules: compressed, unsigned for now (persistent key decided before any release)
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_SIG=n

# PMIC ADC5 Gen4 (pmk8850 adc@9000, driver qcom-spmi-adc5-gen3) and its thermal monitor. They were not enabled,
# so the ADC stayed unbound (PC relay kit pc-004: both bind with these)
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m
CONFIG_QCOM_SPMI_BCL=y

# Both KTZ8869 backlight ICs share their HWEN line (TLMM 1). Since 7.3 gpiolib hands a shared GPIO to its
# consumers through the gpio-shared-proxy driver; as a module it is not there when the backlight probes, and the
# backlight (so the panel and the whole display) defers with no reason printed (PC relay kit pc-006)
CONFIG_GPIO_SHARED_PROXY=y

# DMABUF_DEBUG (default y with DEBUG_KERNEL) hands every dma-buf importer a copy of the exporter's sg table without
# its pages and CPU lengths. The GPU driver builds its own page tables from them (msm_gem_import, sg_phys), so every
# foreign buffer - Iris video frames, udmabuf/shm frames sent to the compositor - was mapped as nothing: GPU
# translation faults, thousands of io-pgtable unmap warnings, and hardware-decoded video shown solid green
# (PC relay runs area-video-2..5). It is a debug check, not a feature.
CONFIG_DMABUF_DEBUG=n

# The pen charger (Maxic MT5806 wireless transmitter on the magnet side, patches 0090-0093)
CONFIG_CHARGER_MT5806_PEN=m

# The pogo keyboard dock (private protocol on one data line at 921600 baud, patches 0094-0097); built in so
# that it is there before user space mounts the module tree
CONFIG_KEYBOARD_ONEPLUS_POGO=y

# The installed Fedora (install plan K1): SELinux is built in but only starts when it is in CONFIG_LSM; Fedora's
# targeted policy then enforces. Fedora ships its firmware xz-compressed (qcom-firmware), so the loader must read
# compressed files; it tries the plain name first, so the kits' uncompressed firmware is found as before. A RAM kit
# without a policy only logs "SELinux:  Initializing." and allows everything (area-combo-65).
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Quick wins (area-combo-78): boot votes released after the deferred-probe timeout (every RPMh provider reaches
# sync_state, the GPU's GMU node has no driver), the camera EEPROMs, the PDCharger log on the SoCCP channel, IMEM and
# the SCMI shared memory on the sram driver, LLCC ECC reports, the watchdog in sysfs.
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y
CONFIG_EEPROM_AT24=m
CONFIG_QCOM_PMIC_PDCHARGER_ULOG=m
CONFIG_SRAM=y
CONFIG_EDAC_QCOM=m
CONFIG_WATCHDOG_SYSFS=y

# USB Attached SCSI for fast USB drives (usb-storage is built in; loads by alias when a UAS drive appears), area-combo-83 / -89.
CONFIG_USB_UAS=m
