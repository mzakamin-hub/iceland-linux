# SPDX-License-Identifier: GPL-2.0-only
# q90i (22 Oct 2026): kernel config round (optimization scan B2). Merged after q90h's config; each line has its reason.
# Full table with the kept options: docs/Q90I-CONFIG-TRIM-2026-10-22.md (private project) / the queue commit message.
#
# Virtual address size 52 -> 48 bit (4 KiB pages: 5 -> 4 page-table levels, PA 52 -> 48 bit). 52-bit VA only serves
# mmap() hints above 2^48 (nothing on the tablet asks for it) and cuts the pointer-authentication code from 7 to 3 bits
# (arch/arm64/Kconfig); 48 bit is what Fedora's own aarch64 kernel uses. 39 bit was rejected: 512 GiB of user space is
# too small for browsers' WebAssembly guard reservations and for x86-64 emulation (FEX needs 47-bit user space).
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
# Timer tick 1000 -> 250 Hz: a quarter of the scheduler ticks on busy CPUs (Android GKI uses 250). The queue's own
# timeouts are all >= 20 ms (msleep / msecs_to_jiffies), idle refresh and vblank waits are in ms, the 0335 latency
# request is a PM QoS value (no tick), input events are interrupt driven, audio / DPU timers are hrtimers.
CONFIG_HZ_250=y
# CONFIG_HZ_1000 is not set
# Preemption: built with PREEMPT_DYNAMIC, boot default stays full preemption (CONFIG_PREEMPT, the 21 Oct latency
# decision); preempt=lazy on the command line (or /sys/kernel/debug/sched/preempt at run time) selects the lazy model
# for an A/B without another kernel.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# ath12k debug messages: every ath12k_dbg() call site tests the debug mask, also in the TX / RX data path; no tool
# here sets ath12k's debug_mask. ATH12K_DEBUGFS (the debugfs statistics) stays.
# CONFIG_ATH12K_DEBUG is not set
# CoreSight trace and STM: five modules loaded by udev at every boot (coresight, _tmc, _funnel, _stm, stm_core) for
# trace hardware no tool here uses; the issue scan already lists the CoreSight devices as INFO when unbound.
# CONFIG_CORESIGHT is not set
# CONFIG_STM is not set
