# q91d: CSD lock wait debugging, reporting only (a CSD lock held past csd_lock_timeout is logged;
# the per-IPI csdlock_debug trace stays off by default)
CONFIG_CSD_LOCK_WAIT_DEBUG=y
# dwc3-qcom built in, as in every q91 package (q91c-q91k): the published fragments left it a module
CONFIG_USB_DWC3_QCOM=y
