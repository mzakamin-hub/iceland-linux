# q90n (24 Oct 2026, owner-approved)
# N1: named anonymous mappings (prctl PR_SET_VMA_ANON_NAME; DroidLoom / Android memory accounting)
CONFIG_ANON_VMA_NAME=y
# C1: lockup detectors (evidence for a stuck CPU): soft lockup + the buddy hard-lockup detector (no NMI needed);
# pseudo-NMI support for the stuck CPU's backtrace, off until irqchip.gicv3_pseudo_nmi=1; panics stay off
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_ARM64_PSEUDO_NMI=y
# C4: PMIC battery current limit monitor (module; probes only with qcom_bcl_hwmon.enable=1)
CONFIG_SENSORS_QCOM_SPMI_BCL=m
