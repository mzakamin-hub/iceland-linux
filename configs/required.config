# SPDX-License-Identifier: GPL-2.0-only
# Must be present in the final .config (checked by build.sh, not merged).
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_KAANAPALI=y
CONFIG_CLK_KAANAPALI_GCC=y
CONFIG_CLK_KAANAPALI_DISPCC=y
CONFIG_CLK_KAANAPALI_GPUCC=y
CONFIG_INTERCONNECT_QCOM_KAANAPALI=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_NOVATEK_NT36536=y
CONFIG_BACKLIGHT_KTZ8869_ICELAND=m
CONFIG_TOUCHSCREEN_NT36536_SPI=m
CONFIG_SND_SOC_TFA9865=m
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_EFI_STUB=y
CONFIG_CHARGER_MT5806_PEN=m
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y
CONFIG_SRAM=y
CONFIG_EEPROM_AT24=m
# Binder (Waydroid): the 7.4 base (q90b) removed the C binder driver; the Rust binder needs CONFIG_RUST, which this
# build does not enable, so the q90 kernels have no binder. Not checked until Rust is in the build.
# CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
