# q90z (30 Oct 2026): a 2 MB bounce-buffer pool that grows on demand instead of a fixed 64 MB one (every DMA master
# of the SoC is behind the SMMU; Qualcomm's qcom.config uses the same two values), and a 128 MB CMA area for the
# camera, video and DisplayPort buffers (32 MB left 8-10 MB free at idle).
CONFIG_SWIOTLB_DYNAMIC=y
CONFIG_SWIOTLB_DEFAULT_SIZE_MB=2
CONFIG_CMA_SIZE_MBYTES=128
