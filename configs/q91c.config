# q91 (v7.4-rc1 queue, released as q91c): CMA dma-buf heap, VM sockets, idle-injection cooling, Gunyah watchdog, no QCOM_LMH
# contiguous camera / video / DP buffers from the CMA heap (/dev/dma_heap/default_cma_region or reserved)
CONFIG_DMABUF_HEAPS_CMA=y
# host <-> Gunyah / QEMU VM sockets for iceland-vms
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m
CONFIG_VIRTIO_VSOCKETS=m
# idle injection as a gentler thermal step (cpuidle cooling device; not mapped in DT by default)
CONFIG_POWERCAP=y
CONFIG_IDLE_INJECT=y
CONFIG_CPU_IDLE_THERMAL=y
# Gunyah watchdog (a hard hang reboots the tablet instead of freezing it once systemd pets it)
CONFIG_GUNYAH_WATCHDOG=m
# lockup detectors, reporting only (no panic): buddy hard-lockup + soft-lockup
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set
# LMH is the OSM-era limits driver; Kaanapali's CPU limits come from CPUCP as SCMI perf notifications
# CONFIG_QCOM_LMH is not set
# sched_ext needs BTF (DEBUG_INFO_BTF: pahole, DEBUG_INFO_REDUCED off), which the k74 plan leaves out: not enabled
# kept as in the q90z package (v7.4-rc1 defconfig + fragments would otherwise leave it out)
CONFIG_BT_HCIBTUSB_QCOM=y
