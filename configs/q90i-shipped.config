# SPDX-License-Identifier: GPL-2.0-only
# q90i: the options in which the shipped q90i kernel's config differs from defconfig + sm8850.config +
# distro-neutral.config + q90b.config + q90i.config. Merged last by scripts/build.sh, so that a build from this
# branch gets the same .config as the kernel-iceland q90i package (checked: 0 differing lines after olddefconfig).
#
# Drivers and options the tablet uses: the memlat devfreq driver of the CPU control processor (SCMI) with its
# remote governor, the Qualcomm SCMI vendor extension it needs, the camera focus motor (DW9719), the KTZ8869
# backlight as a module, power-management debugging (runtime PM usage counts and suspend messages) and a 1 MiB
# kernel log buffer; I3C_OR_I2C and the SDM845 clock drivers follow from the other choices as they do in the
# shipped config.
CONFIG_BACKLIGHT_KTZ8869_ICELAND=m
CONFIG_DEVFREQ_GOV_REMOTE=m
CONFIG_I3C_OR_I2C=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_QCOM_SCMI_GENERIC_EXT=m
CONFIG_SCMI_QCOM_MEMLAT_DEVFREQ=m
CONFIG_SDM_DISPCC_845=y
CONFIG_SDM_GPUCC_845=y
CONFIG_SDM_VIDEOCC_845=y
CONFIG_VIDEO_DW9719=m
#
# Kept off as in the shipped kernel: drivers for other SoCs and boards that defconfig + sm8850.config would enable
# (I3C masters, other-SoC interconnect and clock drivers, panels, sensors, regulators) and the SPI target mode.
# CONFIG_AD4062 is not set
# CONFIG_ADI_I3C_MASTER is not set
# CONFIG_AMD_AXI_I3C_MASTER is not set
# CONFIG_ARCH_GOOGLE is not set
# CONFIG_BACKLIGHT_SY7758 is not set
# CONFIG_CDNS_I3C_MASTER is not set
# CONFIG_CLK_GLYMUR_GPUCC is not set
# CONFIG_DRM_MIPI_DBI is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_CORE is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_SPI is not set
# CONFIG_DRM_PANEL_RENESAS_R63419 is not set
# CONFIG_DW_I3C_MASTER is not set
# CONFIG_I3C is not set
# CONFIG_I3C_HUB is not set
# CONFIG_IIO_ST_LSM6DSX_I3C is not set
# CONFIG_INTERCONNECT_QCOM_HAWI is not set
# CONFIG_INTERCONNECT_QCOM_NORD is not set
# CONFIG_INTERCONNECT_QCOM_SAR2130P is not set
# CONFIG_INTERCONNECT_QCOM_SDM660 is not set
# CONFIG_INTERCONNECT_QCOM_SDM670 is not set
# CONFIG_INTERCONNECT_QCOM_SHIKRA is not set
# CONFIG_INTERCONNECT_QCOM_SM7150 is not set
# CONFIG_INV_ICM45600_I3C is not set
# CONFIG_LEDS_PCA963X is not set
# CONFIG_MIPI_I3C_HCI is not set
# CONFIG_PHY_QCOM_QMP_PCIE_MULTIPHY is not set
# CONFIG_PM_TEST_SUSPEND is not set
# CONFIG_REGMAP_I3C is not set
# CONFIG_REGULATOR_SGM3804 is not set
# CONFIG_SENSORS_EMC2305 is not set
# CONFIG_SENSORS_MR75203 is not set
# CONFIG_SENSORS_SPD5118 is not set
# CONFIG_SENSORS_SPD5118_DETECT is not set
# CONFIG_SPI_SLAVE is not set
# CONFIG_SPI_SLAVE_SYSTEM_CONTROL is not set
# CONFIG_SPI_SLAVE_TIME is not set
# CONFIG_SVC_I3C_MASTER is not set
