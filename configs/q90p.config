# q90p (24 Oct 2026, owner-approved): the board's kernel command line as built-in defaults; every value can still be
# overridden on the command line (iceland-device 0.28-39 boot.conf switches)
# msm / nt36536 panel switches, OnePlus Pad 4 only (DSC once, 30 Hz idle refresh, panel timing, late backlight;
# preemption + CLX only with the vendor533 GPU firmware pair)
CONFIG_DRM_MSM_ICELAND_DEFAULTS=y
# cpuidle.governor=teo
CONFIG_CPU_IDLE_GOV_DEFAULT="teo"
# mem_sleep_default=s2idle
CONFIG_PM_SLEEP_DEFAULT_S2IDLE=y
# rcu_nocbs=all
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
# rcutree.enable_rcu_lazy=1
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
